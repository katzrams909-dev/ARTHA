//@version=6
indicator("ARTHA P03.0 — Order Block / Breaker Lifecycle", overlay=true, max_boxes_count=200, max_labels_count=300)

// P03.0 standalone validation prototype.
// An order block is only created after a confirmed displacement break and is
// anchored to the most recent confirmed opposite-direction candle before the
// displacement leg. A broken order block becomes a breaker of the opposite
// polarity only after a confirmed close through its invalidation boundary.
// No entries are generated here.

string GS="01 Structure / Displacement"
int pivotLen=input.int(3,"Structure pivot strength",minval=1,group=GS)
float dispATR=input.float(0.75,"Displacement body / ATR",minval=0,step=0.05,group=GS)
bool requireClose=input.bool(true,"Require close through structure",group=GS)
int searchBack=input.int(8,"Max candles to search for OB",minval=1,maxval=30,group=GS)

string GO="02 Order Block"
bool useBodyOnly=input.bool(false,"OB zone = candle body only",group=GO)
float mitigationPct=input.float(50,"Mitigation threshold %",minval=1,maxval=99,step=1,group=GO)
int maxZones=input.int(30,"Maximum tracked zones",minval=5,maxval=80,group=GO)

string GV="03 Validation / Display"
bool showZones=input.bool(true,"Show OB / breaker zones",group=GV)
bool showText=input.bool(true,"Show text",group=GV)
bool showLifecycle=input.bool(false,"Show mitigation/broken text",group=GV)
bool diagnostic=input.bool(false,"Diagnostic panel",group=GV)

atr=ta.atr(14)
body=math.abs(close-open)
disp=atr>0?body/atr:0.0

//================ CONFIRMED STRUCTURE ================
ph=ta.pivothigh(high,pivotLen,pivotLen)
pl=ta.pivotlow(low,pivotLen,pivotLen)
var float targetHigh=na
var float targetLow=na
var int targetHighBar=na
var int targetLowBar=na
var bool waitingHigh=false
var bool waitingLow=false
if not na(ph) and not waitingHigh
    targetHigh:=ph
    targetHighBar:=bar_index-pivotLen
    waitingHigh:=true
if not na(pl) and not waitingLow
    targetLow:=pl
    targetLowBar:=bar_index-pivotLen
    waitingLow:=true

bullBreak=barstate.isconfirmed and waitingHigh and (requireClose?close>targetHigh:high>targetHigh) and disp>=dispATR
bearBreak=barstate.isconfirmed and waitingLow and (requireClose?close<targetLow:low<targetLow) and disp>=dispATR

//================ ORDER-BLOCK CANDIDATES ================
f_findBullCandidate() =>
    int found=-1
    for n=1 to searchBack
        if close[n]<open[n]
            found:=n
            break
    found

f_findBearCandidate() =>
    int found=-1
    for n=1 to searchBack
        if close[n]>open[n]
            found:=n
            break
    found

int bullCand=bullBreak?f_findBullCandidate():-1
int bearCand=bearBreak?f_findBearCandidate():-1

// States: 0 ACTIVE OB, 1 MITIGATED OB, 2 BREAKER, 3 INVALIDATED.
// Direction is source OB polarity: 1 bullish / -1 bearish. Breaker polarity
// is therefore the opposite of the source direction.
var float[] tops=array.new_float()
var float[] bots=array.new_float()
var int[] dirs=array.new_int()
var int[] states=array.new_int()
var int[] born=array.new_int()
var bool[] mitigatedFlags=array.new_bool()
var box[] boxes=array.new_box()
var label[] labels=array.new_label()

f_add(_top,_bot,_dir,_born) =>
    if array.size(tops)>=maxZones
        box oldBox=array.shift(boxes)
        box.delete(oldBox)
        label oldLabel=array.shift(labels)
        label.delete(oldLabel)
        array.shift(tops)
        array.shift(bots)
        array.shift(dirs)
        array.shift(states)
        array.shift(born)
        array.shift(mitigatedFlags)
    array.push(tops,_top)
    array.push(bots,_bot)
    array.push(dirs,_dir)
    array.push(states,0)
    array.push(born,_born)
    array.push(mitigatedFlags,false)
    box b=box.new(_born,_top,bar_index,_bot)
    array.push(boxes,b)
    label l=label.new(_born,_top,_dir==1?"OB ↑":"OB ↓",style=label.style_none)
    array.push(labels,l)

// The structure target is consumed by the confirmed break. This preserves the
// persistent-target behavior established by P01.6/P01.7.
if bullBreak
    waitingHigh:=false
    if bullCand>0
        float obTop=useBodyOnly?math.max(open[bullCand],close[bullCand]):high[bullCand]
        float obBot=useBodyOnly?math.min(open[bullCand],close[bullCand]):low[bullCand]
        f_add(obTop,obBot,1,bar_index-bullCand)
if bearBreak
    waitingLow:=false
    if bearCand>0
        float obTop=useBodyOnly?math.max(open[bearCand],close[bearCand]):high[bearCand]
        float obBot=useBodyOnly?math.min(open[bearCand],close[bearCand]):low[bearCand]
        f_add(obTop,obBot,-1,bar_index-bearCand)

int activeCount=0
int mitigatedCount=0
int breakerCount=0
int invalidCount=0
bool bullOBEvent=false
bool bearOBEvent=false
bool bullBreakerEvent=false
bool bearBreakerEvent=false
bool invalidBullEvent=false
bool invalidBearEvent=false

if array.size(tops)>0
    for i=array.size(tops)-1 to 0
        float top=array.get(tops,i)
        float bot=array.get(bots,i)
        int dir=array.get(dirs,i)
        int state=array.get(states,i)
        int bornBar=array.get(born,i)
        box b=array.get(boxes,i)
        label l=array.get(labels,i)

        if state!=3
            box.set_right(b,bar_index)

        if barstate.isconfirmed and bar_index>bornBar and state<=1
            float height=math.max(top-bot,syminfo.mintick)
            float penetration=dir==1?top-low:high-bot
            float fillPct=math.max(0.0,math.min(100.0,penetration/height*100.0))
            bool mitigated=fillPct>=mitigationPct
            bool broken=dir==1?close<bot:close>top

            if mitigated
                array.set(mitigatedFlags,i,true)
                if state==0
                    array.set(states,i,1)

            // A confirmed close through the far side converts the source OB
            // into an opposite-polarity breaker. A wick alone is insufficient.
            if broken
                array.set(states,i,2)
                if dir==1
                    bearBreakerEvent:=true
                else
                    bullBreakerEvent:=true

        else if barstate.isconfirmed and bar_index>bornBar and state==2
            // Breaker invalidation uses the source OB's original near boundary.
            bool breakerInvalid=dir==1?close>top:close<bot
            if breakerInvalid
                array.set(states,i,3)
                if dir==1
                    invalidBearEvent:=true
                else
                    invalidBullEvent:=true

        state:=array.get(states,i)
        if state==0
            label.set_text(l,showText?(dir==1?"OB ↑":"OB ↓"):"")
        else if state==1
            label.set_text(l,showText and showLifecycle?(dir==1?"OB ↑ · MIT":"OB ↓ · MIT"):"")
        else if state==2
            label.set_text(l,showText?(dir==1?"BREAKER ↓":"BREAKER ↑"):"")
        else
            label.set_text(l,showText and showLifecycle?"BREAKER ✕":"")

        if state==0
            activeCount+=1
        else if state==1
            mitigatedCount+=1
        else if state==2
            breakerCount+=1
        else
            invalidCount+=1

bullOBEvent:=bullBreak and bullCand>0
bearOBEvent:=bearBreak and bearCand>0

// Rendering is derived from state. Visibility cannot disable lifecycle logic.
if array.size(boxes)>0
    for i=0 to array.size(boxes)-1
        int dir=array.get(dirs,i)
        int state=array.get(states,i)
        bool breaker=state==2 or state==3
        color fillColor=breaker?(dir==1?color.new(color.red,88):color.new(color.green,88)):(dir==1?color.new(color.green,88):color.new(color.red,88))
        color borderColor=breaker?(dir==1?color.red:color.green):(dir==1?color.green:color.red)
        box.set_bgcolor(array.get(boxes,i),showZones?fillColor:color.new(color.white,100))
        box.set_border_color(array.get(boxes,i),showZones?borderColor:color.new(color.white,100))

var table t=table.new(position.top_right,2,10)
if barstate.islast
    table.clear(t,0,0,1,9)
    if diagnostic
        table.cell(t,0,0,"P03.0")
        table.cell(t,1,0,"OB / BREAKER")
        table.cell(t,0,1,"Bull break")
        table.cell(t,1,1,bullBreak?"YES":"NO")
        table.cell(t,0,2,"Bear break")
        table.cell(t,1,2,bearBreak?"YES":"NO")
        table.cell(t,0,3,"Active OB")
        table.cell(t,1,3,str.tostring(activeCount))
        table.cell(t,0,4,"Mitigated")
        table.cell(t,1,4,str.tostring(mitigatedCount))
        table.cell(t,0,5,"Active breakers")
        table.cell(t,1,5,str.tostring(breakerCount))
        table.cell(t,0,6,"Invalidated")
        table.cell(t,1,6,str.tostring(invalidCount))
        table.cell(t,0,7,"Displacement")
        table.cell(t,1,7,str.tostring(disp,"#.##"))
        table.cell(t,0,8,"Search back")
        table.cell(t,1,8,str.tostring(searchBack))
        table.cell(t,0,9,"Max zones")
        table.cell(t,1,9,str.tostring(maxZones))

alertcondition(bullOBEvent,"ARTHA Bullish Order Block","Confirmed bullish structural break created a bullish order block")
alertcondition(bearOBEvent,"ARTHA Bearish Order Block","Confirmed bearish structural break created a bearish order block")
alertcondition(bullBreakerEvent,"ARTHA Bullish Breaker","Bearish-origin order block converted to bullish breaker")
alertcondition(bearBreakerEvent,"ARTHA Bearish Breaker","Bullish-origin order block converted to bearish breaker")
alertcondition(invalidBullEvent,"ARTHA Bullish Breaker Invalidated","Bullish breaker invalidated by confirmed close")
alertcondition(invalidBearEvent,"ARTHA Bearish Breaker Invalidated","Bearish breaker invalidated by confirmed close")
