//@version=6
indicator("ARTHA P05.1 — Structure-Anchored Premium / Discount Zone", overlay=true, max_boxes_count=10, max_lines_count=30, max_labels_count=30)

//=============================================================================
// ARTHA P05.1 — STRUCTURE-ANCHORED PREMIUM / DISCOUNT ZONE
//
// PURPOSE
// Rebuild P05 around the earlier ARTHA structure/pivot semantics.
//
// STRUCTURAL CONTRACT
// 1. External pivots are confirmed with right-side bars.
// 2. Structural break targets remain frozen until consumed.
// 3. Wick-only breaks do not count; BOS/MSS requires confirmed close.
// 4. A bullish structural break establishes a protected LOW.
// 5. A bearish structural break establishes a protected HIGH.
// 6. P05 waits for the next confirmed external destination swing after the
//    structural break before a new dealing-range zone becomes valid.
// 7. Only ONE P/D zone exists visually. When the next structural zone becomes
//    valid, the prior box, fibs and labels are deleted immediately.
// 8. P/D is context only. No entry signal is generated here.
//=============================================================================

//-----------------------------------------------------------------------------
// INPUTS
//-----------------------------------------------------------------------------
string GS = "01 Structure"
int externalStrength = input.int(5, "External pivot strength", minval=2, maxval=20, group=GS)
bool showStructureAudit = input.bool(false, "Show structure diagnostic panel", group=GS)

string GZ = "02 Zone"
bool showZone = input.bool(true, "Show shaded zone", group=GZ)
int zoneTransparency = input.int(88, "Zone transparency", minval=0, maxval=100, group=GZ)
color zoneColor = input.color(color.gray, "Zone color", group=GZ)
bool showPDLabels = input.bool(true, "Show Premium / EQ / Discount text", group=GZ)
color textColor = input.color(color.white, "Text color", group=GZ)

string GF = "03 Fib Levels"
bool showFibLevels = input.bool(true, "Show fib levels", group=GF)
bool showFibLabels = input.bool(true, "Show fib labels", group=GF)
string fibMapping = input.string("Directional", "Fib mapping", options=["Directional", "Price scale"], group=GF)
color fibColor = input.color(color.gray, "Fib color", group=GF)

float fib1 = input.float(0.000, "Fib 1", step=0.001, group=GF)
float fib2 = input.float(0.250, "Fib 2", step=0.001, group=GF)
float fib3 = input.float(0.500, "Fib 3", step=0.001, group=GF)
float fib4 = input.float(0.750, "Fib 4", step=0.001, group=GF)
float fib5 = input.float(1.000, "Fib 5", step=0.001, group=GF)

//-----------------------------------------------------------------------------
// CONFIRMED EXTERNAL PIVOTS
//
// A pivot at bar N is not usable until N + externalStrength is confirmed.
//-----------------------------------------------------------------------------
float externalPivotHigh = ta.pivothigh(high, externalStrength, externalStrength)
float externalPivotLow = ta.pivotlow(low, externalStrength, externalStrength)

bool newExternalHigh = barstate.isconfirmed and not na(externalPivotHigh)
bool newExternalLow = barstate.isconfirmed and not na(externalPivotLow)

int confirmedPivotBar = bar_index - externalStrength

//-----------------------------------------------------------------------------
// EXTERNAL SWING MEMORY + CLASSIFICATION
//-----------------------------------------------------------------------------
var float externalHigh = na
var float externalLow = na
var int externalHighBar = na
var int externalLowBar = na

var string externalHighClass = "NONE"
var string externalLowClass = "NONE"

// Persistent break targets.
// These do NOT move merely because another same-side pivot confirms.
var float targetHigh = na
var int targetHighBar = na
var bool targetHighActive = false

var float targetLow = na
var int targetLowBar = na
var bool targetLowActive = false

// Protected structure.
var float protectedHigh = na
var int protectedHighBar = na
var float protectedLow = na
var int protectedLowBar = na

// -1 bearish, 0 neutral, 1 bullish.
var int externalBias = 0
var string lastStructureEvent = "NONE"

//-----------------------------------------------------------------------------
// PENDING STRUCTURAL DEALING LEG
//
// BOS/MSS establishes the origin anchor.
// The destination is not finalized until a NEW external swing in the break
// direction forms AFTER the break and is itself confirmed.
//-----------------------------------------------------------------------------
var bool pendingBullLeg = false
var bool pendingBearLeg = false

var float pendingLow = na
var int pendingLowBar = na
var int pendingBullBreakBar = na
var string pendingBullEvent = "NONE"

var float pendingHigh = na
var int pendingHighBar = na
var int pendingBearBreakBar = na
var string pendingBearEvent = "NONE"

//-----------------------------------------------------------------------------
// ACTIVE P05 ZONE STATE
//-----------------------------------------------------------------------------
var float zoneHigh = na
var float zoneLow = na
var int zoneHighBar = na
var int zoneLowBar = na
var int zoneDirection = 0
var int zoneCreatedBar = na
var int zoneVersion = 0
var string zoneSourceEvent = "NONE"

//-----------------------------------------------------------------------------
// ACTIVE DRAWING OBJECTS — ONLY ONE ZONE EXISTS
//-----------------------------------------------------------------------------
var box zoneBox = na

var line fibLine1 = na
var line fibLine2 = na
var line fibLine3 = na
var line fibLine4 = na
var line fibLine5 = na

var label fibLabel1 = na
var label fibLabel2 = na
var label fibLabel3 = na
var label fibLabel4 = na
var label fibLabel5 = na

var label premiumLabel = na
var label eqLabel = na
var label discountLabel = na

//-----------------------------------------------------------------------------
// HELPERS
//-----------------------------------------------------------------------------
f_deleteLine(line _line) =>
    if not na(_line)
        line.delete(_line)

f_deleteLabel(label _label) =>
    if not na(_label)
        label.delete(_label)

f_fibText(float _level) =>
    str.tostring(_level, "#.###")

f_fibPrice(float _level) =>
    float span = zoneHigh - zoneLow
    fibMapping == "Directional" ?
         (zoneDirection == 1 ? zoneLow + span * _level : zoneHigh - span * _level) :
         zoneLow + span * _level

f_biasText(int _bias) =>
    _bias == 1 ? "BULLISH" : _bias == -1 ? "BEARISH" : "NEUTRAL"

//-----------------------------------------------------------------------------
// 1. PROCESS NEW CONFIRMED EXTERNAL PIVOTS
//
// The latest external swing memory may update, but an already-active break
// target remains frozen. This is the persistent-target behavior needed by P05.
//-----------------------------------------------------------------------------
bool destinationBullHigh = false
bool destinationBearLow = false

float destinationHigh = na
int destinationHighBar = na
float destinationLow = na
int destinationLowBar = na

if newExternalHigh
    int thisHighBar = confirmedPivotBar
    float thisHigh = externalPivotHigh

    string thisHighClass = "HIGH"
    if not na(externalHigh)
        thisHighClass := thisHigh > externalHigh ? "HH" : "LH"

    externalHigh := thisHigh
    externalHighBar := thisHighBar
    externalHighClass := thisHighClass

    // Establish a bullish structural target only when none is currently active.
    // Later same-side pivots cannot silently move this target.
    if not targetHighActive
        targetHigh := thisHigh
        targetHighBar := thisHighBar
        targetHighActive := true

    // A pending bullish structural leg is finalized only by a high whose
    // pivot is structurally after the protected origin and becomes confirmed after the bullish BOS/MSS.
    if pendingBullLeg and not na(pendingBullBreakBar) and bar_index > pendingBullBreakBar and not na(pendingLowBar) and thisHighBar > pendingLowBar
        destinationBullHigh := true
        destinationHigh := thisHigh
        destinationHighBar := thisHighBar

if newExternalLow
    int thisLowBar = confirmedPivotBar
    float thisLow = externalPivotLow

    string thisLowClass = "LOW"
    if not na(externalLow)
        thisLowClass := thisLow > externalLow ? "HL" : "LL"

    externalLow := thisLow
    externalLowBar := thisLowBar
    externalLowClass := thisLowClass

    // Establish a bearish structural target only when none is currently active.
    if not targetLowActive
        targetLow := thisLow
        targetLowBar := thisLowBar
        targetLowActive := true

    // A pending bearish structural leg is finalized only by a low whose
    // pivot is structurally after the protected origin and becomes confirmed after the bearish BOS/MSS.
    if pendingBearLeg and not na(pendingBearBreakBar) and bar_index > pendingBearBreakBar and not na(pendingHighBar) and thisLowBar > pendingHighBar
        destinationBearLow := true
        destinationLow := thisLow
        destinationLowBar := thisLowBar

//-----------------------------------------------------------------------------
// 2. FINALIZE A PENDING STRUCTURAL DEALING RANGE
//
// This happens BEFORE processing a possible new break on the same confirmation
// bar. Therefore the completed prior leg can be rendered, while a same-bar BOS
// may immediately begin the next pending leg.
//-----------------------------------------------------------------------------
bool newZone = false
bool newBullZone = false
bool newBearZone = false

float newZoneHigh = na
float newZoneLow = na
int newZoneHighBar = na
int newZoneLowBar = na
int newZoneDirection = 0
string newZoneSource = "NONE"

if destinationBullHigh and not na(pendingLow) and destinationHigh > pendingLow
    newZone := true
    newBullZone := true
    newZoneHigh := destinationHigh
    newZoneLow := pendingLow
    newZoneHighBar := destinationHighBar
    newZoneLowBar := pendingLowBar
    newZoneDirection := 1
    newZoneSource := pendingBullEvent

    pendingBullLeg := false
    pendingLow := na
    pendingLowBar := na
    pendingBullBreakBar := na
    pendingBullEvent := "NONE"

if destinationBearLow and not na(pendingHigh) and pendingHigh > destinationLow
    // If both somehow qualify on the same bar, the later branch wins.
    newZone := true
    newBullZone := false
    newBearZone := true
    newZoneHigh := pendingHigh
    newZoneLow := destinationLow
    newZoneHighBar := pendingHighBar
    newZoneLowBar := destinationLowBar
    newZoneDirection := -1
    newZoneSource := pendingBearEvent

    pendingBearLeg := false
    pendingHigh := na
    pendingHighBar := na
    pendingBearBreakBar := na
    pendingBearEvent := "NONE"

//-----------------------------------------------------------------------------
// 3. CONFIRMED STRUCTURE BREAKS
//
// Wick-only violations are ignored.
// Break references are persistent until consumed.
//-----------------------------------------------------------------------------
bool externalBullBreak =
     barstate.isconfirmed and
     targetHighActive and
     not na(targetHigh) and
     close > targetHigh

bool externalBearBreak =
     barstate.isconfirmed and
     targetLowActive and
     not na(targetLow) and
     close < targetLow

if externalBullBreak and not externalBearBreak
    int previousBias = externalBias
    externalBias := 1

    string event = previousBias == -1 ? "EXTERNAL_MSS_BULLISH" : "EXTERNAL_BOS_BULLISH"
    lastStructureEvent := event

    // Use the latest CONFIRMED external low as the protected origin.
    if not na(externalLow) and not na(externalLowBar)
        protectedLow := externalLow
        protectedLowBar := externalLowBar

        pendingBullLeg := true
        pendingLow := protectedLow
        pendingLowBar := protectedLowBar
        pendingBullBreakBar := bar_index
        pendingBullEvent := event

    // Opposite pending leg is cancelled by the confirmed directional break.
    pendingBearLeg := false
    pendingHigh := na
    pendingHighBar := na
    pendingBearBreakBar := na
    pendingBearEvent := "NONE"

    // Consume the broken high. A later confirmed pivot high can establish
    // the next bullish continuation target.
    targetHighActive := false
    targetHigh := na
    targetHighBar := na

    // In bullish structure, the protected low is the persistent bearish
    // structural break target.
    if not na(protectedLow)
        targetLow := protectedLow
        targetLowBar := protectedLowBar
        targetLowActive := true

if externalBearBreak and not externalBullBreak
    int previousBias = externalBias
    externalBias := -1

    string event = previousBias == 1 ? "EXTERNAL_MSS_BEARISH" : "EXTERNAL_BOS_BEARISH"
    lastStructureEvent := event

    // Use the latest CONFIRMED external high as the protected origin.
    if not na(externalHigh) and not na(externalHighBar)
        protectedHigh := externalHigh
        protectedHighBar := externalHighBar

        pendingBearLeg := true
        pendingHigh := protectedHigh
        pendingHighBar := protectedHighBar
        pendingBearBreakBar := bar_index
        pendingBearEvent := event

    // Opposite pending leg is cancelled by the confirmed directional break.
    pendingBullLeg := false
    pendingLow := na
    pendingLowBar := na
    pendingBullBreakBar := na
    pendingBullEvent := "NONE"

    // Consume the broken low. A later confirmed pivot low can establish
    // the next bearish continuation target.
    targetLowActive := false
    targetLow := na
    targetLowBar := na

    // In bearish structure, the protected high is the persistent bullish
    // structural break target.
    if not na(protectedHigh)
        targetHigh := protectedHigh
        targetHighBar := protectedHighBar
        targetHighActive := true

//-----------------------------------------------------------------------------
// 4. REPLACE THE SINGLE VISIBLE P05 ZONE
//
// The old zone is deleted ONLY when a new structure-qualified zone is ready.
// There is intentionally no historical zone accumulation.
//-----------------------------------------------------------------------------
if newZone
    if not na(zoneBox)
        box.delete(zoneBox)

    f_deleteLine(fibLine1)
    f_deleteLine(fibLine2)
    f_deleteLine(fibLine3)
    f_deleteLine(fibLine4)
    f_deleteLine(fibLine5)

    f_deleteLabel(fibLabel1)
    f_deleteLabel(fibLabel2)
    f_deleteLabel(fibLabel3)
    f_deleteLabel(fibLabel4)
    f_deleteLabel(fibLabel5)

    f_deleteLabel(premiumLabel)
    f_deleteLabel(eqLabel)
    f_deleteLabel(discountLabel)

    zoneHigh := newZoneHigh
    zoneLow := newZoneLow
    zoneHighBar := newZoneHighBar
    zoneLowBar := newZoneLowBar
    zoneDirection := newZoneDirection
    zoneCreatedBar := bar_index
    zoneVersion += 1
    zoneSourceEvent := newZoneSource

    int leftBar = math.min(zoneHighBar, zoneLowBar)

    zoneBox := box.new(
         left=leftBar,
         top=zoneHigh,
         right=bar_index,
         bottom=zoneLow,
         border_color=zoneColor,
         bgcolor=color.new(zoneColor, zoneTransparency)
     )

    float p1 = f_fibPrice(fib1)
    float p2 = f_fibPrice(fib2)
    float p3 = f_fibPrice(fib3)
    float p4 = f_fibPrice(fib4)
    float p5 = f_fibPrice(fib5)

    fibLine1 := line.new(leftBar, p1, bar_index, p1, extend=extend.none, color=fibColor)
    fibLine2 := line.new(leftBar, p2, bar_index, p2, extend=extend.none, color=fibColor)
    fibLine3 := line.new(leftBar, p3, bar_index, p3, extend=extend.none, color=fibColor, style=line.style_dashed)
    fibLine4 := line.new(leftBar, p4, bar_index, p4, extend=extend.none, color=fibColor)
    fibLine5 := line.new(leftBar, p5, bar_index, p5, extend=extend.none, color=fibColor)

    fibLabel1 := label.new(bar_index, p1, f_fibText(fib1), style=label.style_none, textcolor=textColor, size=size.tiny)
    fibLabel2 := label.new(bar_index, p2, f_fibText(fib2), style=label.style_none, textcolor=textColor, size=size.tiny)
    fibLabel3 := label.new(bar_index, p3, f_fibText(fib3), style=label.style_none, textcolor=textColor, size=size.tiny)
    fibLabel4 := label.new(bar_index, p4, f_fibText(fib4), style=label.style_none, textcolor=textColor, size=size.tiny)
    fibLabel5 := label.new(bar_index, p5, f_fibText(fib5), style=label.style_none, textcolor=textColor, size=size.tiny)

    float span = zoneHigh - zoneLow
    float premiumY = zoneLow + span * 0.78
    float eqY = zoneLow + span * 0.50
    float discountY = zoneLow + span * 0.22

    premiumLabel := label.new(bar_index, premiumY, "PREMIUM", style=label.style_none, textcolor=textColor, size=size.small)
    eqLabel := label.new(bar_index, eqY, "EQ", style=label.style_none, textcolor=textColor, size=size.small)
    discountLabel := label.new(bar_index, discountY, "DISCOUNT", style=label.style_none, textcolor=textColor, size=size.small)

//-----------------------------------------------------------------------------
// 5. CURRENT-ZONE RENDERING
//
// No line or box uses extend.right.
// The active zone simply follows the current bar until a replacement zone is
// confirmed, at which point the entire old object set is deleted.
//-----------------------------------------------------------------------------
bool zoneAvailable = not na(zoneHigh) and not na(zoneLow) and zoneHigh > zoneLow

if zoneAvailable
    int leftBar = math.min(zoneHighBar, zoneLowBar)

    if not na(zoneBox)
        box.set_left(zoneBox, leftBar)
        box.set_right(zoneBox, bar_index)
        box.set_top(zoneBox, zoneHigh)
        box.set_bottom(zoneBox, zoneLow)
        box.set_border_color(zoneBox, showZone ? zoneColor : color.new(zoneColor, 100))
        box.set_bgcolor(zoneBox, showZone ? color.new(zoneColor, zoneTransparency) : color.new(zoneColor, 100))

    float p1 = f_fibPrice(fib1)
    float p2 = f_fibPrice(fib2)
    float p3 = f_fibPrice(fib3)
    float p4 = f_fibPrice(fib4)
    float p5 = f_fibPrice(fib5)

    color visibleFibColor = showFibLevels ? fibColor : color.new(fibColor, 100)

    if not na(fibLine1)
        line.set_xy1(fibLine1, leftBar, p1)
        line.set_xy2(fibLine1, bar_index, p1)
        line.set_color(fibLine1, visibleFibColor)

    if not na(fibLine2)
        line.set_xy1(fibLine2, leftBar, p2)
        line.set_xy2(fibLine2, bar_index, p2)
        line.set_color(fibLine2, visibleFibColor)

    if not na(fibLine3)
        line.set_xy1(fibLine3, leftBar, p3)
        line.set_xy2(fibLine3, bar_index, p3)
        line.set_color(fibLine3, visibleFibColor)
        line.set_style(fibLine3, line.style_dashed)

    if not na(fibLine4)
        line.set_xy1(fibLine4, leftBar, p4)
        line.set_xy2(fibLine4, bar_index, p4)
        line.set_color(fibLine4, visibleFibColor)

    if not na(fibLine5)
        line.set_xy1(fibLine5, leftBar, p5)
        line.set_xy2(fibLine5, bar_index, p5)
        line.set_color(fibLine5, visibleFibColor)

    if not na(fibLabel1)
        label.set_xy(fibLabel1, bar_index, p1)
        label.set_text(fibLabel1, showFibLabels ? f_fibText(fib1) : "")
        label.set_textcolor(fibLabel1, textColor)

    if not na(fibLabel2)
        label.set_xy(fibLabel2, bar_index, p2)
        label.set_text(fibLabel2, showFibLabels ? f_fibText(fib2) : "")
        label.set_textcolor(fibLabel2, textColor)

    if not na(fibLabel3)
        label.set_xy(fibLabel3, bar_index, p3)
        label.set_text(fibLabel3, showFibLabels ? f_fibText(fib3) : "")
        label.set_textcolor(fibLabel3, textColor)

    if not na(fibLabel4)
        label.set_xy(fibLabel4, bar_index, p4)
        label.set_text(fibLabel4, showFibLabels ? f_fibText(fib4) : "")
        label.set_textcolor(fibLabel4, textColor)

    if not na(fibLabel5)
        label.set_xy(fibLabel5, bar_index, p5)
        label.set_text(fibLabel5, showFibLabels ? f_fibText(fib5) : "")
        label.set_textcolor(fibLabel5, textColor)

    float span = zoneHigh - zoneLow
    float premiumY = zoneLow + span * 0.78
    float eqY = zoneLow + span * 0.50
    float discountY = zoneLow + span * 0.22

    if not na(premiumLabel)
        label.set_xy(premiumLabel, bar_index, premiumY)
        label.set_text(premiumLabel, showPDLabels ? "PREMIUM" : "")
        label.set_textcolor(premiumLabel, textColor)

    if not na(eqLabel)
        label.set_xy(eqLabel, bar_index, eqY)
        label.set_text(eqLabel, showPDLabels ? "EQ" : "")
        label.set_textcolor(eqLabel, textColor)

    if not na(discountLabel)
        label.set_xy(discountLabel, bar_index, discountY)
        label.set_text(discountLabel, showPDLabels ? "DISCOUNT" : "")
        label.set_textcolor(discountLabel, textColor)

//-----------------------------------------------------------------------------
// 6. STRUCTURE DIAGNOSTIC PANEL
//-----------------------------------------------------------------------------
string pendingText =
     pendingBullLeg ? "WAIT BULL DESTINATION HIGH" :
     pendingBearLeg ? "WAIT BEAR DESTINATION LOW" :
     "NONE"

var table t = table.new(position.top_right, 2, 14)

if barstate.islast
    table.clear(t, 0, 0, 1, 13)

    if showStructureAudit
        table.cell(t, 0, 0, "P05.1")
        table.cell(t, 1, 0, "STRUCTURE-ANCHORED PD")
        table.cell(t, 0, 1, "External bias")
        table.cell(t, 1, 1, f_biasText(externalBias))
        table.cell(t, 0, 2, "Last event")
        table.cell(t, 1, 2, lastStructureEvent)
        table.cell(t, 0, 3, "Ext High")
        table.cell(t, 1, 3, na(externalHigh) ? "-" : str.tostring(externalHigh) + " " + externalHighClass)
        table.cell(t, 0, 4, "Ext Low")
        table.cell(t, 1, 4, na(externalLow) ? "-" : str.tostring(externalLow) + " " + externalLowClass)
        table.cell(t, 0, 5, "Target High")
        table.cell(t, 1, 5, targetHighActive ? str.tostring(targetHigh) : "-")
        table.cell(t, 0, 6, "Target Low")
        table.cell(t, 1, 6, targetLowActive ? str.tostring(targetLow) : "-")
        table.cell(t, 0, 7, "Protected High")
        table.cell(t, 1, 7, na(protectedHigh) ? "-" : str.tostring(protectedHigh))
        table.cell(t, 0, 8, "Protected Low")
        table.cell(t, 1, 8, na(protectedLow) ? "-" : str.tostring(protectedLow))
        table.cell(t, 0, 9, "Pending")
        table.cell(t, 1, 9, pendingText)
        table.cell(t, 0, 10, "Zone")
        table.cell(t, 1, 10, zoneAvailable ? "ACTIVE" : "UNAVAILABLE")
        table.cell(t, 0, 11, "Zone source")
        table.cell(t, 1, 11, zoneSourceEvent)
        table.cell(t, 0, 12, "Zone version")
        table.cell(t, 1, 12, str.tostring(zoneVersion))
        table.cell(t, 0, 13, "Fib mapping")
        table.cell(t, 1, 13, fibMapping)

// Context alerts only — not trade signals.
alertcondition(newZone and newBullZone, "ARTHA Bullish Structural PD Zone", "New bullish structure-qualified Premium/Discount zone")
alertcondition(newZone and newBearZone, "ARTHA Bearish Structural PD Zone", "New bearish structure-qualified Premium/Discount zone")
