//@version=6
indicator("ARTHA P01.3 — Previous Period Reference Engine", overlay=true, max_lines_count=100, max_labels_count=100)

string G = "Display"
bool showDay = input.bool(true, "Previous Day", group=G)
bool showWeek = input.bool(true, "Previous Week", group=G)
bool showMonth = input.bool(true, "Previous Month", group=G)
bool showLabels = input.bool(true, "Level Text", group=G)
bool showSweeps = input.bool(true, "Sweep Text", group=G)

newDay = ta.change(time("D")) != 0
newWeek = ta.change(time("W")) != 0
newMonth = ta.change(time("M")) != 0

// IMPORTANT: [1] references the already completed HTF candle. lookahead_on is
// safe here because the expression itself is one HTF bar behind. It prevents
// lookahead_off from delaying the prior-period value until the current HTF
// candle closes, which was the source of the apparent D/W/M lag.
pDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pDayLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
pWeekHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
pWeekLow = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_on)
pMonthHigh = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
pMonthLow = request.security(syminfo.tickerid, "M", low[1], lookahead=barmerge.lookahead_on)

var float dayH = na
var float dayL = na
var float weekH = na
var float weekL = na
var float monthH = na
var float monthL = na

if barstate.isfirst
    dayH := pDayHigh
    dayL := pDayLow
    weekH := pWeekHigh
    weekL := pWeekLow
    monthH := pMonthHigh
    monthL := pMonthLow

if newDay
    dayH := pDayHigh
    dayL := pDayLow
if newWeek
    weekH := pWeekHigh
    weekL := pWeekLow
if newMonth
    monthH := pMonthHigh
    monthL := pMonthLow

var line dHLine = na
var line dLLine = na
var line wHLine = na
var line wLLine = na
var line mHLine = na
var line mLLine = na
var label dHLabel = na
var label dLLabel = na
var label wHLabel = na
var label wLLabel = na
var label mHLabel = na
var label mLLabel = na

if newDay
    line.delete(dHLine)
    line.delete(dLLine)
    label.delete(dHLabel)
    label.delete(dLLabel)
    dHLine := na
    dLLine := na
    dHLabel := na
    dLLabel := na
if newWeek
    line.delete(wHLine)
    line.delete(wLLine)
    label.delete(wHLabel)
    label.delete(wLLabel)
    wHLine := na
    wLLine := na
    wHLabel := na
    wLLabel := na
if newMonth
    line.delete(mHLine)
    line.delete(mLLine)
    label.delete(mHLabel)
    label.delete(mLLabel)
    mHLine := na
    mLLine := na
    mHLabel := na
    mLLabel := na

if (newDay or barstate.isfirst) and showDay and not na(dayH) and not na(dayL)
    dHLine := line.new(bar_index, dayH, bar_index, dayH, extend=extend.none)
    dLLine := line.new(bar_index, dayL, bar_index, dayL, extend=extend.none)
    if showLabels
        dHLabel := label.new(bar_index, dayH, "PDH", style=label.style_none)
        dLLabel := label.new(bar_index, dayL, "PDL", style=label.style_none)
if (newWeek or barstate.isfirst) and showWeek and not na(weekH) and not na(weekL)
    wHLine := line.new(bar_index, weekH, bar_index, weekH, extend=extend.none)
    wLLine := line.new(bar_index, weekL, bar_index, weekL, extend=extend.none)
    if showLabels
        wHLabel := label.new(bar_index, weekH, "PWH", style=label.style_none)
        wLLabel := label.new(bar_index, weekL, "PWL", style=label.style_none)
if (newMonth or barstate.isfirst) and showMonth and not na(monthH) and not na(monthL)
    mHLine := line.new(bar_index, monthH, bar_index, monthH, extend=extend.none)
    mLLine := line.new(bar_index, monthL, bar_index, monthL, extend=extend.none)
    if showLabels
        mHLabel := label.new(bar_index, monthH, "PMH", style=label.style_none)
        mLLabel := label.new(bar_index, monthL, "PML", style=label.style_none)

if not na(dHLine)
    line.set_x2(dHLine, bar_index)
    line.set_x2(dLLine, bar_index)
if not na(wHLine)
    line.set_x2(wHLine, bar_index)
    line.set_x2(wLLine, bar_index)
if not na(mHLine)
    line.set_x2(mHLine, bar_index)
    line.set_x2(mLLine, bar_index)

// A consumed level cannot generate another sweep during the same period.
var bool dayHConsumed = false
var bool dayLConsumed = false
var bool weekHConsumed = false
var bool weekLConsumed = false
var bool monthHConsumed = false
var bool monthLConsumed = false

if newDay
    dayHConsumed := false
    dayLConsumed := false
if newWeek
    weekHConsumed := false
    weekLConsumed := false
if newMonth
    monthHConsumed := false
    monthLConsumed := false

dHSweep = barstate.isconfirmed and not dayHConsumed and not na(dayH) and high > dayH and close < dayH
dLSweep = barstate.isconfirmed and not dayLConsumed and not na(dayL) and low < dayL and close > dayL
wHSweep = barstate.isconfirmed and not weekHConsumed and not na(weekH) and high > weekH and close < weekH
wLSweep = barstate.isconfirmed and not weekLConsumed and not na(weekL) and low < weekL and close > weekL
mHSweep = barstate.isconfirmed and not monthHConsumed and not na(monthH) and high > monthH and close < monthH
mLSweep = barstate.isconfirmed and not monthLConsumed and not na(monthL) and low < monthL and close > monthL

if dHSweep
    dayHConsumed := true
    line.delete(dHLine)
    label.delete(dHLabel)
    dHLine := na
    dHLabel := na
if dLSweep
    dayLConsumed := true
    line.delete(dLLine)
    label.delete(dLLabel)
    dLLine := na
    dLLabel := na
if wHSweep
    weekHConsumed := true
    line.delete(wHLine)
    label.delete(wHLabel)
    wHLine := na
    wHLabel := na
if wLSweep
    weekLConsumed := true
    line.delete(wLLine)
    label.delete(wLLabel)
    wLLine := na
    wLLabel := na
if mHSweep
    monthHConsumed := true
    line.delete(mHLine)
    label.delete(mHLabel)
    mHLine := na
    mHLabel := na
if mLSweep
    monthLConsumed := true
    line.delete(mLLine)
    label.delete(mLLabel)
    mLLine := na
    mLLabel := na

plotshape(showSweeps and dHSweep, title="PDH Sweep", style=shape.labeldown, location=location.abovebar, text="PDH sweep", size=size.tiny)
plotshape(showSweeps and dLSweep, title="PDL Sweep", style=shape.labelup, location=location.belowbar, text="PDL sweep", size=size.tiny)
plotshape(showSweeps and wHSweep, title="PWH Sweep", style=shape.labeldown, location=location.abovebar, text="PWH sweep", size=size.tiny)
plotshape(showSweeps and wLSweep, title="PWL Sweep", style=shape.labelup, location=location.belowbar, text="PWL sweep", size=size.tiny)
plotshape(showSweeps and mHSweep, title="PMH Sweep", style=shape.labeldown, location=location.abovebar, text="PMH sweep", size=size.tiny)
plotshape(showSweeps and mLSweep, title="PML Sweep", style=shape.labelup, location=location.belowbar, text="PML sweep", size=size.tiny)

alertcondition(dHSweep, "PDH Sweep", "Previous Day High swept")
alertcondition(dLSweep, "PDL Sweep", "Previous Day Low swept")
alertcondition(wHSweep, "PWH Sweep", "Previous Week High swept")
alertcondition(wLSweep, "PWL Sweep", "Previous Week Low swept")
alertcondition(mHSweep, "PMH Sweep", "Previous Month High swept")
alertcondition(mLSweep, "PML Sweep", "Previous Month Low swept")
