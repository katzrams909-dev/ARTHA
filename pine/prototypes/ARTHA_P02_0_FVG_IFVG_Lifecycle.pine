//@version=6
indicator("ARTHA P02.0 — FVG / IFVG Lifecycle", overlay=true, max_boxes_count=200, max_labels_count=300)

// P02.0 is a standalone validation prototype. It detects confirmed
// three-candle FVGs, tracks their lifecycle, and promotes a filled FVG to an
// IFVG candidate only after a confirmed polarity-crossing close.
// No developing/current HTF data or future bars are used.

string GF="01 FVG"
float minGapATR=input.float(0.10,"Minimum gap / ATR",minval=0,step=0.05,group=GF)
float mitigationPct=input.float(100,"Fill threshold %",minval=1,maxval=100,step=1,group=GF)
int maxZones=input.int(30,"Maximum active zones",minval=5,maxval=80,group=GF)
bool requireDisplacement=input.bool(true,"Require displacement",group=GF)
float dispATR=input.float(0.75,"Displacement body / ATR",minval=0,step=0.05,group=GF)

string GV="02 Validation"
bool showZones=input.bool(true,"Show FVG/IFVG zones",group=GV)
bool showText=input.bool(true,"Show text",group=GV)
bool showFilled=input.bool(false,"Show filled/invalidated text",group=GV)
bool diagnostic=input.bool(false,"Diagnostic panel",group=GV)

atr=ta.atr(14)
body=math.abs(close-open)
disp=atr>0?body/atr:0.0

// A bullish FVG exists when the current confirmed low remains above the high
// two bars back. Bearish is the mirror condition.
bullGap=low-high[2]
bearGap=low[2]-high
bullFVG=barstate.isconfirmed and not na(high[2]) and bullGap>0 and bullGap>=atr*minGapATR and (not requireDisplacement or disp>=dispATR)
bearFVG=barstate.isconfirmed and not na(low[2]) and bearGap>0 and bearGap>=atr*minGapATR and (not requireDisplacement or disp>=dispATR)

// zone arrays: direction 1 bull / -1 bear; state 0 active FVG, 1 IFVG, 2 filled
// FVG awaiting flip; 3 invalidated IFVG.
var float[] tops=array.new_float()
var float[] bots=array.new_float()
var int[] dirs=array.new_int()
var int[] states=array.new_int()
var int[] born=array.new_int()
var box[] boxes=array.new_box()
var label[] labels=array.new_label()

f_add(_top,_bot,_dir) =>
    if array.size(tops)>=maxZones
        box oldBox=array.shift(boxes)
        box.delete(oldBox)
        label oldLabel=array.shift(labels)
        label.delete(oldLabel)
        array.shift(tops),array.shift(bots),array.shift(dirs),array.shift(states),array.shift(born)
    array.push(tops,_top)
    array.push(bots,_bot)
    array.push(dirs,_dir)
    array.push(states,0)
    array.push(born,bar_index)
    box b=box.new(bar_index,_top,bar_index,_bot)
    array.push(boxes,b)
    label l=label.new(bar_index,_top,_dir==1?"FVG ↑":"FVG ↓",style=label.style_none)
    array.push(labels,l)

if bullFVG
    f_add(low,high[2],1)
if bearFVG
    f_add(low[2],high,-1)

// Lifecycle is evaluated only on confirmed bars. For a bullish FVG, price
// entering the lower boundary is mitigation. A full fill occurs when price
// reaches the opposite boundary. The first confirmed close through the
// opposite side after a full fill creates an IFVG polarity flip.
int activeCount=0
int ifvgCount=0
int filledCount=0
int invalidCount=0

if array.size(tops)>0
    for i=array.size(tops)-1 to 0
        float top=array.get(tops,i)
        float bot=array.get(bots,i)
        int dir=array.get(dirs,i)
        int state=array.get(states,i)
        int bornBar=array.get(born,i)
        box b=array.get(boxes,i)
        label l=array.get(labels,i)
        box.set_right(b,bar_index)
        if state==0
            bool touched=dir==1?low<=top:high>=bot
            bool fullyFilled=dir==1?low<=bot:high>=top
            if fullyFilled
                array.set(states,i,1)
                label.set_text(l,dir==1?"IFVG ↓":"IFVG ↑")
                label.set_x(l,bar_index)
            else
                if touched
                    label.set_text(l,dir==1?"FVG ↑ · MIT":"FVG ↓ · MIT")
        else if state==1
            bool flipped=dir==1?close<bot:close>top
            if flipped
                // IFVG has been invalidated by a confirmed close through the
                // original zone in the new polarity.
                array.set(states,i,3)
                label.set_text(l,dir==1?"IFVG ✕":"IFVG ✕")
                label.set_x(l,bar_index)
        if state==0
            activeCount+=1
        else if state==1
            ifvgCount+=1
        else if state==2
            filledCount+=1
        else
            invalidCount+=1

// Newly created FVGs are rendered; historical labels remain bounded by the
// maxZones queue. Filled and invalidated objects remain for auditability but
// can be hidden by the display setting.
if not showZones and array.size(boxes)>0
    for i=0 to array.size(boxes)-1
        box.set_bgcolor(array.get(boxes,i),color.new(color.white,100))
        box.set_border_color(array.get(boxes,i),color.new(color.white,100))

if not showText and array.size(labels)>0
    for i=0 to array.size(labels)-1
        label.set_text(array.get(labels,i),"")

// Diagnostic state.
var table t=table.new(position.top_right,2,8)
if barstate.islast
    table.clear(t,0,0,1,7)
    if diagnostic
        table.cell(t,0,0,"P02.0")
        table.cell(t,1,0,"FVG / IFVG")
        table.cell(t,0,1,"Bull FVG now")
        table.cell(t,1,1,bullFVG?"YES":"NO")
        table.cell(t,0,2,"Bear FVG now")
        table.cell(t,1,2,bearFVG?"YES":"NO")
        table.cell(t,0,3,"Active FVG")
        table.cell(t,1,3,str.tostring(activeCount))
        table.cell(t,0,4,"Active IFVG")
        table.cell(t,1,4,str.tostring(ifvgCount))
        table.cell(t,0,5,"Filled")
        table.cell(t,1,5,str.tostring(filledCount))
        table.cell(t,0,6,"Invalidated")
        table.cell(t,1,6,str.tostring(invalidCount))
        table.cell(t,0,7,"Displacement")
        table.cell(t,1,7,str.tostring(disp,"#.##"))

alertcondition(bullFVG,"ARTHA Bullish FVG","Confirmed bullish FVG created")
alertcondition(bearFVG,"ARTHA Bearish FVG","Confirmed bearish FVG created")
