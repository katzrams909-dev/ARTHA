//@version=6
indicator("ARTHA P04.0 — Session Engine", overlay=true, max_lines_count=300, max_labels_count=200)

// P04.0 standalone validation prototype.
// Tracks Asia, London and New York independently. Session state is calculated
// regardless of display settings. A session high/low is only updated while the
// session is active. At the first confirmed bar outside a session, the prior
// session is considered closed and its levels stop extending.

string GT="01 Session Time"
string tzChoice=input.string("Exchange","Session timezone",options=["Exchange","UTC","America/New_York","Europe/London","Asia/Tokyo"],group=GT)
string tz=tzChoice=="Exchange"?syminfo.timezone:tzChoice
string asia=input.session("0000-0800:1234567","Asia session",group=GT)
string london=input.session("0800-1630:1234567","London session",group=GT)
string newYork=input.session("1330-2000:1234567","New York session",group=GT)

string GL="02 Lifecycle"
bool trackCompleted=input.bool(true,"Keep completed session levels",group=GL)
int maxCompleted=input.int(12,"Maximum completed sessions per region",minval=1,maxval=30,group=GL)

string GV="03 Display"
bool showAsia=input.bool(true,"Show Asia",group=GV)
bool showLondon=input.bool(true,"Show London",group=GV)
bool showNewYork=input.bool(true,"Show New York",group=GV)
bool showLabels=input.bool(true,"Show session labels",group=GV)
bool showLevels=input.bool(true,"Show session high/low",group=GV)
bool diagnostic=input.bool(false,"Diagnostic panel",group=GV)

f_inSession(_session) =>
    not na(time(timeframe.period,_session,tz))

asiaIn=f_inSession(asia)
londonIn=f_inSession(london)
nyIn=f_inSession(newYork)

// Session state arrays are indexed 0=Asia, 1=London, 2=New York.
var bool[] active=array.from(false,false,false)
var float[] hi=array.from(na,na,na)
var float[] lo=array.from(na,na,na)
var int[] startBar=array.from(na,na,na)
var int[] lastBar=array.from(na,na,na)
var int[] highBar=array.from(na,na,na)
var int[] lowBar=array.from(na,na,na)
var line[] hiLines=array.new_line()
var line[] loLines=array.new_line()
var label[] sessionLabels=array.new_label()
var int[] lineRegions=array.new_int()
var int[] lineSessionEnds=array.new_int()

// A separate bounded visual record is used for completed sessions. The engine
// state itself is not removed when display is hidden.
f_addCompleted(_region,_hi,_lo,_hiBar,_loBar,_endBar,_startBar) =>
    if trackCompleted
        line hLine=line.new(_hiBar,_hi,_endBar,_hi,xloc=xloc.bar_index)
        line lLine=line.new(_loBar,_lo,_endBar,_lo,xloc=xloc.bar_index)
        label lab=showLabels?label.new(_startBar,_hi,_region==0?"ASIA":"",style=label.style_none):na
        array.push(hiLines,hLine)
        array.push(loLines,lLine)
        array.push(sessionLabels,lab)
        array.push(lineRegions,_region)
        array.push(lineSessionEnds,_endBar)

// Previous active state is retained so session start/end transitions are exact.
prevAsia=array.get(active,0)
prevLondon=array.get(active,1)
prevNY=array.get(active,2)

f_process(_idx,_in,_name) =>
    bool was=array.get(active,_idx)
    if _in
        if not was
            array.set(active,_idx,true)
            array.set(hi,_idx,high)
            array.set(lo,_idx,low)
            array.set(startBar,_idx,bar_index)
            array.set(lastBar,_idx,bar_index)
            array.set(highBar,_idx,bar_index)
            array.set(lowBar,_idx,bar_index)
        else
            float oldHi=array.get(hi,_idx)
            float oldLo=array.get(lo,_idx)
            if high>oldHi
                array.set(hi,_idx,high)
                array.set(highBar,_idx,bar_index)
            if low<oldLo
                array.set(lo,_idx,low)
                array.set(lowBar,_idx,bar_index)
            array.set(lastBar,_idx,bar_index)
    else if was and barstate.isconfirmed
        float endHi=array.get(hi,_idx)
        float endLo=array.get(lo,_idx)
        int endHiBar=array.get(highBar,_idx)
        int endLoBar=array.get(lowBar,_idx)
        int endBar=array.get(lastBar,_idx)
        int beginBar=array.get(startBar,_idx)
        // Completed levels are emitted only from confirmed session-close data.
        f_addCompleted(_idx,endHi,endLo,endHiBar,endLoBar,endBar,beginBar)
        array.set(active,_idx,false)
        array.set(hi,_idx,na)
        array.set(lo,_idx,na)
        array.set(startBar,_idx,na)
        array.set(lastBar,_idx,na)
        array.set(highBar,_idx,na)
        array.set(lowBar,_idx,na)

f_process(0,asiaIn,"Asia")
f_process(1,londonIn,"London")
f_process(2,nyIn,"New York")

// The completion visual is bounded globally. This prevents three independent
// session queues from silently exceeding Pine drawing limits.
while array.size(hiLines)>maxCompleted*3
    line.delete(array.shift(hiLines))
    line.delete(array.shift(loLines))
    label old=array.shift(sessionLabels)
    if not na(old)
        label.delete(old)
    array.shift(lineRegions)
    array.shift(lineSessionEnds)

// Rendering is purely derived from current state + user visibility.
if array.size(hiLines)>0
    for i=0 to array.size(hiLines)-1
        int region=array.get(lineRegions,i)
        bool visible=showLevels and ((region==0 and showAsia) or (region==1 and showLondon) or (region==2 and showNewYork))
        line hLine=array.get(hiLines,i)
        line lLine=array.get(loLines,i)
        line.set_color(hLine,visible?color.gray:color.new(color.white,100))
        line.set_color(lLine,visible?color.gray:color.new(color.white,100))
        label lab=array.get(sessionLabels,i)
        if not na(lab)
            bool labelVisible=showLabels and ((region==0 and showAsia) or (region==1 and showLondon) or (region==2 and showNewYork))
            label.set_text(lab,labelVisible?(region==0?"ASIA":region==1?"LONDON":"NEW YORK"):"")

// Current-session diagnostics are calculated independently of rendering.
int asiaStatus=asiaIn?1:0
int londonStatus=londonIn?1:0
int nyStatus=nyIn?1:0

var table t=table.new(position.top_right,2,8)
if barstate.islast
    table.clear(t,0,0,1,7)
    if diagnostic
        table.cell(t,0,0,"P04.0")
        table.cell(t,1,0,"SESSION ENGINE")
        table.cell(t,0,1,"Timezone")
        table.cell(t,1,1,tzChoice)
        table.cell(t,0,2,"Asia")
        table.cell(t,1,2,asiaStatus==1?"ACTIVE":"CLOSED")
        table.cell(t,0,3,"London")
        table.cell(t,1,3,londonStatus==1?"ACTIVE":"CLOSED")
        table.cell(t,0,4,"New York")
        table.cell(t,1,4,nyStatus==1?"ACTIVE":"CLOSED")
        table.cell(t,0,5,"Completed records")
        table.cell(t,1,5,str.tostring(array.size(hiLines)))
        table.cell(t,0,6,"Asia H/L")
        table.cell(t,1,6,asiaIn?str.tostring(array.get(hi,0))+" / "+str.tostring(array.get(lo,0)):"-")
        table.cell(t,0,7,"London H/L")
        table.cell(t,1,7,londonIn?str.tostring(array.get(hi,1))+" / "+str.tostring(array.get(lo,1)):"-")

alertcondition(asiaIn and not prevAsia,"ARTHA Asia Open","Asia session opened")
alertcondition(londonIn and not prevLondon,"ARTHA London Open","London session opened")
alertcondition(nyIn and not prevNY,"ARTHA New York Open","New York session opened")
alertcondition(not asiaIn and prevAsia and barstate.isconfirmed,"ARTHA Asia Close","Asia session closed")
alertcondition(not londonIn and prevLondon and barstate.isconfirmed,"ARTHA London Close","London session closed")
alertcondition(not nyIn and prevNY and barstate.isconfirmed,"ARTHA New York Close","New York session closed")
