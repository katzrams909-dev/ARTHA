//@version=6
indicator("ARTHA P01.6 — Structure State Engine", overlay=true, max_labels_count=500)

// P01.6: confirmed swing classification and non-repeating BOS/CHoCH/MSS events.
// Event classification is evaluated from the PREVIOUS structural state, then
// the state is mutated. This ordering is critical for CHoCH/MSS detection.

string G1="01 Structure"
int iLen=input.int(2,"Internal pivot strength",minval=1,group=G1)
int xLen=input.int(5,"External pivot strength",minval=2,group=G1)
float minDispATR=input.float(0.75,"MSS displacement / ATR",minval=0.0,step=0.05,group=G1)
bool closeBreak=input.bool(true,"Require close through structure",group=G1)

string G2="02 Display"
bool showEvents=input.bool(true,"Show structure text",group=G2)
bool showSwings=input.bool(false,"Show swing labels",group=G2)
bool showDiagnostics=input.bool(false,"Diagnostic panel",group=G2)

atr=ta.atr(14)

//================ CONFIRMED PIVOTS ================
iPH=ta.pivothigh(high,iLen,iLen)
iPL=ta.pivotlow(low,iLen,iLen)
xPH=ta.pivothigh(high,xLen,xLen)
xPL=ta.pivotlow(low,xLen,xLen)

//================ SWING STATE ================
var float iLastHigh=na
var float iPrevHigh=na
var float iLastLow=na
var float iPrevLow=na
var int iLastHighBar=na
var int iLastLowBar=na
var string iHighClass="NONE"
var string iLowClass="NONE"
var float xLastHigh=na
var float xPrevHigh=na
var float xLastLow=na
var float xPrevLow=na
var int xLastHighBar=na
var int xLastLowBar=na
var string xHighClass="NONE"
var string xLowClass="NONE"

if not na(iPH)
    iPrevHigh:=iLastHigh
    iLastHigh:=iPH
    iLastHighBar:=bar_index-iLen
    iHighClass:=na(iPrevHigh)?"HH":iLastHigh>iPrevHigh?"HH":"LH"
if not na(iPL)
    iPrevLow:=iLastLow
    iLastLow:=iPL
    iLastLowBar:=bar_index-iLen
    iLowClass:=na(iPrevLow)?"HL":iLastLow>iPrevLow?"HL":"LL"
if not na(xPH)
    xPrevHigh:=xLastHigh
    xLastHigh:=xPH
    xLastHighBar:=bar_index-xLen
    xHighClass:=na(xPrevHigh)?"HH":xLastHigh>xPrevHigh?"HH":"LH"
if not na(xPL)
    xPrevLow:=xLastLow
    xLastLow:=xPL
    xLastLowBar:=bar_index-xLen
    xLowClass:=na(xPrevLow)?"HL":xLastLow>xPrevLow?"HL":"LL"

//================ STRUCTURAL STATE ================
var int iTrend=0
var int xTrend=0
var float iProtectedLow=na
var float iProtectedHigh=na
var float xProtectedLow=na
var float xProtectedHigh=na
var int iBrokenHighBar=na
var int iBrokenLowBar=na
var int xBrokenHighBar=na
var int xBrokenLowBar=na

body=math.abs(close-open)
displacement=atr>0?body/atr:0.0

// Break conditions are calculated before any trend update.
bool iBullBreak=barstate.isconfirmed and not na(iLastHigh) and (closeBreak?close>iLastHigh:high>iLastHigh) and iLastHighBar!=iBrokenHighBar
bool iBearBreak=barstate.isconfirmed and not na(iLastLow) and (closeBreak?close<iLastLow:low<iLastLow) and iLastLowBar!=iBrokenLowBar
bool xBullBreak=barstate.isconfirmed and not na(xLastHigh) and (closeBreak?close>xLastHigh:high>xLastHigh) and xLastHighBar!=xBrokenHighBar
bool xBearBreak=barstate.isconfirmed and not na(xLastLow) and (closeBreak?close<xLastLow:low<xLastLow) and xLastLowBar!=xBrokenLowBar

// CHoCH = confirmed break against the established trend.
// MSS = CHoCH-strength break with ATR-qualified body displacement.
bool iBullAgainst=iTrend<0 and iBullBreak
bool iBearAgainst=iTrend>0 and iBearBreak
bool xBullAgainst=xTrend<0 and xBullBreak
bool xBearAgainst=xTrend>0 and xBearBreak
bool iBullMSS=iBullAgainst and displacement>=minDispATR
bool iBearMSS=iBearAgainst and displacement>=minDispATR
bool xBullMSS=xBullAgainst and displacement>=minDispATR
bool xBearMSS=xBearAgainst and displacement>=minDispATR
bool iBullCH=iBullAgainst and not iBullMSS
bool iBearCH=iBearAgainst and not iBearMSS
bool xBullCH=xBullAgainst and not xBullMSS
bool xBearCH=xBearAgainst and not xBearMSS

// A break in the direction of established trend, or a first neutral break,
// is BOS. A reversal break is already classified as CHoCH/MSS above.
bool iBullBOS=iBullBreak and not iBullAgainst
bool iBearBOS=iBearBreak and not iBearAgainst
bool xBullBOS=xBullBreak and not xBullAgainst
bool xBearBOS=xBearBreak and not xBearAgainst

// Mutate state only AFTER event classification.
if iBullBreak
    iBrokenHighBar:=iLastHighBar
    if not na(iLastLow)
        iProtectedLow:=iLastLow
if iBearBreak
    iBrokenLowBar:=iLastLowBar
    if not na(iLastHigh)
        iProtectedHigh:=iLastHigh
if xBullBreak
    xBrokenHighBar:=xLastHighBar
    if not na(xLastLow)
        xProtectedLow:=xLastLow
if xBearBreak
    xBrokenLowBar:=xLastLowBar
    if not na(xLastHigh)
        xProtectedHigh:=xLastHigh

if iBullBOS or iBullCH or iBullMSS
    iTrend:=1
if iBearBOS or iBearCH or iBearMSS
    iTrend:=-1
if xBullBOS or xBullCH or xBullMSS
    xTrend:=1
if xBearBOS or xBearCH or xBearMSS
    xTrend:=-1

//================ TEXT RENDERER ================
if showSwings and not na(iPH)
    label.new(bar_index-iLen,iPH,iHighClass,style=label.style_none)
if showSwings and not na(iPL)
    label.new(bar_index-iLen,iPL,iLowClass,style=label.style_none)
if showSwings and not na(xPH)
    label.new(bar_index-xLen,xPH,xHighClass,style=label.style_none)
if showSwings and not na(xPL)
    label.new(bar_index-xLen,xPL,xLowClass,style=label.style_none)

if showEvents and iBullMSS
    label.new(bar_index,low,"iMSS ↑",style=label.style_none)
else if showEvents and iBullCH
    label.new(bar_index,low,"iCHoCH ↑",style=label.style_none)
else if showEvents and iBullBOS
    label.new(bar_index,low,"iBOS ↑",style=label.style_none)
if showEvents and iBearMSS
    label.new(bar_index,high,"iMSS ↓",style=label.style_none)
else if showEvents and iBearCH
    label.new(bar_index,high,"iCHoCH ↓",style=label.style_none)
else if showEvents and iBearBOS
    label.new(bar_index,high,"iBOS ↓",style=label.style_none)
if showEvents and xBullMSS
    label.new(bar_index,low,"xMSS ↑",style=label.style_none)
else if showEvents and xBullCH
    label.new(bar_index,low,"xCHoCH ↑",style=label.style_none)
else if showEvents and xBullBOS
    label.new(bar_index,low,"xBOS ↑",style=label.style_none)
if showEvents and xBearMSS
    label.new(bar_index,high,"xMSS ↓",style=label.style_none)
else if showEvents and xBearCH
    label.new(bar_index,high,"xCHoCH ↓",style=label.style_none)
else if showEvents and xBearBOS
    label.new(bar_index,high,"xBOS ↓",style=label.style_none)

//================ DIAGNOSTICS ================
string iState=iTrend==1?"BULLISH":iTrend==-1?"BEARISH":"NEUTRAL"
string xState=xTrend==1?"BULLISH":xTrend==-1?"BEARISH":"NEUTRAL"
var table t=table.new(position.top_right,2,10)
if barstate.islast
    table.clear(t,0,0,1,9)
    if showDiagnostics
        table.cell(t,0,0,"ARTHA P01.6")
        table.cell(t,1,0,"STRUCTURE")
        table.cell(t,0,1,"Internal trend")
        table.cell(t,1,1,iState)
        table.cell(t,0,2,"Internal swing")
        table.cell(t,1,2,iHighClass+" / "+iLowClass)
        table.cell(t,0,3,"Internal protected")
        table.cell(t,1,3,str.tostring(iProtectedHigh)+" / "+str.tostring(iProtectedLow))
        table.cell(t,0,4,"External trend")
        table.cell(t,1,4,xState)
        table.cell(t,0,5,"External swing")
        table.cell(t,1,5,xHighClass+" / "+xLowClass)
        table.cell(t,0,6,"Displacement")
        table.cell(t,1,6,str.tostring(displacement,"#.##"))
        table.cell(t,0,7,"i event")
        table.cell(t,1,7,iBullMSS?"BULL MSS":iBearMSS?"BEAR MSS":iBullCH?"BULL CHoCH":iBearCH?"BEAR CHoCH":iBullBOS?"BULL BOS":iBearBOS?"BEAR BOS":"NONE")
        table.cell(t,0,8,"x event")
        table.cell(t,1,8,xBullMSS?"BULL MSS":xBearMSS?"BEAR MSS":xBullCH?"BULL CHoCH":xBearCH?"BEAR CHoCH":xBullBOS?"BULL BOS":xBearBOS?"BEAR BOS":"NONE")
        table.cell(t,0,9,"Confirmed")
        table.cell(t,1,9,barstate.isconfirmed?"YES":"NO")

alertcondition(iBullBOS or xBullBOS,"ARTHA Bullish BOS","Confirmed bullish BOS")
alertcondition(iBearBOS or xBearBOS,"ARTHA Bearish BOS","Confirmed bearish BOS")
alertcondition(iBullCH or xBullCH,"ARTHA Bullish CHoCH","Confirmed bullish CHoCH")
alertcondition(iBearCH or xBearCH,"ARTHA Bearish CHoCH","Confirmed bearish CHoCH")
alertcondition(iBullMSS or xBullMSS,"ARTHA Bullish MSS","Confirmed bullish MSS")
alertcondition(iBearMSS or xBearMSS,"ARTHA Bearish MSS","Confirmed bearish MSS")
