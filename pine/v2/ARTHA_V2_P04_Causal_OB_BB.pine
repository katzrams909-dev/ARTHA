//=============================================================================
string G04="04 Displacement"
string displacementMode=input.string("Balanced","Qualification mode",options=["Body only","Balanced","Strict"],group=G04)
float minDispBodyATR=input.float(0.60,"Minimum body / ATR",minval=0.0,step=0.05,group=G04)
float minDispRangeATR=input.float(0.90,"Minimum range / ATR",minval=0.0,step=0.05,group=G04)
float minDispBodyPct=input.float(0.55,"Minimum body / candle range",minval=0.0,maxval=1.0,step=0.05,group=G04)
float minDispCloseLoc=input.float(0.70,"Minimum directional close location",minval=0.50,maxval=1.0,step=0.05,group=G04)
int minDisplacementScore=input.int(60,"Minimum displacement quality score",minval=0,maxval=100,group=G04)
bool useFollowThrough=input.bool(true,"Reward consecutive directional expansion",group=G04)
bool useVolumeContext=input.bool(false,"Use volume as quality context",group=G04)
int volumeLookback=input.int(20,"Volume average length",minval=5,maxval=200,group=G04)
float volumeExpansionRatio=input.float(1.20,"Volume expansion ratio",minval=0.1,step=0.05,group=G04)
int relativeLookback=input.int(20,"Relative expansion lookback",minval=5,maxval=100,group=G04)
float minBodyVsAvg=input.float(1.25,"Minimum body vs recent average",minval=0.5,step=0.05,group=G04)
float minRangeVsAvg=input.float(1.10,"Minimum range vs recent average",minval=0.5,step=0.05,group=G04)
bool requirePriorRangeClose=input.bool(true,"Require close beyond prior candle range",group=G04)
int episodeGapBars=input.int(1,"Episode allowed gap bars",minval=0,maxval=5,group=G04)
int episodeMaxBars=input.int(8,"Episode maximum duration",minval=1,maxval=30,group=G04)
bool showEpisodeMarkers=input.bool(false,"Show completed episode markers",group=G04)
bool showDisplacementMarkers=input.bool(false,"Show qualified displacement markers",group=G04)
int maxDisplacementMarkers=input.int(80,"Maximum displacement markers",minval=10,maxval=200,group=G04)
color bullDisplacementColor=input.color(color.aqua,"Bull displacement color",group=G04)

color bearDisplacementColor=input.color(color.fuchsia,"Bear displacement color",group=G04)

//=============================================================================
// 05 FVG / IFVG + POI PROVENANCE
//=============================================================================
string G05="05 FVG / IFVG"
string fvgCreationMode=input.string("Displacement-linked","FVG creation mode",options=["All","Displacement-linked","Structural"],group=G05)
float minFVGATR=input.float(0.10,"Minimum FVG size / ATR",minval=0.0,step=0.05,group=G05)
int fvgProvenanceWindow=input.int(2,"Bars allowed after episode DSP",minval=0,maxval=5,group=G05)
string ifvgFlipMode=input.string("Close beyond boundary","IFVG flip confirmation",options=["Close beyond boundary","Full body beyond boundary"],group=G05)
bool retireFVGOnFullWickFill=input.bool(true,"Retire FVG on full wick traversal",group=G05)
bool retireIFVGOnFullWickFill=input.bool(true,"Retire IFVG on full wick traversal",group=G05)
int maxImbalanceZones=input.int(40,"Maximum tracked imbalance zones",minval=10,maxval=100,group=G05)
bool showFVGZones=input.bool(true,"Show FVG zones",group=G05)
bool showIFVGZones=input.bool(true,"Show IFVG zones",group=G05)
bool showPOIProvenance=input.bool(false,"Show provenance in zone labels",group=G05)
bool showSecondaryFVGs=input.bool(false,"Show secondary FVGs",group=G05)
color bullFVGColor=input.color(color.teal,"Bull FVG color",group=G05)
color bearFVGColor=input.color(color.maroon,"Bear FVG color",group=G05)
color bullIFVGColor=input.color(color.aqua,"Bull IFVG color",group=G05)
color bearIFVGColor=input.color(color.fuchsia,"Bear IFVG color",group=G05)
int fvgTransparency=input.int(88,"FVG/IFVG transparency",minval=0,maxval=100,group=G05)

//=============================================================================
// 06 ORDER BLOCK / BREAKER BLOCK
//=============================================================================
string G06="06 Order Block / Breaker"
int obSearchBars=input.int(8,"Origin search bars before episode",minval=1,maxval=20,group=G06)
bool obBodyOnly=input.bool(false,"Use candle body for OB zone",group=G06)
bool requirePrimaryStructuralFVG=input.bool(true,"Require primary structural FVG",group=G06)
bool requireBreakerDisplacement=input.bool(true,"Require opposite displacement for breaker",group=G06)
bool retireOBOnFullWickFill=input.bool(false,"Retire OB on full wick traversal",group=G06)
bool retireBBOnFullWickFill=input.bool(true,"Retire BB on full wick traversal",group=G06)
int maxOrderBlocks=input.int(30,"Maximum tracked OB/BB zones",minval=5,maxval=80,group=G06)
bool showOBZones=input.bool(true,"Show OB zones",group=G06)
bool showBBZones=input.bool(true,"Show Breaker zones",group=G06)
bool showOBProvenance=input.bool(false,"Show OB provenance in box text",group=G06)
color bullOBColor=input.color(color.green,"Bull OB color",group=G06)
color bearOBColor=input.color(color.red,"Bear OB color",group=G06)
color bullBBColor=input.color(color.aqua,"Bull Breaker color",group=G06)
color bearBBColor=input.color(color.fuchsia,"Bear Breaker color",group=G06)
int obTransparency=input.int(88,"OB/BB transparency",minval=0,maxval=100,group=G06)

//=============================================================================
// SHARED MEASUREMENTS
//=============================================================================
float atr=ta.atr(14)
float candleBody=math.abs(close-open)
float candleRange=math.max(high-low,syminfo.mintick)
float displacementBodyATR=atr>0?candleBody/atr:0.0
float displacementRangeATR=atr>0?candleRange/atr:0.0
float displacementBodyPct=candleBody/candleRange
float bullCloseLocation=(close-low)/candleRange
float bearCloseLocation=(high-close)/candleRange
float liquidityTolerance=atr*eqTolATR

float recentAvgBody=ta.sma(candleBody[1],relativeLookback)
float recentAvgRange=ta.sma(candleRange[1],relativeLookback)
float bodyVsAvg=not na(recentAvgBody) and recentAvgBody>0?candleBody/recentAvgBody:na
float rangeVsAvg=not na(recentAvgRange) and recentAvgRange>0?candleRange/recentAvgRange:na

bool bullDirectional=close>open
bool bearDirectional=close<open
bool bullPriorRangeClose=close>high[1]
bool bearPriorRangeClose=close<low[1]
bool bullFollowThrough=bullDirectional and close[1]>open[1] and bullPriorRangeClose
bool bearFollowThrough=bearDirectional and close[1]<open[1] and bearPriorRangeClose

float avgVolume=ta.sma(volume,volumeLookback)
float volumeRatio=not na(avgVolume) and avgVolume>0?volume/avgVolume:na
bool volumeExpanded=not na(volumeRatio) and volumeRatio>=volumeExpansionRatio

// Score curve deliberately does NOT award full points at the minimum threshold.
// At the minimum threshold a component earns 50% of its points; it reaches
// full points only at a materially stronger "excellent" target.
f_rampScore(float value,float floorValue,float targetValue,int points) =>
    if targetValue<=floorValue
        value>=floorValue?points:0
    else if value<floorValue
        0
    else
        float progress=math.min((value-floorValue)/(targetValue-floorValue),1.0)
        int(math.round(points*(0.50+0.50*progress)))

float bodyTarget=math.max(minDispBodyATR*1.75,minDispBodyATR+0.40)
float rangeTarget=math.max(minDispRangeATR*1.60,minDispRangeATR+0.50)
float bodyPctTarget=math.min(0.90,minDispBodyPct+0.25)
float closeLocTarget=math.min(0.98,minDispCloseLoc+0.20)
float bodyRelTarget=minBodyVsAvg+0.75
float rangeRelTarget=minRangeVsAvg+0.60

f_displacementScore(bool bullish) =>
    int score=0
    float closeLoc=bullish?bullCloseLocation:bearCloseLocation
    score+=f_rampScore(displacementBodyATR,minDispBodyATR,bodyTarget,25)
    score+=f_rampScore(displacementRangeATR,minDispRangeATR,rangeTarget,15)
    score+=f_rampScore(displacementBodyPct,minDispBodyPct,bodyPctTarget,15)
    score+=f_rampScore(closeLoc,minDispCloseLoc,closeLocTarget,15)
    score+=na(bodyVsAvg)?0:f_rampScore(bodyVsAvg,minBodyVsAvg,bodyRelTarget,15)
    score+=na(rangeVsAvg)?0:f_rampScore(rangeVsAvg,minRangeVsAvg,rangeRelTarget,10)
    bool follow=bullish?bullFollowThrough:bearFollowThrough
    if useFollowThrough and follow
        score+=5
    if useVolumeContext and volumeExpanded
        score+=5
    math.min(score,100)

int bullDisplacementScore=bullDirectional?f_displacementScore(true):0
int bearDisplacementScore=bearDirectional?f_displacementScore(false):0

f_displacementQualified(bool bullish) =>
    bool directional=bullish?bullDirectional:bearDirectional
    float closeLoc=bullish?bullCloseLocation:bearCloseLocation
    int score=bullish?bullDisplacementScore:bearDisplacementScore

    bool bodyOK=displacementBodyATR>=minDispBodyATR
    bool balancedRangeOK=displacementRangeATR>=minDispRangeATR*0.85
    bool rangeOK=displacementRangeATR>=minDispRangeATR
    bool efficiencyOK=displacementBodyPct>=minDispBodyPct
    bool closeOK=closeLoc>=minDispCloseLoc
    bool bodyRelativeOK=not na(bodyVsAvg) and bodyVsAvg>=minBodyVsAvg
    bool rangeRelativeOK=not na(rangeVsAvg) and rangeVsAvg>=minRangeVsAvg
    bool priorRangeOK=not requirePriorRangeClose or (bullish?bullPriorRangeClose:bearPriorRangeClose)

    bool strictBody=displacementBodyATR>=minDispBodyATR*1.20
    bool strictEfficiency=displacementBodyPct>=math.min(0.95,minDispBodyPct+0.05)
    bool strictClose=closeLoc>=math.min(0.99,minDispCloseLoc+0.05)
    bool strictBodyRelative=not na(bodyVsAvg) and bodyVsAvg>=minBodyVsAvg+0.15
    bool strictRangeRelative=not na(rangeVsAvg) and rangeVsAvg>=minRangeVsAvg+0.15
    int strictScoreFloor=math.max(minDisplacementScore,75)

    displacementMode=="Body only"?directional and bodyOK:
         displacementMode=="Strict"?directional and strictBody and rangeOK and strictEfficiency and strictClose and strictBodyRelative and strictRangeRelative and priorRangeOK and score>=strictScoreFloor:
         directional and bodyOK and balancedRangeOK and efficiencyOK and closeOK and bodyRelativeOK and rangeRelativeOK and priorRangeOK and score>=minDisplacementScore

//=============================================================================
// TYPES
//=============================================================================
type DisplacementEvent
    int id
    int direction          // +1 bull, -1 bear
    int bar
    int score
    float bodyATR
    float rangeATR
    float bodyPct
    float closeLocation
    bool followThrough
    bool volumeExpansion
    bool structureBreak
    string structureScope
    string structureKind

type DisplacementEpisode
    int id
    int direction          // +1 bull, -1 bear
    int startBar
    int endBar
    int peakBar
    int peakScore
    int eventCount
    float highPrice
    float lowPrice
    float totalBodyATR
    bool structureBreak
    string structureScope
    string structureKind

type ImbalanceZone
    int id
    int direction          // original FVG direction: +1 bull, -1 bear
    int state              // 0 ACTIVE FVG, 1 ACTIVE IFVG, 2 RETIRED
    float top
    float bottom
    int bornBar
    int terminalBar
    int episodeId
    int displacementScore
    bool structureLinked
    string structureScope
    string structureKind
    string qualityClass    // ORDINARY | DISPLACEMENT | STRUCTURAL
    bool primary
    int episodePeakBar
    float birthGapATR
    float maxMitigationPct
    box bx

type OrderBlockZone
    int id
    int direction          // original OB direction: +1 bull, -1 bear
    int state              // 0 ACTIVE OB, 1 ACTIVE BB, 2 RETIRED
    float top
    float bottom
    int originBar
    int bornBar
    int terminalBar
    int episodeId
    int fvgId
    int displacementScore
    string structureScope
    string structureKind
    float maxMitigationPct
    box bx

type LiquidityLevel
    int id
    float price
    bool buySide
    int tier
    int state              // 0 ACTIVE, 1 SWEPT, 2 RESOLVED, 3 EXPIRED, 4 SUPERSEDED
    int createdBar
    int terminalBar
    int expiryBar
    int startTime
    int endTime
    string sourceType
    string sourceName
    int originSwingBar
    int clusterCount
    line ln
    label lb


//=============================================================================
// DISPLACEMENT STATE
//=============================================================================
var array<DisplacementEvent> displacementEvents=array.new<DisplacementEvent>()
var int nextDisplacementId=1
var int bullDisplacementCount=0
var int bearDisplacementCount=0
var int lastBullDisplacementBar=na
var int lastBearDisplacementBar=na
var int lastBullDisplacementScore=na
var int lastBearDisplacementScore=na
var label[] displacementLabels=array.new_label()
var label[] episodeLabels=array.new_label()

// Episode registry and active episode state.
var array<DisplacementEpisode> displacementEpisodes=array.new<DisplacementEpisode>()
var int nextEpisodeId=1
var bool episodeActive=false
var int episodeId=na
var int episodeDirection=0
var int episodeStartBar=na
var int episodeLastDSPBar=na
var int episodePeakBar=na
var int episodePeakScore=na
var int episodeEventCount=0
var float episodeHigh=na
var float episodeLow=na
var float episodeTotalBodyATR=0.0
var bool episodeStructureBreak=false
var string episodeStructureScope="NONE"
var string episodeStructureKind="NONE"

var int completedEpisodeCount=0
var int bullEpisodeCount=0
var int bearEpisodeCount=0
var int lastCompletedEpisodeDirection=0
var int lastCompletedEpisodePeakScore=na
var int lastCompletedEpisodeBars=na

bool bullDisplacementEvent=barstate.isconfirmed and f_displacementQualified(true)
bool bearDisplacementEvent=barstate.isconfirmed and f_displacementQualified(false)

// FVG/IFVG registry. Lifecycle logic executes after episode aggregation so
// each new imbalance can capture the most relevant active/completed episode.
var array<ImbalanceZone> imbalanceZones=array.new<ImbalanceZone>()
var int nextImbalanceId=1
var int bullFVGCount=0
var int bearFVGCount=0
var int bullIFVGCount=0
var int bearIFVGCount=0
var int retiredImbalanceCount=0
var int structuralFVGCount=0
var int displacementFVGCount=0
var int ordinaryFVGCount=0
var int primaryFVGCount=0
var int secondaryFVGCount=0

f_episodePeakBar(int epId) =>
    int peak=na
    if episodeActive and episodeId==epId
        peak:=episodePeakBar
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.id==epId
                peak:=ep.peakBar
                break
    peak

f_primaryCandidateBetter(int newBornBar,float newGapATR,int oldBornBar,float oldGapATR,int peakBar) =>
    int newDistance=na(peakBar)?999999:math.abs(newBornBar-peakBar)
    int oldDistance=na(peakBar)?999999:math.abs(oldBornBar-peakBar)
    newDistance<oldDistance or (newDistance==oldDistance and newGapATR>oldGapATR)

f_assignPrimaryForEpisode(int newIndex,int epId,int dir) =>
    bool newPrimary=true
    if not na(epId) and array.size(imbalanceZones)>0
        ImbalanceZone newZone=array.get(imbalanceZones,newIndex)
        for n=0 to array.size(imbalanceZones)-1
            if n!=newIndex
                ImbalanceZone old=array.get(imbalanceZones,n)
                if old.episodeId==epId and old.direction==dir and old.primary
                    bool replace=f_primaryCandidateBetter(newZone.bornBar,newZone.birthGapATR,old.bornBar,old.birthGapATR,newZone.episodePeakBar)
                    if replace
                        old.primary:=false
                        array.set(imbalanceZones,n,old)
                    else
                        newPrimary:=false
                    break
        newZone.primary:=newPrimary
        array.set(imbalanceZones,newIndex,newZone)
    newPrimary

f_deleteImbalance(ImbalanceZone z) =>
    if not na(z.bx)
        box.delete(z.bx)

f_trimImbalances() =>
    while array.size(imbalanceZones)>maxImbalanceZones
        ImbalanceZone old=array.shift(imbalanceZones)
        f_deleteImbalance(old)

//=============================================================================
// ORDER BLOCK / BREAKER STATE + HELPERS
//=============================================================================
var array<OrderBlockZone> orderBlocks=array.new<OrderBlockZone>()
var int nextOrderBlockId=1
var int bullOBCount=0
var int bearOBCount=0
var int bullBBCount=0
var int bearBBCount=0
var int retiredOBBBCount=0

f_deleteOrderBlock(OrderBlockZone z) =>
    if not na(z.bx)
        box.delete(z.bx)

f_trimOrderBlocks() =>
    while array.size(orderBlocks)>maxOrderBlocks
        OrderBlockZone old=array.shift(orderBlocks)
        f_deleteOrderBlock(old)

f_hasOrderBlockForEpisode(int epId,int dir) =>
    bool found=false
    if not na(epId) and array.size(orderBlocks)>0
        for n=0 to array.size(orderBlocks)-1
            OrderBlockZone z=array.get(orderBlocks,n)
            if z.episodeId==epId and z.direction==dir
                found:=true
                break
    found

f_episodeStartBar(int epId) =>
    int start=na
    if episodeActive and episodeId==epId
        start:=episodeStartBar
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.id==epId
                start:=ep.startBar
                break
    start

f_findOBOrigin(int epId,int dir) =>
    int originBar=na
    float zoneTop=na
    float zoneBottom=na
    int epStart=f_episodeStartBar(epId)
    if not na(epStart)
        int startOffset=bar_index-epStart
        int firstOffset=startOffset+1
        int lastOffset=startOffset+obSearchBars
        for j=firstOffset to lastOffset
            if j>=1 and j<=bar_index
                bool opposite=dir==1?close[j]<open[j]:close[j]>open[j]
                if opposite
                    originBar:=bar_index-j
                    if obBodyOnly
                        zoneTop:=math.max(open[j],close[j])
                        zoneBottom:=math.min(open[j],close[j])
                    else
                        zoneTop:=high[j]
                        zoneBottom:=low[j]
                    break
    [originBar,zoneTop,zoneBottom]

//=============================================================================
// LIQUIDITY HELPERS
//=============================================================================
var array<LiquidityLevel> liquidity=array.new<LiquidityLevel>()
var int nextLiquidityId=1
var int duplicateSuppressions=0
var int liquiditySweepCount=0
var int liquidityResolutionCount=0
var int liquidityExpiryCount=0
var int liquiditySupersedeCount=0

f_near(float a,float b,float tol) =>
    not na(a) and not na(b) and math.abs(a-b)<=tol

f_tierColor(int tier) =>
    tier==1?tier1Color:tier==2?tier2Color:tier==3?tier3Color:tier4Color

f_tierVisible(int tier) =>
    tier==1?showTier1:tier==2?showTier2:tier==3?showTier3:showTier4

f_deleteLiquidity(LiquidityLevel q) =>
    if not na(q.ln)
        line.delete(q.ln)
    if not na(q.lb)
        label.delete(q.lb)

f_trimLiquidity() =>
    while array.size(liquidity)>maxLiquidity
        LiquidityLevel old=array.shift(liquidity)
        f_deleteLiquidity(old)

f_findActiveSwingNear(float price,bool buySide,float tol) =>
    int found=-1
    if array.size(liquidity)>0
        for n=array.size(liquidity)-1 to 0
            LiquidityLevel q=array.get(liquidity,n)
            bool swingType=q.sourceType=="EXTERNAL_SWING" or q.sourceType=="INTERNAL_SWING" or q.sourceType=="SWING_CLUSTER"
            if q.state==0 and swingType and q.buySide==buySide and f_near(q.price,price,tol)
                found:=n
                break
    found

f_registerReference(int id,float price,bool buySide,int tier,string sourceType,string sourceName,int createdBar,int startTime) =>
    bool created=false
    if not na(price)
        color c=f_tierColor(tier)
        line ln=line.new(startTime,price,time,price,xloc=xloc.bar_time,extend=extend.none,color=f_hidden(c))
        label lb=label.new(time,price,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
        array.push(liquidity,LiquidityLevel.new(id,price,buySide,tier,0,createdBar,na,na,startTime,na,sourceType,sourceName,na,1,ln,lb))
        f_trimLiquidity()
        created:=true
    created

f_registerSwing(int id,float price,bool buySide,int tier,string sourceType,string sourceName,int pivotBar,int startTime,int expiryBar) =>
    bool created=false
    int idx=f_findActiveSwingNear(price,buySide,liquidityTolerance)
    if idx>=0
        LiquidityLevel q=array.get(liquidity,idx)
        q.clusterCount+=1
        // Preserve the stronger tier/source as primary.
        if tier<q.tier
            q.tier:=tier
            q.sourceType:=sourceType
            q.sourceName:=sourceName
            q.originSwingBar:=pivotBar
        else if q.clusterCount>=2 and q.sourceType!="EXTERNAL_SWING"
            q.sourceType:="SWING_CLUSTER"
            q.sourceName:=buySide?"EQH":"EQL"
            q.tier:=math.min(q.tier,3)
        // Extend expiry when fresh independent swing evidence arrives.
        q.expiryBar:=na(q.expiryBar)?expiryBar:math.max(q.expiryBar,expiryBar)
        array.set(liquidity,idx,q)
    else if not na(price)
        color c=f_tierColor(tier)
        line ln=line.new(startTime,price,time,price,xloc=xloc.bar_time,extend=extend.none,color=f_hidden(c))
        label lb=label.new(time,price,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
        array.push(liquidity,LiquidityLevel.new(id,price,buySide,tier,0,bar_index,na,expiryBar,startTime,na,sourceType,sourceName,pivotBar,1,ln,lb))
        f_trimLiquidity()
        created:=true
    created

f_supersedeSource(string sourceName) =>
    int changed=0
    if array.size(liquidity)>0
        for n=0 to array.size(liquidity)-1
            LiquidityLevel q=array.get(liquidity,n)
            if q.state==0 and q.sourceName==sourceName
                q.state:=4
                q.terminalBar:=bar_index
                q.endTime:=time
                array.set(liquidity,n,q)
                changed+=1
    changed

//=============================================================================
// PIVOTS / SWINGS
//=============================================================================
float iPH=ta.pivothigh(high,iLen,iLen)
float iPL=ta.pivotlow(low,iLen,iLen)
float xPH=ta.pivothigh(high,xLen,xLen)
float xPL=ta.pivotlow(low,xLen,xLen)

bool newIPH=barstate.isconfirmed and not na(iPH)
bool newIPL=barstate.isconfirmed and not na(iPL)
bool newXPH=barstate.isconfirmed and not na(xPH)
bool newXPL=barstate.isconfirmed and not na(xPL)

var float iHigh=na
var float iLow=na
var float iPriorHigh=na
var float iPriorLow=na
var int iHighBar=na
var int iLowBar=na
var int iHighTime=na
var int iLowTime=na
var string iHighClass="NONE"
var string iLowClass="NONE"

var float xHigh=na
var float xLow=na
var float xPriorHigh=na
var float xPriorLow=na
var int xHighBar=na
var int xLowBar=na
var int xHighTime=na
var int xLowTime=na
var string xHighClass="NONE"
var string xLowClass="NONE"

if newIPH
    iPriorHigh:=iHigh
    iHigh:=iPH
    iHighBar:=bar_index-iLen
    iHighTime:=time[iLen]
    iHighClass:=na(iPriorHigh)?"HH":iHigh>iPriorHigh?"HH":"LH"
    if useInternalSwingLiquidity
        bool made=f_registerSwing(nextLiquidityId,iHigh,true,4,"INTERNAL_SWING","iH",iHighBar,iHighTime,bar_index+internalSwingMaxAge)
        if made
            nextLiquidityId+=1
        else
            duplicateSuppressions+=1

if newIPL
    iPriorLow:=iLow
    iLow:=iPL
    iLowBar:=bar_index-iLen
    iLowTime:=time[iLen]
    iLowClass:=na(iPriorLow)?"HL":iLow>iPriorLow?"HL":"LL"
    if useInternalSwingLiquidity
        bool made=f_registerSwing(nextLiquidityId,iLow,false,4,"INTERNAL_SWING","iL",iLowBar,iLowTime,bar_index+internalSwingMaxAge)
        if made
            nextLiquidityId+=1
        else
            duplicateSuppressions+=1

if newXPH
    xPriorHigh:=xHigh
    xHigh:=xPH
    xHighBar:=bar_index-xLen
    xHighTime:=time[xLen]
    xHighClass:=na(xPriorHigh)?"HH":xHigh>xPriorHigh?"HH":"LH"
    if useExternalSwingLiquidity
        bool made=f_registerSwing(nextLiquidityId,xHigh,true,2,"EXTERNAL_SWING","xH",xHighBar,xHighTime,bar_index+externalSwingMaxAge)
        if made
            nextLiquidityId+=1
        else
            duplicateSuppressions+=1

if newXPL
    xPriorLow:=xLow
    xLow:=xPL
    xLowBar:=bar_index-xLen
    xLowTime:=time[xLen]
    xLowClass:=na(xPriorLow)?"HL":xLow>xPriorLow?"HL":"LL"
    if useExternalSwingLiquidity
        bool made=f_registerSwing(nextLiquidityId,xLow,false,2,"EXTERNAL_SWING","xL",xLowBar,xLowTime,bar_index+externalSwingMaxAge)
        if made
            nextLiquidityId+=1
        else
            duplicateSuppressions+=1

//=============================================================================
// STRUCTURE TARGETS / STATE
//=============================================================================
var float iTargetHigh=na
var int iTargetHighTime=na
var bool iHighWaiting=false
var float iTargetLow=na
var int iTargetLowTime=na
var bool iLowWaiting=false

var float xTargetHigh=na
var int xTargetHighTime=na
var bool xHighWaiting=false
var float xTargetLow=na
var int xTargetLowTime=na
var bool xLowWaiting=false

if newIPH and not iHighWaiting
    iTargetHigh:=iPH
    iTargetHighTime:=iHighTime
    iHighWaiting:=true
if newIPL and not iLowWaiting
    iTargetLow:=iPL
    iTargetLowTime:=iLowTime
    iLowWaiting:=true
if newXPH and not xHighWaiting
    xTargetHigh:=xPH
    xTargetHighTime:=xHighTime
    xHighWaiting:=true
if newXPL and not xLowWaiting
    xTargetLow:=xPL
    xTargetLowTime:=xLowTime
    xLowWaiting:=true

var int iTrend=0
var int xTrend=0
var float iProtectedLow=na
var float iProtectedHigh=na
var float xProtectedLow=na
var float xProtectedHigh=na
var int iProtectedLowTime=na
var int iProtectedHighTime=na
var int xProtectedLowTime=na
var int xProtectedHighTime=na

int oldITrend=iTrend
int oldXTrend=xTrend

bool iBullBreak=barstate.isconfirmed and iHighWaiting and not na(iTargetHigh) and (requireClose?close>iTargetHigh:high>iTargetHigh)
bool iBearBreak=barstate.isconfirmed and iLowWaiting and not na(iTargetLow) and (requireClose?close<iTargetLow:low<iTargetLow)
bool xBullBreak=barstate.isconfirmed and xHighWaiting and not na(xTargetHigh) and (requireClose?close>xTargetHigh:high>xTargetHigh)
bool xBearBreak=barstate.isconfirmed and xLowWaiting and not na(xTargetLow) and (requireClose?close<xTargetLow:low<xTargetLow)

bool iBullMSS=iBullBreak and oldITrend<0 and bullDisplacementEvent
bool iBearMSS=iBearBreak and oldITrend>0 and bearDisplacementEvent
bool xBullMSS=xBullBreak and oldXTrend<0 and bullDisplacementEvent
bool xBearMSS=xBearBreak and oldXTrend>0 and bearDisplacementEvent

bool iBullCH=iBullBreak and oldITrend<0 and not iBullMSS
bool iBearCH=iBearBreak and oldITrend>0 and not iBearMSS
bool xBullCH=xBullBreak and oldXTrend<0 and not xBullMSS
bool xBearCH=xBearBreak and oldXTrend>0 and not xBearMSS

bool iBullBOS=iBullBreak and not iBullCH and not iBullMSS
bool iBearBOS=iBearBreak and not iBearCH and not iBearMSS
bool xBullBOS=xBullBreak and not xBullCH and not xBullMSS
bool xBearBOS=xBearBreak and not xBearCH and not xBearMSS

if bullDisplacementEvent
    string scope=(iBullBreak and xBullBreak)?"BOTH":xBullBreak?"EXTERNAL":iBullBreak?"INTERNAL":"NONE"
    string kind=(iBullMSS or xBullMSS)?"MSS":(iBullCH or xBullCH)?"CHoCH":(iBullBOS or xBullBOS)?"BOS":"NONE"
    array.push(displacementEvents,DisplacementEvent.new(nextDisplacementId,1,bar_index,bullDisplacementScore,displacementBodyATR,displacementRangeATR,displacementBodyPct,bullCloseLocation,bullFollowThrough,volumeExpanded,iBullBreak or xBullBreak,scope,kind))
    nextDisplacementId+=1
    bullDisplacementCount+=1
    lastBullDisplacementBar:=bar_index
    lastBullDisplacementScore:=bullDisplacementScore
    if showDisplacementMarkers
        label dl=label.new(bar_index,low,"DSP ↑ "+str.tostring(bullDisplacementScore),style=label.style_none,textcolor=bullDisplacementColor,size=f_textSize())
        array.push(displacementLabels,dl)

if bearDisplacementEvent
    string scope=(iBearBreak and xBearBreak)?"BOTH":xBearBreak?"EXTERNAL":iBearBreak?"INTERNAL":"NONE"
    string kind=(iBearMSS or xBearMSS)?"MSS":(iBearCH or xBearCH)?"CHoCH":(iBearBOS or xBearBOS)?"BOS":"NONE"
    array.push(displacementEvents,DisplacementEvent.new(nextDisplacementId,-1,bar_index,bearDisplacementScore,displacementBodyATR,displacementRangeATR,displacementBodyPct,bearCloseLocation,bearFollowThrough,volumeExpanded,iBearBreak or xBearBreak,scope,kind))
    nextDisplacementId+=1
    bearDisplacementCount+=1
    lastBearDisplacementBar:=bar_index
    lastBearDisplacementScore:=bearDisplacementScore
    if showDisplacementMarkers
        label dl=label.new(bar_index,high,"DSP ↓ "+str.tostring(bearDisplacementScore),style=label.style_none,textcolor=bearDisplacementColor,size=f_textSize())
        array.push(displacementLabels,dl)

while array.size(displacementEvents)>200
    array.shift(displacementEvents)
while array.size(displacementLabels)>maxDisplacementMarkers
    label.delete(array.shift(displacementLabels))

//=============================================================================
// DISPLACEMENT EPISODE AGGREGATION
// A directional episode may contain multiple qualified DSP bars separated by
// a small confirmed-bar gap. Downstream engines should consume episodes rather
// than treating every DSP bar as an independent institutional impulse.
//=============================================================================
bool anyDSP=bullDisplacementEvent or bearDisplacementEvent
int currentDSPDirection=bullDisplacementEvent?1:bearDisplacementEvent?-1:0
int currentDSPScore=bullDisplacementEvent?bullDisplacementScore:bearDisplacementEvent?bearDisplacementScore:0

bool gapExceeded=episodeActive and not na(episodeLastDSPBar) and bar_index-episodeLastDSPBar>episodeGapBars+1
bool durationExceeded=episodeActive and not na(episodeStartBar) and bar_index-episodeStartBar>=episodeMaxBars
bool oppositeDSP=episodeActive and anyDSP and currentDSPDirection!=episodeDirection
bool finalizeEpisode=episodeActive and (gapExceeded or durationExceeded or oppositeDSP)
bool bullEpisodeCompleted=finalizeEpisode and episodeDirection==1
bool bearEpisodeCompleted=finalizeEpisode and episodeDirection==-1

if finalizeEpisode
    array.push(displacementEpisodes,DisplacementEpisode.new(
         episodeId,episodeDirection,episodeStartBar,episodeLastDSPBar,episodePeakBar,episodePeakScore,
         episodeEventCount,episodeHigh,episodeLow,episodeTotalBodyATR,
         episodeStructureBreak,episodeStructureScope,episodeStructureKind))
    while array.size(displacementEpisodes)>100
        array.shift(displacementEpisodes)

    completedEpisodeCount+=1
    if episodeDirection==1
        bullEpisodeCount+=1
    else
        bearEpisodeCount+=1

    lastCompletedEpisodeDirection:=episodeDirection
    lastCompletedEpisodePeakScore:=episodePeakScore
    lastCompletedEpisodeBars:=episodeLastDSPBar-episodeStartBar+1

    if showEpisodeMarkers
        float markerY=episodeDirection==1?episodeLow:episodeHigh
        string markerText=(episodeDirection==1?"EP ↑ ":"EP ↓ ")+str.tostring(episodePeakScore)+" · "+str.tostring(episodeEventCount)+" DSP"
        label ep=label.new(episodePeakBar,markerY,markerText,style=label.style_none,textcolor=episodeDirection==1?bullDisplacementColor:bearDisplacementColor,size=f_textSize())
        array.push(episodeLabels,ep)
        while array.size(episodeLabels)>40
            label.delete(array.shift(episodeLabels))

    episodeActive:=false
    episodeId:=na
    episodeDirection:=0
    episodeStartBar:=na
    episodeLastDSPBar:=na
    episodePeakBar:=na
    episodePeakScore:=na
    episodeEventCount:=0
    episodeHigh:=na
    episodeLow:=na
    episodeTotalBodyATR:=0.0
    episodeStructureBreak:=false
    episodeStructureScope:="NONE"
    episodeStructureKind:="NONE"

// Start a new episode after finalizing an opposite/expired episode, or when idle.
if anyDSP and not episodeActive
    episodeActive:=true
    episodeId:=nextEpisodeId
    nextEpisodeId+=1
    episodeDirection:=currentDSPDirection
    episodeStartBar:=bar_index
    episodeLastDSPBar:=bar_index
    episodePeakBar:=bar_index
    episodePeakScore:=currentDSPScore
    episodeEventCount:=1
    episodeHigh:=high
    episodeLow:=low
    episodeTotalBodyATR:=displacementBodyATR
    episodeStructureBreak:=(currentDSPDirection==1?(iBullBreak or xBullBreak):(iBearBreak or xBearBreak))
    episodeStructureScope:=currentDSPDirection==1?((iBullBreak and xBullBreak)?"BOTH":xBullBreak?"EXTERNAL":iBullBreak?"INTERNAL":"NONE"):((iBearBreak and xBearBreak)?"BOTH":xBearBreak?"EXTERNAL":iBearBreak?"INTERNAL":"NONE")
    episodeStructureKind:=currentDSPDirection==1?((iBullMSS or xBullMSS)?"MSS":(iBullCH or xBullCH)?"CHoCH":(iBullBOS or xBullBOS)?"BOS":"NONE"):((iBearMSS or xBearMSS)?"MSS":(iBearCH or xBearCH)?"CHoCH":(iBearBOS or xBearBOS)?"BOS":"NONE")

// Extend the active episode only with same-direction qualifying DSP bars.
else if anyDSP and episodeActive and currentDSPDirection==episodeDirection
    episodeLastDSPBar:=bar_index
    episodeEventCount+=1
    episodeHigh:=math.max(episodeHigh,high)
    episodeLow:=math.min(episodeLow,low)
    episodeTotalBodyATR+=displacementBodyATR

    if currentDSPScore>episodePeakScore
        episodePeakScore:=currentDSPScore
        episodePeakBar:=bar_index

    bool thisStructureBreak=currentDSPDirection==1?(iBullBreak or xBullBreak):(iBearBreak or xBearBreak)
    if thisStructureBreak
        episodeStructureBreak:=true
        string thisScope=currentDSPDirection==1?((iBullBreak and xBullBreak)?"BOTH":xBullBreak?"EXTERNAL":iBullBreak?"INTERNAL":"NONE"):((iBearBreak and xBearBreak)?"BOTH":xBearBreak?"EXTERNAL":iBearBreak?"INTERNAL":"NONE")
        string thisKind=currentDSPDirection==1?((iBullMSS or xBullMSS)?"MSS":(iBullCH or xBullCH)?"CHoCH":(iBullBOS or xBullBOS)?"BOS":"NONE"):((iBearMSS or xBearMSS)?"MSS":(iBearCH or xBearCH)?"CHoCH":(iBearBOS or xBearBOS)?"BOS":"NONE")
        episodeStructureScope:=thisScope
        episodeStructureKind:=thisKind

//=============================================================================
// FVG / IFVG + POI PROVENANCE
//=============================================================================

// Resolve the episode most plausibly responsible for an imbalance born now.
// Prefer an active same-direction episode; otherwise use the latest completed
// same-direction episode whose end is within the provenance window.
f_findEpisodeProvenance(int dir) =>
    int foundId=na
    int foundScore=na
    bool foundStructure=false
    string foundScope="NONE"
    string foundKind="NONE"

    if episodeActive and episodeDirection==dir and not na(episodeLastDSPBar) and bar_index-episodeLastDSPBar<=fvgProvenanceWindow
        foundId:=episodeId
        foundScore:=episodePeakScore
        foundStructure:=episodeStructureBreak
        foundScope:=episodeStructureScope
        foundKind:=episodeStructureKind
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.direction==dir and bar_index-ep.endBar<=fvgProvenanceWindow
                foundId:=ep.id
                foundScore:=ep.peakScore
                foundStructure:=ep.structureBreak
                foundScope:=ep.structureScope
                foundKind:=ep.structureKind
                break
    [foundId,foundScore,foundStructure,foundScope,foundKind]

bool rawBullFVG=barstate.isconfirmed and low>high[2]
bool rawBearFVG=barstate.isconfirmed and high<low[2]
float bullFVGSize=rawBullFVG?low-high[2]:0.0
float bearFVGSize=rawBearFVG?low[2]-high:0.0
bool bullSizeOK=rawBullFVG and (atr<=0 or bullFVGSize/atr>=minFVGATR)
bool bearSizeOK=rawBearFVG and (atr<=0 or bearFVGSize/atr>=minFVGATR)

[bullEpisodeId,bullProvScore,bullStructureLinked,bullStructureScope,bullStructureKind]=f_findEpisodeProvenance(1)
[bearEpisodeId,bearProvScore,bearStructureLinked,bearStructureScope,bearStructureKind]=f_findEpisodeProvenance(-1)

bool bullCausal=not na(bullEpisodeId)
bool bearCausal=not na(bearEpisodeId)

bool bullCreateAllowed=fvgCreationMode=="All" or (fvgCreationMode=="Displacement-linked" and bullCausal) or (fvgCreationMode=="Structural" and bullCausal and bullStructureLinked)
bool bearCreateAllowed=fvgCreationMode=="All" or (fvgCreationMode=="Displacement-linked" and bearCausal) or (fvgCreationMode=="Structural" and bearCausal and bearStructureLinked)

bool bullFVGEvent=bullSizeOK and bullCreateAllowed
bool bearFVGEvent=bearSizeOK and bearCreateAllowed

f_qualityClass(bool causal,bool structural) =>
    structural?"STRUCTURAL":causal?"DISPLACEMENT":"ORDINARY"

bool newBullPrimaryStructuralFVG=false
bool newBearPrimaryStructuralFVG=false
int newBullPrimaryFVGId=na
int newBearPrimaryFVGId=na
int newBullPrimaryEpisodeId=na
int newBearPrimaryEpisodeId=na
int newBullPrimaryScore=na
int newBearPrimaryScore=na
string newBullPrimaryScope="NONE"
string newBearPrimaryScope="NONE"
string newBullPrimaryKind="NONE"
string newBearPrimaryKind="NONE"

if bullFVGEvent
    string quality=f_qualityClass(bullCausal,bullStructureLinked)
    color c=bullFVGColor
    string txt=showPOIProvenance?"FVG · "+quality+(na(bullEpisodeId)?"":" · EP"+str.tostring(bullEpisodeId)):"FVG"
    box bx=box.new(bar_index-2,low,bar_index,high[2],xloc=xloc.bar_index,extend=extend.none,bgcolor=color.new(c,fvgTransparency),border_color=color.new(c,20),text=txt,text_color=c,text_size=f_textSize(),text_halign=text.align_right,text_valign=text.align_center)
    int epPeak=f_episodePeakBar(bullEpisodeId)
    float gapATR=atr>0?bullFVGSize/atr:0.0
    array.push(imbalanceZones,ImbalanceZone.new(nextImbalanceId,1,0,low,high[2],bar_index,na,bullEpisodeId,bullProvScore,bullStructureLinked,bullStructureScope,bullStructureKind,quality,true,epPeak,gapATR,0.0,bx))
    int newIndex=array.size(imbalanceZones)-1
    bool becamePrimary=f_assignPrimaryForEpisode(newIndex,bullEpisodeId,1)
    if becamePrimary
        primaryFVGCount+=1
        if bullStructureLinked
            newBullPrimaryStructuralFVG:=true
            newBullPrimaryFVGId:=nextImbalanceId
            newBullPrimaryEpisodeId:=bullEpisodeId
            newBullPrimaryScore:=bullProvScore
            newBullPrimaryScope:=bullStructureScope
            newBullPrimaryKind:=bullStructureKind
    else
        secondaryFVGCount+=1
    nextImbalanceId+=1
    bullFVGCount+=1
    if quality=="STRUCTURAL"
        structuralFVGCount+=1
    else if quality=="DISPLACEMENT"
        displacementFVGCount+=1
    else
        ordinaryFVGCount+=1
    f_trimImbalances()

if bearFVGEvent
    string quality=f_qualityClass(bearCausal,bearStructureLinked)
    color c=bearFVGColor
    string txt=showPOIProvenance?"FVG · "+quality+(na(bearEpisodeId)?"":" · EP"+str.tostring(bearEpisodeId)):"FVG"
    box bx=box.new(bar_index-2,low[2],bar_index,high,xloc=xloc.bar_index,extend=extend.none,bgcolor=color.new(c,fvgTransparency),border_color=color.new(c,20),text=txt,text_color=c,text_size=f_textSize(),text_halign=text.align_right,text_valign=text.align_center)
    int epPeak=f_episodePeakBar(bearEpisodeId)
    float gapATR=atr>0?bearFVGSize/atr:0.0
    array.push(imbalanceZones,ImbalanceZone.new(nextImbalanceId,-1,0,low[2],high,bar_index,na,bearEpisodeId,bearProvScore,bearStructureLinked,bearStructureScope,bearStructureKind,quality,true,epPeak,gapATR,0.0,bx))
    int newIndex=array.size(imbalanceZones)-1
    bool becamePrimary=f_assignPrimaryForEpisode(newIndex,bearEpisodeId,-1)
    if becamePrimary
        primaryFVGCount+=1
        if bearStructureLinked
            newBearPrimaryStructuralFVG:=true
            newBearPrimaryFVGId:=nextImbalanceId
            newBearPrimaryEpisodeId:=bearEpisodeId
            newBearPrimaryScore:=bearProvScore
            newBearPrimaryScope:=bearStructureScope
            newBearPrimaryKind:=bearStructureKind
    else
        secondaryFVGCount+=1
    nextImbalanceId+=1
    bearFVGCount+=1
    if quality=="STRUCTURAL"
        structuralFVGCount+=1
    else if quality=="DISPLACEMENT"
        displacementFVGCount+=1
    else
        ordinaryFVGCount+=1
    f_trimImbalances()

bool bullIFVGEvent=false
bool bearIFVGEvent=false

if array.size(imbalanceZones)>0
    for n=0 to array.size(imbalanceZones)-1
        ImbalanceZone z=array.get(imbalanceZones,n)

        if z.state==0
            float zoneHeight=math.max(z.top-z.bottom,syminfo.mintick)
            float overlapTop=math.min(high,z.top)
            float overlapBottom=math.max(low,z.bottom)
            float overlap=math.max(overlapTop-overlapBottom,0.0)
            float mitigationPct=100.0*overlap/zoneHeight
            z.maxMitigationPct:=math.max(z.maxMitigationPct,mitigationPct)

            bool bullFullWick=z.direction==1 and low<=z.bottom
            bool bearFullWick=z.direction==-1 and high>=z.top

            bool bullFlipClose=z.direction==1 and close<z.bottom
            bool bearFlipClose=z.direction==-1 and close>z.top
            bool bullFlipBody=z.direction==1 and open<z.bottom and close<z.bottom
            bool bearFlipBody=z.direction==-1 and open>z.top and close>z.top

            bool flipToBear=ifvgFlipMode=="Full body beyond boundary"?bullFlipBody:bullFlipClose
            bool flipToBull=ifvgFlipMode=="Full body beyond boundary"?bearFlipBody:bearFlipClose

            if flipToBear
                z.state:=1
                bearIFVGEvent:=true
                bearIFVGCount+=1
            else if flipToBull
                z.state:=1
                bullIFVGEvent:=true
                bullIFVGCount+=1
            else if (z.direction==1 and retireFVGOnFullWickFill and bullFullWick) or (z.direction==-1 and retireFVGOnFullWickFill and bearFullWick)
                z.state:=2
                z.terminalBar:=bar_index
                retiredImbalanceCount+=1

        else if z.state==1
            // Inverted direction is opposite the original FVG direction.
            bool ifvgBull=z.direction==-1
            bool ifvgBear=z.direction==1
            bool fullTraverse=ifvgBull?low<=z.bottom:high>=z.top
            bool invalidClose=ifvgBull?close<z.bottom:close>z.top

            if invalidClose or (retireIFVGOnFullWickFill and fullTraverse)
                z.state:=2
                z.terminalBar:=bar_index
                retiredImbalanceCount+=1

        bool active=z.state<2
        bool isFVG=z.state==0
        bool isIFVG=z.state==1
        bool bullVisual=isFVG?z.direction==1:z.direction==-1
        color c=isIFVG?(bullVisual?bullIFVGColor:bearIFVGColor):(bullVisual?bullFVGColor:bearFVGColor)
        bool familyVisible=z.primary or showSecondaryFVGs or na(z.episodeId)
        bool visible=active and familyVisible and ((isFVG and showFVGZones) or (isIFVG and showIFVGZones))

        if not na(z.bx)
            box.set_right(z.bx,active?bar_index:(na(z.terminalBar)?bar_index:z.terminalBar))
            box.set_bgcolor(z.bx,visible?color.new(c,fvgTransparency):color.new(c,100))
            box.set_border_color(z.bx,visible?color.new(c,20):color.new(c,100))
            string kind=isIFVG?"IFVG":"FVG"
            string familyTag=z.primary?" · PRIMARY":" · SECONDARY"
            string prov=showPOIProvenance?" · "+z.qualityClass+(na(z.episodeId)?"":" · EP"+str.tostring(z.episodeId))+familyTag:""
            box.set_text(z.bx,visible?kind+prov:"")
            box.set_text_color(z.bx,c)
            box.set_text_size(z.bx,f_textSize())
            box.set_text_halign(z.bx,text.align_right)
            box.set_text_valign(z.bx,text.align_center)

        array.set(imbalanceZones,n,z)

//=============================================================================
// CAUSAL ORDER BLOCK / BREAKER BLOCK
//=============================================================================
bool bullOBEvent=false
bool bearOBEvent=false
bool bullBBEvent=false
bool bearBBEvent=false

bool bullOBTrigger=requirePrimaryStructuralFVG?newBullPrimaryStructuralFVG:(bullFVGEvent and bullCausal and bullStructureLinked)
bool bearOBTrigger=requirePrimaryStructuralFVG?newBearPrimaryStructuralFVG:(bearFVGEvent and bearCausal and bearStructureLinked)

if bullOBTrigger and not na(newBullPrimaryEpisodeId) and not f_hasOrderBlockForEpisode(newBullPrimaryEpisodeId,1)
    [originBar,zoneTop,zoneBottom]=f_findOBOrigin(newBullPrimaryEpisodeId,1)
    if not na(originBar) and not na(zoneTop) and not na(zoneBottom)
        string txt=showOBProvenance?"OB · EP"+str.tostring(newBullPrimaryEpisodeId)+" · "+newBullPrimaryKind:"OB"
        box bx=box.new(originBar,zoneTop,bar_index,zoneBottom,xloc=xloc.bar_index,extend=extend.none,bgcolor=color.new(bullOBColor,obTransparency),border_color=color.new(bullOBColor,20),text=txt,text_color=bullOBColor,text_size=f_textSize(),text_halign=text.align_right,text_valign=text.align_center)
        array.push(orderBlocks,OrderBlockZone.new(nextOrderBlockId,1,0,zoneTop,zoneBottom,originBar,bar_index,na,newBullPrimaryEpisodeId,newBullPrimaryFVGId,newBullPrimaryScore,newBullPrimaryScope,newBullPrimaryKind,0.0,bx))
        nextOrderBlockId+=1
        bullOBCount+=1
        bullOBEvent:=true
        f_trimOrderBlocks()

if bearOBTrigger and not na(newBearPrimaryEpisodeId) and not f_hasOrderBlockForEpisode(newBearPrimaryEpisodeId,-1)
    [originBar,zoneTop,zoneBottom]=f_findOBOrigin(newBearPrimaryEpisodeId,-1)
    if not na(originBar) and not na(zoneTop) and not na(zoneBottom)
        string txt=showOBProvenance?"OB · EP"+str.tostring(newBearPrimaryEpisodeId)+" · "+newBearPrimaryKind:"OB"
        box bx=box.new(originBar,zoneTop,bar_index,zoneBottom,xloc=xloc.bar_index,extend=extend.none,bgcolor=color.new(bearOBColor,obTransparency),border_color=color.new(bearOBColor,20),text=txt,text_color=bearOBColor,text_size=f_textSize(),text_halign=text.align_right,text_valign=text.align_center)
        array.push(orderBlocks,OrderBlockZone.new(nextOrderBlockId,-1,0,zoneTop,zoneBottom,originBar,bar_index,na,newBearPrimaryEpisodeId,newBearPrimaryFVGId,newBearPrimaryScore,newBearPrimaryScope,newBearPrimaryKind,0.0,bx))
        nextOrderBlockId+=1
        bearOBCount+=1
        bearOBEvent:=true
        f_trimOrderBlocks()

if array.size(orderBlocks)>0
    for n=0 to array.size(orderBlocks)-1
        OrderBlockZone z=array.get(orderBlocks,n)
        float zoneHeight=math.max(z.top-z.bottom,syminfo.mintick)

        if z.state==0
            float overlapTop=math.min(high,z.top)
            float overlapBottom=math.max(low,z.bottom)
            float overlap=math.max(overlapTop-overlapBottom,0.0)
            float mitigationPct=100.0*overlap/zoneHeight
            z.maxMitigationPct:=math.max(z.maxMitigationPct,mitigationPct)

            bool bullFailure=z.direction==1 and close<z.bottom
            bool bearFailure=z.direction==-1 and close>z.top
            bool breakerQualified=z.direction==1?(bullFailure and (not requireBreakerDisplacement or bearDisplacementEvent)):(bearFailure and (not requireBreakerDisplacement or bullDisplacementEvent))
            bool fullWickFill=z.direction==1?low<=z.bottom:high>=z.top

            if breakerQualified
                z.state:=1
                if z.direction==1
                    bearBBEvent:=true
                    bearBBCount+=1
                else
                    bullBBEvent:=true
                    bullBBCount+=1
            else if retireOBOnFullWickFill and fullWickFill
                z.state:=2
                z.terminalBar:=bar_index
                retiredOBBBCount+=1

        else if z.state==1
            bool bbBull=z.direction==-1
            bool invalidClose=bbBull?close<z.bottom:close>z.top
            bool fullTraverse=bbBull?low<=z.bottom:high>=z.top
            if invalidClose or (retireBBOnFullWickFill and fullTraverse)
                z.state:=2
                z.terminalBar:=bar_index
                retiredOBBBCount+=1

        bool active=z.state<2
        bool isOB=z.state==0
        bool isBB=z.state==1
        bool visualBull=isOB?z.direction==1:z.direction==-1
        color c=isBB?(visualBull?bullBBColor:bearBBColor):(visualBull?bullOBColor:bearOBColor)
        bool visible=active and ((isOB and showOBZones) or (isBB and showBBZones))

        if not na(z.bx)
            box.set_right(z.bx,active?bar_index:(na(z.terminalBar)?bar_index:z.terminalBar))
            box.set_bgcolor(z.bx,visible?color.new(c,obTransparency):color.new(c,100))
            box.set_border_color(z.bx,visible?color.new(c,20):color.new(c,100))
            string kind=isBB?"BB":"OB"
            string prov=showOBProvenance?" · EP"+str.tostring(z.episodeId)+" · FVG"+str.tostring(z.fvgId)+" · "+z.structureKind:""
            box.set_text(z.bx,visible?kind+prov:"")
            box.set_text_color(z.bx,c)
            box.set_text_size(z.bx,f_textSize())
            box.set_text_halign(z.bx,text.align_right)
            box.set_text_valign(z.bx,text.align_center)

        array.set(orderBlocks,n,z)

var string lastInternalEvent="NONE"
var string lastExternalEvent="NONE"
var int lastInternalEventBar=na
var int lastExternalEventBar=na
var line[] structureLines=array.new_line()
var label[] structureLabels=array.new_label()

f_structureKind(bool mss,bool choch) =>
    mss?"MSS":choch?"CHoCH":"BOS"

f_addStructureVisual(bool enabled,int swingTime,float price,string kind,bool bullish) =>
    if enabled and not na(swingTime) and not na(price)
        color c=bullish?bullStructureColor:bearStructureColor
        line ln=line.new(swingTime,price,time,price,xloc=xloc.bar_time,extend=extend.none,color=c,style=kind=="CHoCH"?line.style_dashed:line.style_solid,width=kind=="MSS"?2:1)
        label lb=label.new(swingTime+(time-swingTime)/2,price,kind,xloc=xloc.bar_time,style=label.style_none,textcolor=c,size=f_textSize())
        array.push(structureLines,ln)
        array.push(structureLabels,lb)
        while array.size(structureLines)>maxStructureEvents
            line.delete(array.shift(structureLines))
            label.delete(array.shift(structureLabels))

if iBullBreak
    string kind=f_structureKind(iBullMSS,iBullCH)
    f_addStructureVisual(showInternalStructure,iTargetHighTime,iTargetHigh,kind,true)
    lastInternalEvent:="BULL "+kind
    lastInternalEventBar:=bar_index
    iHighWaiting:=false
    iProtectedLow:=iLow
    iProtectedLowTime:=iLowTime
    iTrend:=1

if iBearBreak
    string kind=f_structureKind(iBearMSS,iBearCH)
    f_addStructureVisual(showInternalStructure,iTargetLowTime,iTargetLow,kind,false)
    lastInternalEvent:="BEAR "+kind
    lastInternalEventBar:=bar_index
    iLowWaiting:=false
    iProtectedHigh:=iHigh
    iProtectedHighTime:=iHighTime
    iTrend:=-1

if xBullBreak
    string kind=f_structureKind(xBullMSS,xBullCH)
    f_addStructureVisual(showExternalStructure,xTargetHighTime,xTargetHigh,kind,true)
    lastExternalEvent:="BULL "+kind
    lastExternalEventBar:=bar_index
    xHighWaiting:=false
    xProtectedLow:=xLow
    xProtectedLowTime:=xLowTime
    xTrend:=1

if xBearBreak
    string kind=f_structureKind(xBearMSS,xBearCH)
    f_addStructureVisual(showExternalStructure,xTargetLowTime,xTargetLow,kind,false)
    lastExternalEvent:="BEAR "+kind
    lastExternalEventBar:=bar_index
    xLowWaiting:=false
    xProtectedHigh:=xHigh
    xProtectedHighTime:=xHighTime
    xTrend:=-1

//=============================================================================
// PREVIOUS D/W/M LIQUIDITY
// Confirmed previous period values.
//=============================================================================
float pdH=request.security(syminfo.tickerid,"D",high[1],lookahead=barmerge.lookahead_on)
float pdL=request.security(syminfo.tickerid,"D",low[1],lookahead=barmerge.lookahead_on)
float pwH=request.security(syminfo.tickerid,"W",high[1],lookahead=barmerge.lookahead_on)
float pwL=request.security(syminfo.tickerid,"W",low[1],lookahead=barmerge.lookahead_on)
float pmH=request.security(syminfo.tickerid,"M",high[1],lookahead=barmerge.lookahead_on)
float pmL=request.security(syminfo.tickerid,"M",low[1],lookahead=barmerge.lookahead_on)

bool newD=ta.change(time("D"))!=0
bool newW=ta.change(time("W"))!=0
bool newM=ta.change(time("M"))!=0

if (barstate.isfirst or newD) and usePD
    liquiditySupersedeCount+=f_supersedeSource("PDH")
    liquiditySupersedeCount+=f_supersedeSource("PDL")
    if f_registerReference(nextLiquidityId,pdH,true,2,"PREVIOUS_DAY","PDH",bar_index,time)
        nextLiquidityId+=1
    if f_registerReference(nextLiquidityId,pdL,false,2,"PREVIOUS_DAY","PDL",bar_index,time)
        nextLiquidityId+=1

if (barstate.isfirst or newW) and usePW
    liquiditySupersedeCount+=f_supersedeSource("PWH")
    liquiditySupersedeCount+=f_supersedeSource("PWL")
    if f_registerReference(nextLiquidityId,pwH,true,1,"PREVIOUS_WEEK","PWH",bar_index,time)
        nextLiquidityId+=1
    if f_registerReference(nextLiquidityId,pwL,false,1,"PREVIOUS_WEEK","PWL",bar_index,time)
        nextLiquidityId+=1

if (barstate.isfirst or newM) and usePM
    liquiditySupersedeCount+=f_supersedeSource("PMH")
    liquiditySupersedeCount+=f_supersedeSource("PML")
    if f_registerReference(nextLiquidityId,pmH,true,1,"PREVIOUS_MONTH","PMH",bar_index,time)
        nextLiquidityId+=1
    if f_registerReference(nextLiquidityId,pmL,false,1,"PREVIOUS_MONTH","PML",bar_index,time)
        nextLiquidityId+=1

//=============================================================================
// LIQUIDITY LIFECYCLE / EVENTS
//=============================================================================
bool bullLiquiditySweep=false
bool bearLiquiditySweep=false
bool bullLiquidityResolution=false
bool bearLiquidityResolution=false
string latestSweepSource="NONE"
int latestSweepTier=na
float latestSweepPrice=na
string latestResolutionSource="NONE"
int latestResolutionTier=na
float latestResolutionPrice=na

if array.size(liquidity)>0
    for n=0 to array.size(liquidity)-1
        LiquidityLevel q=array.get(liquidity,n)

        if q.state==0
            bool expired=not na(q.expiryBar) and bar_index>q.expiryBar
            bool swept=barstate.isconfirmed and (q.buySide?(high>q.price and close<q.price):(low<q.price and close>q.price))
            bool resolved=barstate.isconfirmed and (q.buySide?close>q.price:close<q.price)

            if swept
                q.state:=1
                q.terminalBar:=bar_index
                q.endTime:=time
                latestSweepSource:=q.sourceName
                latestSweepTier:=q.tier
                latestSweepPrice:=q.price
                liquiditySweepCount+=1
                if q.buySide
                    bearLiquiditySweep:=true
                else
                    bullLiquiditySweep:=true
            else if resolved
                q.state:=2
                q.terminalBar:=bar_index
                q.endTime:=time
                latestResolutionSource:=q.sourceName
                latestResolutionTier:=q.tier
                latestResolutionPrice:=q.price
                liquidityResolutionCount+=1
                if q.buySide
                    bullLiquidityResolution:=true
                else
                    bearLiquidityResolution:=true
            else if expired
                q.state:=3
                q.terminalBar:=bar_index
                q.endTime:=time
                liquidityExpiryCount+=1

            array.set(liquidity,n,q)

        bool terminal=q.state!=0
        bool visibleState=q.state==0 or showTerminalLiquidity
        bool tierVisible=f_tierVisible(q.tier)
        bool modeVisible=modeFull or modeAnalysis or (modeExecution and q.tier<=2)
        bool visible=visibleState and tierVisible and modeVisible
        color base=f_tierColor(q.tier)
        color c=terminal?terminalColor:base
        int x2=terminal and not na(q.endTime)?q.endTime:time

        if not na(q.ln)
            line.set_xy2(q.ln,x2,q.price)
            line.set_color(q.ln,visible?c:f_hidden(c))
            line.set_style(q.ln,terminal?line.style_dashed:line.style_solid)

        if not na(q.lb)
            label.set_xy(q.lb,x2,q.price)
            string clusterText=q.clusterCount>=2?" · x"+str.tostring(q.clusterCount):""
            string tierText=modeFull?" · T"+str.tostring(q.tier):""
            string labelText=showLiquidityLabels and visible?q.sourceName+clusterText+tierText:""
            label.set_text(q.lb,labelText)
            label.set_textcolor(q.lb,c)

//=============================================================================
// DIAGNOSTIC COUNTS
//=============================================================================
int activeTier1=0
int activeTier2=0
int activeTier3=0
int activeTier4=0
int eqhCount=0
int eqlCount=0

if array.size(liquidity)>0
    for n=0 to array.size(liquidity)-1
        LiquidityLevel q=array.get(liquidity,n)
        if q.state==0
            if q.tier==1
                activeTier1+=1
            else if q.tier==2
                activeTier2+=1
            else if q.tier==3
                activeTier3+=1
            else
                activeTier4+=1
            if q.buySide and q.clusterCount>=2
                eqhCount+=1
            if not q.buySide and q.clusterCount>=2
                eqlCount+=1

int activePrimaryFVG=0
int activeSecondaryFVG=0
if array.size(imbalanceZones)>0
    for n=0 to array.size(imbalanceZones)-1
        ImbalanceZone z=array.get(imbalanceZones,n)
        if z.state<2
            if z.primary or na(z.episodeId)
                activePrimaryFVG+=1
            else
                activeSecondaryFVG+=1

int activeBullOB=0
int activeBearOB=0
int activeBullBB=0
int activeBearBB=0
if array.size(orderBlocks)>0
    for n=0 to array.size(orderBlocks)-1
        OrderBlockZone z=array.get(orderBlocks,n)
        if z.state==0
            if z.direction==1
                activeBullOB+=1
            else
                activeBearOB+=1
        else if z.state==1
            if z.direction==-1
                activeBullBB+=1
            else
                activeBearBB+=1

f_trendText(int t) =>
    t==1?"BULL":t==-1?"BEAR":"NEUTRAL"

f_priceText(float v) =>
    na(v)?"—":str.tostring(v,format.mintick)

var table diag=table.new(position.top_right,2,44,border_width=1)

if barstate.islast
    table.clear(diag,0,0,1,43)
    if showDiagnostics
        int r=0
        table.cell(diag,0,r,"ARTHA v2 P04")
        table.cell(diag,1,r,"CAUSAL OB / BB")
        r+=1
        table.cell(diag,0,r,"Internal trend")
        table.cell(diag,1,r,f_trendText(iTrend))
        r+=1
        table.cell(diag,0,r,"External trend")
        table.cell(diag,1,r,f_trendText(xTrend))
        r+=1
        table.cell(diag,0,r,"Internal event")
        table.cell(diag,1,r,lastInternalEvent)
        r+=1
        table.cell(diag,0,r,"External event")
        table.cell(diag,1,r,lastExternalEvent)
        r+=1
        table.cell(diag,0,r,"i Protected H/L")
        table.cell(diag,1,r,f_priceText(iProtectedHigh)+" / "+f_priceText(iProtectedLow))
        r+=1
        table.cell(diag,0,r,"x Protected H/L")
        table.cell(diag,1,r,f_priceText(xProtectedHigh)+" / "+f_priceText(xProtectedLow))
        r+=1
        table.cell(diag,0,r,"Active T1/T2")
        table.cell(diag,1,r,str.tostring(activeTier1)+" / "+str.tostring(activeTier2))
        r+=1
        table.cell(diag,0,r,"Active T3/T4")
        table.cell(diag,1,r,str.tostring(activeTier3)+" / "+str.tostring(activeTier4))
        r+=1
        table.cell(diag,0,r,"EQH / EQL")
        table.cell(diag,1,r,str.tostring(eqhCount)+" / "+str.tostring(eqlCount))
        r+=1
        table.cell(diag,0,r,"Last sweep")
        table.cell(diag,1,r,latestSweepSource+(na(latestSweepTier)?"":" · T"+str.tostring(latestSweepTier)))
        r+=1
        table.cell(diag,0,r,"Last resolution")
        table.cell(diag,1,r,latestResolutionSource+(na(latestResolutionTier)?"":" · T"+str.tostring(latestResolutionTier)))
        r+=1
        table.cell(diag,0,r,"Sweeps / Resolves")
        table.cell(diag,1,r,str.tostring(liquiditySweepCount)+" / "+str.tostring(liquidityResolutionCount))
        r+=1
        table.cell(diag,0,r,"Expired")
        table.cell(diag,1,r,str.tostring(liquidityExpiryCount))
        r+=1
        table.cell(diag,0,r,"Superseded")
        table.cell(diag,1,r,str.tostring(liquiditySupersedeCount))
        r+=1
        table.cell(diag,0,r,"Dup suppressions")
        table.cell(diag,1,r,str.tostring(duplicateSuppressions))
        r+=1
        table.cell(diag,0,r,"Body / ATR")
        table.cell(diag,1,r,str.tostring(displacementBodyATR,"#.00"))
        r+=1
        table.cell(diag,0,r,"Range / ATR")
        table.cell(diag,1,r,str.tostring(displacementRangeATR,"#.00"))
        r+=1
        table.cell(diag,0,r,"Body efficiency")
        table.cell(diag,1,r,str.tostring(displacementBodyPct*100,"#.0")+"%")
        r+=1
        table.cell(diag,0,r,"Body vs avg")
        table.cell(diag,1,r,na(bodyVsAvg)?"—":str.tostring(bodyVsAvg,"#.00")+"x")
        r+=1
        table.cell(diag,0,r,"Range vs avg")
        table.cell(diag,1,r,na(rangeVsAvg)?"—":str.tostring(rangeVsAvg,"#.00")+"x")
        r+=1
        table.cell(diag,0,r,"Bull/Bear DSP score")
        table.cell(diag,1,r,str.tostring(bullDisplacementScore)+" / "+str.tostring(bearDisplacementScore))
        r+=1
        table.cell(diag,0,r,"DSP events B/S")
        table.cell(diag,1,r,str.tostring(bullDisplacementCount)+" / "+str.tostring(bearDisplacementCount))
        r+=1
        table.cell(diag,0,r,"Last DSP score B/S")
        table.cell(diag,1,r,(na(lastBullDisplacementScore)?"—":str.tostring(lastBullDisplacementScore))+" / "+(na(lastBearDisplacementScore)?"—":str.tostring(lastBearDisplacementScore)))
        r+=1
        table.cell(diag,0,r,"Episode state")
        table.cell(diag,1,r,episodeActive?(episodeDirection==1?"BULL ACTIVE":"BEAR ACTIVE"):"IDLE")
        r+=1
        table.cell(diag,0,r,"Episode DSP count")
        table.cell(diag,1,r,episodeActive?str.tostring(episodeEventCount):"—")
        r+=1
        table.cell(diag,0,r,"Episode peak score")
        table.cell(diag,1,r,episodeActive and not na(episodePeakScore)?str.tostring(episodePeakScore):"—")
        r+=1
        table.cell(diag,0,r,"Completed episodes")
        table.cell(diag,1,r,str.tostring(completedEpisodeCount)+" · B "+str.tostring(bullEpisodeCount)+" / S "+str.tostring(bearEpisodeCount))
        r+=1
        table.cell(diag,0,r,"Last episode")
        table.cell(diag,1,r,lastCompletedEpisodeDirection==0?"—":(lastCompletedEpisodeDirection==1?"BULL ":"BEAR ")+str.tostring(lastCompletedEpisodePeakScore)+" · "+str.tostring(lastCompletedEpisodeBars)+" bars")
        r+=1
        table.cell(diag,0,r,"FVG B/S")
        table.cell(diag,1,r,str.tostring(bullFVGCount)+" / "+str.tostring(bearFVGCount))
        r+=1
        table.cell(diag,0,r,"IFVG B/S")
        table.cell(diag,1,r,str.tostring(bullIFVGCount)+" / "+str.tostring(bearIFVGCount))
        r+=1
        table.cell(diag,0,r,"FVG quality")
        table.cell(diag,1,r,"S "+str.tostring(structuralFVGCount)+" · D "+str.tostring(displacementFVGCount)+" · O "+str.tostring(ordinaryFVGCount))
        r+=1
        table.cell(diag,0,r,"Tracked imbalances")
        table.cell(diag,1,r,str.tostring(array.size(imbalanceZones)))
        r+=1
        table.cell(diag,0,r,"Active primary FVG")
        table.cell(diag,1,r,str.tostring(activePrimaryFVG))
        r+=1
        table.cell(diag,0,r,"Active secondary FVG")
        table.cell(diag,1,r,str.tostring(activeSecondaryFVG))
        r+=1
        table.cell(diag,0,r,"Retired imbalances")
        table.cell(diag,1,r,str.tostring(retiredImbalanceCount))
        r+=1
        table.cell(diag,0,r,"OB created B/S")
        table.cell(diag,1,r,str.tostring(bullOBCount)+" / "+str.tostring(bearOBCount))
        r+=1
        table.cell(diag,0,r,"Active OB B/S")
        table.cell(diag,1,r,str.tostring(activeBullOB)+" / "+str.tostring(activeBearOB))
        r+=1
        table.cell(diag,0,r,"Active BB B/S")
        table.cell(diag,1,r,str.tostring(activeBullBB)+" / "+str.tostring(activeBearBB))
        r+=1
        table.cell(diag,0,r,"BB transitions B/S")
        table.cell(diag,1,r,str.tostring(bullBBCount)+" / "+str.tostring(bearBBCount))
        r+=1
        table.cell(diag,0,r,"Retired OB/BB")
        table.cell(diag,1,r,str.tostring(retiredOBBBCount))

//=============================================================================
// ALERTS — ENGINE EVENTS ONLY, NOT TRADE SIGNALS
//=============================================================================
alertcondition(bullOBEvent,"ARTHA v2 Bullish OB","Qualified bullish causal Order Block created")
alertcondition(bearOBEvent,"ARTHA v2 Bearish OB","Qualified bearish causal Order Block created")
alertcondition(bullBBEvent,"ARTHA v2 Bullish Breaker","Qualified bullish Breaker Block transition")
alertcondition(bearBBEvent,"ARTHA v2 Bearish Breaker","Qualified bearish Breaker Block transition")
alertcondition(bullFVGEvent,"ARTHA v2 Bullish FVG","Confirmed bullish FVG created")
alertcondition(bearFVGEvent,"ARTHA v2 Bearish FVG","Confirmed bearish FVG created")
alertcondition(bullIFVGEvent,"ARTHA v2 Bullish IFVG","Confirmed bullish IFVG transition")
alertcondition(bearIFVGEvent,"ARTHA v2 Bearish IFVG","Confirmed bearish IFVG transition")
alertcondition(bullDisplacementEvent,"ARTHA v2 Bullish Displacement","Confirmed bullish displacement event")
alertcondition(bearDisplacementEvent,"ARTHA v2 Bearish Displacement","Confirmed bearish displacement event")
alertcondition(bullEpisodeCompleted,"ARTHA v2 Bullish Displacement Episode Complete","Confirmed bullish displacement episode completed")
alertcondition(bearEpisodeCompleted,"ARTHA v2 Bearish Displacement Episode Complete","Confirmed bearish displacement episode completed")
alertcondition(iBullBOS or xBullBOS,"ARTHA v2 Bullish BOS","Confirmed bullish BOS")
alertcondition(iBearBOS or xBearBOS,"ARTHA v2 Bearish BOS","Confirmed bearish BOS")
alertcondition(iBullCH or xBullCH,"ARTHA v2 Bullish CHoCH","Confirmed bullish CHoCH")
alertcondition(iBearCH or xBearCH,"ARTHA v2 Bearish CHoCH","Confirmed bearish CHoCH")
alertcondition(iBullMSS or xBullMSS,"ARTHA v2 Bullish MSS","Confirmed bullish MSS")
alertcondition(iBearMSS or xBearMSS,"ARTHA v2 Bearish MSS","Confirmed bearish MSS")
alertcondition(bullLiquiditySweep,"ARTHA v2 Bullish Liquidity Sweep","Confirmed sell-side liquidity sweep")
alertcondition(bearLiquiditySweep,"ARTHA v2 Bearish Liquidity Sweep","Confirmed buy-side liquidity sweep")
alertcondition(bullLiquidityResolution,"ARTHA v2 Bullish Liquidity Resolution","Confirmed bullish liquidity resolution")
alertcondition(bearLiquidityResolution,"ARTHA v2 Bearish Liquidity Resolution","Confirmed bearish liquidity resolution")
