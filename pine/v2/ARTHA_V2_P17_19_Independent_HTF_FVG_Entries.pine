//@version=6
indicator("ARTHA v2 P17.19 — Independent HTF FVG Entries", shorttitle="ARTHA v2 P17.19", overlay=true, max_lines_count=500, max_boxes_count=400, max_labels_count=500)

//=============================================================================
// ARTHA v2 — P17.12 LABEL STYLE, DASHBOARD & ARRAY GUARD
// Built from the current P17.10 source.
// Adds reference-inspired signal badges, configurable colors/EMA plots, a setup dashboard, and empty-array guard.
// Keeps confirmed-close causal behavior; does not use unfinished HTF values.
// Preserves setup/POI/risk architecture; fixes empty signalLabels reverse loop.
//=============================================================================

// Explicit history for dynamic episode-relative OB searches.
max_bars_back(time, 5000)
max_bars_back(open, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)

//=============================================================================
// 01 GLOBAL / DIAGNOSTICS
//=============================================================================
string G01="01 Global"
string displayMode=input.string("Execution","Display mode",options=["Execution","Analysis","Full"],group=G01)
string textSizeChoice=input.string("Small","Text size",options=["Tiny","Small","Normal"],group=G01)
string calibrationPreset=input.string("Default","Calibration preset",options=["Default","Indices","Gold","FX","Custom"],group=G01)

f_textSize() =>
    textSizeChoice=="Tiny"?size.tiny:textSizeChoice=="Normal"?size.normal:size.small

f_hidden(color c) =>
    color.new(c,100)

bool modeExecution=displayMode=="Execution"
bool modeAnalysis=displayMode=="Analysis"
bool modeFull=displayMode=="Full"

// Production contract:
// - displayMode and all show* inputs control rendering only;
// - engine calculations, setup state, scoring and signal admission run independently;
// - Execution mode is the production default; Analysis/Full are inspection modes.

//=============================================================================
// 02 STRUCTURE INPUTS
//=============================================================================
string G02="02 Structure"
int iLen=input.int(2,"Internal pivot strength",minval=1,maxval=20,group=G02)
int xLen=input.int(5,"External pivot strength",minval=2,maxval=50,group=G02)
bool requireClose=input.bool(true,"Require close through structure",group=G02)
bool showInternalStructure=input.bool(false,"Show internal structure",group=G02)
bool showExternalStructure=input.bool(true,"Show external structure",group=G02)
int maxStructureEvents=input.int(60,"Maximum structure visuals",minval=20,maxval=120,group=G02)
color bullStructureColor=input.color(color.lime,"Bull structure color",group=G02)
color bearStructureColor=input.color(color.red,"Bear structure color",group=G02)

//=============================================================================
// 03 LIQUIDITY INPUTS
//=============================================================================
string G03="03 Liquidity"
float customEqTolATR=input.float(0.10,"Custom · Swing clustering tolerance / ATR",minval=0.01,step=0.01,group=G03)
bool usePD=input.bool(true,"Previous day H/L",group=G03)
bool usePW=input.bool(true,"Previous week H/L",group=G03)
bool usePM=input.bool(true,"Previous month H/L",group=G03)
bool useExternalSwingLiquidity=input.bool(true,"External swing liquidity",group=G03)
bool useInternalSwingLiquidity=input.bool(true,"Internal swing liquidity",group=G03)
bool useSessionLiquidity=input.bool(true,"Include completed session highs / lows",group=G03)
string sessionTimeZone=input.string("America/New_York","Session timezone (IANA)",group=G03)
bool useAsiaSession=input.bool(true,"Asian session",group=G03)
string asiaSession=input.session("2000-0000","Asian session hours",group=G03)
bool useLondonSession=input.bool(true,"London session",group=G03)
string londonSession=input.session("0200-0500","London session hours",group=G03)
bool useNewYorkSession=input.bool(true,"New York session",group=G03)
string newYorkSession=input.session("0830-1200","New York session hours",group=G03)
int sessionLiquidityTier=input.int(2,"Completed session liquidity tier",minval=1,maxval=4,group=G03)
bool showTier1=input.bool(true,"Show Tier 1 liquidity",group=G03)
bool showTier2=input.bool(true,"Show Tier 2 liquidity",group=G03)
bool showTier3=input.bool(true,"Show Tier 3 liquidity",group=G03)
bool showTier4=input.bool(false,"Show Tier 4 liquidity",group=G03)
bool showLiquidityLabels=input.bool(true,"Show liquidity labels",group=G03)
bool showTerminalLiquidity=input.bool(false,"Keep swept/resolved liquidity visible",group=G03)
int internalSwingMaxAge=input.int(250,"Internal swing max age (bars)",minval=20,maxval=5000,group=G03)
int externalSwingMaxAge=input.int(1000,"External swing max age (bars)",minval=50,maxval=10000,group=G03)
int maxLiquidity=input.int(120,"Maximum liquidity records",minval=40,maxval=180,group=G03)
color tier1Color=input.color(color.orange,"Tier 1 color",group=G03)
color tier2Color=input.color(color.yellow,"Tier 2 color",group=G03)
color tier3Color=input.color(color.aqua,"Tier 3 color",group=G03)
color tier4Color=input.color(color.gray,"Tier 4 color",group=G03)
color terminalColor=input.color(color.gray,"Terminal liquidity color",group=G03)

//=============================================================================
// 03A MULTI-TIMEFRAME CONTEXT — CONFIRMED HTF SNAPSHOTS
//=============================================================================
string GMTF="03A Multi-Timeframe Context"
bool enableMTFContext=input.bool(true,"Enable confirmed higher-timeframe context",group=GMTF)
string mtfPOITimeframe=input.timeframe("60","POI source timeframe",group=GMTF)
