//=============================================================================
// 15 PERFORMANCE ATTRIBUTION
//=============================================================================
string G15="15 Performance Attribution"
bool enablePerformanceAttribution=input.bool(true,"Track performance attribution",group=G15)
bool showPerformanceTable=input.bool(false,"Show performance table",group=G15)
int performanceMinSample=input.int(3,"Minimum sample for win-rate display",minval=1,maxval=100,group=G15)

//=============================================================================
// ACTIVE CALIBRATION
//=============================================================================
bool presetDefault=calibrationPreset=="Default"
bool presetIndices=calibrationPreset=="Indices"
bool presetGold=calibrationPreset=="Gold"
bool presetFX=calibrationPreset=="FX"
bool presetCustom=calibrationPreset=="Custom"

// Default reproduces the validated production/P16 values exactly.
// Presets change thresholds only; causal definitions and state machines remain universal.
float eqTolATR=presetCustom?customEqTolATR:presetIndices?0.12:presetGold?0.12:presetFX?0.08:0.10

float minDispBodyATR=presetCustom?customMinDispBodyATR:presetIndices?0.65:presetGold?0.70:presetFX?0.50:0.60
float minDispRangeATR=presetCustom?customMinDispRangeATR:presetIndices?0.95:presetGold?1.00:presetFX?0.80:0.90
float minDispBodyPct=presetCustom?customMinDispBodyPct:presetIndices?0.55:presetGold?0.55:presetFX?0.50:0.55
float minDispCloseLoc=presetCustom?customMinDispCloseLoc:presetIndices?0.70:presetGold?0.72:presetFX?0.68:0.70
int minDisplacementScore=presetCustom?customMinDisplacementScore:presetIndices?62:presetGold?65:presetFX?55:60
float minBodyVsAvg=presetCustom?customMinBodyVsAvg:presetIndices?1.30:presetGold?1.35:presetFX?1.15:1.25
float minRangeVsAvg=presetCustom?customMinRangeVsAvg:presetIndices?1.15:presetGold?1.20:presetFX?1.05:1.10

float minFVGATR=presetCustom?customMinFVGATR:presetIndices?0.10:presetGold?0.12:presetFX?0.07:0.10

int revSweepToShiftBars=presetCustom?customRevSweepToShiftBars:presetIndices?10:presetGold?10:presetFX?14:12
int revShiftToPOIBars=presetCustom?customRevShiftToPOIBars:presetIndices?7:presetGold?6:presetFX?10:8
int revPOIToRetestBars=presetCustom?customRevPOIToRetestBars:presetIndices?24:presetGold?24:presetFX?36:30
int contImpulseToPOIBars=presetCustom?customContImpulseToPOIBars:presetIndices?7:presetGold?6:presetFX?10:8
int contPOIToRetestBars=presetCustom?customContPOIToRetestBars:presetIndices?24:presetGold?24:presetFX?36:30

int minREVSignalScore=presetCustom?customMinREVSignalScore:presetIndices?75:presetGold?78:presetFX?72:75
int minCONTSignalScore=presetCustom?customMinCONTSignalScore:presetIndices?75:presetGold?78:presetFX?72:75

float maxLiquidityTargetR=presetCustom?customMaxLiquidityTargetR:presetIndices?4.50:presetGold?4.00:presetFX?4.00:5.00
float minTargetSeparationATR=presetCustom?customMinTargetSeparationATR:presetIndices?0.20:presetGold?0.25:presetFX?0.15:0.20

float auditMinCloseLocation=presetCustom?customAuditMinCloseLocation:presetIndices?0.55:presetGold?0.57:presetFX?0.53:0.55
float auditMaxSweepBeyondATR=presetCustom?customAuditMaxSweepBeyondATR:presetIndices?0.40:presetGold?0.50:presetFX?0.30:0.35
int auditContextBars=presetCustom?customAuditContextBars:presetIndices?7:presetGold?6:presetFX?10:8
int earlySignalMinScore=presetCustom?customEarlySignalMinScore:presetIndices?68:presetGold?70:presetFX?62:65

//=============================================================================
// SHARED MEASUREMENTS
//=============================================================================
float atr=ta.atr(14)
float candleBody=math.abs(close-open)
float candleRange=math.max(high-low,syminfo.mintick)
float displacementBodyATR=atr>0?candleBody/atr:0.0
float displacementRangeATR=atr>0?candleRange/atr:0.0
float displacementBodyPct=candleBody/candleRange
float bullCloseLocation=(close-low)/candleRange
float bearCloseLocation=(high-close)/candleRange
float liquidityTolerance=atr*eqTolATR

float recentAvgBody=ta.sma(candleBody[1],relativeLookback)
float recentAvgRange=ta.sma(candleRange[1],relativeLookback)
float bodyVsAvg=not na(recentAvgBody) and recentAvgBody>0?candleBody/recentAvgBody:na
float rangeVsAvg=not na(recentAvgRange) and recentAvgRange>0?candleRange/recentAvgRange:na

bool bullDirectional=close>open
bool bearDirectional=close<open
bool bullPriorRangeClose=close>high[1]
bool bearPriorRangeClose=close<low[1]
bool bullFollowThrough=bullDirectional and close[1]>open[1] and bullPriorRangeClose
bool bearFollowThrough=bearDirectional and close[1]<open[1] and bearPriorRangeClose

float avgVolume=ta.sma(volume,volumeLookback)
float volumeRatio=not na(avgVolume) and avgVolume>0?volume/avgVolume:na
bool volumeExpanded=not na(volumeRatio) and volumeRatio>=volumeExpansionRatio

// Confirmed HTF values use the prior completed HTF bar to avoid unfinished-bar repainting.
float confirmedHTFFastEMA=request.security(syminfo.tickerid,trendTimeframe,ta.ema(close,trendFastEMALength)[1],lookahead=barmerge.lookahead_on)
float confirmedHTFSlowEMA=request.security(syminfo.tickerid,trendTimeframe,ta.ema(close,trendSlowEMALength)[1],lookahead=barmerge.lookahead_on)
bool confirmedHTFBull=not na(confirmedHTFFastEMA) and not na(confirmedHTFSlowEMA) and confirmedHTFFastEMA>confirmedHTFSlowEMA
bool confirmedHTFBear=not na(confirmedHTFFastEMA) and not na(confirmedHTFSlowEMA) and confirmedHTFFastEMA<confirmedHTFSlowEMA

// Confirmed swing structure bias. Pivots only become available after right-side bars confirm them.
float trendPivotHigh=ta.pivothigh(high,trendPivotStrength,trendPivotStrength)
float trendPivotLow=ta.pivotlow(low,trendPivotStrength,trendPivotStrength)
var float lastTrendSwingHigh=na
var float lastTrendSwingLow=na
var int confirmedStructureBias=0
if not na(trendPivotHigh)
    lastTrendSwingHigh:=trendPivotHigh
if not na(trendPivotLow)
    lastTrendSwingLow:=trendPivotLow
if barstate.isconfirmed
    if not na(lastTrendSwingHigh) and close>lastTrendSwingHigh and close[1]<=lastTrendSwingHigh
        confirmedStructureBias:=1
    else if not na(lastTrendSwingLow) and close<lastTrendSwingLow and close[1]>=lastTrendSwingLow
        confirmedStructureBias:=-1
bool trendBullAllowed=confirmedHTFBull and confirmedStructureBias==1
bool trendBearAllowed=confirmedHTFBear and confirmedStructureBias==-1
plot(showTrendEMAs?confirmedHTFFastEMA:na,title="Confirmed HTF Fast EMA",color=trendFastEMAColor,linewidth=2)
plot(showTrendEMAs?confirmedHTFSlowEMA:na,title="Confirmed HTF Slow EMA",color=trendSlowEMAColor,linewidth=2)

// Score curve deliberately does NOT award full points at the minimum threshold.
// At the minimum threshold a component earns 50% of its points; it reaches
// full points only at a materially stronger "excellent" target.
f_rampScore(float value,float floorValue,float targetValue,int points) =>
    if targetValue<=floorValue
        value>=floorValue?points:0
    else if value<floorValue
        0
    else
        float progress=math.min((value-floorValue)/(targetValue-floorValue),1.0)
        int(math.round(points*(0.50+0.50*progress)))

float bodyTarget=math.max(minDispBodyATR*1.75,minDispBodyATR+0.40)
float rangeTarget=math.max(minDispRangeATR*1.60,minDispRangeATR+0.50)
float bodyPctTarget=math.min(0.90,minDispBodyPct+0.25)
float closeLocTarget=math.min(0.98,minDispCloseLoc+0.20)
float bodyRelTarget=minBodyVsAvg+0.75
float rangeRelTarget=minRangeVsAvg+0.60

f_displacementScore(bool bullish) =>
    int score=0
    float closeLoc=bullish?bullCloseLocation:bearCloseLocation
    score+=f_rampScore(displacementBodyATR,minDispBodyATR,bodyTarget,25)
    score+=f_rampScore(displacementRangeATR,minDispRangeATR,rangeTarget,15)
    score+=f_rampScore(displacementBodyPct,minDispBodyPct,bodyPctTarget,15)
    score+=f_rampScore(closeLoc,minDispCloseLoc,closeLocTarget,15)
    score+=na(bodyVsAvg)?0:f_rampScore(bodyVsAvg,minBodyVsAvg,bodyRelTarget,15)
    score+=na(rangeVsAvg)?0:f_rampScore(rangeVsAvg,minRangeVsAvg,rangeRelTarget,10)
    bool follow=bullish?bullFollowThrough:bearFollowThrough
    if useFollowThrough and follow
        score+=5
    if useVolumeContext and volumeExpanded
        score+=5
    math.min(score,100)

int bullDisplacementScore=bullDirectional?f_displacementScore(true):0
int bearDisplacementScore=bearDirectional?f_displacementScore(false):0

f_displacementQualified(bool bullish) =>
    bool directional=bullish?bullDirectional:bearDirectional
    float closeLoc=bullish?bullCloseLocation:bearCloseLocation
    int score=bullish?bullDisplacementScore:bearDisplacementScore

    bool bodyOK=displacementBodyATR>=minDispBodyATR
    bool balancedRangeOK=displacementRangeATR>=minDispRangeATR*0.85
    bool rangeOK=displacementRangeATR>=minDispRangeATR
    bool efficiencyOK=displacementBodyPct>=minDispBodyPct
    bool closeOK=closeLoc>=minDispCloseLoc
    bool bodyRelativeOK=not na(bodyVsAvg) and bodyVsAvg>=minBodyVsAvg
    bool rangeRelativeOK=not na(rangeVsAvg) and rangeVsAvg>=minRangeVsAvg
    bool priorRangeOK=not requirePriorRangeClose or (bullish?bullPriorRangeClose:bearPriorRangeClose)

    bool strictBody=displacementBodyATR>=minDispBodyATR*1.20
    bool strictEfficiency=displacementBodyPct>=math.min(0.95,minDispBodyPct+0.05)
    bool strictClose=closeLoc>=math.min(0.99,minDispCloseLoc+0.05)
    bool strictBodyRelative=not na(bodyVsAvg) and bodyVsAvg>=minBodyVsAvg+0.15
    bool strictRangeRelative=not na(rangeVsAvg) and rangeVsAvg>=minRangeVsAvg+0.15
    int strictScoreFloor=math.max(minDisplacementScore,75)

    displacementMode=="Body only"?directional and bodyOK:
         displacementMode=="Strict"?directional and strictBody and rangeOK and strictEfficiency and strictClose and strictBodyRelative and strictRangeRelative and priorRangeOK and score>=strictScoreFloor:
         directional and bodyOK and balancedRangeOK and efficiencyOK and closeOK and bodyRelativeOK and rangeRelativeOK and priorRangeOK and score>=minDisplacementScore

//=============================================================================
// TYPES
//=============================================================================
type DisplacementEvent
    int id
    int direction          // +1 bull, -1 bear
    int bar
    int score
    float bodyATR
    float rangeATR
    float bodyPct
    float closeLocation
    bool followThrough
    bool volumeExpansion
    bool structureBreak
    string structureScope
    string structureKind

type DisplacementEpisode
    int id
    int direction          // +1 bull, -1 bear
    int startBar
    int endBar
    int peakBar
    int peakScore
    int eventCount
    float highPrice
    float lowPrice
    float totalBodyATR
    bool structureBreak
    string structureScope
    string structureKind

type ImbalanceZone
    int id
    int direction          // original FVG direction: +1 bull, -1 bear
    int state              // 0 ACTIVE FVG, 1 ACTIVE IFVG, 2 RETIRED
    float top
    float bottom
    int bornBar
    int terminalBar
    int episodeId
    int displacementScore
    bool structureLinked
    string structureScope
    string structureKind
    string qualityClass    // ORDINARY | DISPLACEMENT | STRUCTURAL
    bool primary
    int episodePeakBar
    float birthGapATR
    float maxMitigationPct
    box bx

type OrderBlockZone
    int id
    int direction          // original OB direction: +1 bull, -1 bear
    int state              // 0 ACTIVE OB, 1 ACTIVE BB, 2 RETIRED
    float top
    float bottom
    int originBar
    int originTime
    int bornBar
    int bornTime
    int terminalBar
    int terminalTime
    int episodeId
    int fvgId
    int displacementScore
    string structureScope
    string structureKind
    float maxMitigationPct
    box bx

type UnifiedPOI
    string sourceEngine      // IMBALANCE | ORDERBLOCK
    int sourceId             // stable native source ID
    string poiType           // FVG | IFVG | OB | BB
    int direction            // current actionable direction
    float top
    float bottom
    int bornBar
    int episodeId
    int parentFVGId
    bool primary
    int displacementScore
    bool structureLinked
    string structureScope
    string structureKind
    float mitigationPct

type LiquidityLevel
    int id
    float price
    bool buySide
    int tier
    int state              // 0 ACTIVE, 1 SWEPT, 2 RESOLVED, 3 EXPIRED, 4 SUPERSEDED
    int createdBar
    int terminalBar
    int expiryBar
    int startTime
    int endTime
    string sourceType
    string sourceName
    int originSwingBar
    int clusterCount
    line ln
    label lb


//=============================================================================
// DISPLACEMENT STATE
//=============================================================================
var array<DisplacementEvent> displacementEvents=array.new<DisplacementEvent>()
var int nextDisplacementId=1
var int bullDisplacementCount=0
var int bearDisplacementCount=0
var int lastBullDisplacementBar=na
var int lastBearDisplacementBar=na
var int lastBullDisplacementScore=na
var int lastBearDisplacementScore=na
var label[] displacementLabels=array.new_label()
var label[] episodeLabels=array.new_label()

// Episode registry and active episode state.
var array<DisplacementEpisode> displacementEpisodes=array.new<DisplacementEpisode>()
var int nextEpisodeId=1
var bool episodeActive=false
var int episodeId=na
var int episodeDirection=0
var int episodeStartBar=na
var int episodeLastDSPBar=na
var int episodePeakBar=na
var int episodePeakScore=na
var int episodeEventCount=0
var float episodeHigh=na
var float episodeLow=na
var float episodeTotalBodyATR=0.0
var bool episodeStructureBreak=false
var string episodeStructureScope="NONE"
var string episodeStructureKind="NONE"

var int completedEpisodeCount=0
var int bullEpisodeCount=0
var int bearEpisodeCount=0
var int lastCompletedEpisodeDirection=0
var int lastCompletedEpisodePeakScore=na
var int lastCompletedEpisodeBars=na

bool bullDisplacementEvent=barstate.isconfirmed and f_displacementQualified(true)
bool bearDisplacementEvent=barstate.isconfirmed and f_displacementQualified(false)

// FVG/IFVG registry. Lifecycle logic executes after episode aggregation so
// each new imbalance can capture the most relevant active/completed episode.
var array<ImbalanceZone> imbalanceZones=array.new<ImbalanceZone>()
var int nextImbalanceId=1
var int bullFVGCount=0
var int bearFVGCount=0
var int bullIFVGCount=0
var int bearIFVGCount=0
var int retiredImbalanceCount=0
var int structuralFVGCount=0
var int displacementFVGCount=0
var int ordinaryFVGCount=0
var int primaryFVGCount=0
var int secondaryFVGCount=0

f_episodePeakBar(int epId) =>
    int peak=na
    if episodeActive and episodeId==epId
        peak:=episodePeakBar
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.id==epId
                peak:=ep.peakBar
                break
    peak

f_primaryCandidateBetter(int newBornBar,float newGapATR,int oldBornBar,float oldGapATR,int peakBar) =>
    int newDistance=na(peakBar)?999999:math.abs(newBornBar-peakBar)
    int oldDistance=na(peakBar)?999999:math.abs(oldBornBar-peakBar)
    newDistance<oldDistance or (newDistance==oldDistance and newGapATR>oldGapATR)

f_assignPrimaryForEpisode(int newIndex,int epId,int dir) =>
    bool newPrimary=true
    if not na(epId) and array.size(imbalanceZones)>0
        ImbalanceZone newZone=array.get(imbalanceZones,newIndex)
        for n=0 to array.size(imbalanceZones)-1
            if n!=newIndex
                ImbalanceZone old=array.get(imbalanceZones,n)
                if old.episodeId==epId and old.direction==dir and old.primary
                    bool replace=f_primaryCandidateBetter(newZone.bornBar,newZone.birthGapATR,old.bornBar,old.birthGapATR,newZone.episodePeakBar)
                    if replace
                        old.primary:=false
                        array.set(imbalanceZones,n,old)
                    else
                        newPrimary:=false
                    break
        newZone.primary:=newPrimary
        array.set(imbalanceZones,newIndex,newZone)
    newPrimary

f_deleteImbalance(ImbalanceZone z) =>
    if not na(z.bx)
        box.delete(z.bx)

f_trimImbalances() =>
    while array.size(imbalanceZones)>maxImbalanceZones
        ImbalanceZone old=array.shift(imbalanceZones)
        f_deleteImbalance(old)

//=============================================================================
// ORDER BLOCK / BREAKER STATE + HELPERS
//=============================================================================
var array<OrderBlockZone> orderBlocks=array.new<OrderBlockZone>()
var int nextOrderBlockId=1
var int bullOBCount=0
var int bearOBCount=0
var int bullBBCount=0
var int bearBBCount=0
var int retiredOBBBCount=0

f_deleteOrderBlock(OrderBlockZone z) =>
    if not na(z.bx)
        box.delete(z.bx)

f_trimOrderBlocks() =>
    while array.size(orderBlocks)>maxOrderBlocks
        OrderBlockZone old=array.shift(orderBlocks)
        f_deleteOrderBlock(old)

f_hasOrderBlockForEpisode(int epId,int dir) =>
    bool found=false
    if not na(epId) and array.size(orderBlocks)>0
        for n=0 to array.size(orderBlocks)-1
            OrderBlockZone z=array.get(orderBlocks,n)
            if z.episodeId==epId and z.direction==dir
                found:=true
                break
    found

f_episodeStartBar(int epId) =>
    int start=na
    if episodeActive and episodeId==epId
        start:=episodeStartBar
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.id==epId
                start:=ep.startBar
                break
    start

f_findOBOrigin(int epId,int dir) =>
    int originBar=na
    int originTime=na
    float zoneTop=na
    float zoneBottom=na
    int epStart=f_episodeStartBar(epId)
    if not na(epStart)
        int startOffset=bar_index-epStart
        int firstOffset=startOffset+1
        int lastOffset=math.min(startOffset+obSearchBars,4999)
        if firstOffset<=lastOffset
            for j=firstOffset to lastOffset
                if j>=1 and j<=bar_index
                    bool opposite=dir==1?close[j]<open[j]:close[j]>open[j]
                    if opposite
                        originBar:=bar_index-j
                        originTime:=time[j]
                        if obBodyOnly
                            zoneTop:=math.max(open[j],close[j])
                            zoneBottom:=math.min(open[j],close[j])
                        else
                            zoneTop:=high[j]
                            zoneBottom:=low[j]
                        break
    [originBar,originTime,zoneTop,zoneBottom]

//=============================================================================
// UNIFIED POI REGISTRY
// Rebuilt from native source registries each bar. Native IDs remain stable.
//=============================================================================
var array<UnifiedPOI> unifiedPOIs=array.new<UnifiedPOI>()

f_rebuildUnifiedPOIs() =>
    array.clear(unifiedPOIs)

    if array.size(imbalanceZones)>0
        for n=0 to array.size(imbalanceZones)-1
            ImbalanceZone z=array.get(imbalanceZones,n)
            if z.state<2
                bool isFVG=z.state==0
                bool currentBull=isFVG?z.direction==1:z.direction==-1
                int currentDir=currentBull?1:-1
                string currentType=isFVG?"FVG":"IFVG"
                bool typeAllowed=(isFVG and poiIncludeFVG) or (not isFVG and poiIncludeIFVG)
                bool familyAllowed=z.primary or poiIncludeSecondaryFVG or na(z.episodeId)
                if typeAllowed and familyAllowed
                    array.push(unifiedPOIs,UnifiedPOI.new(
                         "IMBALANCE",z.id,currentType,currentDir,z.top,z.bottom,z.bornBar,
                         z.episodeId,na,z.primary,z.displacementScore,z.structureLinked,
                         z.structureScope,z.structureKind,z.maxMitigationPct))

    if array.size(orderBlocks)>0
        for n=0 to array.size(orderBlocks)-1
            OrderBlockZone z=array.get(orderBlocks,n)
            if z.state<2
                bool isOB=z.state==0
                bool currentBull=isOB?z.direction==1:z.direction==-1
                int currentDir=currentBull?1:-1
                string currentType=isOB?"OB":"BB"
                bool typeAllowed=(isOB and poiIncludeOB) or (not isOB and poiIncludeBB)
                if typeAllowed
                    array.push(unifiedPOIs,UnifiedPOI.new(
                         "ORDERBLOCK",z.id,currentType,currentDir,z.top,z.bottom,z.bornBar,
                         z.episodeId,z.fvgId,true,z.displacementScore,true,
                         z.structureScope,z.structureKind,z.maxMitigationPct))

f_nearestPOIIndex(int dir) =>
    int found=-1
    float bestDistance=na
    if array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            if p.direction==dir
                float d=close>p.top?close-p.top:close<p.bottom?p.bottom-close:0.0
                if na(bestDistance) or d<bestDistance
                    bestDistance:=d
                    found:=n
    found

f_findUnifiedPOIByKey(string sourceEngine,int sourceId) =>
    int found=-1
    if array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            if p.sourceEngine==sourceEngine and p.sourceId==sourceId
                found:=n
                break
    found

f_auditCloseConfirmed(int dir,float top,float bottom,string klass) =>
    float mid=(top+bottom)*0.5
    float loc=(close-low)/math.max(high-low,syminfo.mintick)
    bool directional=dir==1?(close>open and loc>=auditMinCloseLocation):(close<open and loc<=1.0-auditMinCloseLocation)
    bool midpoint=dir==1?close>=mid:close<=mid
    bool anyValid=dir==1?close>=bottom:close<=top
    bool standard=auditConfirmationMode=="Directional Close"?directional:auditConfirmationMode=="Midpoint Reclaim"?midpoint:anyValid
    bool sweepClose=dir==1?close>=bottom:close<=top
    klass=="SWEEP_RECLAIM"?(sweepClose and standard):standard

f_findREVPOI(int epId,int dir) =>
    int found=-1
    float bestDistance=na
    int bestClass=999

    if not na(epId) and array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            if p.episodeId==epId and p.direction==dir and p.primary
                bool isOBFamily=p.poiType=="OB" or p.poiType=="BB"
                int classRank=revPOIPreference=="OB/BB first"?(isOBFamily?0:1):revPOIPreference=="FVG/IFVG first"?(isOBFamily?1:0):0
                float d=close>p.top?close-p.top:close<p.bottom?p.bottom-close:0.0

                bool better=false
                if revPOIPreference=="Nearest"
                    better:=na(bestDistance) or d<bestDistance
                else
                    better:=classRank<bestClass or (classRank==bestClass and (na(bestDistance) or d<bestDistance))

                if better
                    found:=n
                    bestDistance:=d
                    bestClass:=classRank
    found

f_findCONTPOI(int epId,int dir) =>
    int found=-1
    float bestDistance=na
    int bestClass=999

    if not na(epId) and array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            if p.episodeId==epId and p.direction==dir and p.primary
                bool isOBFamily=p.poiType=="OB" or p.poiType=="BB"
                int classRank=contPOIPreference=="OB/BB first"?(isOBFamily?0:1):contPOIPreference=="FVG/IFVG first"?(isOBFamily?1:0):0
                float d=close>p.top?close-p.top:close<p.bottom?p.bottom-close:0.0

                bool better=false
                if contPOIPreference=="Nearest"
                    better:=na(bestDistance) or d<bestDistance
                else
                    better:=classRank<bestClass or (classRank==bestClass and (na(bestDistance) or d<bestDistance))

                if better
                    found:=n
                    bestDistance:=d
                    bestClass:=classRank
    found

f_episodeQualityScore(int epId) =>
    int found=na
    if episodeActive and episodeId==epId
        found:=episodePeakScore
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.id==epId
                found:=ep.peakScore
                break
    found

f_qualityGrade(int score) =>
    score>=qualityGradeA?"A":score>=qualityGradeB?"B":score>=qualityGradeC?"C":"D"

f_displacementQualityPoints(int epId) =>
    int raw=f_episodeQualityScore(epId)
    na(raw)?0:int(math.round(math.min(math.max(raw,0),100)*0.30))

f_structureQualityPoints(string family,string scope,string kind) =>
    int pts=0
    if family=="REV"
        pts:=scope=="EXTERNAL"?(kind=="MSS"?20:kind=="CHoCH"?18:12):(kind=="MSS"?15:kind=="CHoCH"?13:8)
    else
        pts:=scope=="EXTERNAL"?20:scope=="INTERNAL"?15:10
    pts

f_poiQualityPoints(UnifiedPOI p) =>
    int pts=p.poiType=="OB" or p.poiType=="BB"?20:p.poiType=="IFVG"?16:14
    if (p.poiType=="FVG" or p.poiType=="IFVG") and p.structureLinked
        pts+=p.poiType=="FVG"?4:2
    math.min(pts,20)

f_mitigationQualityPoints(float pct) =>
    na(pct)?0:pct<=25?15:pct<=50?13:pct<=75?9:pct<100?5:0

f_revContextPoints(int tier) =>
    na(tier)?0:tier==1?15:tier==2?12:tier==3?8:4

type SignalRecord
    string family
    int direction
    int episodeId
    string poiEngine
    int poiId
    int bar
    int score
    string source
    int priority

var array<SignalRecord> signalHistory=array.new<SignalRecord>()
var label[] signalLabels=array.new_label()
var int bullSignalCount=0
var int bearSignalCount=0
var int revSignalCount=0
var int contSignalCount=0
var int signalRejectedQuality=0
var int signalRejectedDuplicate=0
var int signalRejectedConflict=0
var int lastBullSignalBar=na
var int lastBearSignalBar=na
var int lastBullSignalPriority=0
var int lastBearSignalPriority=0
var string lastBullSignalSource="NONE"
var string lastBearSignalSource="NONE"
var string lastSignalText="NONE"

f_signalDuplicate(string family,int epId,string poiEngine,int poiId) =>
    bool duplicate=false
    if oneSignalPerEpisodePOI and array.size(signalHistory)>0
        for n=array.size(signalHistory)-1 to 0
            SignalRecord sr=array.get(signalHistory,n)
            if sr.family==family and sr.episodeId==epId and sr.poiEngine==poiEngine and sr.poiId==poiId
                duplicate:=true
                break
    duplicate

f_signalAdmissionOK(int dir,int priority) =>
    int lastBar=dir==1?lastBullSignalBar:lastBearSignalBar
    int lastPriority=dir==1?lastBullSignalPriority:lastBearSignalPriority
    bool outsideWindow=na(lastBar) or bar_index-lastBar>signalConflictBars
    outsideWindow or priority>lastPriority

f_signalEntryMarker(int dir,string family,int score,string grade) =>
    label result=na
    if showSignalMarkers
        float y=dir==1?low:high
        color bg=color.new(dir==1?bullSignalColor:bearSignalColor,signalLabelTransparency)
        color tc=dir==1?bullSignalTextColor:bearSignalTextColor
        string emoji=signalLabelEmoji?(dir==1?" 🟢":" 🔴"):""
        if modeExecution and showCompactExecutionEntries
            string compact=(dir==1?"▲ ":"▼ ")+(family=="REV"?"R":"C")+emoji
            result:=label.new(bar_index,y,compact,style=signalLabelStyle=="Badge"?(dir==1?label.style_label_up:label.style_label_down):label.style_none,color=bg,textcolor=signalLabelStyle=="Badge"?tc:(dir==1?bullSignalColor:bearSignalColor),size=size.small)
        else
            string verbose=(dir==1?"BUY ":"SELL ")+family+" · Q"+str.tostring(score)+" "+grade+emoji
            result:=label.new(bar_index,y,verbose,style=signalLabelStyle=="Badge"?(dir==1?label.style_label_up:label.style_label_down):label.style_none,color=bg,textcolor=signalLabelStyle=="Badge"?tc:(dir==1?bullSignalColor:bearSignalColor),size=f_textSize())
    result

f_signalScoreForPlan(string family,int epId,string poiEngine,int poiId) =>
    int result=na
    if array.size(signalHistory)>0
        for n=array.size(signalHistory)-1 to 0
            SignalRecord sr=array.get(signalHistory,n)
            if sr.family==family and sr.episodeId==epId and sr.poiEngine==poiEngine and sr.poiId==poiId
                result:=sr.score
                break
    result

type RiskPlan
    int id
    string family
    string source
    int direction
    int episodeId
    string poiEngine
    int poiId
    int signalBar
    int signalTime
    int score
    string grade
    float entry
    float stop
    float target1
    float target2
    float target3
    float target4
    float rr1
    float rr2
    float rr3
    float rr4
    string target1Source
    string target2Source
    int stage              // 0 none, 1 T1, 2 T2, 3 T3, 4 T4
    float remainingSize     // Fraction of original simulated position still open
    int state              // 0 ACTIVE, 1 PARTIAL, 2 FINAL_TP, 3 STOPPED, 4 legacy EXPIRED
    int terminalTime
    bool outcomeRecorded
    float realizedR
    string outcome
    label signalMarker
    line entryLine
    line stopLine
    line target1Line
    line target2Line
    line target3Line
    line target4Line
    label target3Tag
    label target4Tag
    box riskBox
    box rewardBox
    label entryTag
    label stopTag
    label target1Tag
    label target2Tag
    label statusTag

var array<RiskPlan> riskPlans=array.new<RiskPlan>()
var int nextRiskPlanId=1
var int riskPlanCount=0
var float lastPlanEntry=na
var float lastPlanStop=na
var float lastPlanT1=na
var float lastPlanT2=na
var float lastPlanRR1=na
var float lastPlanRR2=na
var string lastPlanText="NONE"

var int completedTradeCount=0
var int stoppedTradeCount=0
var int expiredTradeCount=0
var int t1ReachedCount=0
var int t2ReachedCount=0
var float totalRealizedR=0.0
var float revRealizedR=0.0
var float contRealizedR=0.0
var int revClosedCount=0
var int contClosedCount=0
var int revWinCount=0
var int contWinCount=0
var int revLossCount=0
var int contLossCount=0
var string lastOutcomeText="NONE"

// P16 attribution buckets.
// First six: family × source. Last four: quality grade.
var array<string> perfKeys=array.from("REV_NORMAL","REV_MISS","REV_EARLY","CONT_NORMAL","CONT_MISS","CONT_EARLY","GRADE_A","GRADE_B","GRADE_C","GRADE_D","REV_HTF_POI","CONT_HTF_POI")
var array<string> perfLabels=array.from("REV · NORMAL","REV · MISS","REV · EARLY","CONT · NORMAL","CONT · MISS","CONT · EARLY","Grade A","Grade B","Grade C","Grade D","REV · HTF POI","CONT · HTF POI")
var array<int> perfClosed=array.new_int(12,0)
var array<int> perfWins=array.new_int(12,0)
var array<int> perfLosses=array.new_int(12,0)
var array<float> perfRealizedR=array.new_float(12,0.0)

f_perfRecord(string key,float realizedR) =>
    if enablePerformanceAttribution and not na(realizedR)
        int idx=array.indexof(perfKeys,key)
        if idx>=0
            array.set(perfClosed,idx,array.get(perfClosed,idx)+1)
            array.set(perfRealizedR,idx,array.get(perfRealizedR,idx)+realizedR)
            if realizedR>0
                array.set(perfWins,idx,array.get(perfWins,idx)+1)
            else
                array.set(perfLosses,idx,array.get(perfLosses,idx)+1)

f_perfPct(int wins,int closed) =>
    closed>0?wins*100.0/closed:na

f_perfAvgR(float totalR,int closed) =>
    closed>0?totalR/closed:na

var table performanceTable=table.new(position.top_right,7,14,border_width=1)

f_renderPerformanceTable() =>
    if showPerformanceTable
        table.cell(performanceTable,0,0,"ARTHA P17 · "+calibrationPreset,text_color=color.white)
        table.cell(performanceTable,1,0,"Closed",text_color=color.white)
        table.cell(performanceTable,2,0,"Wins",text_color=color.white)
        table.cell(performanceTable,3,0,"Loss",text_color=color.white)
        table.cell(performanceTable,4,0,"Win %",text_color=color.white)
        table.cell(performanceTable,5,0,"Total R",text_color=color.white)
        table.cell(performanceTable,6,0,"Avg R",text_color=color.white)
        for i=0 to array.size(perfKeys)-1
            int row=i+1
            int closed=array.get(perfClosed,i)
            int wins=array.get(perfWins,i)
            int losses=array.get(perfLosses,i)
            float totalR=array.get(perfRealizedR,i)
            float winPct=f_perfPct(wins,closed)
            float avgR=f_perfAvgR(totalR,closed)
            string winText=closed>=performanceMinSample and not na(winPct)?str.tostring(winPct,"#.0")+"%":"—"
            string avgText=not na(avgR)?str.tostring(avgR,"#.00")+"R":"—"
            table.cell(performanceTable,0,row,array.get(perfLabels,i))
            table.cell(performanceTable,1,row,str.tostring(closed))
            table.cell(performanceTable,2,row,str.tostring(wins))
            table.cell(performanceTable,3,row,str.tostring(losses))
            table.cell(performanceTable,4,row,winText)
            table.cell(performanceTable,5,row,str.tostring(totalR,"#.00")+"R")
            table.cell(performanceTable,6,row,avgText)
    else
        table.clear(performanceTable,0,0,6,13)

var label[] recentEntryResultLabels=array.new_label()
var int[] recentEntryResultIds=array.new_int()

f_recentEntryText(string family,string source,int dir,int score,float entry,string status,float realizedR) =>
    string grade=na(score)?"":f_qualityGrade(score)
    string scoreText=na(score)?"":" · Q"+str.tostring(score)+" "+grade
    string sourceText=source=="NORMAL"?"":" · "+source
    string rText=na(realizedR)?"":" · "+(realizedR>0?"+":"")+str.tostring(realizedR,"#.00")+"R"
    family+" "+(dir==1?"BUY":"SELL")+sourceText+scoreText+"\nENTRY "+str.tostring(entry,format.mintick)+"\n"+status+rText

f_recentTerminalText(string family,string source,int dir,int score,string status,float realizedR) =>
    string grade=na(score)?"":f_qualityGrade(score)
    string scoreText=na(score)?"":" · Q"+str.tostring(score)+" "+grade
    string sourceText=source=="NORMAL"?"":" · "+source
    string rText=na(realizedR)?"":" · "+(realizedR>0?"+":"")+str.tostring(realizedR,"#.00")+"R"
    family+" "+(dir==1?"BUY":"SELL")+sourceText+scoreText+"\n"+status+rText

f_addRecentEntryCard(int planId,string family,string source,int dir,int epId,string poiEngine,int poiId,int signalTime,float entry) =>
    if showRecentEntryResults
        int score=f_signalScoreForPlan(family,epId,poiEngine,poiId)
        string txt=f_recentEntryText(family,source,dir,score,entry,"ACTIVE",na)
        color bg=dir==1?bullSignalColor:bearSignalColor
        label lb=label.new(signalTime,entry,txt,xloc=xloc.bar_time,style=dir==1?label.style_label_up:label.style_label_down,color=color.new(bg,15),textcolor=color.white,size=size.small)
        array.push(recentEntryResultIds,planId)
        array.push(recentEntryResultLabels,lb)
        while array.size(recentEntryResultLabels)>recentEntryResultCount
            array.shift(recentEntryResultIds)
            label.delete(array.shift(recentEntryResultLabels))

f_updateRecentEntryCard(int planId,string family,string source,int dir,int epId,string poiEngine,int poiId,float entry,string status,float realizedR) =>
    if showRecentEntryResults and array.size(recentEntryResultIds)>0
        int found=-1
        for n=0 to array.size(recentEntryResultIds)-1
            if array.get(recentEntryResultIds,n)==planId
                found:=n
                break
        if found>=0
            label lb=array.get(recentEntryResultLabels,found)
            int score=f_signalScoreForPlan(family,epId,poiEngine,poiId)
            bool terminal=status=="T2 HIT" or status=="STOPPED" or status=="EXPIRED"
            string txt=terminal?f_recentTerminalText(family,source,dir,score,status,realizedR):f_recentEntryText(family,source,dir,score,entry,status,realizedR)
            label.set_text(lb,txt)
            color bg=dir==1?bullSignalColor:bearSignalColor
            label.set_color(lb,color.new(bg,15))
            label.set_textcolor(lb,color.white)

f_planStop(string family,int dir,float entryPrice,float poiTop,float poiBottom,float sweepPrice,float protectedLevel) =>
    float buffer=atr*stopBufferATR
    float poiEdge=dir==1?poiBottom:poiTop
    float causalBase=na
    if family=="REV"
        causalBase:=dir==1?(na(sweepPrice)?poiEdge:math.min(sweepPrice,poiEdge)):(na(sweepPrice)?poiEdge:math.max(sweepPrice,poiEdge))
    else
        causalBase:=na(protectedLevel)?poiEdge:(dir==1?math.min(protectedLevel,poiEdge):math.max(protectedLevel,poiEdge))

    float base=riskStopMode=="POI edge"?poiEdge:riskStopMode=="Protected swing"?(na(protectedLevel)?poiEdge:protectedLevel):causalBase
    float result=dir==1?base-buffer:base+buffer

    // Guarantee stop remains on the risk side of entry.
    if dir==1 and (na(result) or result>=entryPrice)
        result:=entryPrice-math.max(atr*0.50,syminfo.mintick)
    if dir==-1 and (na(result) or result<=entryPrice)
        result:=entryPrice+math.max(atr*0.50,syminfo.mintick)
    result

//=============================================================================
// CONFIRMED MTF FVG AND SWING SNAPSHOTS
// A single HTF FVG is retained per source; all outputs are offset by one
// completed source bar before merging onto the execution chart.
//=============================================================================
f_mtfFVGState() =>
    var float zoneTop=na
    var float zoneBottom=na
    var int direction=0
    var int originTime=na
    bool bullishGap=low>high[2]
    bool bearishGap=high<low[2]
    if bullishGap
        zoneTop:=low
        zoneBottom:=high[2]
        direction:=1
        originTime:=time
    else if bearishGap
        zoneTop:=low[2]
        zoneBottom:=high
        direction:=-1
        originTime:=time
    else if direction==1 and close<zoneBottom
        direction:=0
        zoneTop:=na
        zoneBottom:=na
        originTime:=na
    else if direction==-1 and close>zoneTop
        direction:=0
        zoneTop:=na
        zoneBottom:=na
        originTime:=na
    [direction,zoneTop,zoneBottom,originTime]

f_confirmedMTFFVG() =>
    [d,t,b,origin]=f_mtfFVGState()
    [d[1],t[1],b[1],origin[1]]

f_confirmedMTFSwings() =>
    float ph=ta.pivothigh(high,xLen,xLen)
    float pl=ta.pivotlow(low,xLen,xLen)
    float lastH=ta.valuewhen(not na(ph),ph,0)
    float lastL=ta.valuewhen(not na(pl),pl,0)
    [lastH[1],lastL[1]]

bool mtfPOIValidTF=timeframe.in_seconds(mtfPOITimeframe)>timeframe.in_seconds(timeframe.period)
bool mtfTargetValidTF=timeframe.in_seconds(mtfTargetTimeframe)>timeframe.in_seconds(timeframe.period)
[mtfFVGDir,mtfFVGTop,mtfFVGBottom,mtfFVGOrigin]=request.security(syminfo.tickerid,mtfPOITimeframe,f_confirmedMTFFVG(),lookahead=barmerge.lookahead_on)
[mtf15Dir,mtf15Top,mtf15Bottom,mtf15Origin]=request.security(syminfo.tickerid,"15",f_confirmedMTFFVG(),lookahead=barmerge.lookahead_on)
[mtf60Dir,mtf60Top,mtf60Bottom,mtf60Origin]=request.security(syminfo.tickerid,"60",f_confirmedMTFFVG(),lookahead=barmerge.lookahead_on)
[mtfSwingHigh,mtfSwingLow]=request.security(syminfo.tickerid,mtfTargetTimeframe,f_confirmedMTFSwings(),lookahead=barmerge.lookahead_on)
bool mtfPOIEnabled=enableMTFContext and mtfPOIValidTF
bool mtfTargetEnabled=enableMTFContext and mtfTargetValidTF and includeHTFTargets
bool mtfBullZone=mtfPOIEnabled and mtfFVGDir==1 and not na(mtfFVGTop) and not na(mtfFVGBottom)
bool mtfBearZone=mtfPOIEnabled and mtfFVGDir==-1 and not na(mtfFVGTop) and not na(mtfFVGBottom)
// Confirmed HTF zones are visualized with bounded rectangles, not stepped plots.
// The left edge is back-anchored to the HTF candle that formed the FVG, while
// the *calculations* only become available after that source candle closes.
// Historical placement is a provenance visual, NOT permission for earlier entries.
// Display switches do not change signal admission, HTF context, or targets.
f_renderHTFBox(box activeBox,int priorOrigin,array<box> history,int direction,float zoneTop,float zoneBottom,int origin,bool visible,string sourceTag) =>
    box result=activeBox
    int activeOrigin=priorOrigin
    bool usable=visible and direction!=0 and not na(origin) and not na(zoneTop) and not na(zoneBottom)
    if usable
        bool newZone=na(result) or activeOrigin!=origin or box.get_top(result)!=zoneTop or box.get_bottom(result)!=zoneBottom
        if newZone
            color c=direction==1?htfBullZoneColor:htfBearZoneColor
            result:=box.new(left=origin,top=zoneTop,right=time,bottom=zoneBottom,xloc=xloc.bar_time,extend=extend.none,bgcolor=color.new(c,htfFVGZoneTransparency),border_color=color.new(c,30),text=sourceTag+" FVG",text_color=c,text_size=size.tiny,text_halign=text.align_right,text_valign=text.align_center)
            activeOrigin:=origin
            array.push(history,result)
            while array.size(history)>maxHTFZoneBoxes
                box old=array.shift(history)
                box.delete(old)
        else
            box.set_right(result,time)
    else
        result:=na
        activeOrigin:=na
    [result,activeOrigin]

bool valid15=timeframe.in_seconds(timeframe.period)<timeframe.in_seconds("15")
bool valid60=timeframe.in_seconds(timeframe.period)<timeframe.in_seconds("60")
bool customTF=mtfPOITimeframe!="15" and mtfPOITimeframe!="60"
var array<box> mtf15History=array.new_box()
var array<box> mtf60History=array.new_box()
var array<box> mtfCustomHistory=array.new_box()
var box mtf15Active=na
var box mtf60Active=na
var box mtfCustomActive=na
var int mtf15ActiveOrigin=na
var int mtf60ActiveOrigin=na
var int mtfCustomActiveOrigin=na
if barstate.isconfirmed
    [next15Box,next15Origin]=f_renderHTFBox(mtf15Active,mtf15ActiveOrigin,mtf15History,mtf15Dir,mtf15Top,mtf15Bottom,mtf15Origin,enableMTFContext and showHTF15mZones and valid15,"15m")
    mtf15Active:=next15Box
    mtf15ActiveOrigin:=next15Origin
    [next60Box,next60Origin]=f_renderHTFBox(mtf60Active,mtf60ActiveOrigin,mtf60History,mtf60Dir,mtf60Top,mtf60Bottom,mtf60Origin,enableMTFContext and showHTF1hZones and valid60,"1H")
    mtf60Active:=next60Box
    mtf60ActiveOrigin:=next60Origin
    [nextCustomBox,nextCustomOrigin]=f_renderHTFBox(mtfCustomActive,mtfCustomActiveOrigin,mtfCustomHistory,mtfFVGDir,mtfFVGTop,mtfFVGBottom,mtfFVGOrigin,enableMTFContext and showHTFSelectedZones and mtfPOIValidTF and customTF,mtfPOITimeframe)
    mtfCustomActive:=nextCustomBox
    mtfCustomActiveOrigin:=nextCustomOrigin


f_mtfPOIMatch(int dir,float signalPrice) =>
    bool matching=dir==1?mtfBullZone:mtfBearZone
    matching and signalPrice>=mtfFVGBottom and signalPrice<=mtfFVGTop

f_mtfExtraTarget(int dir,float beyondPrice,float minSep,float registeredCandidate) =>
    float result=registeredCandidate
    if mtfTargetEnabled
        float htfCandidate=dir==1?mtfSwingHigh:mtfSwingLow
        bool beyond=not na(htfCandidate) and (dir==1?htfCandidate>beyondPrice+minSep:htfCandidate<beyondPrice-minSep)
        if beyond and (na(result) or math.abs(htfCandidate-beyondPrice)<math.abs(result-beyondPrice))
            result:=htfCandidate
    result

//=============================================================================
// LIQUIDITY HELPERS
//=============================================================================
var array<LiquidityLevel> liquidity=array.new<LiquidityLevel>()
var int nextLiquidityId=1
var int duplicateSuppressions=0
var int liquiditySweepCount=0
var int liquidityResolutionCount=0
var int liquidityExpiryCount=0
var int liquiditySupersedeCount=0

f_activeLiquidityT1(int dir,float entryPrice,float riskDistance) =>
    float result=na
    float bestDistance=na
    if array.size(liquidity)>0 and riskDistance>0
        float maxT1R=maxLiquidityTargetR-math.max(atr*minTargetSeparationATR,syminfo.mintick)/riskDistance
        for n=0 to array.size(liquidity)-1
            LiquidityLevel q=array.get(liquidity,n)
            bool sideOK=dir==1?(q.buySide and q.price>entryPrice):(not q.buySide and q.price<entryPrice)
            float d=math.abs(q.price-entryPrice)
            float rr=d/riskDistance
            // Leave enough room inside the global maximum R bound for T2 separation.
            bool candidate=q.state==0 and not str.startswith(q.sourceType,"SESSION_") and q.tier<=maxTargetLiquidityTier and sideOK and rr>=minTarget1R and rr<=maxT1R
            if candidate and (na(bestDistance) or d<bestDistance)
                result:=q.price
                bestDistance:=d
    result

f_activeLiquidityT2(int dir,float entryPrice,float riskDistance,float target1) =>
    float result=na
    float bestDistance=na
    float minSep=math.max(atr*minTargetSeparationATR,syminfo.mintick)
    if array.size(liquidity)>0 and riskDistance>0 and not na(target1)
        for n=0 to array.size(liquidity)-1
            LiquidityLevel q=array.get(liquidity,n)
            bool sideOK=dir==1?(q.buySide and q.price>entryPrice):(not q.buySide and q.price<entryPrice)
            bool beyondT1=dir==1?q.price>=target1+minSep:q.price<=target1-minSep
            float d=math.abs(q.price-entryPrice)
            float rr=d/riskDistance
            bool candidate=q.state==0 and not str.startswith(q.sourceType,"SESSION_") and q.tier<=maxTargetLiquidityTier and sideOK and beyondT1 and rr>=minTarget2R and rr<=maxLiquidityTargetR
            if candidate and (na(bestDistance) or d<bestDistance)
                result:=q.price
                bestDistance:=d
    result

// Snapshot eligible session/swing/period liquidity beyond managed TP2.
// Completed session liquidity is reserved for visual extensions; managed
// TP1/TP2 keep the pre-session eligible liquidity universe.
// Snapshot additional active liquidity beyond the final managed target.
f_visualLiquidityBeyond(int dir,float beyondPrice,float minSep) =>
    float result=na
    float bestDistance=na
    if array.size(liquidity)>0 and not na(beyondPrice)
        for n=0 to array.size(liquidity)-1
            LiquidityLevel q=array.get(liquidity,n)
            bool sideOK=dir==1?q.buySide:not q.buySide
            bool beyond=dir==1?q.price>beyondPrice+minSep:q.price<beyondPrice-minSep
            float d=math.abs(q.price-beyondPrice)
            if q.state==0 and q.tier<=maxTargetLiquidityTier and sideOK and beyond and (na(bestDistance) or d<bestDistance)
                result:=q.price
                bestDistance:=d
    result

f_near(float a,float b,float tol) =>
    not na(a) and not na(b) and math.abs(a-b)<=tol

f_tierColor(int tier) =>
    tier==1?tier1Color:tier==2?tier2Color:tier==3?tier3Color:tier4Color

f_tierVisible(int tier) =>
    tier==1?showTier1:tier==2?showTier2:tier==3?showTier3:showTier4

f_deleteLiquidity(LiquidityLevel q) =>
    if not na(q.ln)
        line.delete(q.ln)
    if not na(q.lb)
        label.delete(q.lb)

f_trimLiquidity() =>
    while array.size(liquidity)>maxLiquidity
        LiquidityLevel old=array.shift(liquidity)
        f_deleteLiquidity(old)

f_findActiveSwingNear(float price,bool buySide,float tol) =>
    int found=-1
    if array.size(liquidity)>0
        for n=array.size(liquidity)-1 to 0
            LiquidityLevel q=array.get(liquidity,n)
            bool swingType=q.sourceType=="EXTERNAL_SWING" or q.sourceType=="INTERNAL_SWING" or q.sourceType=="SWING_CLUSTER"
            if q.state==0 and swingType and q.buySide==buySide and f_near(q.price,price,tol)
                found:=n
                break
    found

f_registerReference(int id,float price,bool buySide,int tier,string sourceType,string sourceName,int createdBar,int startTime) =>
    bool created=false
    if not na(price)
        color c=f_tierColor(tier)
        line ln=line.new(startTime,price,time,price,xloc=xloc.bar_time,extend=extend.none,color=f_hidden(c))
        label lb=label.new(time,price,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
        array.push(liquidity,LiquidityLevel.new(id,price,buySide,tier,0,createdBar,na,na,startTime,na,sourceType,sourceName,na,1,ln,lb))
        f_trimLiquidity()
        created:=true
    created

f_registerSwing(int id,float price,bool buySide,int tier,string sourceType,string sourceName,int pivotBar,int startTime,int expiryBar) =>
    bool created=false
    int idx=f_findActiveSwingNear(price,buySide,liquidityTolerance)
    if idx>=0
        LiquidityLevel q=array.get(liquidity,idx)
        q.clusterCount+=1
        // Preserve the stronger tier/source as primary.
        if tier<q.tier
            q.tier:=tier
            q.sourceType:=sourceType
            q.sourceName:=sourceName
            q.originSwingBar:=pivotBar
        else if q.clusterCount>=2 and q.sourceType!="EXTERNAL_SWING"
            q.sourceType:="SWING_CLUSTER"
            q.sourceName:=buySide?"EQH":"EQL"
            q.tier:=math.min(q.tier,3)
        // Extend expiry when fresh independent swing evidence arrives.
        q.expiryBar:=na(q.expiryBar)?expiryBar:math.max(q.expiryBar,expiryBar)
        array.set(liquidity,idx,q)
    else if not na(price)
        color c=f_tierColor(tier)
        line ln=line.new(startTime,price,time,price,xloc=xloc.bar_time,extend=extend.none,color=f_hidden(c))
        label lb=label.new(time,price,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
        array.push(liquidity,LiquidityLevel.new(id,price,buySide,tier,0,bar_index,na,expiryBar,startTime,na,sourceType,sourceName,pivotBar,1,ln,lb))
        f_trimLiquidity()
        created:=true
    created

f_supersedeSource(string sourceName) =>
    int changed=0
    if array.size(liquidity)>0
        for n=0 to array.size(liquidity)-1
            LiquidityLevel q=array.get(liquidity,n)
            if q.state==0 and q.sourceName==sourceName
                q.state:=4
                q.terminalBar:=bar_index
                q.endTime:=time
                array.set(liquidity,n,q)
                changed+=1
    changed

//=============================================================================
// PIVOTS / SWINGS
//=============================================================================
float iPH=ta.pivothigh(high,iLen,iLen)
float iPL=ta.pivotlow(low,iLen,iLen)
float xPH=ta.pivothigh(high,xLen,xLen)
float xPL=ta.pivotlow(low,xLen,xLen)

bool newIPH=barstate.isconfirmed and not na(iPH)
bool newIPL=barstate.isconfirmed and not na(iPL)
bool newXPH=barstate.isconfirmed and not na(xPH)
bool newXPL=barstate.isconfirmed and not na(xPL)

var float iHigh=na
var float iLow=na
var float iPriorHigh=na
var float iPriorLow=na
var int iHighBar=na
var int iLowBar=na
var int iHighTime=na
var int iLowTime=na
var string iHighClass="NONE"
var string iLowClass="NONE"

var float xHigh=na
var float xLow=na
var float xPriorHigh=na
var float xPriorLow=na
var int xHighBar=na
var int xLowBar=na
var int xHighTime=na
var int xLowTime=na
var string xHighClass="NONE"
var string xLowClass="NONE"

if newIPH
    iPriorHigh:=iHigh
    iHigh:=iPH
    iHighBar:=bar_index-iLen
    iHighTime:=time[iLen]
    iHighClass:=na(iPriorHigh)?"HH":iHigh>iPriorHigh?"HH":"LH"
    if useInternalSwingLiquidity
        bool made=f_registerSwing(nextLiquidityId,iHigh,true,4,"INTERNAL_SWING","iH",iHighBar,iHighTime,bar_index+internalSwingMaxAge)
        if made
            nextLiquidityId+=1
        else
            duplicateSuppressions+=1

if newIPL
    iPriorLow:=iLow
    iLow:=iPL
    iLowBar:=bar_index-iLen
    iLowTime:=time[iLen]
    iLowClass:=na(iPriorLow)?"HL":iLow>iPriorLow?"HL":"LL"
    if useInternalSwingLiquidity
        bool made=f_registerSwing(nextLiquidityId,iLow,false,4,"INTERNAL_SWING","iL",iLowBar,iLowTime,bar_index+internalSwingMaxAge)
        if made
            nextLiquidityId+=1
        else
            duplicateSuppressions+=1

if newXPH
    xPriorHigh:=xHigh
    xHigh:=xPH
    xHighBar:=bar_index-xLen
    xHighTime:=time[xLen]
    xHighClass:=na(xPriorHigh)?"HH":xHigh>xPriorHigh?"HH":"LH"
    if useExternalSwingLiquidity
        bool made=f_registerSwing(nextLiquidityId,xHigh,true,2,"EXTERNAL_SWING","xH",xHighBar,xHighTime,bar_index+externalSwingMaxAge)
        if made
            nextLiquidityId+=1
        else
            duplicateSuppressions+=1

if newXPL
    xPriorLow:=xLow
    xLow:=xPL
    xLowBar:=bar_index-xLen
    xLowTime:=time[xLen]
    xLowClass:=na(xPriorLow)?"HL":xLow>xPriorLow?"HL":"LL"
    if useExternalSwingLiquidity
        bool made=f_registerSwing(nextLiquidityId,xLow,false,2,"EXTERNAL_SWING","xL",xLowBar,xLowTime,bar_index+externalSwingMaxAge)
        if made
            nextLiquidityId+=1
        else
            duplicateSuppressions+=1

//=============================================================================
// STRUCTURE TARGETS / STATE
//=============================================================================
var float iTargetHigh=na
var int iTargetHighTime=na
var bool iHighWaiting=false
var float iTargetLow=na
var int iTargetLowTime=na
var bool iLowWaiting=false

var float xTargetHigh=na
var int xTargetHighTime=na
var bool xHighWaiting=false
var float xTargetLow=na
var int xTargetLowTime=na
var bool xLowWaiting=false

if newIPH and not iHighWaiting
    iTargetHigh:=iPH
    iTargetHighTime:=iHighTime
    iHighWaiting:=true
if newIPL and not iLowWaiting
    iTargetLow:=iPL
    iTargetLowTime:=iLowTime
    iLowWaiting:=true
if newXPH and not xHighWaiting
    xTargetHigh:=xPH
    xTargetHighTime:=xHighTime
    xHighWaiting:=true
if newXPL and not xLowWaiting
    xTargetLow:=xPL
    xTargetLowTime:=xLowTime
    xLowWaiting:=true

var int iTrend=0
var int xTrend=0
var float iProtectedLow=na
var float iProtectedHigh=na
var float xProtectedLow=na
var float xProtectedHigh=na
var int iProtectedLowTime=na
var int iProtectedHighTime=na
var int xProtectedLowTime=na
var int xProtectedHighTime=na

int oldITrend=iTrend
int oldXTrend=xTrend

bool iBullBreak=barstate.isconfirmed and iHighWaiting and not na(iTargetHigh) and (requireClose?close>iTargetHigh:high>iTargetHigh)
bool iBearBreak=barstate.isconfirmed and iLowWaiting and not na(iTargetLow) and (requireClose?close<iTargetLow:low<iTargetLow)
bool xBullBreak=barstate.isconfirmed and xHighWaiting and not na(xTargetHigh) and (requireClose?close>xTargetHigh:high>xTargetHigh)
bool xBearBreak=barstate.isconfirmed and xLowWaiting and not na(xTargetLow) and (requireClose?close<xTargetLow:low<xTargetLow)

bool iBullMSS=iBullBreak and oldITrend<0 and bullDisplacementEvent
bool iBearMSS=iBearBreak and oldITrend>0 and bearDisplacementEvent
bool xBullMSS=xBullBreak and oldXTrend<0 and bullDisplacementEvent
bool xBearMSS=xBearBreak and oldXTrend>0 and bearDisplacementEvent

bool iBullCH=iBullBreak and oldITrend<0 and not iBullMSS
bool iBearCH=iBearBreak and oldITrend>0 and not iBearMSS
bool xBullCH=xBullBreak and oldXTrend<0 and not xBullMSS
bool xBearCH=xBearBreak and oldXTrend>0 and not xBearMSS

bool iBullBOS=iBullBreak and not iBullCH and not iBullMSS
bool iBearBOS=iBearBreak and not iBearCH and not iBearMSS
bool xBullBOS=xBullBreak and not xBullCH and not xBullMSS
bool xBearBOS=xBearBreak and not xBearCH and not xBearMSS

if bullDisplacementEvent
    string scope=(iBullBreak and xBullBreak)?"BOTH":xBullBreak?"EXTERNAL":iBullBreak?"INTERNAL":"NONE"
    string kind=(iBullMSS or xBullMSS)?"MSS":(iBullCH or xBullCH)?"CHoCH":(iBullBOS or xBullBOS)?"BOS":"NONE"
    array.push(displacementEvents,DisplacementEvent.new(nextDisplacementId,1,bar_index,bullDisplacementScore,displacementBodyATR,displacementRangeATR,displacementBodyPct,bullCloseLocation,bullFollowThrough,volumeExpanded,iBullBreak or xBullBreak,scope,kind))
    nextDisplacementId+=1
    bullDisplacementCount+=1
    lastBullDisplacementBar:=bar_index
    lastBullDisplacementScore:=bullDisplacementScore
    if showDisplacementMarkers
        label dl=label.new(bar_index,low,"DSP ↑ "+str.tostring(bullDisplacementScore),style=label.style_none,textcolor=bullDisplacementColor,size=f_textSize())
        array.push(displacementLabels,dl)

if bearDisplacementEvent
    string scope=(iBearBreak and xBearBreak)?"BOTH":xBearBreak?"EXTERNAL":iBearBreak?"INTERNAL":"NONE"
    string kind=(iBearMSS or xBearMSS)?"MSS":(iBearCH or xBearCH)?"CHoCH":(iBearBOS or xBearBOS)?"BOS":"NONE"
    array.push(displacementEvents,DisplacementEvent.new(nextDisplacementId,-1,bar_index,bearDisplacementScore,displacementBodyATR,displacementRangeATR,displacementBodyPct,bearCloseLocation,bearFollowThrough,volumeExpanded,iBearBreak or xBearBreak,scope,kind))
    nextDisplacementId+=1
    bearDisplacementCount+=1
    lastBearDisplacementBar:=bar_index
    lastBearDisplacementScore:=bearDisplacementScore
    if showDisplacementMarkers
        label dl=label.new(bar_index,high,"DSP ↓ "+str.tostring(bearDisplacementScore),style=label.style_none,textcolor=bearDisplacementColor,size=f_textSize())
        array.push(displacementLabels,dl)

while array.size(displacementEvents)>200
    array.shift(displacementEvents)
while array.size(displacementLabels)>maxDisplacementMarkers
    label.delete(array.shift(displacementLabels))

//=============================================================================
// DISPLACEMENT EPISODE AGGREGATION
// A directional episode may contain multiple qualified DSP bars separated by
// a small confirmed-bar gap. Downstream engines should consume episodes rather
// than treating every DSP bar as an independent institutional impulse.
//=============================================================================
bool anyDSP=bullDisplacementEvent or bearDisplacementEvent
int currentDSPDirection=bullDisplacementEvent?1:bearDisplacementEvent?-1:0
int currentDSPScore=bullDisplacementEvent?bullDisplacementScore:bearDisplacementEvent?bearDisplacementScore:0

bool gapExceeded=episodeActive and not na(episodeLastDSPBar) and bar_index-episodeLastDSPBar>episodeGapBars+1
bool durationExceeded=episodeActive and not na(episodeStartBar) and bar_index-episodeStartBar>=episodeMaxBars
bool oppositeDSP=episodeActive and anyDSP and currentDSPDirection!=episodeDirection
bool finalizeEpisode=episodeActive and (gapExceeded or durationExceeded or oppositeDSP)
bool bullEpisodeCompleted=finalizeEpisode and episodeDirection==1
bool bearEpisodeCompleted=finalizeEpisode and episodeDirection==-1

if finalizeEpisode
    array.push(displacementEpisodes,DisplacementEpisode.new(
         episodeId,episodeDirection,episodeStartBar,episodeLastDSPBar,episodePeakBar,episodePeakScore,
         episodeEventCount,episodeHigh,episodeLow,episodeTotalBodyATR,
         episodeStructureBreak,episodeStructureScope,episodeStructureKind))
    while array.size(displacementEpisodes)>100
        array.shift(displacementEpisodes)

    completedEpisodeCount+=1
    if episodeDirection==1
        bullEpisodeCount+=1
    else
        bearEpisodeCount+=1

    lastCompletedEpisodeDirection:=episodeDirection
    lastCompletedEpisodePeakScore:=episodePeakScore
    lastCompletedEpisodeBars:=episodeLastDSPBar-episodeStartBar+1

    if showEpisodeMarkers
        float markerY=episodeDirection==1?episodeLow:episodeHigh
        string markerText=(episodeDirection==1?"EP ↑ ":"EP ↓ ")+str.tostring(episodePeakScore)+" · "+str.tostring(episodeEventCount)+" DSP"
        label ep=label.new(episodePeakBar,markerY,markerText,style=label.style_none,textcolor=episodeDirection==1?bullDisplacementColor:bearDisplacementColor,size=f_textSize())
        array.push(episodeLabels,ep)
        while array.size(episodeLabels)>40
            label.delete(array.shift(episodeLabels))

    episodeActive:=false
    episodeId:=na
    episodeDirection:=0
    episodeStartBar:=na
    episodeLastDSPBar:=na
    episodePeakBar:=na
    episodePeakScore:=na
    episodeEventCount:=0
    episodeHigh:=na
    episodeLow:=na
    episodeTotalBodyATR:=0.0
    episodeStructureBreak:=false
    episodeStructureScope:="NONE"
    episodeStructureKind:="NONE"

// Start a new episode after finalizing an opposite/expired episode, or when idle.
if anyDSP and not episodeActive
    episodeActive:=true
    episodeId:=nextEpisodeId
    nextEpisodeId+=1
    episodeDirection:=currentDSPDirection
    episodeStartBar:=bar_index
    episodeLastDSPBar:=bar_index
    episodePeakBar:=bar_index
    episodePeakScore:=currentDSPScore
    episodeEventCount:=1
    episodeHigh:=high
    episodeLow:=low
    episodeTotalBodyATR:=displacementBodyATR
    episodeStructureBreak:=(currentDSPDirection==1?(iBullBreak or xBullBreak):(iBearBreak or xBearBreak))
    episodeStructureScope:=currentDSPDirection==1?((iBullBreak and xBullBreak)?"BOTH":xBullBreak?"EXTERNAL":iBullBreak?"INTERNAL":"NONE"):((iBearBreak and xBearBreak)?"BOTH":xBearBreak?"EXTERNAL":iBearBreak?"INTERNAL":"NONE")
    episodeStructureKind:=currentDSPDirection==1?((iBullMSS or xBullMSS)?"MSS":(iBullCH or xBullCH)?"CHoCH":(iBullBOS or xBullBOS)?"BOS":"NONE"):((iBearMSS or xBearMSS)?"MSS":(iBearCH or xBearCH)?"CHoCH":(iBearBOS or xBearBOS)?"BOS":"NONE")

// Extend the active episode only with same-direction qualifying DSP bars.
else if anyDSP and episodeActive and currentDSPDirection==episodeDirection
    episodeLastDSPBar:=bar_index
    episodeEventCount+=1
    episodeHigh:=math.max(episodeHigh,high)
    episodeLow:=math.min(episodeLow,low)
    episodeTotalBodyATR+=displacementBodyATR

    if currentDSPScore>episodePeakScore
        episodePeakScore:=currentDSPScore
        episodePeakBar:=bar_index

    bool thisStructureBreak=currentDSPDirection==1?(iBullBreak or xBullBreak):(iBearBreak or xBearBreak)
    if thisStructureBreak
        episodeStructureBreak:=true
        string thisScope=currentDSPDirection==1?((iBullBreak and xBullBreak)?"BOTH":xBullBreak?"EXTERNAL":iBullBreak?"INTERNAL":"NONE"):((iBearBreak and xBearBreak)?"BOTH":xBearBreak?"EXTERNAL":iBearBreak?"INTERNAL":"NONE")
        string thisKind=currentDSPDirection==1?((iBullMSS or xBullMSS)?"MSS":(iBullCH or xBullCH)?"CHoCH":(iBullBOS or xBullBOS)?"BOS":"NONE"):((iBearMSS or xBearMSS)?"MSS":(iBearCH or xBearCH)?"CHoCH":(iBearBOS or xBearBOS)?"BOS":"NONE")
        episodeStructureScope:=thisScope
        episodeStructureKind:=thisKind

//=============================================================================
// FVG / IFVG + POI PROVENANCE
//=============================================================================

// Resolve the episode most plausibly responsible for an imbalance born now.
// Prefer an active same-direction episode; otherwise use the latest completed
// same-direction episode whose end is within the provenance window.
f_findEpisodeProvenance(int dir) =>
    int foundId=na
    int foundScore=na
    bool foundStructure=false
    string foundScope="NONE"
    string foundKind="NONE"

    if episodeActive and episodeDirection==dir and not na(episodeLastDSPBar) and bar_index-episodeLastDSPBar<=fvgProvenanceWindow
        foundId:=episodeId
        foundScore:=episodePeakScore
        foundStructure:=episodeStructureBreak
        foundScope:=episodeStructureScope
        foundKind:=episodeStructureKind
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.direction==dir and bar_index-ep.endBar<=fvgProvenanceWindow
                foundId:=ep.id
                foundScore:=ep.peakScore
                foundStructure:=ep.structureBreak
                foundScope:=ep.structureScope
                foundKind:=ep.structureKind
                break
    [foundId,foundScore,foundStructure,foundScope,foundKind]

bool rawBullFVG=barstate.isconfirmed and low>high[2]
bool rawBearFVG=barstate.isconfirmed and high<low[2]
float bullFVGSize=rawBullFVG?low-high[2]:0.0
float bearFVGSize=rawBearFVG?low[2]-high:0.0
bool bullSizeOK=rawBullFVG and (atr<=0 or bullFVGSize/atr>=minFVGATR)
bool bearSizeOK=rawBearFVG and (atr<=0 or bearFVGSize/atr>=minFVGATR)

[bullEpisodeId,bullProvScore,bullStructureLinked,bullStructureScope,bullStructureKind]=f_findEpisodeProvenance(1)
[bearEpisodeId,bearProvScore,bearStructureLinked,bearStructureScope,bearStructureKind]=f_findEpisodeProvenance(-1)

bool bullCausal=not na(bullEpisodeId)
bool bearCausal=not na(bearEpisodeId)

bool bullCreateAllowed=fvgCreationMode=="All" or (fvgCreationMode=="Displacement-linked" and bullCausal) or (fvgCreationMode=="Structural" and bullCausal and bullStructureLinked)
bool bearCreateAllowed=fvgCreationMode=="All" or (fvgCreationMode=="Displacement-linked" and bearCausal) or (fvgCreationMode=="Structural" and bearCausal and bearStructureLinked)

bool bullFVGEvent=bullSizeOK and bullCreateAllowed
bool bearFVGEvent=bearSizeOK and bearCreateAllowed

f_qualityClass(bool causal,bool structural) =>
    structural?"STRUCTURAL":causal?"DISPLACEMENT":"ORDINARY"

bool newBullPrimaryStructuralFVG=false
bool newBearPrimaryStructuralFVG=false
int newBullPrimaryFVGId=na
int newBearPrimaryFVGId=na
int newBullPrimaryEpisodeId=na
int newBearPrimaryEpisodeId=na
int newBullPrimaryScore=na
int newBearPrimaryScore=na
string newBullPrimaryScope="NONE"
string newBearPrimaryScope="NONE"
string newBullPrimaryKind="NONE"
string newBearPrimaryKind="NONE"

if bullFVGEvent
    string quality=f_qualityClass(bullCausal,bullStructureLinked)
    color c=bullFVGColor
    string txt=showPOIProvenance?"FVG · "+quality+(na(bullEpisodeId)?"":" · EP"+str.tostring(bullEpisodeId)):"FVG"
    box bx=box.new(bar_index-2,low,bar_index,high[2],xloc=xloc.bar_index,extend=extend.none,bgcolor=color.new(c,fvgTransparency),border_color=color.new(c,20),text=txt,text_color=c,text_size=f_textSize(),text_halign=text.align_right,text_valign=text.align_center)
    int epPeak=f_episodePeakBar(bullEpisodeId)
    float gapATR=atr>0?bullFVGSize/atr:0.0
    array.push(imbalanceZones,ImbalanceZone.new(nextImbalanceId,1,0,low,high[2],bar_index,na,bullEpisodeId,bullProvScore,bullStructureLinked,bullStructureScope,bullStructureKind,quality,true,epPeak,gapATR,0.0,bx))
    int newIndex=array.size(imbalanceZones)-1
    bool becamePrimary=f_assignPrimaryForEpisode(newIndex,bullEpisodeId,1)
    if becamePrimary
        primaryFVGCount+=1
        if bullStructureLinked
            newBullPrimaryStructuralFVG:=true
            newBullPrimaryFVGId:=nextImbalanceId
            newBullPrimaryEpisodeId:=bullEpisodeId
            newBullPrimaryScore:=bullProvScore
            newBullPrimaryScope:=bullStructureScope
            newBullPrimaryKind:=bullStructureKind
    else
        secondaryFVGCount+=1
    nextImbalanceId+=1
    bullFVGCount+=1
    if quality=="STRUCTURAL"
        structuralFVGCount+=1
    else if quality=="DISPLACEMENT"
        displacementFVGCount+=1
    else
        ordinaryFVGCount+=1
    f_trimImbalances()

if bearFVGEvent
    string quality=f_qualityClass(bearCausal,bearStructureLinked)
    color c=bearFVGColor
    string txt=showPOIProvenance?"FVG · "+quality+(na(bearEpisodeId)?"":" · EP"+str.tostring(bearEpisodeId)):"FVG"
    box bx=box.new(bar_index-2,low[2],bar_index,high,xloc=xloc.bar_index,extend=extend.none,bgcolor=color.new(c,fvgTransparency),border_color=color.new(c,20),text=txt,text_color=c,text_size=f_textSize(),text_halign=text.align_right,text_valign=text.align_center)
    int epPeak=f_episodePeakBar(bearEpisodeId)
    float gapATR=atr>0?bearFVGSize/atr:0.0
    array.push(imbalanceZones,ImbalanceZone.new(nextImbalanceId,-1,0,low[2],high,bar_index,na,bearEpisodeId,bearProvScore,bearStructureLinked,bearStructureScope,bearStructureKind,quality,true,epPeak,gapATR,0.0,bx))
    int newIndex=array.size(imbalanceZones)-1
    bool becamePrimary=f_assignPrimaryForEpisode(newIndex,bearEpisodeId,-1)
    if becamePrimary
        primaryFVGCount+=1
        if bearStructureLinked
            newBearPrimaryStructuralFVG:=true
            newBearPrimaryFVGId:=nextImbalanceId
            newBearPrimaryEpisodeId:=bearEpisodeId
            newBearPrimaryScore:=bearProvScore
            newBearPrimaryScope:=bearStructureScope
            newBearPrimaryKind:=bearStructureKind
    else
        secondaryFVGCount+=1
    nextImbalanceId+=1
    bearFVGCount+=1
    if quality=="STRUCTURAL"
        structuralFVGCount+=1
    else if quality=="DISPLACEMENT"
        displacementFVGCount+=1
    else
        ordinaryFVGCount+=1
    f_trimImbalances()

bool bullIFVGEvent=false
bool bearIFVGEvent=false

if array.size(imbalanceZones)>0
    for n=0 to array.size(imbalanceZones)-1
        ImbalanceZone z=array.get(imbalanceZones,n)

        if z.state==0
            float zoneHeight=math.max(z.top-z.bottom,syminfo.mintick)
            float overlapTop=math.min(high,z.top)
            float overlapBottom=math.max(low,z.bottom)
            float overlap=math.max(overlapTop-overlapBottom,0.0)
            float mitigationPct=100.0*overlap/zoneHeight
            z.maxMitigationPct:=math.max(z.maxMitigationPct,mitigationPct)

            bool bullFullWick=z.direction==1 and low<=z.bottom
            bool bearFullWick=z.direction==-1 and high>=z.top

            bool bullFlipClose=z.direction==1 and close<z.bottom
            bool bearFlipClose=z.direction==-1 and close>z.top
            bool bullFlipBody=z.direction==1 and open<z.bottom and close<z.bottom
            bool bearFlipBody=z.direction==-1 and open>z.top and close>z.top

            bool flipToBear=ifvgFlipMode=="Full body beyond boundary"?bullFlipBody:bullFlipClose
            bool flipToBull=ifvgFlipMode=="Full body beyond boundary"?bearFlipBody:bearFlipClose

            if flipToBear
                z.state:=1
                bearIFVGEvent:=true
                bearIFVGCount+=1
            else if flipToBull
                z.state:=1
                bullIFVGEvent:=true
                bullIFVGCount+=1
            else if (z.direction==1 and retireFVGOnFullWickFill and bullFullWick) or (z.direction==-1 and retireFVGOnFullWickFill and bearFullWick)
                z.state:=2
                z.terminalBar:=bar_index
                retiredImbalanceCount+=1

        else if z.state==1
            // Inverted direction is opposite the original FVG direction.
            bool ifvgBull=z.direction==-1
            bool ifvgBear=z.direction==1
            bool fullTraverse=ifvgBull?low<=z.bottom:high>=z.top
            bool invalidClose=ifvgBull?close<z.bottom:close>z.top

            if invalidClose or (retireIFVGOnFullWickFill and fullTraverse)
                z.state:=2
                z.terminalBar:=bar_index
                retiredImbalanceCount+=1

        bool active=z.state<2
        bool isFVG=z.state==0
        bool isIFVG=z.state==1
        bool bullVisual=isFVG?z.direction==1:z.direction==-1
        color c=isIFVG?(bullVisual?bullIFVGColor:bearIFVGColor):(bullVisual?bullFVGColor:bearFVGColor)
        bool familyVisible=z.primary or showSecondaryFVGs or na(z.episodeId)
        bool visible=active and familyVisible and ((isFVG and showFVGZones) or (isIFVG and showIFVGZones))

        if not na(z.bx)
            box.set_right(z.bx,active?bar_index:(na(z.terminalBar)?bar_index:z.terminalBar))
            box.set_bgcolor(z.bx,visible?color.new(c,fvgTransparency):color.new(c,100))
            box.set_border_color(z.bx,visible?color.new(c,20):color.new(c,100))
            string kind=isIFVG?"IFVG":"FVG"
            string familyTag=z.primary?" · PRIMARY":" · SECONDARY"
            string prov=showPOIProvenance?" · "+z.qualityClass+(na(z.episodeId)?"":" · EP"+str.tostring(z.episodeId))+familyTag:""
            box.set_text(z.bx,visible?kind+prov:"")
            box.set_text_color(z.bx,c)
            box.set_text_size(z.bx,f_textSize())
            box.set_text_halign(z.bx,text.align_right)
            box.set_text_valign(z.bx,text.align_center)

        array.set(imbalanceZones,n,z)

//=============================================================================
// CAUSAL ORDER BLOCK / BREAKER BLOCK
//=============================================================================
bool bullOBEvent=false
bool bearOBEvent=false
bool bullBBEvent=false
bool bearBBEvent=false

bool bullOBTrigger=requirePrimaryStructuralFVG?newBullPrimaryStructuralFVG:(bullFVGEvent and bullCausal and bullStructureLinked)
bool bearOBTrigger=requirePrimaryStructuralFVG?newBearPrimaryStructuralFVG:(bearFVGEvent and bearCausal and bearStructureLinked)

if bullOBTrigger and not na(newBullPrimaryEpisodeId) and not f_hasOrderBlockForEpisode(newBullPrimaryEpisodeId,1)
    [originBar,originTime,zoneTop,zoneBottom]=f_findOBOrigin(newBullPrimaryEpisodeId,1)
    if not na(originBar) and not na(originTime) and not na(zoneTop) and not na(zoneBottom)
        string txt=showOBProvenance?"OB · EP"+str.tostring(newBullPrimaryEpisodeId)+" · "+newBullPrimaryKind:"OB"
        box bx=box.new(originTime,zoneTop,time,zoneBottom,xloc=xloc.bar_time,extend=extend.none,bgcolor=color.new(bullOBColor,obTransparency),border_color=color.new(bullOBColor,20),text=txt,text_color=bullOBColor,text_size=f_textSize(),text_halign=text.align_right,text_valign=text.align_center)
        array.push(orderBlocks,OrderBlockZone.new(nextOrderBlockId,1,0,zoneTop,zoneBottom,originBar,originTime,bar_index,time,na,na,newBullPrimaryEpisodeId,newBullPrimaryFVGId,newBullPrimaryScore,newBullPrimaryScope,newBullPrimaryKind,0.0,bx))
        nextOrderBlockId+=1
        bullOBCount+=1
        bullOBEvent:=true
        f_trimOrderBlocks()

if bearOBTrigger and not na(newBearPrimaryEpisodeId) and not f_hasOrderBlockForEpisode(newBearPrimaryEpisodeId,-1)
    [originBar,originTime,zoneTop,zoneBottom]=f_findOBOrigin(newBearPrimaryEpisodeId,-1)
    if not na(originBar) and not na(originTime) and not na(zoneTop) and not na(zoneBottom)
        string txt=showOBProvenance?"OB · EP"+str.tostring(newBearPrimaryEpisodeId)+" · "+newBearPrimaryKind:"OB"
        box bx=box.new(originTime,zoneTop,time,zoneBottom,xloc=xloc.bar_time,extend=extend.none,bgcolor=color.new(bearOBColor,obTransparency),border_color=color.new(bearOBColor,20),text=txt,text_color=bearOBColor,text_size=f_textSize(),text_halign=text.align_right,text_valign=text.align_center)
        array.push(orderBlocks,OrderBlockZone.new(nextOrderBlockId,-1,0,zoneTop,zoneBottom,originBar,originTime,bar_index,time,na,na,newBearPrimaryEpisodeId,newBearPrimaryFVGId,newBearPrimaryScore,newBearPrimaryScope,newBearPrimaryKind,0.0,bx))
        nextOrderBlockId+=1
        bearOBCount+=1
        bearOBEvent:=true
        f_trimOrderBlocks()

if array.size(orderBlocks)>0
    for n=0 to array.size(orderBlocks)-1
        OrderBlockZone z=array.get(orderBlocks,n)
        float zoneHeight=math.max(z.top-z.bottom,syminfo.mintick)

        if z.state==0
            float overlapTop=math.min(high,z.top)
            float overlapBottom=math.max(low,z.bottom)
            float overlap=math.max(overlapTop-overlapBottom,0.0)
            float mitigationPct=100.0*overlap/zoneHeight
            z.maxMitigationPct:=math.max(z.maxMitigationPct,mitigationPct)

            bool bullCloseFailure=z.direction==1 and close<z.bottom
            bool bearCloseFailure=z.direction==-1 and close>z.top
            bool bullBodyFailure=z.direction==1 and open<z.bottom and close<z.bottom
            bool bearBodyFailure=z.direction==-1 and open>z.top and close>z.top
            bool bullFlipConfirmed=bbFlipMode=="Full body beyond boundary"?bullBodyFailure:bullCloseFailure
            bool bearFlipConfirmed=bbFlipMode=="Full body beyond boundary"?bearBodyFailure:bearCloseFailure
            bool breakerQualified=z.direction==1?(bullFlipConfirmed and (not requireBreakerDisplacement or bearDisplacementEvent)):(bearFlipConfirmed and (not requireBreakerDisplacement or bullDisplacementEvent))
            bool fullWickFill=z.direction==1?low<=z.bottom:high>=z.top

            if breakerQualified
                z.state:=1
                if z.direction==1
                    bearBBEvent:=true
                    bearBBCount+=1
                else
                    bullBBEvent:=true
                    bullBBCount+=1
            else if retireOBOnFullWickFill and fullWickFill
                z.state:=2
                z.terminalBar:=bar_index
                z.terminalTime:=time
                retiredOBBBCount+=1

        else if z.state==1
            bool bbBull=z.direction==-1
            bool invalidClose=bbBull?close<z.bottom:close>z.top
            bool fullTraverse=bbBull?low<=z.bottom:high>=z.top
            if invalidClose or (retireBBOnFullWickFill and fullTraverse)
                z.state:=2
                z.terminalBar:=bar_index
                z.terminalTime:=time
                retiredOBBBCount+=1

        bool active=z.state<2
        bool isOB=z.state==0
        bool isBB=z.state==1
        bool visualBull=isOB?z.direction==1:z.direction==-1
        color c=isBB?(visualBull?bullBBColor:bearBBColor):(visualBull?bullOBColor:bearOBColor)
        bool visible=active and ((isOB and showOBZones) or (isBB and showBBZones))

        if not na(z.bx)
            box.set_right(z.bx,active?time:(na(z.terminalTime)?time:z.terminalTime))
            box.set_bgcolor(z.bx,visible?color.new(c,obTransparency):color.new(c,100))
            box.set_border_color(z.bx,visible?color.new(c,20):color.new(c,100))
            string kind=isBB?"BB":"OB"
            string prov=showOBProvenance?" · EP"+str.tostring(z.episodeId)+" · FVG"+str.tostring(z.fvgId)+" · "+z.structureKind:""
            box.set_text(z.bx,visible?kind+prov:"")
            box.set_text_color(z.bx,c)
            box.set_text_size(z.bx,f_textSize())
            box.set_text_halign(z.bx,text.align_right)
            box.set_text_valign(z.bx,text.align_center)

        array.set(orderBlocks,n,z)

// Build normalized downstream view after both POI source engines update.
f_rebuildUnifiedPOIs()

var string lastInternalEvent="NONE"
var string lastExternalEvent="NONE"
var int lastInternalEventBar=na
var int lastExternalEventBar=na
var line[] structureLines=array.new_line()
var label[] structureLabels=array.new_label()

f_structureKind(bool mss,bool choch) =>
    mss?"MSS":choch?"CHoCH":"BOS"

f_addStructureVisual(bool enabled,int swingTime,float price,string kind,bool bullish) =>
    if enabled and not na(swingTime) and not na(price)
        color c=bullish?bullStructureColor:bearStructureColor
        line ln=line.new(swingTime,price,time,price,xloc=xloc.bar_time,extend=extend.none,color=c,style=kind=="CHoCH"?line.style_dashed:line.style_solid,width=kind=="MSS"?2:1)
        label lb=label.new(swingTime+(time-swingTime)/2,price,kind,xloc=xloc.bar_time,style=label.style_none,textcolor=c,size=f_textSize())
        array.push(structureLines,ln)
        array.push(structureLabels,lb)
        while array.size(structureLines)>maxStructureEvents
            line.delete(array.shift(structureLines))
            label.delete(array.shift(structureLabels))

if iBullBreak
    string kind=f_structureKind(iBullMSS,iBullCH)
    f_addStructureVisual(showInternalStructure,iTargetHighTime,iTargetHigh,kind,true)
    lastInternalEvent:="BULL "+kind
    lastInternalEventBar:=bar_index
    iHighWaiting:=false
    iProtectedLow:=iLow
    iProtectedLowTime:=iLowTime
    iTrend:=1

if iBearBreak
    string kind=f_structureKind(iBearMSS,iBearCH)
    f_addStructureVisual(showInternalStructure,iTargetLowTime,iTargetLow,kind,false)
    lastInternalEvent:="BEAR "+kind
    lastInternalEventBar:=bar_index
    iLowWaiting:=false
    iProtectedHigh:=iHigh
    iProtectedHighTime:=iHighTime
    iTrend:=-1

if xBullBreak
    string kind=f_structureKind(xBullMSS,xBullCH)
    f_addStructureVisual(showExternalStructure,xTargetHighTime,xTargetHigh,kind,true)
    lastExternalEvent:="BULL "+kind
    lastExternalEventBar:=bar_index
    xHighWaiting:=false
    xProtectedLow:=xLow
    xProtectedLowTime:=xLowTime
    xTrend:=1

if xBearBreak
    string kind=f_structureKind(xBearMSS,xBearCH)
    f_addStructureVisual(showExternalStructure,xTargetLowTime,xTargetLow,kind,false)
    lastExternalEvent:="BEAR "+kind
    lastExternalEventBar:=bar_index
    xLowWaiting:=false
    xProtectedHigh:=xHigh
    xProtectedHighTime:=xHighTime
    xTrend:=-1

//=============================================================================
// PREVIOUS D/W/M LIQUIDITY
// Confirmed previous period values.
//=============================================================================
float pdH=request.security(syminfo.tickerid,"D",high[1],lookahead=barmerge.lookahead_on)
float pdL=request.security(syminfo.tickerid,"D",low[1],lookahead=barmerge.lookahead_on)
float pwH=request.security(syminfo.tickerid,"W",high[1],lookahead=barmerge.lookahead_on)
float pwL=request.security(syminfo.tickerid,"W",low[1],lookahead=barmerge.lookahead_on)
float pmH=request.security(syminfo.tickerid,"M",high[1],lookahead=barmerge.lookahead_on)
float pmL=request.security(syminfo.tickerid,"M",low[1],lookahead=barmerge.lookahead_on)

bool newD=ta.change(time("D"))!=0
bool newW=ta.change(time("W"))!=0
bool newM=ta.change(time("M"))!=0

if (barstate.isfirst or newD) and usePD
    liquiditySupersedeCount+=f_supersedeSource("PDH")
    liquiditySupersedeCount+=f_supersedeSource("PDL")
    if f_registerReference(nextLiquidityId,pdH,true,2,"PREVIOUS_DAY","PDH",bar_index,time)
        nextLiquidityId+=1
    if f_registerReference(nextLiquidityId,pdL,false,2,"PREVIOUS_DAY","PDL",bar_index,time)
        nextLiquidityId+=1

if (barstate.isfirst or newW) and usePW
    liquiditySupersedeCount+=f_supersedeSource("PWH")
    liquiditySupersedeCount+=f_supersedeSource("PWL")
    if f_registerReference(nextLiquidityId,pwH,true,1,"PREVIOUS_WEEK","PWH",bar_index,time)
        nextLiquidityId+=1
    if f_registerReference(nextLiquidityId,pwL,false,1,"PREVIOUS_WEEK","PWL",bar_index,time)
        nextLiquidityId+=1

if (barstate.isfirst or newM) and usePM
    liquiditySupersedeCount+=f_supersedeSource("PMH")
    liquiditySupersedeCount+=f_supersedeSource("PML")
    if f_registerReference(nextLiquidityId,pmH,true,1,"PREVIOUS_MONTH","PMH",bar_index,time)
        nextLiquidityId+=1
    if f_registerReference(nextLiquidityId,pmL,false,1,"PREVIOUS_MONTH","PML",bar_index,time)
        nextLiquidityId+=1

//=============================================================================
// COMPLETED TRADING-SESSION LIQUIDITY (CAUSAL)
// Session windows use the selected IANA timezone. Highs/lows are accumulated
// only from confirmed chart candles, then registered on the first bar outside
// each session. Never expose an unfinished session extreme as confirmed POI.
//=============================================================================
int asiaSessionTime=time(timeframe.period,asiaSession,sessionTimeZone)
int londonSessionTime=time(timeframe.period,londonSession,sessionTimeZone)
int nySessionTime=time(timeframe.period,newYorkSession,sessionTimeZone)
bool inAsia=not na(asiaSessionTime)
bool inLondon=not na(londonSessionTime)
bool inNY=not na(nySessionTime)
var float asiaHi=na
var float asiaLo=na
var int asiaStart=na
var float londonHi=na
var float londonLo=na
var int londonStart=na
var float nyHi=na
var float nyLo=na
var int nyStart=na

if barstate.isconfirmed
    if useSessionLiquidity and useAsiaSession
        if inAsia
            if not inAsia[1]
                asiaHi:=high
                asiaLo:=low
                asiaStart:=time
            else
                asiaHi:=math.max(nz(asiaHi,high),high)
                asiaLo:=math.min(nz(asiaLo,low),low)
        else if inAsia[1] and not na(asiaHi) and not na(asiaLo)
            liquiditySupersedeCount+=f_supersedeSource("ASH")
            liquiditySupersedeCount+=f_supersedeSource("ASL")
            if f_registerReference(nextLiquidityId,asiaHi,true,sessionLiquidityTier,"SESSION_ASIA","ASH",bar_index,asiaStart)
                nextLiquidityId+=1
            if f_registerReference(nextLiquidityId,asiaLo,false,sessionLiquidityTier,"SESSION_ASIA","ASL",bar_index,asiaStart)
                nextLiquidityId+=1
            asiaHi:=na
            asiaLo:=na
            asiaStart:=na
    if useSessionLiquidity and useLondonSession
        if inLondon
            if not inLondon[1]
                londonHi:=high
                londonLo:=low
                londonStart:=time
            else
                londonHi:=math.max(nz(londonHi,high),high)
                londonLo:=math.min(nz(londonLo,low),low)
        else if inLondon[1] and not na(londonHi) and not na(londonLo)
            liquiditySupersedeCount+=f_supersedeSource("LDH")
            liquiditySupersedeCount+=f_supersedeSource("LDL")
            if f_registerReference(nextLiquidityId,londonHi,true,sessionLiquidityTier,"SESSION_LONDON","LDH",bar_index,londonStart)
                nextLiquidityId+=1
            if f_registerReference(nextLiquidityId,londonLo,false,sessionLiquidityTier,"SESSION_LONDON","LDL",bar_index,londonStart)
                nextLiquidityId+=1
            londonHi:=na
            londonLo:=na
            londonStart:=na
    if useSessionLiquidity and useNewYorkSession
        if inNY
            if not inNY[1]
                nyHi:=high
                nyLo:=low
                nyStart:=time
            else
                nyHi:=math.max(nz(nyHi,high),high)
                nyLo:=math.min(nz(nyLo,low),low)
        else if inNY[1] and not na(nyHi) and not na(nyLo)
            liquiditySupersedeCount+=f_supersedeSource("NYH")
            liquiditySupersedeCount+=f_supersedeSource("NYL")
            if f_registerReference(nextLiquidityId,nyHi,true,sessionLiquidityTier,"SESSION_NEW_YORK","NYH",bar_index,nyStart)
                nextLiquidityId+=1
            if f_registerReference(nextLiquidityId,nyLo,false,sessionLiquidityTier,"SESSION_NEW_YORK","NYL",bar_index,nyStart)
                nextLiquidityId+=1
            nyHi:=na
            nyLo:=na
            nyStart:=na

//=============================================================================
// LIQUIDITY LIFECYCLE / EVENTS
//=============================================================================
bool bullLiquiditySweep=false
bool bearLiquiditySweep=false
bool bullLiquidityResolution=false
bool bearLiquidityResolution=false
string latestSweepSource="NONE"
int latestSweepTier=na
float latestSweepPrice=na
string bullSweepSourceThisBar="NONE"
string bearSweepSourceThisBar="NONE"
int bullSweepTierThisBar=na
int bearSweepTierThisBar=na
float bullSweepPriceThisBar=na
float bearSweepPriceThisBar=na
string latestResolutionSource="NONE"
int latestResolutionTier=na
float latestResolutionPrice=na

if array.size(liquidity)>0
    for n=0 to array.size(liquidity)-1
        LiquidityLevel q=array.get(liquidity,n)

        if q.state==0
            bool expired=not na(q.expiryBar) and bar_index>q.expiryBar
            bool swept=barstate.isconfirmed and (q.buySide?(high>q.price and close<q.price):(low<q.price and close>q.price))
            bool resolved=barstate.isconfirmed and (q.buySide?close>q.price:close<q.price)

            if swept
                q.state:=1
                q.terminalBar:=bar_index
                q.endTime:=time
                latestSweepSource:=q.sourceName
                latestSweepTier:=q.tier
                latestSweepPrice:=q.price
                liquiditySweepCount+=1
                if q.buySide
                    bearLiquiditySweep:=true
                    bearSweepSourceThisBar:=q.sourceName
                    bearSweepTierThisBar:=q.tier
                    bearSweepPriceThisBar:=q.price
                else
                    bullLiquiditySweep:=true
                    bullSweepSourceThisBar:=q.sourceName
                    bullSweepTierThisBar:=q.tier
                    bullSweepPriceThisBar:=q.price
            else if resolved
                q.state:=2
                q.terminalBar:=bar_index
                q.endTime:=time
                latestResolutionSource:=q.sourceName
                latestResolutionTier:=q.tier
                latestResolutionPrice:=q.price
                liquidityResolutionCount+=1
                if q.buySide
                    bullLiquidityResolution:=true
                else
                    bearLiquidityResolution:=true
            else if expired
                q.state:=3
                q.terminalBar:=bar_index
                q.endTime:=time
                liquidityExpiryCount+=1

            array.set(liquidity,n,q)

        bool terminal=q.state!=0
        bool visibleState=q.state==0 or showTerminalLiquidity
        bool tierVisible=f_tierVisible(q.tier)
        bool modeVisible=modeFull or modeAnalysis or (modeExecution and q.tier<=2)
        bool visible=visibleState and tierVisible and modeVisible
        color base=f_tierColor(q.tier)
        color c=terminal?terminalColor:base
        int x2=terminal and not na(q.endTime)?q.endTime:time

        if not na(q.ln)
            line.set_xy2(q.ln,x2,q.price)
            line.set_color(q.ln,visible?c:f_hidden(c))
            line.set_style(q.ln,terminal?line.style_dashed:line.style_solid)

        if not na(q.lb)
            label.set_xy(q.lb,x2,q.price)
            string clusterText=q.clusterCount>=2?" · x"+str.tostring(q.clusterCount):""
            string tierText=modeFull?" · T"+str.tostring(q.tier):""
            string labelText=showLiquidityLabels and visible?q.sourceName+clusterText+tierText:""
            label.set_text(q.lb,labelText)
            label.set_textcolor(q.lb,c)

//=============================================================================
// REVERSAL SETUP STATE MACHINE
// State: 0 IDLE, 1 SWEEP, 2 SHIFT/WAITING POI, 3 ARMED, 4 RETEST, 5 ELIGIBLE
// One independent candidate per direction. Eligibility is binary.
//=============================================================================
var int bullREVState=0
var int bearREVState=0

var int bullREVSweepBar=na
var int bearREVSweepBar=na
var string bullREVSweepSource="NONE"
var string bearREVSweepSource="NONE"
var int bullREVSweepTier=na
var int bearREVSweepTier=na
var float bullREVSweepPrice=na
var float bearREVSweepPrice=na

var int bullREVShiftBar=na
var int bearREVShiftBar=na
var int bullREVEpisodeId=na
var int bearREVEpisodeId=na

var string bullREVPOIEngine="NONE"
var string bearREVPOIEngine="NONE"
var int bullREVPOIId=na
var int bearREVPOIId=na
var string bullREVPOIType="NONE"
var string bearREVPOIType="NONE"
var float bullREVPOITop=na
var float bullREVPOIBottom=na
var float bearREVPOITop=na
var float bearREVPOIBottom=na
var int bullREVArmedBar=na
var int bearREVArmedBar=na
var int bullREVRetestBar=na
var int bearREVRetestBar=na
var int bullREVEligibleBar=na
var int bearREVEligibleBar=na

var int bullREVEligibleCount=0
var int bearREVEligibleCount=0
var int bullREVInvalidationCount=0
var int bearREVInvalidationCount=0
var string bullREVShiftScopeUsed="NONE"
var string bearREVShiftScopeUsed="NONE"
var string bullREVShiftKindUsed="NONE"
var string bearREVShiftKindUsed="NONE"
var int bullREVLastScore=na
var int bearREVLastScore=na
var string bullREVLastGrade="—"
var string bearREVLastGrade="—"
var string bullREVLastBreakdown="—"
var string bearREVLastBreakdown="—"
var label[] revLabels=array.new_label()

bool bullREVEligibleEvent=false
bool bearREVEligibleEvent=false

// Eligible is an event state. Return to idle on the next confirmed bar.
if bullREVState==5 and barstate.isconfirmed and bar_index>bullREVEligibleBar
    bullREVState:=0
if bearREVState==5 and barstate.isconfirmed and bar_index>bearREVEligibleBar
    bearREVState:=0

// A fresh same-direction sweep replaces any unfinished candidate.
if bullLiquiditySweep
    bullREVState:=1
    bullREVSweepBar:=bar_index
    bullREVSweepSource:=bullSweepSourceThisBar
    bullREVSweepTier:=bullSweepTierThisBar
    bullREVSweepPrice:=bullSweepPriceThisBar
    bullREVShiftBar:=na
    bullREVEpisodeId:=na
    bullREVPOIEngine:="NONE"
    bullREVPOIId:=na
    bullREVPOIType:="NONE"
    bullREVArmedBar:=na
    bullREVRetestBar:=na

if bearLiquiditySweep
    bearREVState:=1
    bearREVSweepBar:=bar_index
    bearREVSweepSource:=bearSweepSourceThisBar
    bearREVSweepTier:=bearSweepTierThisBar
    bearREVSweepPrice:=bearSweepPriceThisBar
    bearREVShiftBar:=na
    bearREVEpisodeId:=na
    bearREVPOIEngine:="NONE"
    bearREVPOIId:=na
    bearREVPOIType:="NONE"
    bearREVArmedBar:=na
    bearREVRetestBar:=na

bool bullREVShiftEvent=bullDisplacementEvent and (revShiftScope=="External"?(xBullMSS or xBullCH):(iBullMSS or xBullMSS or iBullCH or xBullCH))
bool bearREVShiftEvent=bearDisplacementEvent and (revShiftScope=="External"?(xBearMSS or xBearCH):(iBearMSS or xBearMSS or iBearCH or xBearCH))

// Sweep -> displacement + reversal structural shift.
if bullREVState==1
    if bar_index-bullREVSweepBar>revSweepToShiftBars
        bullREVState:=0
        bullREVInvalidationCount+=1
    else if bullREVShiftEvent and episodeActive and episodeDirection==1
        bullREVState:=2
        bullREVShiftBar:=bar_index
        bullREVEpisodeId:=episodeId
        bullREVShiftScopeUsed:=(xBullMSS or xBullCH)?"EXTERNAL":"INTERNAL"
        bullREVShiftKindUsed:=xBullMSS?"MSS":xBullCH?"CHoCH":iBullMSS?"MSS":"CHoCH"

if bearREVState==1
    if bar_index-bearREVSweepBar>revSweepToShiftBars
        bearREVState:=0
        bearREVInvalidationCount+=1
    else if bearREVShiftEvent and episodeActive and episodeDirection==-1
        bearREVState:=2
        bearREVShiftBar:=bar_index
        bearREVEpisodeId:=episodeId
        bearREVShiftScopeUsed:=(xBearMSS or xBearCH)?"EXTERNAL":"INTERNAL"
        bearREVShiftKindUsed:=xBearMSS?"MSS":xBearCH?"CHoCH":iBearMSS?"MSS":"CHoCH"

// Shift -> same-episode Unified POI.
if bullREVState==2
    if bar_index-bullREVShiftBar>revShiftToPOIBars
        bullREVState:=0
        bullREVInvalidationCount+=1
    else
        int idx=f_findREVPOI(bullREVEpisodeId,1)
        if idx>=0
            UnifiedPOI p=array.get(unifiedPOIs,idx)
            bullREVPOIEngine:=p.sourceEngine
            bullREVPOIId:=p.sourceId
            bullREVPOIType:=p.poiType
            bullREVPOITop:=p.top
            bullREVPOIBottom:=p.bottom
            bullREVArmedBar:=bar_index
            bullREVState:=3

if bearREVState==2
    if bar_index-bearREVShiftBar>revShiftToPOIBars
        bearREVState:=0
        bearREVInvalidationCount+=1
    else
        int idx=f_findREVPOI(bearREVEpisodeId,-1)
        if idx>=0
            UnifiedPOI p=array.get(unifiedPOIs,idx)
            bearREVPOIEngine:=p.sourceEngine
            bearREVPOIId:=p.sourceId
            bearREVPOIType:=p.poiType
            bearREVPOITop:=p.top
            bearREVPOIBottom:=p.bottom
            bearREVArmedBar:=bar_index
            bearREVState:=3

// Keep source POI synchronized. A retired or inverted POI invalidates candidate.
if bullREVState==3 or bullREVState==4
    int idx=f_findUnifiedPOIByKey(bullREVPOIEngine,bullREVPOIId)
    bool invalidPOI=idx<0
    if not invalidPOI
        UnifiedPOI p=array.get(unifiedPOIs,idx)
        invalidPOI:=p.direction!=1
        if not invalidPOI
            bullREVPOIType:=p.poiType
            bullREVPOITop:=p.top
            bullREVPOIBottom:=p.bottom

    bool oppositeBreak=revInvalidateOppositeBreak and (iBearBreak or xBearBreak)
    bool retestExpired=bar_index-bullREVArmedBar>revPOIToRetestBars

    if invalidPOI or oppositeBreak or retestExpired
        bullREVState:=0
        bullREVInvalidationCount+=1
    else
        bool touch=bar_index>bullREVArmedBar and low<=bullREVPOITop and high>=bullREVPOIBottom
        if bullREVState==3 and touch
            bullREVState:=4
            bullREVRetestBar:=bar_index

        if bullREVState==4
            float midpoint=(bullREVPOITop+bullREVPOIBottom)/2.0
            bool directionalReaction=close>open
            bool reaction=revReactionMode=="Midpoint reclaim"?directionalReaction and close>midpoint:directionalReaction
            if barstate.isconfirmed and reaction
                bullREVState:=5
                bullREVEligibleBar:=bar_index
                bullREVEligibleCount+=1
                bullREVEligibleEvent:=true
                int pidx=f_findUnifiedPOIByKey(bullREVPOIEngine,bullREVPOIId)
                int dspPts=f_displacementQualityPoints(bullREVEpisodeId)
                int strPts=f_structureQualityPoints("REV",bullREVShiftScopeUsed,bullREVShiftKindUsed)
                int poiPts=pidx>=0?f_poiQualityPoints(array.get(unifiedPOIs,pidx)):0
                int mitPts=pidx>=0?f_mitigationQualityPoints(array.get(unifiedPOIs,pidx).mitigationPct):0
                int ctxPts=f_revContextPoints(bullREVSweepTier)
                bullREVLastScore:=math.min(dspPts+strPts+poiPts+mitPts+ctxPts,100)
                bullREVLastGrade:=f_qualityGrade(bullREVLastScore)
                bullREVLastBreakdown:="D"+str.tostring(dspPts)+" S"+str.tostring(strPts)+" P"+str.tostring(poiPts)+" M"+str.tostring(mitPts)+" C"+str.tostring(ctxPts)
                if showREVEligibilityMarkers and not modeExecution
                    string qtxt=showQualityInMarkers?" · Q"+str.tostring(bullREVLastScore)+" "+bullREVLastGrade:""
                    label lb=label.new(bar_index,low,"REV ↑ · "+bullREVPOIType+"#"+str.tostring(bullREVPOIId)+qtxt,style=label.style_none,textcolor=bullREVColor,size=f_textSize())
                    array.push(revLabels,lb)

if bearREVState==3 or bearREVState==4
    int idx=f_findUnifiedPOIByKey(bearREVPOIEngine,bearREVPOIId)
    bool invalidPOI=idx<0
    if not invalidPOI
        UnifiedPOI p=array.get(unifiedPOIs,idx)
        invalidPOI:=p.direction!=-1
        if not invalidPOI
            bearREVPOIType:=p.poiType
            bearREVPOITop:=p.top
            bearREVPOIBottom:=p.bottom

    bool oppositeBreak=revInvalidateOppositeBreak and (iBullBreak or xBullBreak)
    bool retestExpired=bar_index-bearREVArmedBar>revPOIToRetestBars

    if invalidPOI or oppositeBreak or retestExpired
        bearREVState:=0
        bearREVInvalidationCount+=1
    else
        bool touch=bar_index>bearREVArmedBar and high>=bearREVPOIBottom and low<=bearREVPOITop
        if bearREVState==3 and touch
            bearREVState:=4
            bearREVRetestBar:=bar_index

        if bearREVState==4
            float midpoint=(bearREVPOITop+bearREVPOIBottom)/2.0
            bool directionalReaction=close<open
            bool reaction=revReactionMode=="Midpoint reclaim"?directionalReaction and close<midpoint:directionalReaction
            if barstate.isconfirmed and reaction
                bearREVState:=5
                bearREVEligibleBar:=bar_index
                bearREVEligibleCount+=1
                bearREVEligibleEvent:=true
                int pidx=f_findUnifiedPOIByKey(bearREVPOIEngine,bearREVPOIId)
                int dspPts=f_displacementQualityPoints(bearREVEpisodeId)
                int strPts=f_structureQualityPoints("REV",bearREVShiftScopeUsed,bearREVShiftKindUsed)
                int poiPts=pidx>=0?f_poiQualityPoints(array.get(unifiedPOIs,pidx)):0
                int mitPts=pidx>=0?f_mitigationQualityPoints(array.get(unifiedPOIs,pidx).mitigationPct):0
                int ctxPts=f_revContextPoints(bearREVSweepTier)
                bearREVLastScore:=math.min(dspPts+strPts+poiPts+mitPts+ctxPts,100)
                bearREVLastGrade:=f_qualityGrade(bearREVLastScore)
                bearREVLastBreakdown:="D"+str.tostring(dspPts)+" S"+str.tostring(strPts)+" P"+str.tostring(poiPts)+" M"+str.tostring(mitPts)+" C"+str.tostring(ctxPts)
                if showREVEligibilityMarkers and not modeExecution
                    string qtxt=showQualityInMarkers?" · Q"+str.tostring(bearREVLastScore)+" "+bearREVLastGrade:""
                    label lb=label.new(bar_index,high,"REV ↓ · "+bearREVPOIType+"#"+str.tostring(bearREVPOIId)+qtxt,style=label.style_none,textcolor=bearREVColor,size=f_textSize())
                    array.push(revLabels,lb)

while array.size(revLabels)>maxREVMarkers
    label.delete(array.shift(revLabels))

f_revStateText(int state) =>
    state==1?"SWEEP":state==2?"SHIFT":state==3?"ARMED":state==4?"RETEST":state==5?"ELIGIBLE":"IDLE"

//=============================================================================
// CONTINUATION SETUP STATE MACHINE
// State: 0 IDLE, 1 IMPULSE/WAITING POI, 2 ARMED, 3 RETEST, 4 ELIGIBLE.
// Trend must pre-exist the qualifying impulse. CHoCH/MSS never starts CONT.
//=============================================================================
var int bullCONTState=0
var int bearCONTState=0
var int bullCONTImpulseBar=na
var int bearCONTImpulseBar=na
var int bullCONTEpisodeId=na
var int bearCONTEpisodeId=na

var string bullCONTPOIEngine="NONE"
var string bearCONTPOIEngine="NONE"
var int bullCONTPOIId=na
var int bearCONTPOIId=na
var string bullCONTPOIType="NONE"
var string bearCONTPOIType="NONE"
var float bullCONTPOITop=na
var float bullCONTPOIBottom=na
var float bearCONTPOITop=na
var float bearCONTPOIBottom=na
var int bullCONTArmedBar=na
var int bearCONTArmedBar=na
var int bullCONTRetestBar=na
var int bearCONTRetestBar=na
var int bullCONTEligibleBar=na
var int bearCONTEligibleBar=na

var int bullCONTEligibleCount=0
var int bearCONTEligibleCount=0
var int bullCONTInvalidationCount=0
var int bearCONTInvalidationCount=0
var string bullCONTBOSScopeUsed="NONE"
var string bearCONTBOSScopeUsed="NONE"
var int bullCONTContextPts=0
var int bearCONTContextPts=0
var int bullCONTLastScore=na
var int bearCONTLastScore=na
var string bullCONTLastGrade="—"
var string bearCONTLastGrade="—"
var string bullCONTLastBreakdown="—"
var string bearCONTLastBreakdown="—"
var label[] contLabels=array.new_label()

bool bullCONTEligibleEvent=false
bool bearCONTEligibleEvent=false

if bullCONTState==4 and barstate.isconfirmed and bar_index>bullCONTEligibleBar
    bullCONTState:=0
if bearCONTState==4 and barstate.isconfirmed and bar_index>bearCONTEligibleBar
    bearCONTState:=0

bool bullTrendPreExisting=contTrendScope=="External"?oldXTrend==1:(oldXTrend==1 and oldITrend==1)
bool bearTrendPreExisting=contTrendScope=="External"?oldXTrend==-1:(oldXTrend==-1 and oldITrend==-1)

bool bullSameDirectionBOS=contBOSScope=="External"?xBullBOS:(iBullBOS or xBullBOS)
bool bearSameDirectionBOS=contBOSScope=="External"?xBearBOS:(iBearBOS or xBearBOS)

bool bullCONTImpulseEvent=barstate.isconfirmed and bullTrendPreExisting and bullDisplacementEvent and episodeActive and episodeDirection==1 and not (iBullCH or xBullCH or iBullMSS or xBullMSS) and (not contRequireBOS or bullSameDirectionBOS)
bool bearCONTImpulseEvent=barstate.isconfirmed and bearTrendPreExisting and bearDisplacementEvent and episodeActive and episodeDirection==-1 and not (iBearCH or xBearCH or iBearMSS or xBearMSS) and (not contRequireBOS or bearSameDirectionBOS)

// A fresh qualifying continuation impulse replaces an unfinished candidate.
if bullCONTImpulseEvent
    bullCONTState:=1
    bullCONTImpulseBar:=bar_index
    bullCONTEpisodeId:=episodeId
    bullCONTBOSScopeUsed:=xBullBOS?"EXTERNAL":iBullBOS?"INTERNAL":"NONE"
    bullCONTContextPts:=oldXTrend==1 and oldITrend==1?15:11
    bullCONTPOIEngine:="NONE"
    bullCONTPOIId:=na
    bullCONTPOIType:="NONE"
    bullCONTArmedBar:=na
    bullCONTRetestBar:=na

if bearCONTImpulseEvent
    bearCONTState:=1
    bearCONTImpulseBar:=bar_index
    bearCONTEpisodeId:=episodeId
    bearCONTBOSScopeUsed:=xBearBOS?"EXTERNAL":iBearBOS?"INTERNAL":"NONE"
    bearCONTContextPts:=oldXTrend==-1 and oldITrend==-1?15:11
    bearCONTPOIEngine:="NONE"
    bearCONTPOIId:=na
    bearCONTPOIType:="NONE"
    bearCONTArmedBar:=na
    bearCONTRetestBar:=na

// Expansion -> same-episode primary Unified POI.
if bullCONTState==1
    if bar_index-bullCONTImpulseBar>contImpulseToPOIBars
        bullCONTState:=0
        bullCONTInvalidationCount+=1
    else
        int idx=f_findCONTPOI(bullCONTEpisodeId,1)
        if idx>=0
            UnifiedPOI p=array.get(unifiedPOIs,idx)
            bullCONTPOIEngine:=p.sourceEngine
            bullCONTPOIId:=p.sourceId
            bullCONTPOIType:=p.poiType
            bullCONTPOITop:=p.top
            bullCONTPOIBottom:=p.bottom
            bullCONTArmedBar:=bar_index
            bullCONTState:=2

if bearCONTState==1
    if bar_index-bearCONTImpulseBar>contImpulseToPOIBars
        bearCONTState:=0
        bearCONTInvalidationCount+=1
    else
        int idx=f_findCONTPOI(bearCONTEpisodeId,-1)
        if idx>=0
            UnifiedPOI p=array.get(unifiedPOIs,idx)
            bearCONTPOIEngine:=p.sourceEngine
            bearCONTPOIId:=p.sourceId
            bearCONTPOIType:=p.poiType
            bearCONTPOITop:=p.top
            bearCONTPOIBottom:=p.bottom
            bearCONTArmedBar:=bar_index
            bearCONTState:=2

// Pullback and reaction. Source POI must remain active with same direction.
if bullCONTState==2 or bullCONTState==3
    int idx=f_findUnifiedPOIByKey(bullCONTPOIEngine,bullCONTPOIId)
    bool invalidPOI=idx<0
    if not invalidPOI
        UnifiedPOI p=array.get(unifiedPOIs,idx)
        invalidPOI:=p.direction!=1
        if not invalidPOI
            bullCONTPOIType:=p.poiType
            bullCONTPOITop:=p.top
            bullCONTPOIBottom:=p.bottom

    bool oppositeShift=contInvalidateOppositeShift and (iBearCH or xBearCH or iBearMSS or xBearMSS)
    bool trendLost=contTrendScope=="External"?xTrend!=1:(xTrend!=1 or iTrend!=1)
    bool retestExpired=bar_index-bullCONTArmedBar>contPOIToRetestBars

    if invalidPOI or oppositeShift or trendLost or retestExpired
        bullCONTState:=0
        bullCONTInvalidationCount+=1
    else
        bool touch=bar_index>bullCONTArmedBar and low<=bullCONTPOITop and high>=bullCONTPOIBottom
        if bullCONTState==2 and touch
            bullCONTState:=3
            bullCONTRetestBar:=bar_index

        if bullCONTState==3
            float midpoint=(bullCONTPOITop+bullCONTPOIBottom)/2.0
            bool directionalReaction=close>open
            bool reaction=contReactionMode=="Midpoint reclaim"?directionalReaction and close>midpoint:directionalReaction
            if barstate.isconfirmed and reaction
                bullCONTState:=4
                bullCONTEligibleBar:=bar_index
                bullCONTEligibleCount+=1
                bullCONTEligibleEvent:=true
                int pidx=f_findUnifiedPOIByKey(bullCONTPOIEngine,bullCONTPOIId)
                int dspPts=f_displacementQualityPoints(bullCONTEpisodeId)
                int strPts=f_structureQualityPoints("CONT",bullCONTBOSScopeUsed,"BOS")
                int poiPts=pidx>=0?f_poiQualityPoints(array.get(unifiedPOIs,pidx)):0
                int mitPts=pidx>=0?f_mitigationQualityPoints(array.get(unifiedPOIs,pidx).mitigationPct):0
                int ctxPts=bullCONTContextPts
                bullCONTLastScore:=math.min(dspPts+strPts+poiPts+mitPts+ctxPts,100)
                bullCONTLastGrade:=f_qualityGrade(bullCONTLastScore)
                bullCONTLastBreakdown:="D"+str.tostring(dspPts)+" S"+str.tostring(strPts)+" P"+str.tostring(poiPts)+" M"+str.tostring(mitPts)+" C"+str.tostring(ctxPts)
                if showCONTEligibilityMarkers and not modeExecution
                    string qtxt=showQualityInMarkers?" · Q"+str.tostring(bullCONTLastScore)+" "+bullCONTLastGrade:""
                    label lb=label.new(bar_index,low,"CONT ↑ · "+bullCONTPOIType+"#"+str.tostring(bullCONTPOIId)+qtxt,style=label.style_none,textcolor=bullCONTColor,size=f_textSize())
                    array.push(contLabels,lb)

if bearCONTState==2 or bearCONTState==3
    int idx=f_findUnifiedPOIByKey(bearCONTPOIEngine,bearCONTPOIId)
    bool invalidPOI=idx<0
    if not invalidPOI
        UnifiedPOI p=array.get(unifiedPOIs,idx)
        invalidPOI:=p.direction!=-1
        if not invalidPOI
            bearCONTPOIType:=p.poiType
            bearCONTPOITop:=p.top
            bearCONTPOIBottom:=p.bottom

    bool oppositeShift=contInvalidateOppositeShift and (iBullCH or xBullCH or iBullMSS or xBullMSS)
    bool trendLost=contTrendScope=="External"?xTrend!=-1:(xTrend!=-1 or iTrend!=-1)
    bool retestExpired=bar_index-bearCONTArmedBar>contPOIToRetestBars

    if invalidPOI or oppositeShift or trendLost or retestExpired
        bearCONTState:=0
        bearCONTInvalidationCount+=1
    else
        bool touch=bar_index>bearCONTArmedBar and high>=bearCONTPOIBottom and low<=bearCONTPOITop
        if bearCONTState==2 and touch
            bearCONTState:=3
            bearCONTRetestBar:=bar_index

        if bearCONTState==3
            float midpoint=(bearCONTPOITop+bearCONTPOIBottom)/2.0
            bool directionalReaction=close<open
            bool reaction=contReactionMode=="Midpoint reclaim"?directionalReaction and close<midpoint:directionalReaction
            if barstate.isconfirmed and reaction
                bearCONTState:=4
                bearCONTEligibleBar:=bar_index
                bearCONTEligibleCount+=1
                bearCONTEligibleEvent:=true
                int pidx=f_findUnifiedPOIByKey(bearCONTPOIEngine,bearCONTPOIId)
                int dspPts=f_displacementQualityPoints(bearCONTEpisodeId)
                int strPts=f_structureQualityPoints("CONT",bearCONTBOSScopeUsed,"BOS")
                int poiPts=pidx>=0?f_poiQualityPoints(array.get(unifiedPOIs,pidx)):0
                int mitPts=pidx>=0?f_mitigationQualityPoints(array.get(unifiedPOIs,pidx).mitigationPct):0
                int ctxPts=bearCONTContextPts
                bearCONTLastScore:=math.min(dspPts+strPts+poiPts+mitPts+ctxPts,100)
                bearCONTLastGrade:=f_qualityGrade(bearCONTLastScore)
                bearCONTLastBreakdown:="D"+str.tostring(dspPts)+" S"+str.tostring(strPts)+" P"+str.tostring(poiPts)+" M"+str.tostring(mitPts)+" C"+str.tostring(ctxPts)
                if showCONTEligibilityMarkers and not modeExecution
                    string qtxt=showQualityInMarkers?" · Q"+str.tostring(bearCONTLastScore)+" "+bearCONTLastGrade:""
                    label lb=label.new(bar_index,high,"CONT ↓ · "+bearCONTPOIType+"#"+str.tostring(bearCONTPOIId)+qtxt,style=label.style_none,textcolor=bearCONTColor,size=f_textSize())
                    array.push(contLabels,lb)

while array.size(contLabels)>maxCONTMarkers
    label.delete(array.shift(contLabels))

f_contStateText(int state) =>
    state==1?"IMPULSE":state==2?"ARMED":state==3?"RETEST":state==4?"ELIGIBLE":"IDLE"

f_reactionQuality(UnifiedPOI p,string family,string structureScope,string structureKind,int contextPts) =>
    int dspPts=na(p.episodeId)?int(math.round(math.min(math.max(p.displacementScore,0),100)*0.30)):f_displacementQualityPoints(p.episodeId)
    int strPts=f_structureQualityPoints(family,structureScope,structureKind)
    int poiPts=f_poiQualityPoints(p)
    int mitPts=f_mitigationQualityPoints(p.mitigationPct)
    math.min(dspPts+strPts+poiPts+mitPts+contextPts,100)

//=============================================================================
// SIGNAL ENGINE
// Eligibility event + score threshold + duplicate/cooldown suppression.
// This layer does not mutate REV/CONT setup state or quality.
//=============================================================================
bool bullREVSignal=false
bool bearREVSignal=false
bool bullCONTSignal=false
bool bearCONTSignal=false

bool bullREVQualityOK=enableREVSignals and bullREVEligibleEvent and not na(bullREVLastScore) and bullREVLastScore>=minREVSignalScore and (not useTrendFilter or trendBullAllowed)
bool bearREVQualityOK=enableREVSignals and bearREVEligibleEvent and not na(bearREVLastScore) and bearREVLastScore>=minREVSignalScore and (not useTrendFilter or trendBearAllowed)
bool bullCONTQualityOK=enableCONTSignals and bullCONTEligibleEvent and not na(bullCONTLastScore) and bullCONTLastScore>=minCONTSignalScore and (not useTrendFilter or trendBullAllowed)
bool bearCONTQualityOK=enableCONTSignals and bearCONTEligibleEvent and not na(bearCONTLastScore) and bearCONTLastScore>=minCONTSignalScore and (not useTrendFilter or trendBearAllowed)

bool bullREVDuplicate=bullREVEligibleEvent and f_signalDuplicate("REV",bullREVEpisodeId,bullREVPOIEngine,bullREVPOIId)
bool bearREVDuplicate=bearREVEligibleEvent and f_signalDuplicate("REV",bearREVEpisodeId,bearREVPOIEngine,bearREVPOIId)
bool bullCONTDuplicate=bullCONTEligibleEvent and f_signalDuplicate("CONT",bullCONTEpisodeId,bullCONTPOIEngine,bullCONTPOIId)
bool bearCONTDuplicate=bearCONTEligibleEvent and f_signalDuplicate("CONT",bearCONTEpisodeId,bearCONTPOIEngine,bearCONTPOIId)

if bullREVEligibleEvent and enableREVSignals
    if not bullREVQualityOK
        signalRejectedQuality+=1
    else if bullREVDuplicate
        signalRejectedDuplicate+=1
    else if not f_signalAdmissionOK(1,3)
        signalRejectedConflict+=1
    else
        bullREVSignal:=true
        bullSignalCount+=1
        revSignalCount+=1
        lastBullSignalBar:=bar_index
        lastBullSignalPriority:=3
        lastBullSignalSource:="NORMAL"
        lastSignalText:="REV BULL · Q"+str.tostring(bullREVLastScore)+" "+bullREVLastGrade+" · EP"+str.tostring(bullREVEpisodeId)+" · POI"+str.tostring(bullREVPOIId)
        array.push(signalHistory,SignalRecord.new("REV",1,bullREVEpisodeId,bullREVPOIEngine,bullREVPOIId,bar_index,bullREVLastScore,"NORMAL",3))
        label sigLb=f_signalEntryMarker(1,"REV",bullREVLastScore,bullREVLastGrade)
        if not na(sigLb)
            array.push(signalLabels,sigLb)

if bearREVEligibleEvent and enableREVSignals
    if not bearREVQualityOK
        signalRejectedQuality+=1
    else if bearREVDuplicate
        signalRejectedDuplicate+=1
    else if not f_signalAdmissionOK(-1,3)
        signalRejectedConflict+=1
    else
        bearREVSignal:=true
        bearSignalCount+=1
        revSignalCount+=1
        lastBearSignalBar:=bar_index
        lastBearSignalPriority:=3
        lastBearSignalSource:="NORMAL"
        lastSignalText:="REV BEAR · Q"+str.tostring(bearREVLastScore)+" "+bearREVLastGrade+" · EP"+str.tostring(bearREVEpisodeId)+" · POI"+str.tostring(bearREVPOIId)
        array.push(signalHistory,SignalRecord.new("REV",-1,bearREVEpisodeId,bearREVPOIEngine,bearREVPOIId,bar_index,bearREVLastScore,"NORMAL",3))
        label sigLb=f_signalEntryMarker(-1,"REV",bearREVLastScore,bearREVLastGrade)
        if not na(sigLb)
            array.push(signalLabels,sigLb)

if bullCONTEligibleEvent and enableCONTSignals
    if not bullCONTQualityOK
        signalRejectedQuality+=1
    else if bullCONTDuplicate
        signalRejectedDuplicate+=1
    else if not f_signalAdmissionOK(1,3)
        signalRejectedConflict+=1
    else
        bullCONTSignal:=true
        bullSignalCount+=1
        contSignalCount+=1
        lastBullSignalBar:=bar_index
        lastBullSignalPriority:=3
        lastBullSignalSource:="NORMAL"
        lastSignalText:="CONT BULL · Q"+str.tostring(bullCONTLastScore)+" "+bullCONTLastGrade+" · EP"+str.tostring(bullCONTEpisodeId)+" · POI"+str.tostring(bullCONTPOIId)
        array.push(signalHistory,SignalRecord.new("CONT",1,bullCONTEpisodeId,bullCONTPOIEngine,bullCONTPOIId,bar_index,bullCONTLastScore,"NORMAL",3))
        label sigLb=f_signalEntryMarker(1,"CONT",bullCONTLastScore,bullCONTLastGrade)
        if not na(sigLb)
            array.push(signalLabels,sigLb)

if bearCONTEligibleEvent and enableCONTSignals
    if not bearCONTQualityOK
        signalRejectedQuality+=1
    else if bearCONTDuplicate
        signalRejectedDuplicate+=1
    else if not f_signalAdmissionOK(-1,3)
        signalRejectedConflict+=1
    else
        bearCONTSignal:=true
        bearSignalCount+=1
        contSignalCount+=1
        lastBearSignalBar:=bar_index
        lastBearSignalPriority:=3
        lastBearSignalSource:="NORMAL"
        lastSignalText:="CONT BEAR · Q"+str.tostring(bearCONTLastScore)+" "+bearCONTLastGrade+" · EP"+str.tostring(bearCONTEpisodeId)+" · POI"+str.tostring(bearCONTPOIId)
        array.push(signalHistory,SignalRecord.new("CONT",-1,bearCONTEpisodeId,bearCONTPOIEngine,bearCONTPOIId,bar_index,bearCONTLastScore,"NORMAL",3))
        label sigLb=f_signalEntryMarker(-1,"CONT",bearCONTLastScore,bearCONTLastGrade)
        if not na(sigLb)
            array.push(signalLabels,sigLb)

while array.size(signalHistory)>120
    array.shift(signalHistory)

while array.size(signalLabels)>maxSignalMarkers
    label.delete(array.shift(signalLabels))

//=============================================================================
// ADAPTIVE REACTION SIGNAL ENGINE
// Converts confirmed MISSED and EARLY opportunities into normal execution signals.
// RAW reactions are ignored.
//=============================================================================
var string bullRxEngine="NONE"
var string bearRxEngine="NONE"
var int bullRxPOIId=na
var int bearRxPOIId=na
var string bullRxPOIType="NONE"
var string bearRxPOIType="NONE"
var string bullRxClass="NONE"
var string bearRxClass="NONE"
var string bullRxFamily="NONE"
var string bearRxFamily="NONE"
var string bullRxKind="NONE"   // MISSED | EARLY
var string bearRxKind="NONE"
var float bullRxTop=na
var float bullRxBottom=na
var float bearRxTop=na
var float bearRxBottom=na
var int bullRxStart=na
var int bearRxStart=na
var int bullRxDeadline=na
var int bearRxDeadline=na

var int lastBullCONTContextBar=na
var int lastBearCONTContextBar=na
var int lastBullREVContextBar=na
var int lastBearREVContextBar=na
var int lastStructuralResetBar=na
var int lastBullEarlySignalBar=na
var int lastBearEarlySignalBar=na
var int lastBullEarlyEpisodeId=na
var int lastBearEarlyEpisodeId=na
var string lastBullREVScope="INTERNAL"
var string lastBearREVScope="INTERNAL"
var string lastBullREVKind="CHoCH"
var string lastBearREVKind="CHoCH"
var string lastBullCONTScope="INTERNAL"
var string lastBearCONTScope="INTERNAL"

f_earlyReentryAllowed(int epId,int lastEarlyBar,int lastEarlyEpisodeId,int resetBar,int oppositeSignalBar) =>
    bool first=na(lastEarlyBar)
    bool newEpisode=not na(epId) and (na(lastEarlyEpisodeId) or epId!=lastEarlyEpisodeId)
    bool structureReset=not na(resetBar) and not na(lastEarlyBar) and resetBar>lastEarlyBar
    bool oppositeSignal=not na(oppositeSignalBar) and not na(lastEarlyBar) and oppositeSignalBar>lastEarlyBar
    not suppressRepeatedEarly or first or newEpisode or structureReset or oppositeSignal

bool reactionSignalEvent=false
string reactionFamily="NONE"
string reactionKind="NONE"
int reactionDir=0
int reactionEpisodeId=na
string reactionPOIEngine="NONE"
int reactionPOIId=na
string reactionPOIType="NONE"
int reactionScore=na
string reactionGrade="—"
float reactionSweepPrice=na

if bullDisplacementEvent or iBullBOS or xBullBOS
    lastBullCONTContextBar:=bar_index
    lastBullCONTScope:=xBullBOS?"EXTERNAL":"INTERNAL"
if bearDisplacementEvent or iBearBOS or xBearBOS
    lastBearCONTContextBar:=bar_index
    lastBearCONTScope:=xBearBOS?"EXTERNAL":"INTERNAL"

if iBullCH or xBullCH or iBullMSS or xBullMSS
    lastStructuralResetBar:=bar_index
    lastBullREVContextBar:=bar_index
    lastBullREVScope:=(xBullMSS or xBullCH)?"EXTERNAL":"INTERNAL"
    lastBullREVKind:=xBullMSS?"MSS":xBullCH?"CHoCH":iBullMSS?"MSS":"CHoCH"
if iBearCH or xBearCH or iBearMSS or xBearMSS
    lastStructuralResetBar:=bar_index
    lastBearREVContextBar:=bar_index
    lastBearREVScope:=(xBearMSS or xBearCH)?"EXTERNAL":"INTERNAL"
    lastBearREVKind:=xBearMSS?"MSS":xBearCH?"CHoCH":iBearMSS?"MSS":"CHoCH"

f_poiFillReached(int dir,float top,float bottom) =>
    float poiHeight=math.max(top-bottom,syminfo.mintick)
    // Wick-based penetration is cumulative: a deeper fill satisfies every lower threshold.
    float penetrationPct=dir==1?(top-low)/poiHeight*100.0:(high-bottom)/poiHeight*100.0
    bool reached15=penetrationPct>=15.0
    bool reached25=penetrationPct>=25.0
    bool reached50=penetrationPct>=50.0
    bool reached75=penetrationPct>=75.0
    bool reached100=penetrationPct>=100.0
    bool reachedSweep=dir==1?low<bottom:high>top
    reactionPOIFillTrigger=="15%"?reached15:reactionPOIFillTrigger=="25%"?reached25:reactionPOIFillTrigger=="50%"?reached50:reactionPOIFillTrigger=="75%"?reached75:reactionPOIFillTrigger=="100%"?reached100:reachedSweep

f_auditInteractionPOI(int dir) =>
    int found=-1
    string klass="NONE"
    int bestContextRank=-1
    float bestDistance=na
    if enableReactionSignals and array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            bool familyOK=not auditPrimaryOnly or p.primary
            bool touch=p.direction==dir and familyOK and f_poiFillReached(dir,p.top,p.bottom)
            if touch
                bool missREV=dir==1?(bullREVState>=3 and bullREVState<=4 and p.sourceEngine==bullREVPOIEngine and p.sourceId==bullREVPOIId):(bearREVState>=3 and bearREVState<=4 and p.sourceEngine==bearREVPOIEngine and p.sourceId==bearREVPOIId)
                bool missCONT=dir==1?(bullCONTState>=2 and bullCONTState<=3 and p.sourceEngine==bullCONTPOIEngine and p.sourceId==bullCONTPOIId):(bearCONTState>=2 and bearCONTState<=3 and p.sourceEngine==bearCONTPOIEngine and p.sourceId==bearCONTPOIId)
                bool recentREV=dir==1?(not na(lastBullREVContextBar) and bar_index-lastBullREVContextBar<=auditContextBars and (na(lastBearREVContextBar) or lastBullREVContextBar>lastBearREVContextBar)):(not na(lastBearREVContextBar) and bar_index-lastBearREVContextBar<=auditContextBars and (na(lastBullREVContextBar) or lastBearREVContextBar>lastBullREVContextBar))
                bool recentCONT=dir==1?(xTrend==1 and not na(lastBullCONTContextBar) and bar_index-lastBullCONTContextBar<=auditContextBars and (na(lastBearCONTContextBar) or lastBullCONTContextBar>lastBearCONTContextBar)):(xTrend==-1 and not na(lastBearCONTContextBar) and bar_index-lastBearCONTContextBar<=auditContextBars and (na(lastBullCONTContextBar) or lastBearCONTContextBar>lastBullCONTContextBar))
                int contextRank=(missREV or missCONT)?3:(recentREV or recentCONT)?2:1
                bool sweptBoundary=dir==1?low<p.bottom:high>p.top
                float sweepBeyond=sweptBoundary?(dir==1?p.bottom-low:high-p.top):0.0
                bool sweepWithin=not sweptBoundary or na(atr) or sweepBeyond<=auditMaxSweepBeyondATR*atr
                string thisClass=(p.poiType=="IFVG" or p.poiType=="BB")?"FLIP_RETEST":sweptBoundary and sweepWithin?"SWEEP_RECLAIM":"REJECTION"
                float d=math.abs(close-(p.top+p.bottom)*0.5)
                bool better=contextRank>bestContextRank or (contextRank==bestContextRank and (na(bestDistance) or d<bestDistance))
                if better
                    found:=n
                    klass:=thisClass
                    bestContextRank:=contextRank
                    bestDistance:=d
    [found,klass]

[bullRxIdx,bullRxDetectedClass]=f_auditInteractionPOI(1)
[bearRxIdx,bearRxDetectedClass]=f_auditInteractionPOI(-1)

if enableReactionSignals and bullRxIdx>=0 and na(bullRxPOIId)
    UnifiedPOI p=array.get(unifiedPOIs,bullRxIdx)
    bool missREV=bullREVState>=3 and bullREVState<=4 and p.sourceEngine==bullREVPOIEngine and p.sourceId==bullREVPOIId
    bool missCONT=bullCONTState>=2 and bullCONTState<=3 and p.sourceEngine==bullCONTPOIEngine and p.sourceId==bullCONTPOIId
    bool recentREV=not na(lastBullREVContextBar) and bar_index-lastBullREVContextBar<=auditContextBars and (na(lastBearREVContextBar) or lastBullREVContextBar>lastBearREVContextBar)
    bool recentCONT=xTrend==1 and not na(lastBullCONTContextBar) and bar_index-lastBullCONTContextBar<=auditContextBars and (na(lastBearCONTContextBar) or lastBullCONTContextBar>lastBearCONTContextBar)
    string kind=(missREV or missCONT)?"MISSED":(recentREV or recentCONT)?"EARLY":"RAW"
    string fam=missREV?"REV":missCONT?"CONT":recentREV and (not recentCONT or lastBullREVContextBar>=lastBullCONTContextBar)?"REV":recentCONT?"CONT":"NONE"
    if kind!="RAW"
        bullRxEngine:=p.sourceEngine
        bullRxPOIId:=p.sourceId
        bullRxPOIType:=p.poiType
        bullRxClass:=bullRxDetectedClass
        bullRxFamily:=fam
        bullRxKind:=kind
        bullRxTop:=p.top
        bullRxBottom:=p.bottom
        bullRxStart:=bar_index
        bullRxDeadline:=bar_index+auditConfirmBars-1

if enableReactionSignals and bearRxIdx>=0 and na(bearRxPOIId)
    UnifiedPOI p=array.get(unifiedPOIs,bearRxIdx)
    bool missREV=bearREVState>=3 and bearREVState<=4 and p.sourceEngine==bearREVPOIEngine and p.sourceId==bearREVPOIId
    bool missCONT=bearCONTState>=2 and bearCONTState<=3 and p.sourceEngine==bearCONTPOIEngine and p.sourceId==bearCONTPOIId
    bool recentREV=not na(lastBearREVContextBar) and bar_index-lastBearREVContextBar<=auditContextBars and (na(lastBullREVContextBar) or lastBearREVContextBar>lastBullREVContextBar)
    bool recentCONT=xTrend==-1 and not na(lastBearCONTContextBar) and bar_index-lastBearCONTContextBar<=auditContextBars and (na(lastBullCONTContextBar) or lastBearCONTContextBar>lastBullCONTContextBar)
    string kind=(missREV or missCONT)?"MISSED":(recentREV or recentCONT)?"EARLY":"RAW"
    string fam=missREV?"REV":missCONT?"CONT":recentREV and (not recentCONT or lastBearREVContextBar>=lastBearCONTContextBar)?"REV":recentCONT?"CONT":"NONE"
    if kind!="RAW"
        bearRxEngine:=p.sourceEngine
        bearRxPOIId:=p.sourceId
        bearRxPOIType:=p.poiType
        bearRxClass:=bearRxDetectedClass
        bearRxFamily:=fam
        bearRxKind:=kind
        bearRxTop:=p.top
        bearRxBottom:=p.bottom
        bearRxStart:=bar_index
        bearRxDeadline:=bar_index+auditConfirmBars-1

if not na(bullRxPOIId)
    int liveIdx=f_findUnifiedPOIByKey(bullRxEngine,bullRxPOIId)
    bool stillValid=liveIdx>=0 and array.get(unifiedPOIs,liveIdx).direction==1
    if stillValid
        UnifiedPOI live=array.get(unifiedPOIs,liveIdx)
        bullRxTop:=live.top
        bullRxBottom:=live.bottom
    bool timingOK=bar_index<=bullRxDeadline and (bullRxKind=="MISSED"?(auditAllowSameBar or bar_index>bullRxStart):(bar_index-bullRxStart>=earlyMinBarsAfterTouch))
    bool confirmed=stillValid and timingOK and barstate.isconfirmed and f_auditCloseConfirmed(1,bullRxTop,bullRxBottom,bullRxClass)
    bool alreadyCaptured=not na(lastBullSignalBar) and lastBullSignalBar>=bullRxStart and lastBullSignalBar<=bar_index
    if confirmed and not alreadyCaptured
        UnifiedPOI p=array.get(unifiedPOIs,liveIdx)
        bool isMiss=bullRxKind=="MISSED"
        bool allowed=(isMiss and signalMissedReactions) or (not isMiss and signalEarlyReactions)
        string scope=bullRxFamily=="REV"?(isMiss?bullREVShiftScopeUsed:lastBullREVScope):(isMiss?bullCONTBOSScopeUsed:lastBullCONTScope)
        string kind=bullRxFamily=="REV"?(isMiss?bullREVShiftKindUsed:lastBullREVKind):"BOS"
        int contextPts=bullRxFamily=="REV"?(isMiss?f_revContextPoints(bullREVSweepTier):10):(isMiss?bullCONTContextPts:15)
        int score=f_reactionQuality(p,bullRxFamily,scope,kind,contextPts)
        int minScore=isMiss?(bullRxFamily=="REV"?minREVSignalScore:minCONTSignalScore):earlySignalMinScore
        int epId=isMiss?(bullRxFamily=="REV"?bullREVEpisodeId:bullCONTEpisodeId):p.episodeId
        bool duplicate=f_signalDuplicate(bullRxFamily,epId,bullRxEngine,bullRxPOIId)
        bool earlyFrequencyOK=isMiss or f_earlyReentryAllowed(epId,lastBullEarlySignalBar,lastBullEarlyEpisodeId,lastStructuralResetBar,lastBearSignalBar)
        int rxPriority=isMiss?2:1
        if allowed and earlyFrequencyOK and not na(epId) and score>=minScore and f_signalAdmissionOK(1,rxPriority) and not duplicate and (not useTrendFilter or trendBullAllowed)
            reactionSignalEvent:=true
            reactionFamily:=bullRxFamily
            reactionKind:=isMiss?"MISS":"EARLY"
            reactionDir:=1
            reactionEpisodeId:=epId
            reactionPOIEngine:=bullRxEngine
            reactionPOIId:=bullRxPOIId
            reactionPOIType:=bullRxPOIType
            reactionScore:=score
            reactionGrade:=f_qualityGrade(score)
            reactionSweepPrice:=isMiss and bullRxFamily=="REV"?bullREVSweepPrice:na
        bullRxPOIId:=na
        bullRxKind:="NONE"
    else if not stillValid or bar_index>bullRxDeadline
        bullRxPOIId:=na
        bullRxKind:="NONE"

if not na(bearRxPOIId)
    int liveIdx=f_findUnifiedPOIByKey(bearRxEngine,bearRxPOIId)
    bool stillValid=liveIdx>=0 and array.get(unifiedPOIs,liveIdx).direction==-1
    if stillValid
        UnifiedPOI live=array.get(unifiedPOIs,liveIdx)
        bearRxTop:=live.top
        bearRxBottom:=live.bottom
    bool timingOK=bar_index<=bearRxDeadline and (bearRxKind=="MISSED"?(auditAllowSameBar or bar_index>bearRxStart):(bar_index-bearRxStart>=earlyMinBarsAfterTouch))
    bool confirmed=stillValid and timingOK and barstate.isconfirmed and f_auditCloseConfirmed(-1,bearRxTop,bearRxBottom,bearRxClass)
    bool alreadyCaptured=not na(lastBearSignalBar) and lastBearSignalBar>=bearRxStart and lastBearSignalBar<=bar_index
    if confirmed and not alreadyCaptured
        UnifiedPOI p=array.get(unifiedPOIs,liveIdx)
        bool isMiss=bearRxKind=="MISSED"
        bool allowed=(isMiss and signalMissedReactions) or (not isMiss and signalEarlyReactions)
        string scope=bearRxFamily=="REV"?(isMiss?bearREVShiftScopeUsed:lastBearREVScope):(isMiss?bearCONTBOSScopeUsed:lastBearCONTScope)
        string kind=bearRxFamily=="REV"?(isMiss?bearREVShiftKindUsed:lastBearREVKind):"BOS"
        int contextPts=bearRxFamily=="REV"?(isMiss?f_revContextPoints(bearREVSweepTier):10):(isMiss?bearCONTContextPts:15)
        int score=f_reactionQuality(p,bearRxFamily,scope,kind,contextPts)
        int minScore=isMiss?(bearRxFamily=="REV"?minREVSignalScore:minCONTSignalScore):earlySignalMinScore
        int epId=isMiss?(bearRxFamily=="REV"?bearREVEpisodeId:bearCONTEpisodeId):p.episodeId
        bool duplicate=f_signalDuplicate(bearRxFamily,epId,bearRxEngine,bearRxPOIId)
        bool earlyFrequencyOK=isMiss or f_earlyReentryAllowed(epId,lastBearEarlySignalBar,lastBearEarlyEpisodeId,lastStructuralResetBar,lastBullSignalBar)
        int rxPriority=isMiss?2:1
        if allowed and earlyFrequencyOK and not na(epId) and score>=minScore and f_signalAdmissionOK(-1,rxPriority) and not duplicate and (not useTrendFilter or trendBearAllowed)
            reactionSignalEvent:=true
            reactionFamily:=bearRxFamily
            reactionKind:=isMiss?"MISS":"EARLY"
            reactionDir:=-1
            reactionEpisodeId:=epId
            reactionPOIEngine:=bearRxEngine
            reactionPOIId:=bearRxPOIId
            reactionPOIType:=bearRxPOIType
            reactionScore:=score
            reactionGrade:=f_qualityGrade(score)
            reactionSweepPrice:=isMiss and bearRxFamily=="REV"?bearREVSweepPrice:na
        bearRxPOIId:=na
        bearRxKind:="NONE"
    else if not stillValid or bar_index>bearRxDeadline
        bearRxPOIId:=na
        bearRxKind:="NONE"

if reactionSignalEvent
    if reactionDir==1
        bullSignalCount+=1
        lastBullSignalBar:=bar_index
        lastBullSignalPriority:=reactionKind=="MISS"?2:1
        lastBullSignalSource:=reactionKind
        if reactionKind=="EARLY"
            lastBullEarlySignalBar:=bar_index
            lastBullEarlyEpisodeId:=reactionEpisodeId
        if reactionFamily=="REV"
            bullREVSignal:=true
            bullREVLastScore:=reactionScore
            bullREVLastGrade:=reactionGrade
            revSignalCount+=1
        else
            bullCONTSignal:=true
            bullCONTLastScore:=reactionScore
            bullCONTLastGrade:=reactionGrade
            contSignalCount+=1
    else
        bearSignalCount+=1
        lastBearSignalBar:=bar_index
        lastBearSignalPriority:=reactionKind=="MISS"?2:1
        lastBearSignalSource:=reactionKind
        if reactionKind=="EARLY"
            lastBearEarlySignalBar:=bar_index
            lastBearEarlyEpisodeId:=reactionEpisodeId
        if reactionFamily=="REV"
            bearREVSignal:=true
            bearREVLastScore:=reactionScore
            bearREVLastGrade:=reactionGrade
            revSignalCount+=1
        else
            bearCONTSignal:=true
            bearCONTLastScore:=reactionScore
            bearCONTLastGrade:=reactionGrade
            contSignalCount+=1
    lastSignalText:=(reactionFamily=="REV"?"REV ":"CONT ")+(reactionDir==1?"BULL":"BEAR")+" · "+reactionKind+" · Q"+str.tostring(reactionScore)+" "+reactionGrade
    array.push(signalHistory,SignalRecord.new(reactionFamily,reactionDir,reactionEpisodeId,reactionPOIEngine,reactionPOIId,bar_index,reactionScore,reactionKind,reactionKind=="MISS"?2:1))
    label rxLb=f_signalEntryMarker(reactionDir,reactionFamily,reactionScore,reactionGrade)
    if not na(rxLb)
        array.push(signalLabels,rxLb)

//=============================================================================
// SAME-BAR SIGNAL ARBITRATION
// A single risk plan must map to one family, direction, POI and marker.
//=============================================================================
bool hasCurrentSignal=false
int selectedDirection=0
string selectedFamily="NONE"
string selectedSource="NONE"
int selectedEpisodeId=na
string selectedPOIEngine="NONE"
int selectedPOIId=na
int selectedScore=na
int selectedPriority=-1
int selectedFamilyRank=-1
bool topRankDirectionConflict=false

if array.size(signalHistory)>0
    for n=0 to array.size(signalHistory)-1
        SignalRecord sr=array.get(signalHistory,n)
        if sr.bar==bar_index
            hasCurrentSignal:=true
            int candidateFamilyRank=sr.family=="REV"?1:0
            bool better=sr.priority>selectedPriority or (sr.priority==selectedPriority and sr.score>selectedScore) or (sr.priority==selectedPriority and sr.score==selectedScore and candidateFamilyRank>selectedFamilyRank)
            bool equalRank=sr.priority==selectedPriority and sr.score==selectedScore and candidateFamilyRank==selectedFamilyRank
            if better
                selectedDirection:=sr.direction
                selectedFamily:=sr.family
                selectedSource:=sr.source
                selectedEpisodeId:=sr.episodeId
                selectedPOIEngine:=sr.poiEngine
                selectedPOIId:=sr.poiId
                selectedScore:=sr.score
                selectedPriority:=sr.priority
                selectedFamilyRank:=candidateFamilyRank
                topRankDirectionConflict:=false
            else if equalRank and sr.direction!=selectedDirection
                topRankDirectionConflict:=true

bool selectedSignalValid=hasCurrentSignal and not topRankDirectionConflict

if hasCurrentSignal
    // Remove every unselected same-bar signal record. Keep one exact winner only.
    bool keptSelectedRecord=false
    for n=array.size(signalHistory)-1 to 0
        SignalRecord sr=array.get(signalHistory,n)
        if sr.bar==bar_index
            bool matchesWinner=selectedSignalValid and sr.family==selectedFamily and sr.direction==selectedDirection and sr.episodeId==selectedEpisodeId and sr.poiEngine==selectedPOIEngine and sr.poiId==selectedPOIId and sr.score==selectedScore and sr.source==selectedSource and sr.priority==selectedPriority
            if matchesWinner and not keptSelectedRecord
                keptSelectedRecord:=true
            else
                if sr.direction==1
                    bullSignalCount:=math.max(0,bullSignalCount-1)
                else
                    bearSignalCount:=math.max(0,bearSignalCount-1)
                if sr.family=="REV"
                    revSignalCount:=math.max(0,revSignalCount-1)
                else
                    contSignalCount:=math.max(0,contSignalCount-1)
                array.remove(signalHistory,n)

    // Remove markers from same-bar candidates that did not win arbitration.
    // Guard the reverse loop: an empty array would otherwise start at index -1.
    if array.size(signalLabels)>0
        for n=array.size(signalLabels)-1 to 0
            label candidate=array.get(signalLabels,n)
            if not na(candidate) and label.get_x(candidate)==bar_index
                string candidateText=label.get_text(candidate)
                int candidateDirection=(str.startswith(candidateText,"▲ ") or str.startswith(candidateText,"BUY "))?1:(str.startswith(candidateText,"▼ ") or str.startswith(candidateText,"SELL "))?-1:0
                string candidateFamily=(str.startswith(candidateText,"▲ R") or str.startswith(candidateText,"BUY REV"))?"REV":(str.startswith(candidateText,"▲ C") or str.startswith(candidateText,"BUY CONT") or str.startswith(candidateText,"▼ C") or str.startswith(candidateText,"SELL CONT"))?"CONT":(str.startswith(candidateText,"▼ R") or str.startswith(candidateText,"SELL REV"))?"REV":"NONE"
                bool keepMarker=selectedSignalValid and candidateDirection==selectedDirection and candidateFamily==selectedFamily
                if not keepMarker
                    label.delete(candidate)
                    array.remove(signalLabels,n)

    if topRankDirectionConflict
        signalRejectedConflict+=1

    bullREVSignal:=selectedSignalValid and selectedFamily=="REV" and selectedDirection==1
    bearREVSignal:=selectedSignalValid and selectedFamily=="REV" and selectedDirection==-1
    bullCONTSignal:=selectedSignalValid and selectedFamily=="CONT" and selectedDirection==1
    bearCONTSignal:=selectedSignalValid and selectedFamily=="CONT" and selectedDirection==-1
    reactionSignalEvent:=selectedSignalValid and selectedSource!="NORMAL"

    if reactionSignalEvent
        reactionFamily:=selectedFamily
        reactionKind:=selectedSource
        reactionDir:=selectedDirection
        reactionEpisodeId:=selectedEpisodeId
        reactionPOIEngine:=selectedPOIEngine
        reactionPOIId:=selectedPOIId
        reactionScore:=selectedScore
        reactionGrade:=f_qualityGrade(selectedScore)

    // Rebuild same-direction conflict state and EARLY suppression from retained history.
    lastBullSignalBar:=na
    lastBearSignalBar:=na
    lastBullSignalPriority:=0
    lastBearSignalPriority:=0
    lastBullSignalSource:="NONE"
    lastBearSignalSource:="NONE"
    lastBullEarlySignalBar:=na
    lastBearEarlySignalBar:=na
    lastBullEarlyEpisodeId:=na
    lastBearEarlyEpisodeId:=na

    if array.size(signalHistory)>0
        for n=0 to array.size(signalHistory)-1
            SignalRecord sr=array.get(signalHistory,n)
            if sr.direction==1 and (na(lastBullSignalBar) or sr.bar>=lastBullSignalBar)
                lastBullSignalBar:=sr.bar
                lastBullSignalPriority:=sr.priority
                lastBullSignalSource:=sr.source
            if sr.direction==-1 and (na(lastBearSignalBar) or sr.bar>=lastBearSignalBar)
                lastBearSignalBar:=sr.bar
                lastBearSignalPriority:=sr.priority
                lastBearSignalSource:=sr.source
            if sr.direction==1 and sr.source=="EARLY" and (na(lastBullEarlySignalBar) or sr.bar>=lastBullEarlySignalBar)
                lastBullEarlySignalBar:=sr.bar
                lastBullEarlyEpisodeId:=sr.episodeId
            if sr.direction==-1 and sr.source=="EARLY" and (na(lastBearEarlySignalBar) or sr.bar>=lastBearEarlySignalBar)
                lastBearEarlySignalBar:=sr.bar
                lastBearEarlyEpisodeId:=sr.episodeId

    if selectedSignalValid
        lastSignalText:=selectedFamily+" "+(selectedDirection==1?"BULL":"BEAR")+" · "+selectedSource+" · Q"+str.tostring(selectedScore)+" · EP"+str.tostring(selectedEpisodeId)+" · POI"+str.tostring(selectedPOIId)
    else
        lastSignalText:="CONFLICT · NO ENTRY"

//=============================================================================
// RISK & TARGET ENGINE
// Created only after a P09 signal emits. Does not alter signal state.
//=============================================================================
bool newRiskPlanEvent=false

// Independent HTF-FVG reaction path. Native signal arbitration is untouched.
// A confirmed source FVG can produce at most one accepted LTF entry per origin.
var int lastHTFTradedOrigin=na
bool newHTFPlanEvent=false
bool validHTFReaction=mtfPOIEnabled and enableHTFPOIEntries and not na(mtfFVGOrigin) and mtfFVGOrigin!=lastHTFTradedOrigin and barstate.isconfirmed
bool htfIntersects=validHTFReaction and low<=mtfFVGTop and high>=mtfFVGBottom
float htfCloseLocation=(close-low)/math.max(high-low,syminfo.mintick)
bool htfBullReaction=htfIntersects and mtfFVGDir==1 and close>open and htfCloseLocation>=htfEntryMinCloseLocation and close>=mtfFVGBottom
bool htfBearReaction=htfIntersects and mtfFVGDir==-1 and close<open and htfCloseLocation<=1.0-htfEntryMinCloseLocation and close<=mtfFVGTop
bool htfEntryEvent=htfBullReaction or htfBearReaction
string htfEntryFamily=(mtfFVGDir==xTrend)?"CONT":"REV"
// Dedicated HTF reaction score, not inherited native REV/CONT predicate score.
int htfEntryScore=math.min(100,70+(math.abs(close-open)>=atr*0.4?10:0)+(mtfFVGDir==xTrend?10:0)+(math.abs(close-open)>=atr*0.8?10:0))
bool anySignal=bullREVSignal or bearREVSignal or bullCONTSignal or bearCONTSignal
// Process HTF event first; each accepted event creates its own RiskPlan.
// With latest-only drawings disabled by default, both remain visible.
// HTF reaction family describes directional alignment with local xTrend,
// not satisfaction of the native REV/CONT pattern predicates.
for eventSlot=0 to 1
    bool isHTFEvent=eventSlot==0
    if (isHTFEvent and htfEntryEvent) or (not isHTFEvent and anySignal and allowNativeEntries)
        string family=isHTFEvent?htfEntryFamily:reactionSignalEvent?reactionFamily:(bullREVSignal or bearREVSignal?"REV":"CONT")
        string signalSource=isHTFEvent?"HTF_POI":reactionSignalEvent?reactionKind:"NORMAL"
        int dir=isHTFEvent?mtfFVGDir:reactionSignalEvent?reactionDir:(bullREVSignal or bullCONTSignal?1:-1)

        // Bind this risk plan to the matching signal label on the signal bar.
        // Handles compact Execution labels and verbose Analysis/Full labels.
        label planSignalMarker=na
        if not isHTFEvent and array.size(signalLabels)>0
            string compactExpected=(dir==1?"▲ ":"▼ ")+(family=="REV"?"R":"C")
            string verbosePrefix=(dir==1?"BUY ":"SELL ")+family+" · Q"
            for n=array.size(signalLabels)-1 to 0
                label candidate=array.get(signalLabels,n)
                if not na(candidate)
                    string candidateText=label.get_text(candidate)
                    bool matchingText=str.startswith(candidateText,compactExpected) or str.startswith(candidateText,verbosePrefix)
                    if label.get_x(candidate)==bar_index and matchingText
                        planSignalMarker:=candidate
                        break

        int epId=isHTFEvent?mtfFVGOrigin:reactionSignalEvent?reactionEpisodeId:(family=="REV"?(dir==1?bullREVEpisodeId:bearREVEpisodeId):(dir==1?bullCONTEpisodeId:bearCONTEpisodeId))
        string poiEngine=isHTFEvent?"HTF_FVG":reactionSignalEvent?reactionPOIEngine:(family=="REV"?(dir==1?bullREVPOIEngine:bearREVPOIEngine):(dir==1?bullCONTPOIEngine:bearCONTPOIEngine))
        int poiId=isHTFEvent?mtfFVGOrigin:reactionSignalEvent?reactionPOIId:(family=="REV"?(dir==1?bullREVPOIId:bearREVPOIId):(dir==1?bullCONTPOIId:bearCONTPOIId))
        float sweepPrice=reactionSignalEvent?reactionSweepPrice:(family=="REV"?(dir==1?bullREVSweepPrice:bearREVSweepPrice):na)

        int pidx=f_findUnifiedPOIByKey(poiEngine,poiId)
        float poiTop=isHTFEvent?mtfFVGTop:pidx>=0?array.get(unifiedPOIs,pidx).top:na
        float poiBottom=isHTFEvent?mtfFVGBottom:pidx>=0?array.get(unifiedPOIs,pidx).bottom:na

        float entryPrice=close
        float protectedLevel=dir==1?xProtectedLow:xProtectedHigh
        float stopPrice=isHTFEvent?(dir==1?poiBottom-atr*stopBufferATR:poiTop+atr*stopBufferATR):f_planStop(family,dir,entryPrice,poiTop,poiBottom,sweepPrice,protectedLevel)
        float riskDistance=math.abs(entryPrice-stopPrice)

        float minT2Separation=math.max(atr*minTargetSeparationATR,syminfo.mintick)
        float maxT1AllowedR=riskDistance>0?maxLiquidityTargetR-minT2Separation/riskDistance:na
        bool stopDistanceAccepted=not na(atr) and atr>0 and riskDistance<=atr*(isHTFEvent?htfMaxStopDistanceATR:maxStopDistanceATR)
        bool targetGeometryAccepted=riskDistance>0 and (primaryTargetMode=="Fixed R"?(fixedTarget2R>fixedTarget1R):(not na(maxT1AllowedR) and maxT1AllowedR>=minTarget1R and maxLiquidityTargetR>=minTarget2R))
        bool mtfAligned=f_mtfPOIMatch(dir,entryPrice)
        bool mtfAlignmentAccepted=isHTFEvent or not (requireHTFPOIAlignment and mtfPOIEnabled) or mtfAligned
        bool stopSideAccepted=dir==1?stopPrice<entryPrice:stopPrice>entryPrice
        bool planAccepted=stopSideAccepted and stopDistanceAccepted and targetGeometryAccepted and mtfAlignmentAccepted

        if planAccepted
            if showOnlyLatestActivePlan and array.size(riskPlans)>0
                for n=0 to array.size(riskPlans)-1
                    RiskPlan oldVisual=array.get(riskPlans,n)
                    if oldVisual.state<2
                        if not na(oldVisual.riskBox)
                            box.delete(oldVisual.riskBox)
                            oldVisual.riskBox:=na
                        if not na(oldVisual.rewardBox)
                            box.delete(oldVisual.rewardBox)
                            oldVisual.rewardBox:=na
                        if not na(oldVisual.entryLine)
                            line.delete(oldVisual.entryLine)
                            oldVisual.entryLine:=na
                        if not na(oldVisual.stopLine)
                            line.delete(oldVisual.stopLine)
                            oldVisual.stopLine:=na
                        if not na(oldVisual.target1Line)
                            line.delete(oldVisual.target1Line)
                            oldVisual.target1Line:=na
                        if not na(oldVisual.target2Line)
                            line.delete(oldVisual.target2Line)
                            oldVisual.target2Line:=na
                        if not na(oldVisual.target3Line)
                            line.delete(oldVisual.target3Line)
                            oldVisual.target3Line:=na
                        if not na(oldVisual.target4Line)
                            line.delete(oldVisual.target4Line)
                            oldVisual.target4Line:=na
                        if not na(oldVisual.target3Tag)
                            label.delete(oldVisual.target3Tag)
                            oldVisual.target3Tag:=na
                        if not na(oldVisual.target4Tag)
                            label.delete(oldVisual.target4Tag)
                            oldVisual.target4Tag:=na
                        if not na(oldVisual.entryTag)
                            label.delete(oldVisual.entryTag)
                            oldVisual.entryTag:=na
                        if not na(oldVisual.stopTag)
                            label.delete(oldVisual.stopTag)
                            oldVisual.stopTag:=na
                        if not na(oldVisual.target1Tag)
                            label.delete(oldVisual.target1Tag)
                            oldVisual.target1Tag:=na
                        if not na(oldVisual.target2Tag)
                            label.delete(oldVisual.target2Tag)
                            oldVisual.target2Tag:=na
                        if not na(oldVisual.statusTag)
                            label.delete(oldVisual.statusTag)
                            oldVisual.statusTag:=na
                        array.set(riskPlans,n,oldVisual)
            float fallback1R=math.min(math.max(fallbackTarget1R,minTarget1R),maxT1AllowedR)
            float fallback1=dir==1?entryPrice+riskDistance*fallback1R:entryPrice-riskDistance*fallback1R
            float fallback2Base=dir==1?entryPrice+riskDistance*fallbackTarget2R:entryPrice-riskDistance*fallbackTarget2R

            float liqT1=useLiquidityTargets?f_activeLiquidityT1(dir,entryPrice,riskDistance):na
            float target1=primaryTargetMode=="Fixed R"?(dir==1?entryPrice+riskDistance*fixedTarget1R:entryPrice-riskDistance*fixedTarget1R):(not na(liqT1)?liqT1:fallback1)
            string t1Source=primaryTargetMode=="Fixed R"?"FIXED R":not na(liqT1)?"LIQ":"R"

            // Keep T2 beyond T1 while respecting the configured maximum R bound.
            float liqT2=useLiquidityTargets?f_activeLiquidityT2(dir,entryPrice,riskDistance,target1):na
            float maxTargetPrice=dir==1?entryPrice+riskDistance*maxLiquidityTargetR:entryPrice-riskDistance*maxLiquidityTargetR
            float fallback2=dir==1?math.min(math.max(fallback2Base,target1+minT2Separation),maxTargetPrice):math.max(math.min(fallback2Base,target1-minT2Separation),maxTargetPrice)
            float target2=primaryTargetMode=="Fixed R"?(dir==1?entryPrice+riskDistance*fixedTarget2R:entryPrice-riskDistance*fixedTarget2R):(not na(liqT2)?liqT2:fallback2)
            string t2Source=primaryTargetMode=="Fixed R"?"FIXED R":not na(liqT2)?"LIQ":"R"

            bool allowExtensions=showVisualLiquidityExtensions or outcomeModel=="Four-stage liquidity ladder"
            float visualTP3=allowExtensions?f_mtfExtraTarget(dir,target2,minT2Separation,f_visualLiquidityBeyond(dir,target2,minT2Separation)):na
            float visualTP4=allowExtensions and not na(visualTP3)?f_mtfExtraTarget(dir,visualTP3,minT2Separation,f_visualLiquidityBeyond(dir,visualTP3,minT2Separation)):na

            float rr1=riskDistance>0?math.abs(target1-entryPrice)/riskDistance:na
            float rr2=riskDistance>0?math.abs(target2-entryPrice)/riskDistance:na
            float rr3=not na(visualTP3) and riskDistance>0?math.abs(visualTP3-entryPrice)/riskDistance:na
            float rr4=not na(visualTP4) and riskDistance>0?math.abs(visualTP4-entryPrice)/riskDistance:na

            int setupScore=isHTFEvent?htfEntryScore:reactionSignalEvent?reactionScore:(family=="REV"?(dir==1?bullREVLastScore:bearREVLastScore):(dir==1?bullCONTLastScore:bearCONTLastScore))
            string setupGrade=isHTFEvent?f_qualityGrade(htfEntryScore):reactionSignalEvent?reactionGrade:(family=="REV"?(dir==1?bullREVLastGrade:bearREVLastGrade):(dir==1?bullCONTLastGrade:bearCONTLastGrade))
            color targetPlanColor=dir==1?bullTargetColor:bearTargetColor

            line eLine=na
            line sLine=na
            line t1Line=na
            line t2Line=na
            line t3Line=na
            line t4Line=na
            label t3Tag=na
            label t4Tag=na
            box rBox=na
            box rwBox=na
            label eTag=na
            label sTag=na
            label t1Tag=na
            label t2Tag=na
            label stTag=na

            if showRiskPlans
                int initialRight=na(time_close)?time:time_close
                rBox:=box.new(left=time,top=math.max(entryPrice,stopPrice),right=initialRight,bottom=math.min(entryPrice,stopPrice),xloc=xloc.bar_time,bgcolor=color.new(riskAreaColor,riskAreaTransparency),border_color=color.new(riskAreaColor,100))
                rwBox:=box.new(left=time,top=math.max(entryPrice,target2),right=initialRight,bottom=math.min(entryPrice,target2),xloc=xloc.bar_time,bgcolor=color.new(dir==1?bullRewardAreaColor:bearRewardAreaColor,rewardAreaTransparency),border_color=color.new(dir==1?bullRewardAreaColor:bearRewardAreaColor,100))
                eLine:=line.new(time,entryPrice,initialRight,entryPrice,xloc=xloc.bar_time,extend=extend.none,color=entryPlanColor,style=line.style_dotted,width=2)
                sLine:=line.new(time,stopPrice,initialRight,stopPrice,xloc=xloc.bar_time,extend=extend.none,color=stopPlanColor,width=2)
                t1Line:=line.new(time,target1,initialRight,target1,xloc=xloc.bar_time,extend=extend.none,color=targetPlanColor,style=line.style_dashed,width=2)
                t2Line:=line.new(time,target2,initialRight,target2,xloc=xloc.bar_time,extend=extend.none,color=targetPlanColor,width=2)
                if not na(visualTP3)
                    t3Line:=line.new(time,visualTP3,initialRight,visualTP3,xloc=xloc.bar_time,extend=extend.none,color=targetPlanColor,style=line.style_dotted,width=1)
                    t3Tag:=label.new(initialRight,visualTP3,"TP3 · LIQ  "+str.tostring(visualTP3,format.mintick),xloc=xloc.bar_time,style=label.style_label_left,color=color.new(targetPlanColor,20),textcolor=color.white,size=size.small)
                if not na(visualTP4)
                    t4Line:=line.new(time,visualTP4,initialRight,visualTP4,xloc=xloc.bar_time,extend=extend.none,color=targetPlanColor,style=line.style_dotted,width=1)
                    t4Tag:=label.new(initialRight,visualTP4,"TP4 · LIQ  "+str.tostring(visualTP4,format.mintick),xloc=xloc.bar_time,style=label.style_label_left,color=color.new(targetPlanColor,20),textcolor=color.white,size=size.small)
                if showRiskLevelTags
                    string setupPOIType=isHTFEvent?"HTF FVG":reactionSignalEvent?reactionPOIType:(family=="REV"?(dir==1?bullREVPOIType:bearREVPOIType):(dir==1?bullCONTPOIType:bearCONTPOIType))
                    string sourceText=signalSource=="NORMAL"?"":" · "+signalSource
                    string identityText=showFamilyDirectionInEntryTag?family+" "+(dir==1?"BUY":"SELL")+sourceText+" · Q"+str.tostring(setupScore)+" "+setupGrade+"\n":""
                    string reasonText=isHTFEvent?"Confirmed "+mtfPOITimeframe+" FVG · LTF reaction":(family=="REV"?"Reversal":"Continuation")+" · "+setupPOIType+"#"+str.tostring(poiId)+" · EP"+str.tostring(epId)+(mtfAligned?" · HTF FVG "+mtfPOITimeframe:"")
                    string eText=family+" "+(dir==1?"BUY":"SELL")+(signalSource=="NORMAL"?"":" · "+signalSource)+" · Q"+str.tostring(setupScore)+" "+setupGrade+"\nENTRY "+str.tostring(entryPrice,format.mintick)+" · "+reasonText
                    string sText="SL  "+str.tostring(stopPrice,format.mintick)
                    string t1Text="T1  "+str.tostring(target1,format.mintick)+"  ·  "+str.tostring(rr1,"#.00")+"R"
                    string t2Text="T2  "+str.tostring(target2,format.mintick)+"  ·  "+str.tostring(rr2,"#.00")+"R"
                    eTag:=label.new(initialRight,entryPrice,eText,xloc=xloc.bar_time,style=label.style_label_left,color=color.new(dir==1?bullSignalColor:bearSignalColor,10),textcolor=color.white,size=size.normal)
                    sTag:=label.new(initialRight,stopPrice,sText,xloc=xloc.bar_time,style=label.style_label_left,color=color.new(stopPlanColor,10),textcolor=color.white,size=size.normal)
                    t1Tag:=label.new(initialRight,target1,t1Text,xloc=xloc.bar_time,style=label.style_label_left,color=color.new(targetPlanColor,10),textcolor=color.white,size=size.normal)
                    t2Tag:=label.new(initialRight,target2,t2Text,xloc=xloc.bar_time,style=label.style_label_left,color=color.new(targetPlanColor,10),textcolor=color.white,size=size.normal)
                // Unified entry label replaces the redundant status label.

            if not na(planSignalMarker) and showRiskPlans and showRiskLevelTags
                label.delete(planSignalMarker)
                int unifiedMarkerIndex=array.indexof(signalLabels,planSignalMarker)
                if unifiedMarkerIndex>=0
                    array.remove(signalLabels,unifiedMarkerIndex)
                planSignalMarker:=na

            if isHTFEvent
                lastHTFTradedOrigin:=mtfFVGOrigin
                newHTFPlanEvent:=true
                array.push(signalHistory,SignalRecord.new(family,dir,epId,poiEngine,poiId,bar_index,setupScore,"HTF_POI",0))
            array.push(riskPlans,RiskPlan.new(nextRiskPlanId,family,signalSource,dir,epId,poiEngine,poiId,bar_index,time,setupScore,setupGrade,entryPrice,stopPrice,target1,target2,visualTP3,visualTP4,rr1,rr2,rr3,rr4,t1Source,t2Source,0,1.0,0,na,false,outcomeModel=="Four-stage liquidity ladder"?0.0:na,"ACTIVE",planSignalMarker,eLine,sLine,t1Line,t2Line,t3Line,t4Line,t3Tag,t4Tag,rBox,rwBox,eTag,sTag,t1Tag,t2Tag,stTag))
            f_addRecentEntryCard(nextRiskPlanId,family,signalSource,dir,epId,poiEngine,poiId,time,entryPrice)
            nextRiskPlanId+=1
            riskPlanCount+=1
            newRiskPlanEvent:=true

            lastPlanEntry:=entryPrice
            lastPlanStop:=stopPrice
            lastPlanT1:=target1
            lastPlanT2:=target2
            lastPlanRR1:=rr1
            lastPlanRR2:=rr2
            lastPlanText:=family+" "+(dir==1?"BUY":"SELL")+" · T1 "+t1Source+" · T2 "+t2Source
        else
            string rejectionReason=not stopSideAccepted?"STOP WRONG SIDE":not mtfAlignmentAccepted?"HTF FVG MISMATCH":not stopDistanceAccepted?"STOP > "+str.tostring(isHTFEvent?htfMaxStopDistanceATR:maxStopDistanceATR,"#.##")+" ATR":"TARGET RR LIMITS"
            lastPlanText:="RISK FILTER · "+rejectionReason
            lastSignalText:="RISK FILTER · "+rejectionReason
            if not na(planSignalMarker)
                label.delete(planSignalMarker)
                int rejectedMarkerIndex=array.indexof(signalLabels,planSignalMarker)
                if rejectedMarkerIndex>=0
                    array.remove(signalLabels,rejectedMarkerIndex)


// Update active risk plans and terminate their drawings cleanly.
bool tradeOutcomeEvent=false
if array.size(riskPlans)>0
    for n=0 to array.size(riskPlans)-1
        RiskPlan p=array.get(riskPlans,n)
        bool terminal=p.state>=2
        bool bull=p.direction==1

        if not terminal and bar_index>p.signalBar
            bool stopHit=bull?low<=p.stop:high>=p.stop
            bool t1Hit=bull?high>=p.target1:low<=p.target1
            bool t2Hit=bull?high>=p.target2:low<=p.target2
            bool t3Hit=not na(p.target3) and (bull?high>=p.target3:low<=p.target3)
            bool t4Hit=not na(p.target4) and (bull?high>=p.target4:low<=p.target4)
            bool ladder=outcomeModel=="Four-stage liquidity ladder"
            bool hadT1=p.stage>=1

            // Conservative same-bar precedence: stop wins over all unfilled targets.
            if stopHit
                p.state:=3
                p.terminalTime:=time
                p.outcome:="STOPPED"
                if ladder
                    p.realizedR+=p.remainingSize*(p.stage>=1?0.0:-1.0)
                    p.remainingSize:=0.0
                else
                    p.realizedR:=outcomeModel=="50% T1 + BE remainder" and hadT1?p.rr1*0.50:-1.0
            else if ladder
                // 25/25/25/25 with both extensions; 25/25/50 with only TP3;
                // 50/50 at TP1/TP2 when neither extension exists.
                bool hasT3=not na(p.target3)
                bool hasT4=not na(p.target4)
                float share1=hasT3?0.25:0.50
                float share2=hasT3?0.25:0.50
                float share3=hasT3?(hasT4?0.25:0.50):0.0
                float share4=hasT4?0.25:0.0
                if t1Hit and p.stage==0
                    p.realizedR+=share1*p.rr1
                    p.remainingSize-=share1
                    p.stage:=1
                    p.state:=1
                    p.outcome:="T1_HIT"
                    p.stop:=p.entry
                    if not na(p.stopLine)
                        line.set_y1(p.stopLine,p.entry)
                        line.set_y2(p.stopLine,p.entry)
                    if not na(p.stopTag)
                        label.set_y(p.stopTag,p.entry)
                        label.set_text(p.stopTag,"BE  "+str.tostring(p.entry,format.mintick))
                    t1ReachedCount+=1
                    f_updateRecentEntryCard(p.id,p.family,p.source,p.direction,p.episodeId,p.poiEngine,p.poiId,p.entry,"T1 HIT",na)
                if t2Hit and p.stage==1
                    p.realizedR+=share2*p.rr2
                    p.remainingSize-=share2
                    p.stage:=2
                    p.outcome:="T2_HIT"
                    t2ReachedCount+=1
                    f_updateRecentEntryCard(p.id,p.family,p.source,p.direction,p.episodeId,p.poiEngine,p.poiId,p.entry,"T2 HIT · RUNNER",na)
                    if not hasT3
                        p.state:=2
                        p.terminalTime:=time
                        p.remainingSize:=0.0
                if t3Hit and p.stage==2 and p.state<2
                    p.realizedR+=share3*p.rr3
                    p.remainingSize-=share3
                    p.stage:=3
                    p.outcome:="T3_HIT"
                    f_updateRecentEntryCard(p.id,p.family,p.source,p.direction,p.episodeId,p.poiEngine,p.poiId,p.entry,"T3 HIT · RUNNER",na)
                    if not hasT4
                        p.state:=2
                        p.terminalTime:=time
                        p.remainingSize:=0.0
                if t4Hit and p.stage==3 and p.state<2
                    p.realizedR+=share4*p.rr4
                    p.remainingSize:=0.0
                    p.stage:=4
                    p.state:=2
                    p.terminalTime:=time
                    p.outcome:="T4_HIT"
            else if t2Hit
                p.state:=2
                p.stage:=2
                p.terminalTime:=time
                p.outcome:="T2_HIT"
                p.realizedR:=outcomeModel=="50% T1 + BE remainder"?p.rr1*0.50+p.rr2*0.50:p.rr2
            else if t1Hit and p.state==0
                p.state:=1
                p.stage:=1
                p.outcome:="T1_HIT"
                if outcomeModel=="50% T1 + BE remainder"
                    p.stop:=p.entry
                    if not na(p.stopLine)
                        line.set_y1(p.stopLine,p.entry)
                        line.set_y2(p.stopLine,p.entry)
                    if not na(p.stopTag)
                        label.set_y(p.stopTag,p.entry)
                        label.set_text(p.stopTag,"BE  "+str.tostring(p.entry,format.mintick))
                t1ReachedCount+=1
                f_updateRecentEntryCard(p.id,p.family,p.source,p.direction,p.episodeId,p.poiEngine,p.poiId,p.entry,"T1 HIT",na)

        terminal:=p.state>=2

        // CONT signal markers are lifecycle-linked: remove on first TP, SL, or expiry.
        // T1 counts as the first TP event; the remaining runner can continue to T2/stop.
        if removeCONTMarkerAfterResolution and p.family=="CONT" and p.state>=1 and not na(p.signalMarker)
            label.delete(p.signalMarker)
            int markerIndex=array.indexof(signalLabels,p.signalMarker)
            if markerIndex>=0
                array.remove(signalLabels,markerIndex)
            p.signalMarker:=na

        // At terminal outcome, clear every per-trade label but retain the separate
        // recent-entry result card. Risk-plan lines are also removed unconditionally.
        if terminal
            if not na(p.signalMarker)
                label.delete(p.signalMarker)
                int terminalMarkerIndex=array.indexof(signalLabels,p.signalMarker)
                if terminalMarkerIndex>=0
                    array.remove(signalLabels,terminalMarkerIndex)
                p.signalMarker:=na
            if not na(p.entryTag)
                label.delete(p.entryTag)
                p.entryTag:=na
            if not na(p.stopTag)
                label.delete(p.stopTag)
                p.stopTag:=na
            if not na(p.target1Tag)
                label.delete(p.target1Tag)
                p.target1Tag:=na
            if not na(p.target2Tag)
                label.delete(p.target2Tag)
                p.target2Tag:=na
            if not na(p.target3Tag)
                label.delete(p.target3Tag)
                p.target3Tag:=na
            if not na(p.target4Tag)
                label.delete(p.target4Tag)
                p.target4Tag:=na
            if not na(p.statusTag)
                label.delete(p.statusTag)
                p.statusTag:=na

        if terminal and not p.outcomeRecorded
            p.outcomeRecorded:=true
            tradeOutcomeEvent:=true
            if p.state==2
                completedTradeCount+=1
                if outcomeModel!="Four-stage liquidity ladder"
                    t2ReachedCount+=1
            else if p.state==3
                stoppedTradeCount+=1
            else if p.state==4
                expiredTradeCount+=1

            if not na(p.realizedR)
                totalRealizedR+=p.realizedR

                // P16: one family/source bucket + one grade bucket per realized terminal outcome.
                string sourceKey=p.family+"_"+p.source
                string gradeKey="GRADE_"+p.grade
                f_perfRecord(sourceKey,p.realizedR)
                f_perfRecord(gradeKey,p.realizedR)

                bool win=p.realizedR>0
                if p.family=="REV"
                    revClosedCount+=1
                    revRealizedR+=p.realizedR
                    if win
                        revWinCount+=1
                    else
                        revLossCount+=1
                else
                    contClosedCount+=1
                    contRealizedR+=p.realizedR
                    if win
                        contWinCount+=1
                    else
                        contLossCount+=1

            lastOutcomeText:=p.family+" "+(bull?"BUY":"SELL")+" · "+p.outcome+(na(p.realizedR)?"":" · "+str.tostring(p.realizedR,"#.00")+"R")

            string terminalStatus=p.outcome=="T4_HIT"?"T4 HIT":p.outcome=="T3_HIT"?"T3 HIT":p.outcome=="T2_HIT"?"T2 HIT":p.outcome=="STOPPED"?"STOPPED":p.outcome=="EXPIRED"?"EXPIRED":p.outcome
            f_updateRecentEntryCard(p.id,p.family,p.source,p.direction,p.episodeId,p.poiEngine,p.poiId,p.entry,terminalStatus,p.realizedR)

        int rightTime=terminal and not na(p.terminalTime)?p.terminalTime:time

        if not na(p.riskBox)
            box.set_right(p.riskBox,rightTime)
            box.set_top(p.riskBox,math.max(p.entry,p.stop))
            box.set_bottom(p.riskBox,math.min(p.entry,p.stop))
        if not na(p.rewardBox)
            box.set_right(p.rewardBox,rightTime)
            box.set_top(p.rewardBox,math.max(p.entry,p.target2))
            box.set_bottom(p.rewardBox,math.min(p.entry,p.target2))
        if not na(p.entryLine)
            line.set_xy2(p.entryLine,rightTime,p.entry)
        if not na(p.stopLine)
            line.set_xy2(p.stopLine,rightTime,p.stop)
        if not na(p.target1Line)
            line.set_xy2(p.target1Line,rightTime,p.target1)
        if not na(p.target2Line)
            line.set_xy2(p.target2Line,rightTime,p.target2)
        if not na(p.target3Line)
            line.set_x2(p.target3Line,rightTime)
        if not na(p.target4Line)
            line.set_x2(p.target4Line,rightTime)
        if not na(p.target3Tag)
            label.set_x(p.target3Tag,rightTime)
        if not na(p.target4Tag)
            label.set_x(p.target4Tag,rightTime)
        if not na(p.entryTag)
            label.set_xy(p.entryTag,rightTime,p.entry)
        if not na(p.stopTag)
            label.set_xy(p.stopTag,rightTime,p.stop)
        if not na(p.target1Tag)
            label.set_xy(p.target1Tag,rightTime,p.target1)
        if not na(p.target2Tag)
            label.set_xy(p.target2Tag,rightTime,p.target2)
        if not na(p.statusTag)
            float statusY=p.direction==1?p.entry+atr*0.30:p.entry-atr*0.30
            label.set_xy(p.statusTag,rightTime,statusY)
            string stateText=p.state==1?"T1 HIT":"ACTIVE"
            label.set_text(p.statusTag,p.family+" "+(p.direction==1?"BUY":"SELL")+" · "+stateText)

        if terminal
            if not na(p.riskBox)
                box.delete(p.riskBox)
                p.riskBox:=na
            if not na(p.rewardBox)
                box.delete(p.rewardBox)
                p.rewardBox:=na
            if not na(p.entryLine)
                line.delete(p.entryLine)
                p.entryLine:=na
            if not na(p.stopLine)
                line.delete(p.stopLine)
                p.stopLine:=na
            if not na(p.target1Line)
                line.delete(p.target1Line)
                p.target1Line:=na
            if not na(p.target2Line)
                line.delete(p.target2Line)
                p.target2Line:=na
            if not na(p.target3Line)
                line.delete(p.target3Line)
                p.target3Line:=na
            if not na(p.target4Line)
                line.delete(p.target4Line)
                p.target4Line:=na
            if not na(p.entryTag)
                label.delete(p.entryTag)
                p.entryTag:=na
            if not na(p.stopTag)
                label.delete(p.stopTag)
                p.stopTag:=na
            if not na(p.target1Tag)
                label.delete(p.target1Tag)
                p.target1Tag:=na
            if not na(p.target2Tag)
                label.delete(p.target2Tag)
                p.target2Tag:=na
            if not na(p.target3Tag)
                label.delete(p.target3Tag)
                p.target3Tag:=na
            if not na(p.target4Tag)
                label.delete(p.target4Tag)
                p.target4Tag:=na
            if not na(p.statusTag)
                label.delete(p.statusTag)
                p.statusTag:=na

        array.set(riskPlans,n,p)

// Retention cap applies to resolved plans only. Never silently drop active trades.
// TradingView drawings are separately limited by showOnlyLatestActivePlan.
if array.size(riskPlans)>maxRiskPlans
    for n=array.size(riskPlans)-1 to 0
        if array.size(riskPlans)>maxRiskPlans
            RiskPlan old=array.get(riskPlans,n)
            if old.state>=2
                if not na(old.riskBox)
                    box.delete(old.riskBox)
                if not na(old.rewardBox)
                    box.delete(old.rewardBox)
                if not na(old.entryLine)
                    line.delete(old.entryLine)
                if not na(old.stopLine)
                    line.delete(old.stopLine)
                if not na(old.target1Line)
                    line.delete(old.target1Line)
                if not na(old.target2Line)
                    line.delete(old.target2Line)
                if not na(old.target3Line)
                    line.delete(old.target3Line)
                if not na(old.target4Line)
                    line.delete(old.target4Line)
                if not na(old.entryTag)
                    label.delete(old.entryTag)
                if not na(old.stopTag)
                    label.delete(old.stopTag)
                if not na(old.target1Tag)
                    label.delete(old.target1Tag)
                if not na(old.target2Tag)
                    label.delete(old.target2Tag)
                if not na(old.target3Tag)
                    label.delete(old.target3Tag)
                if not na(old.target4Tag)
                    label.delete(old.target4Tag)
                if not na(old.statusTag)
                    label.delete(old.statusTag)
                array.remove(riskPlans,n)

if barstate.islast
    f_renderPerformanceTable()


 //=============================================================================
// SETUP DASHBOARD — reference-inspired state + active trade levels
//=============================================================================
setupDashPos=setupDashboardPosition=="Top Right"?position.top_right:setupDashboardPosition=="Top Left"?position.top_left:setupDashboardPosition=="Bottom Left"?position.bottom_left:position.bottom_right
var table setupDashboard=table.new(setupDashPos,2,10,bgcolor=dashboardCellColor,frame_color=dashboardHeaderColor,frame_width=1,border_color=color.new(dashboardHeaderColor,35),border_width=1)
string dashTextSize=setupDashboardSize=="Standard"?size.normal:size.small
string dashTrendText=not useTrendFilter?"FILTER OFF":trendBullAllowed?"BULLISH":trendBearAllowed?"BEARISH":"NEUTRAL / BLOCKED"
color dashTrendColor=not useTrendFilter?dashboardNeutralColor:trendBullAllowed?dashboardBullColor:trendBearAllowed?dashboardBearColor:dashboardNeutralColor
string dashStructureText=confirmedStructureBias==1?"BULLISH":confirmedStructureBias==-1?"BEARISH":"NEUTRAL"
color dashStructureColor=confirmedStructureBias==1?dashboardBullColor:confirmedStructureBias==-1?dashboardBearColor:dashboardNeutralColor
string dashStateText=lastSignalText
string dashEntry="—"
string dashStop="—"
string dashT1="—"
string dashT2="—"
string dashT3="—"
string dashT4="—"
string dashPlanState="NO ACTIVE PLAN"
if array.size(riskPlans)>0
    RiskPlan dashPlan=array.get(riskPlans,array.size(riskPlans)-1)
    if dashPlan.state<2
        dashEntry:=str.tostring(dashPlan.entry,format.mintick)
        dashStop:=str.tostring(dashPlan.stop,format.mintick)
        dashT1:=str.tostring(dashPlan.target1,format.mintick)
        dashT2:=str.tostring(dashPlan.target2,format.mintick)
        dashT3:=not showVisualLiquidityExtensions?"DISABLED":na(dashPlan.target3)?"NO ELIGIBLE LIQ":str.tostring(dashPlan.target3,format.mintick)
        dashT4:=not showVisualLiquidityExtensions?"DISABLED":na(dashPlan.target3)?"WAITING FOR TP3":na(dashPlan.target4)?"NO ELIGIBLE LIQ":str.tostring(dashPlan.target4,format.mintick)
        dashPlanState:=dashPlan.state==1?(dashPlan.stage==3?"T3 HIT · RUNNER":dashPlan.stage==2?"T2 HIT · RUNNER":"T1 HIT · BE MANAGED"):"ACTIVE"
if barstate.islast
    if showSetupDashboard
        table.cell(setupDashboard,0,0,"ARTHA · SETUP",bgcolor=dashboardHeaderColor,text_color=color.white,text_size=dashTextSize,text_formatting=text.format_bold)
        table.cell(setupDashboard,1,0,"P17.19",bgcolor=dashboardHeaderColor,text_color=color.white,text_size=dashTextSize,text_formatting=text.format_bold)
        table.cell(setupDashboard,0,1,"TREND",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,1,dashTrendText,bgcolor=dashboardAltColor,text_color=dashTrendColor,text_size=dashTextSize,text_formatting=text.format_bold)
        table.cell(setupDashboard,0,2,"STRUCTURE",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,2,dashStructureText,bgcolor=dashboardAltColor,text_color=dashStructureColor,text_size=dashTextSize,text_formatting=text.format_bold)
        table.cell(setupDashboard,0,3,"SETUP / STATE",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,3,dashStateText,bgcolor=dashboardAltColor,text_color=color.white,text_size=dashTextSize)
        table.cell(setupDashboard,0,4,"PLAN",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,4,dashPlanState,bgcolor=dashboardAltColor,text_color=dashPlanState=="ACTIVE" or dashPlanState=="T1 HIT · BE MANAGED"?dashboardBullColor:dashboardNeutralColor,text_size=dashTextSize)
        table.cell(setupDashboard,0,5,"ENTRY",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,5,dashEntry,bgcolor=dashboardAltColor,text_color=entryPlanColor,text_size=dashTextSize)
        table.cell(setupDashboard,0,6,"STOP / T1",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,6,dashStop+" / "+dashT1,bgcolor=dashboardAltColor,text_color=stopPlanColor,text_size=dashTextSize)
        table.cell(setupDashboard,0,7,"T2",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,7,dashT2,bgcolor=dashboardAltColor,text_color=bullTargetColor,text_size=dashTextSize)
        table.cell(setupDashboard,0,8,"TP3 · LIQ",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,8,dashT3,bgcolor=dashboardAltColor,text_color=dashboardNeutralColor,text_size=dashTextSize)
        table.cell(setupDashboard,0,9,"TP4 · LIQ",bgcolor=dashboardCellColor,text_color=dashboardTextColor,text_size=dashTextSize)
        table.cell(setupDashboard,1,9,dashT4,bgcolor=dashboardAltColor,text_color=dashboardNeutralColor,text_size=dashTextSize)
    else
        table.clear(setupDashboard,0,0,1,9)

//=============================================================================
// ALERTS — EXECUTION / OUTCOME
//=============================================================================
alertcondition(newHTFPlanEvent,"ARTHA v2 HTF FVG Entry","Independent HTF FVG lower-timeframe entry accepted")
alertcondition(newRiskPlanEvent,"ARTHA v2 Risk Plan Created","Risk and target plan created for execution signal")
alertcondition(tradeOutcomeEvent,"ARTHA v2 Trade Outcome Update","A tracked ARTHA trade plan reached a terminal outcome")
alertcondition(bullREVSignal and newRiskPlanEvent,"ARTHA v2 BUY REV","Bullish REV execution signal")
alertcondition(bearREVSignal and newRiskPlanEvent,"ARTHA v2 SELL REV","Bearish REV execution signal")
alertcondition(bullCONTSignal and newRiskPlanEvent,"ARTHA v2 BUY CONT","Bullish CONT execution signal")
alertcondition(bearCONTSignal and newRiskPlanEvent,"ARTHA v2 SELL CONT","Bearish CONT execution signal")