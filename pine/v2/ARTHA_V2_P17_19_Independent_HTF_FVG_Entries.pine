bool enableHTFPOIEntries=input.bool(true,"Allow independent HTF FVG reaction entries",group=GMTF)
bool allowNativeEntries=input.bool(true,"Keep native REV / CONT entries",group=GMTF)
float htfEntryMinCloseLocation=input.float(0.60,"HTF FVG reaction close strength",minval=0.50,maxval=0.95,step=0.05,group=GMTF)
float htfMaxStopDistanceATR=input.float(12.0,"HTF-POI maximum stop / chart ATR",minval=1.0,maxval=100.0,step=1.0,group=GMTF)
bool showHTF15mZones=input.bool(true,"Show 15m HTF FVG rectangles",group=GMTF)
bool showHTF1hZones=input.bool(true,"Show 1H HTF FVG rectangles",group=GMTF)
bool showHTFSelectedZones=input.bool(true,"Show custom selected-HTF FVG rectangles",group=GMTF)
int maxHTFZoneBoxes=input.int(12,"Maximum historical zones per timeframe",minval=1,maxval=30,group=GMTF)
int htfFVGZoneTransparency=input.int(87,"HTF FVG fill transparency",minval=0,maxval=100,group=GMTF)
color htfBullZoneColor=input.color(color.teal,"HTF bullish FVG color",group=GMTF)
color htfBearZoneColor=input.color(color.fuchsia,"HTF bearish FVG color",group=GMTF)
bool includeHTFTargets=input.bool(true,"Include confirmed HTF swing liquidity in TP3 / TP4",group=GMTF)

