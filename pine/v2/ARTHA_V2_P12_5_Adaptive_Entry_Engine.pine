//@version=6
indicator("ARTHA v2 P12.5 — Adaptive Entry Engine", shorttitle="ARTHA v2 P12.5", overlay=true, max_lines_count=500, max_boxes_count=400, max_labels_count=500)

//=============================================================================
// ARTHA v2 — PHASE 12.5
// Converts confirmed TRUE_MISS reactions into valid adaptive entries when they
// belong to the exact active ARTHA candidate POI and pass the normal signal gates.
// Also refactors risk-plan visual lifecycle out of the main body for CE10295.
//=============================================================================

