var int bullDisplacementCount=0
var int bearDisplacementCount=0
var int lastBullDisplacementBar=na
var int lastBearDisplacementBar=na
var int lastBullDisplacementScore=na
var int lastBearDisplacementScore=na
var label[] displacementLabels=array.new_label()
var label[] episodeLabels=array.new_label()

// Episode registry and active episode state.
var array<DisplacementEpisode> displacementEpisodes=array.new<DisplacementEpisode>()
var int nextEpisodeId=1
var bool episodeActive=false
var int episodeId=na
var int episodeDirection=0
var int episodeStartBar=na
var int episodeLastDSPBar=na
var int episodePeakBar=na
var int episodePeakScore=na
var int episodeEventCount=0
var float episodeHigh=na
var float episodeLow=na
var float episodeTotalBodyATR=0.0
var bool episodeStructureBreak=false
var string episodeStructureScope="NONE"
var string episodeStructureKind="NONE"

var int completedEpisodeCount=0
var int bullEpisodeCount=0
var int bearEpisodeCount=0
var int lastCompletedEpisodeDirection=0
var int lastCompletedEpisodePeakScore=na
var int lastCompletedEpisodeBars=na

bool bullDisplacementEvent=barstate.isconfirmed and f_displacementQualified(true)
bool bearDisplacementEvent=barstate.isconfirmed and f_displacementQualified(false)

// FVG/IFVG registry. Lifecycle logic executes after episode aggregation so
// each new imbalance can capture the most relevant active/completed episode.
var array<ImbalanceZone> imbalanceZones=array.new<ImbalanceZone>()
var int nextImbalanceId=1
var int bullFVGCount=0
var int bearFVGCount=0
var int bullIFVGCount=0
var int bearIFVGCount=0
var int retiredImbalanceCount=0
var int structuralFVGCount=0
var int displacementFVGCount=0
var int ordinaryFVGCount=0
var int primaryFVGCount=0
var int secondaryFVGCount=0

f_episodePeakBar(int epId) =>
    int peak=na
    if episodeActive and episodeId==epId
        peak:=episodePeakBar
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.id==epId
                peak:=ep.peakBar
                break
    peak

f_primaryCandidateBetter(int newBornBar,float newGapATR,int oldBornBar,float oldGapATR,int peakBar) =>
    int newDistance=na(peakBar)?999999:math.abs(newBornBar-peakBar)
    int oldDistance=na(peakBar)?999999:math.abs(oldBornBar-peakBar)
    newDistance<oldDistance or (newDistance==oldDistance and newGapATR>oldGapATR)

f_assignPrimaryForEpisode(int newIndex,int epId,int dir) =>
    bool newPrimary=true
    if not na(epId) and array.size(imbalanceZones)>0
        ImbalanceZone newZone=array.get(imbalanceZones,newIndex)
        for n=0 to array.size(imbalanceZones)-1
            if n!=newIndex
                ImbalanceZone old=array.get(imbalanceZones,n)
                if old.episodeId==epId and old.direction==dir and old.primary
                    bool replace=f_primaryCandidateBetter(newZone.bornBar,newZone.birthGapATR,old.bornBar,old.birthGapATR,newZone.episodePeakBar)
                    if replace
                        old.primary:=false
                        array.set(imbalanceZones,n,old)
                    else
                        newPrimary:=false
                    break
        newZone.primary:=newPrimary
        array.set(imbalanceZones,newIndex,newZone)
    newPrimary

f_deleteImbalance(ImbalanceZone z) =>
    if not na(z.bx)
        box.delete(z.bx)

f_trimImbalances() =>
    while array.size(imbalanceZones)>maxImbalanceZones
        ImbalanceZone old=array.shift(imbalanceZones)
        f_deleteImbalance(old)

//=============================================================================
// ORDER BLOCK / BREAKER STATE + HELPERS
//=============================================================================
var array<OrderBlockZone> orderBlocks=array.new<OrderBlockZone>()
var int nextOrderBlockId=1
var int bullOBCount=0
var int bearOBCount=0
var int bullBBCount=0
var int bearBBCount=0
var int retiredOBBBCount=0

f_deleteOrderBlock(OrderBlockZone z) =>
    if not na(z.bx)
        box.delete(z.bx)

f_trimOrderBlocks() =>
    while array.size(orderBlocks)>maxOrderBlocks
        OrderBlockZone old=array.shift(orderBlocks)
        f_deleteOrderBlock(old)

f_hasOrderBlockForEpisode(int epId,int dir) =>
    bool found=false
    if not na(epId) and array.size(orderBlocks)>0
        for n=0 to array.size(orderBlocks)-1
            OrderBlockZone z=array.get(orderBlocks,n)
            if z.episodeId==epId and z.direction==dir
                found:=true
                break
    found

f_episodeStartBar(int epId) =>
    int start=na
    if episodeActive and episodeId==epId
        start:=episodeStartBar
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.id==epId
                start:=ep.startBar
                break
    start

f_findOBOrigin(int epId,int dir) =>
    int originBar=na
    int originTime=na
    float zoneTop=na
    float zoneBottom=na
    int epStart=f_episodeStartBar(epId)
    if not na(epStart)
        int startOffset=bar_index-epStart
        int firstOffset=startOffset+1
        int lastOffset=startOffset+obSearchBars
        for j=firstOffset to lastOffset
            if j>=1 and j<=bar_index
                bool opposite=dir==1?close[j]<open[j]:close[j]>open[j]
                if opposite
                    originBar:=bar_index-j
                    originTime:=time[j]
                    if obBodyOnly
                        zoneTop:=math.max(open[j],close[j])
                        zoneBottom:=math.min(open[j],close[j])
                    else
                        zoneTop:=high[j]
                        zoneBottom:=low[j]
                    break
    [originBar,originTime,zoneTop,zoneBottom]

//=============================================================================
// UNIFIED POI REGISTRY
// Rebuilt from native source registries each bar. Native IDs remain stable.
//=============================================================================
var array<UnifiedPOI> unifiedPOIs=array.new<UnifiedPOI>()

f_rebuildUnifiedPOIs() =>
    array.clear(unifiedPOIs)

    if array.size(imbalanceZones)>0
        for n=0 to array.size(imbalanceZones)-1
            ImbalanceZone z=array.get(imbalanceZones,n)
            if z.state<2
                bool isFVG=z.state==0
                bool currentBull=isFVG?z.direction==1:z.direction==-1
                int currentDir=currentBull?1:-1
                string currentType=isFVG?"FVG":"IFVG"
                bool typeAllowed=(isFVG and poiIncludeFVG) or (not isFVG and poiIncludeIFVG)
                bool familyAllowed=z.primary or poiIncludeSecondaryFVG or na(z.episodeId)
                if typeAllowed and familyAllowed
                    array.push(unifiedPOIs,UnifiedPOI.new(
                         "IMBALANCE",z.id,currentType,currentDir,z.top,z.bottom,z.bornBar,
                         z.episodeId,na,z.primary,z.displacementScore,z.structureLinked,
                         z.structureScope,z.structureKind,z.maxMitigationPct))

    if array.size(orderBlocks)>0
        for n=0 to array.size(orderBlocks)-1
            OrderBlockZone z=array.get(orderBlocks,n)
            if z.state<2
                bool isOB=z.state==0
                bool currentBull=isOB?z.direction==1:z.direction==-1
                int currentDir=currentBull?1:-1
                string currentType=isOB?"OB":"BB"
                bool typeAllowed=(isOB and poiIncludeOB) or (not isOB and poiIncludeBB)
                if typeAllowed
                    array.push(unifiedPOIs,UnifiedPOI.new(
                         "ORDERBLOCK",z.id,currentType,currentDir,z.top,z.bottom,z.bornBar,
                         z.episodeId,z.fvgId,true,z.displacementScore,true,
                         z.structureScope,z.structureKind,z.maxMitigationPct))

f_nearestPOIIndex(int dir) =>
    int found=-1
    float bestDistance=na
    if array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            if p.direction==dir
                float d=close>p.top?close-p.top:close<p.bottom?p.bottom-close:0.0
                if na(bestDistance) or d<bestDistance
                    bestDistance:=d
                    found:=n
    found

f_findUnifiedPOIByKey(string sourceEngine,int sourceId) =>
    int found=-1
    if array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            if p.sourceEngine==sourceEngine and p.sourceId==sourceId
                found:=n
                break
    found

f_auditInteractionPOI(int dir) =>
    int found=-1
    string klass="NONE"
    float bestDistance=na
    if reactionEngineEnabled and array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            bool familyOK=not auditPrimaryOnly or p.primary
            bool touch=p.direction==dir and familyOK and low<=p.top and high>=p.bottom
            if touch
                bool sweptBoundary=dir==1?low<p.bottom:high>p.top
                float sweepBeyond=sweptBoundary?(dir==1?p.bottom-low:high-p.top):0.0
                bool sweepWithin=not sweptBoundary or na(atr) or sweepBeyond<=auditMaxSweepBeyondATR*atr
                string thisClass=(p.poiType=="IFVG" or p.poiType=="BB")?"FLIP_RETEST":sweptBoundary and sweepWithin?"SWEEP_RECLAIM":"REJECTION"
                float d=math.abs(close-(p.top+p.bottom)*0.5)
                if na(bestDistance) or d<bestDistance
                    found:=n
                    klass:=thisClass
                    bestDistance:=d
    [found,klass]

f_auditCloseConfirmed(int dir,float top,float bottom,string klass) =>
    float mid=(top+bottom)*0.5
    float loc=(close-low)/math.max(high-low,syminfo.mintick)
    bool directional=dir==1?(close>open and loc>=auditMinCloseLocation):(close<open and loc<=1.0-auditMinCloseLocation)
    bool midpoint=dir==1?close>=mid:close<=mid
    bool anyValid=dir==1?close>=bottom:close<=top
    bool standard=auditConfirmationMode=="Directional Close"?directional:auditConfirmationMode=="Midpoint Reclaim"?midpoint:anyValid
    bool sweepClose=dir==1?close>=bottom:close<=top
    klass=="SWEEP_RECLAIM"?(sweepClose and standard):standard

f_auditREVReason(int st) =>
    st==1?"WAIT_SHIFT":st==2?"WAIT_POI":st==3?"WAIT_RETEST":st==4?"REACTION_GATE":st==5?"ELIGIBLE":"NO_ACTIVE_REV_STATE"

f_auditCONTReason(int st) =>
    st==1?"WAIT_POI":st==2?"WAIT_RETEST":st==3?"REACTION_GATE":st==4?"ELIGIBLE":"NO_ACTIVE_CONT_STATE"

f_findREVPOI(int epId,int dir) =>
    int found=-1
    float bestDistance=na
    int bestClass=999

    if not na(epId) and array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            if p.episodeId==epId and p.direction==dir and p.primary
                bool isOBFamily=p.poiType=="OB" or p.poiType=="BB"
                int classRank=revPOIPreference=="OB/BB first"?(isOBFamily?0:1):revPOIPreference=="FVG/IFVG first"?(isOBFamily?1:0):0
                float d=close>p.top?close-p.top:close<p.bottom?p.bottom-close:0.0

                bool better=false
                if revPOIPreference=="Nearest"
                    better:=na(bestDistance) or d<bestDistance
                else
                    better:=classRank<bestClass or (classRank==bestClass and (na(bestDistance) or d<bestDistance))

                if better
                    found:=n
                    bestDistance:=d
                    bestClass:=classRank
    found

f_findCONTPOI(int epId,int dir) =>
    int found=-1
    float bestDistance=na
    int bestClass=999

    if not na(epId) and array.size(unifiedPOIs)>0
        for n=0 to array.size(unifiedPOIs)-1
            UnifiedPOI p=array.get(unifiedPOIs,n)
            if p.episodeId==epId and p.direction==dir and p.primary
                bool isOBFamily=p.poiType=="OB" or p.poiType=="BB"
                int classRank=contPOIPreference=="OB/BB first"?(isOBFamily?0:1):contPOIPreference=="FVG/IFVG first"?(isOBFamily?1:0):0
                float d=close>p.top?close-p.top:close<p.bottom?p.bottom-close:0.0

                bool better=false
                if contPOIPreference=="Nearest"
                    better:=na(bestDistance) or d<bestDistance
                else
                    better:=classRank<bestClass or (classRank==bestClass and (na(bestDistance) or d<bestDistance))

                if better
                    found:=n
                    bestDistance:=d
                    bestClass:=classRank
    found

f_episodeQualityScore(int epId) =>
    int found=na
    if episodeActive and episodeId==epId
        found:=episodePeakScore
    else if array.size(displacementEpisodes)>0
        for n=array.size(displacementEpisodes)-1 to 0
            DisplacementEpisode ep=array.get(displacementEpisodes,n)
            if ep.id==epId
                found:=ep.peakScore
                break
    found

f_qualityGrade(int score) =>
    score>=qualityGradeA?"A":score>=qualityGradeB?"B":score>=qualityGradeC?"C":"D"

f_displacementQualityPoints(int epId) =>
    int raw=f_episodeQualityScore(epId)
    na(raw)?0:int(math.round(math.min(math.max(raw,0),100)*0.30))

f_structureQualityPoints(string family,string scope,string kind) =>
    int pts=0
    if family=="REV"
        pts:=scope=="EXTERNAL"?(kind=="MSS"?20:kind=="CHoCH"?18:12):(kind=="MSS"?15:kind=="CHoCH"?13:8)
    else
        pts:=scope=="EXTERNAL"?20:scope=="INTERNAL"?15:10
    pts

f_poiQualityPoints(UnifiedPOI p) =>
    int pts=p.poiType=="OB" or p.poiType=="BB"?20:p.poiType=="IFVG"?16:14
    if (p.poiType=="FVG" or p.poiType=="IFVG") and p.structureLinked
        pts+=p.poiType=="FVG"?4:2
    math.min(pts,20)

f_mitigationQualityPoints(float pct) =>
    na(pct)?0:pct<=25?15:pct<=50?13:pct<=75?9:pct<100?5:0

f_revContextPoints(int tier) =>
    na(tier)?0:tier==1?15:tier==2?12:tier==3?8:4

type SignalRecord
    string family
    int direction
    int episodeId
    string poiEngine
    int poiId
    int bar
    int score

var array<SignalRecord> signalHistory=array.new<SignalRecord>()
var label[] signalLabels=array.new_label()
var int bullSignalCount=0
var int bearSignalCount=0
var int revSignalCount=0
var int contSignalCount=0
var int signalRejectedQuality=0
var int signalRejectedDuplicate=0
var int signalRejectedCooldown=0
var int lastBullSignalBar=na
var int lastBearSignalBar=na
var string lastSignalText="NONE"

f_signalDuplicate(string family,int epId,string poiEngine,int poiId) =>
    bool duplicate=false
    if oneSignalPerEpisodePOI and array.size(signalHistory)>0
        for n=array.size(signalHistory)-1 to 0
            SignalRecord sr=array.get(signalHistory,n)
            if sr.family==family and sr.episodeId==epId and sr.poiEngine==poiEngine and sr.poiId==poiId
                duplicate:=true
                break
    duplicate

f_signalCooldownOK(int dir) =>
    int lastBar=dir==1?lastBullSignalBar:lastBearSignalBar
    na(lastBar) or bar_index-lastBar>signalCooldownBars

f_signalEntryMarker(int dir,string family,int score,string grade) =>
    label result=na
    if showSignalMarkers
        float y=dir==1?low:high
        color c=dir==1?bullSignalColor:bearSignalColor
        if modeExecution and showCompactExecutionEntries
            string compact=(dir==1?"▲ ":"▼ ")+(family=="REV"?"R":"C")
            result:=label.new(bar_index,y,compact,style=label.style_none,textcolor=c,size=size.small)
        else if not modeExecution
            string verbose=(dir==1?"BUY ":"SELL ")+family+" · Q"+str.tostring(score)+" "+grade
            result:=label.new(bar_index,y,verbose,style=label.style_none,textcolor=c,size=f_textSize())
    result

f_signalScoreForPlan(string family,int epId,string poiEngine,int poiId) =>
    int result=na
    if array.size(signalHistory)>0
        for n=array.size(signalHistory)-1 to 0
            SignalRecord sr=array.get(signalHistory,n)
            if sr.family==family and sr.episodeId==epId and sr.poiEngine==poiEngine and sr.poiId==poiId
                result:=sr.score
                break
    result

type RiskPlan
    int id
    string family
    int direction
    int episodeId
    string poiEngine
    int poiId
    int signalBar
    int signalTime
    float entry
    float stop
    float target1
    float target2
    float rr1
    float rr2
    string target1Source
    string target2Source
    int state              // 0 ACTIVE, 1 T1_HIT, 2 T2_HIT, 3 STOPPED, 4 EXPIRED
    int terminalTime
    bool outcomeRecorded
    float realizedR
    string outcome
    line entryLine
    line stopLine
    line target1Line
    line target2Line
    label entryTag
    label stopTag
    label target1Tag
    label target2Tag
    label statusTag

var array<RiskPlan> riskPlans=array.new<RiskPlan>()
var int nextRiskPlanId=1
var int riskPlanCount=0
var float lastPlanEntry=na
var float lastPlanStop=na
var float lastPlanT1=na
var float lastPlanT2=na
var float lastPlanRR1=na
var float lastPlanRR2=na
var string lastPlanText="NONE"

var int completedTradeCount=0
var int stoppedTradeCount=0
var int expiredTradeCount=0
var int t1ReachedCount=0
var int t2ReachedCount=0
var float totalRealizedR=0.0
var float revRealizedR=0.0
var float contRealizedR=0.0
var int revClosedCount=0
var int contClosedCount=0
var int revWinCount=0
var int contWinCount=0
var int revLossCount=0
var int contLossCount=0
var string lastOutcomeText="NONE"
var label[] outcomeLabels=array.new_label()
var label[] recentEntryResultLabels=array.new_label()
var int[] recentEntryResultIds=array.new_int()

f_recentEntryText(string family,int dir,int score,float entry,string status,float realizedR) =>
    string grade=na(score)?"":f_qualityGrade(score)
    string scoreText=na(score)?"":" · Q"+str.tostring(score)+" "+grade
    string rText=na(realizedR)?"":" · "+(realizedR>0?"+":"")+str.tostring(realizedR,"#.00")+"R"
    family+" "+(dir==1?"BUY":"SELL")+scoreText+"\nENTRY "+str.tostring(entry,format.mintick)+"\n"+status+rText

f_addRecentEntryCard(int planId,string family,int dir,int epId,string poiEngine,int poiId,int signalTime,float entry) =>
    if showRecentEntryResults
        int score=f_signalScoreForPlan(family,epId,poiEngine,poiId)
        string txt=f_recentEntryText(family,dir,score,entry,"ACTIVE",na)
        color bg=dir==1?bullSignalColor:bearSignalColor
        label lb=label.new(signalTime,entry,txt,xloc=xloc.bar_time,style=dir==1?label.style_label_up:label.style_label_down,color=color.new(bg,15),textcolor=color.white,size=size.small)
        array.push(recentEntryResultIds,planId)
        array.push(recentEntryResultLabels,lb)
        while array.size(recentEntryResultLabels)>recentEntryResultCount
            array.shift(recentEntryResultIds)
            label.delete(array.shift(recentEntryResultLabels))

f_updateRecentEntryCard(int planId,string family,int dir,int epId,string poiEngine,int poiId,float entry,string status,float realizedR) =>
    if showRecentEntryResults and array.size(recentEntryResultIds)>0
        int found=-1
        for n=0 to array.size(recentEntryResultIds)-1
            if array.get(recentEntryResultIds,n)==planId
                found:=n
                break
        if found>=0
            label lb=array.get(recentEntryResultLabels,found)
            int score=f_signalScoreForPlan(family,epId,poiEngine,poiId)
            label.set_text(lb,f_recentEntryText(family,dir,score,entry,status,realizedR))
            color bg=na(realizedR)?(dir==1?bullSignalColor:bearSignalColor):realizedR>=0?bullSignalColor:bearSignalColor
            label.set_color(lb,color.new(bg,15))
            label.set_textcolor(lb,color.white)

f_clearRiskPlanVisuals(RiskPlan p) =>
    if not na(p.entryLine)
        line.delete(p.entryLine)
        p.entryLine:=na
    if not na(p.stopLine)
        line.delete(p.stopLine)
        p.stopLine:=na
    if not na(p.target1Line)
        line.delete(p.target1Line)
        p.target1Line:=na
    if not na(p.target2Line)
        line.delete(p.target2Line)
        p.target2Line:=na
    if not na(p.entryTag)
        label.delete(p.entryTag)
        p.entryTag:=na
    if not na(p.stopTag)
        label.delete(p.stopTag)
        p.stopTag:=na
    if not na(p.target1Tag)
        label.delete(p.target1Tag)
        p.target1Tag:=na
    if not na(p.target2Tag)
        label.delete(p.target2Tag)
        p.target2Tag:=na
    if not na(p.statusTag)
        label.delete(p.statusTag)
        p.statusTag:=na
    p

f_hidePriorActiveRiskVisuals() =>
    if showOnlyLatestActivePlan and array.size(riskPlans)>0
        for n=0 to array.size(riskPlans)-1
            RiskPlan p=array.get(riskPlans,n)
            if p.state<2
                p:=f_clearRiskPlanVisuals(p)
                array.set(riskPlans,n,p)

f_refreshRiskPlanVisuals(RiskPlan p,bool terminal) =>
    int rightTime=terminal and not na(p.terminalTime)?p.terminalTime:time
    if not na(p.entryLine)
        line.set_xy2(p.entryLine,rightTime,p.entry)
    if not na(p.stopLine)
        line.set_xy2(p.stopLine,rightTime,p.stop)
    if not na(p.target1Line)
        line.set_xy2(p.target1Line,rightTime,p.target1)
    if not na(p.target2Line)
        line.set_xy2(p.target2Line,rightTime,p.target2)
    if not na(p.entryTag)
        label.set_xy(p.entryTag,rightTime,p.entry)
    if not na(p.stopTag)
        label.set_xy(p.stopTag,rightTime,p.stop)
    if not na(p.target1Tag)
        label.set_xy(p.target1Tag,rightTime,p.target1)
    if not na(p.target2Tag)
        label.set_xy(p.target2Tag,rightTime,p.target2)
    if not na(p.statusTag)
        float statusY=p.direction==1?p.entry+atr*0.30:p.entry-atr*0.30
        label.set_xy(p.statusTag,rightTime,statusY)
        label.set_text(p.statusTag,p.family+" "+(p.direction==1?"BUY":"SELL")+" · "+(p.state==1?"T1 HIT":"ACTIVE"))
    if terminal and not showTerminalRiskPlans
        p:=f_clearRiskPlanVisuals(p)
    p

f_trimRiskPlans() =>
    f_trimRiskPlans()

//=============================================================================
// DIAGNOSTIC COUNTS
//=============================================================================

int activeTier1=0
int activeTier2=0
int activeTier3=0
int activeTier4=0
int eqhCount=0
int eqlCount=0

if array.size(liquidity)>0
    for n=0 to array.size(liquidity)-1
        LiquidityLevel q=array.get(liquidity,n)
        if q.state==0
            if q.tier==1
                activeTier1+=1
            else if q.tier==2
                activeTier2+=1
            else if q.tier==3
                activeTier3+=1
            else
                activeTier4+=1
            if q.buySide and q.clusterCount>=2
                eqhCount+=1
            if not q.buySide and q.clusterCount>=2
                eqlCount+=1

int activePrimaryFVG=0
int activeSecondaryFVG=0
if array.size(imbalanceZones)>0
    for n=0 to array.size(imbalanceZones)-1
        ImbalanceZone z=array.get(imbalanceZones,n)
        if z.state<2
            if z.primary or na(z.episodeId)
                activePrimaryFVG+=1
            else
                activeSecondaryFVG+=1

int activeBullOB=0
int activeBearOB=0
int activeBullBB=0
int activeBearBB=0
if array.size(orderBlocks)>0
    for n=0 to array.size(orderBlocks)-1
        OrderBlockZone z=array.get(orderBlocks,n)
        if z.state==0
            if z.direction==1
                activeBullOB+=1
            else
                activeBearOB+=1
        else if z.state==1
            if z.direction==-1
                activeBullBB+=1
            else
                activeBearBB+=1

int unifiedBullPOI=0
int unifiedBearPOI=0
int unifiedFVG=0
int unifiedIFVG=0
int unifiedOB=0
int unifiedBB=0
if array.size(unifiedPOIs)>0
    for n=0 to array.size(unifiedPOIs)-1
        UnifiedPOI p=array.get(unifiedPOIs,n)
        if p.direction==1
            unifiedBullPOI+=1
        else
            unifiedBearPOI+=1
        if p.poiType=="FVG"
            unifiedFVG+=1
        else if p.poiType=="IFVG"
            unifiedIFVG+=1
        else if p.poiType=="OB"
            unifiedOB+=1
        else if p.poiType=="BB"
            unifiedBB+=1

int nearestBullPOI=f_nearestPOIIndex(1)
int nearestBearPOI=f_nearestPOIIndex(-1)
string nearestBullPOIText=nearestBullPOI>=0?array.get(unifiedPOIs,nearestBullPOI).poiType+"#"+str.tostring(array.get(unifiedPOIs,nearestBullPOI).sourceId):"NONE"
string nearestBearPOIText=nearestBearPOI>=0?array.get(unifiedPOIs,nearestBearPOI).poiType+"#"+str.tostring(array.get(unifiedPOIs,nearestBearPOI).sourceId):"NONE"

f_trendText(int t) =>
    t==1?"BULL":t==-1?"BEAR":"NEUTRAL"

f_priceText(float v) =>
    na(v)?"—":str.tostring(v,format.mintick)

float avgRealizedR=(revClosedCount+contClosedCount)>0?totalRealizedR/(revClosedCount+contClosedCount):na
float revAvgR=revClosedCount>0?revRealizedR/revClosedCount:na
float contAvgR=contClosedCount>0?contRealizedR/contClosedCount:na
float revWinRate=revClosedCount>0?100.0*revWinCount/revClosedCount:na
float contWinRate=contClosedCount>0?100.0*contWinCount/contClosedCount:na

var table diag=table.new(position.top_right,2,107,border_width=1)

if barstate.islast
    table.clear(diag,0,0,1,106)
    if showDiagnostics
        int r=0
        table.cell(diag,0,r,"ARTHA v2 P12.5")
        table.cell(diag,1,r,runtimeProfile=="Production"?"PRODUCTION CANDIDATE":"RESEARCH MODE")
        r+=1
        table.cell(diag,0,r,"Runtime / Display")
        table.cell(diag,1,r,runtimeProfile+" / "+displayMode)
        r+=1
        table.cell(diag,0,r,"Internal trend")
        table.cell(diag,1,r,f_trendText(iTrend))
        r+=1
        table.cell(diag,0,r,"External trend")
        table.cell(diag,1,r,f_trendText(xTrend))
        r+=1
        table.cell(diag,0,r,"Internal event")
        table.cell(diag,1,r,lastInternalEvent)
        r+=1
        table.cell(diag,0,r,"External event")
        table.cell(diag,1,r,lastExternalEvent)
        r+=1
        table.cell(diag,0,r,"i Protected H/L")
        table.cell(diag,1,r,f_priceText(iProtectedHigh)+" / "+f_priceText(iProtectedLow))
        r+=1
        table.cell(diag,0,r,"x Protected H/L")
        table.cell(diag,1,r,f_priceText(xProtectedHigh)+" / "+f_priceText(xProtectedLow))
        r+=1
        table.cell(diag,0,r,"Active T1/T2")
        table.cell(diag,1,r,str.tostring(activeTier1)+" / "+str.tostring(activeTier2))
        r+=1
        table.cell(diag,0,r,"Active T3/T4")
        table.cell(diag,1,r,str.tostring(activeTier3)+" / "+str.tostring(activeTier4))
        r+=1
        table.cell(diag,0,r,"EQH / EQL")
        table.cell(diag,1,r,str.tostring(eqhCount)+" / "+str.tostring(eqlCount))
        r+=1
        table.cell(diag,0,r,"Last sweep")
        table.cell(diag,1,r,latestSweepSource+(na(latestSweepTier)?"":" · T"+str.tostring(latestSweepTier)))
        r+=1
        table.cell(diag,0,r,"Last resolution")
        table.cell(diag,1,r,latestResolutionSource+(na(latestResolutionTier)?"":" · T"+str.tostring(latestResolutionTier)))
        r+=1
        table.cell(diag,0,r,"Sweeps / Resolves")
        table.cell(diag,1,r,str.tostring(liquiditySweepCount)+" / "+str.tostring(liquidityResolutionCount))
        r+=1
        table.cell(diag,0,r,"Expired")
        table.cell(diag,1,r,str.tostring(liquidityExpiryCount))
        r+=1
        table.cell(diag,0,r,"Superseded")
        table.cell(diag,1,r,str.tostring(liquiditySupersedeCount))
        r+=1
        table.cell(diag,0,r,"Dup suppressions")
        table.cell(diag,1,r,str.tostring(duplicateSuppressions))
        r+=1
        table.cell(diag,0,r,"Body / ATR")
        table.cell(diag,1,r,str.tostring(displacementBodyATR,"#.00"))
        r+=1
        table.cell(diag,0,r,"Range / ATR")
        table.cell(diag,1,r,str.tostring(displacementRangeATR,"#.00"))
        r+=1
        table.cell(diag,0,r,"Body efficiency")
        table.cell(diag,1,r,str.tostring(displacementBodyPct*100,"#.0")+"%")
        r+=1
        table.cell(diag,0,r,"Body vs avg")
        table.cell(diag,1,r,na(bodyVsAvg)?"—":str.tostring(bodyVsAvg,"#.00")+"x")
        r+=1
        table.cell(diag,0,r,"Range vs avg")
        table.cell(diag,1,r,na(rangeVsAvg)?"—":str.tostring(rangeVsAvg,"#.00")+"x")
        r+=1
        table.cell(diag,0,r,"Bull/Bear DSP score")
        table.cell(diag,1,r,str.tostring(bullDisplacementScore)+" / "+str.tostring(bearDisplacementScore))
        r+=1
        table.cell(diag,0,r,"DSP events B/S")
        table.cell(diag,1,r,str.tostring(bullDisplacementCount)+" / "+str.tostring(bearDisplacementCount))
        r+=1
        table.cell(diag,0,r,"Last DSP score B/S")
        table.cell(diag,1,r,(na(lastBullDisplacementScore)?"—":str.tostring(lastBullDisplacementScore))+" / "+(na(lastBearDisplacementScore)?"—":str.tostring(lastBearDisplacementScore)))
        r+=1
        table.cell(diag,0,r,"Episode state")
        table.cell(diag,1,r,episodeActive?(episodeDirection==1?"BULL ACTIVE":"BEAR ACTIVE"):"IDLE")
        r+=1
        table.cell(diag,0,r,"Episode DSP count")
        table.cell(diag,1,r,episodeActive?str.tostring(episodeEventCount):"—")
        r+=1
        table.cell(diag,0,r,"Episode peak score")
        table.cell(diag,1,r,episodeActive and not na(episodePeakScore)?str.tostring(episodePeakScore):"—")
        r+=1
        table.cell(diag,0,r,"Completed episodes")
        table.cell(diag,1,r,str.tostring(completedEpisodeCount)+" · B "+str.tostring(bullEpisodeCount)+" / S "+str.tostring(bearEpisodeCount))
        r+=1
        table.cell(diag,0,r,"Last episode")
        table.cell(diag,1,r,lastCompletedEpisodeDirection==0?"—":(lastCompletedEpisodeDirection==1?"BULL ":"BEAR ")+str.tostring(lastCompletedEpisodePeakScore)+" · "+str.tostring(lastCompletedEpisodeBars)+" bars")
        r+=1
        table.cell(diag,0,r,"FVG B/S")
        table.cell(diag,1,r,str.tostring(bullFVGCount)+" / "+str.tostring(bearFVGCount))
        r+=1
        table.cell(diag,0,r,"IFVG B/S")
        table.cell(diag,1,r,str.tostring(bullIFVGCount)+" / "+str.tostring(bearIFVGCount))
        r+=1
        table.cell(diag,0,r,"FVG quality")
        table.cell(diag,1,r,"S "+str.tostring(structuralFVGCount)+" · D "+str.tostring(displacementFVGCount)+" · O "+str.tostring(ordinaryFVGCount))
        r+=1
        table.cell(diag,0,r,"Tracked imbalances")
        table.cell(diag,1,r,str.tostring(array.size(imbalanceZones)))
        r+=1
        table.cell(diag,0,r,"Active primary FVG")
        table.cell(diag,1,r,str.tostring(activePrimaryFVG))
        r+=1
        table.cell(diag,0,r,"Active secondary FVG")
        table.cell(diag,1,r,str.tostring(activeSecondaryFVG))
        r+=1
        table.cell(diag,0,r,"Retired imbalances")
        table.cell(diag,1,r,str.tostring(retiredImbalanceCount))
        r+=1
        table.cell(diag,0,r,"OB created B/S")
        table.cell(diag,1,r,str.tostring(bullOBCount)+" / "+str.tostring(bearOBCount))
        r+=1
        table.cell(diag,0,r,"Active OB B/S")
        table.cell(diag,1,r,str.tostring(activeBullOB)+" / "+str.tostring(activeBearOB))
        r+=1
        table.cell(diag,0,r,"Active BB B/S")
        table.cell(diag,1,r,str.tostring(activeBullBB)+" / "+str.tostring(activeBearBB))
        r+=1
        table.cell(diag,0,r,"BB transitions B/S")
        table.cell(diag,1,r,str.tostring(bullBBCount)+" / "+str.tostring(bearBBCount))
        r+=1
        table.cell(diag,0,r,"Retired OB/BB")
        table.cell(diag,1,r,str.tostring(retiredOBBBCount))
        if showPOIDiagnostics
            r+=1
            table.cell(diag,0,r,"Unified POI B/S")
            table.cell(diag,1,r,str.tostring(unifiedBullPOI)+" / "+str.tostring(unifiedBearPOI))
            r+=1
            table.cell(diag,0,r,"POI FVG / IFVG")
            table.cell(diag,1,r,str.tostring(unifiedFVG)+" / "+str.tostring(unifiedIFVG))
            r+=1
            table.cell(diag,0,r,"POI OB / BB")
            table.cell(diag,1,r,str.tostring(unifiedOB)+" / "+str.tostring(unifiedBB))
            r+=1
            table.cell(diag,0,r,"Nearest bull POI")
            table.cell(diag,1,r,nearestBullPOIText)
            r+=1
            table.cell(diag,0,r,"Nearest bear POI")
            table.cell(diag,1,r,nearestBearPOIText)
        r+=1
        table.cell(diag,0,r,"REV state B/S")
        table.cell(diag,1,r,f_revStateText(bullREVState)+" / "+f_revStateText(bearREVState))
        r+=1
        table.cell(diag,0,r,"REV sweep B/S")
        table.cell(diag,1,r,bullREVSweepSource+" / "+bearREVSweepSource)
        r+=1
        table.cell(diag,0,r,"REV episode B/S")
        table.cell(diag,1,r,(na(bullREVEpisodeId)?"—":str.tostring(bullREVEpisodeId))+" / "+(na(bearREVEpisodeId)?"—":str.tostring(bearREVEpisodeId)))
        r+=1
        table.cell(diag,0,r,"REV POI B/S")
        table.cell(diag,1,r,bullREVPOIType+"#"+(na(bullREVPOIId)?"—":str.tostring(bullREVPOIId))+" / "+bearREVPOIType+"#"+(na(bearREVPOIId)?"—":str.tostring(bearREVPOIId)))
        r+=1
        table.cell(diag,0,r,"REV eligible B/S")
        table.cell(diag,1,r,str.tostring(bullREVEligibleCount)+" / "+str.tostring(bearREVEligibleCount))
        r+=1
        table.cell(diag,0,r,"REV invalid B/S")
        table.cell(diag,1,r,str.tostring(bullREVInvalidationCount)+" / "+str.tostring(bearREVInvalidationCount))
        r+=1
        table.cell(diag,0,r,"CONT state B/S")
        table.cell(diag,1,r,f_contStateText(bullCONTState)+" / "+f_contStateText(bearCONTState))
        r+=1
        table.cell(diag,0,r,"CONT episode B/S")
        table.cell(diag,1,r,(na(bullCONTEpisodeId)?"—":str.tostring(bullCONTEpisodeId))+" / "+(na(bearCONTEpisodeId)?"—":str.tostring(bearCONTEpisodeId)))
        r+=1
        table.cell(diag,0,r,"CONT POI B/S")
        table.cell(diag,1,r,bullCONTPOIType+"#"+(na(bullCONTPOIId)?"—":str.tostring(bullCONTPOIId))+" / "+bearCONTPOIType+"#"+(na(bearCONTPOIId)?"—":str.tostring(bearCONTPOIId)))
        r+=1
        table.cell(diag,0,r,"CONT eligible B/S")
        table.cell(diag,1,r,str.tostring(bullCONTEligibleCount)+" / "+str.tostring(bearCONTEligibleCount))
        r+=1
        table.cell(diag,0,r,"CONT invalid B/S")
        table.cell(diag,1,r,str.tostring(bullCONTInvalidationCount)+" / "+str.tostring(bearCONTInvalidationCount))
        if showQualityDiagnostics
            r+=1
            table.cell(diag,0,r,"REV quality B/S")
            table.cell(diag,1,r,(na(bullREVLastScore)?"—":str.tostring(bullREVLastScore)+" "+bullREVLastGrade)+" / "+(na(bearREVLastScore)?"—":str.tostring(bearREVLastScore)+" "+bearREVLastGrade))
            r+=1
            table.cell(diag,0,r,"REV breakdown B")
            table.cell(diag,1,r,bullREVLastBreakdown)
            r+=1
            table.cell(diag,0,r,"REV breakdown S")
            table.cell(diag,1,r,bearREVLastBreakdown)
            r+=1
            table.cell(diag,0,r,"CONT quality B/S")
            table.cell(diag,1,r,(na(bullCONTLastScore)?"—":str.tostring(bullCONTLastScore)+" "+bullCONTLastGrade)+" / "+(na(bearCONTLastScore)?"—":str.tostring(bearCONTLastScore)+" "+bearCONTLastGrade))
            r+=1
            table.cell(diag,0,r,"CONT breakdown B")
            table.cell(diag,1,r,bullCONTLastBreakdown)
            r+=1
            table.cell(diag,0,r,"CONT breakdown S")
            table.cell(diag,1,r,bearCONTLastBreakdown)
        r+=1
        table.cell(diag,0,r,"Signals B/S")
        table.cell(diag,1,r,str.tostring(bullSignalCount)+" / "+str.tostring(bearSignalCount))
        r+=1
        table.cell(diag,0,r,"Signals REV/CONT")
        table.cell(diag,1,r,str.tostring(revSignalCount)+" / "+str.tostring(contSignalCount))
        r+=1
        table.cell(diag,0,r,"Rejected quality")
        table.cell(diag,1,r,str.tostring(signalRejectedQuality))
        r+=1
        table.cell(diag,0,r,"Rejected duplicate")
        table.cell(diag,1,r,str.tostring(signalRejectedDuplicate))
        r+=1
        table.cell(diag,0,r,"Rejected cooldown")
        table.cell(diag,1,r,str.tostring(signalRejectedCooldown))
        r+=1
        table.cell(diag,0,r,"Last signal")
        table.cell(diag,1,r,lastSignalText)
        if auditEnabled
            r+=1
            table.cell(diag,0,r,"Audit confirm B/S")
            table.cell(diag,1,r,str.tostring(bullAuditConfirmCount)+" / "+str.tostring(bearAuditConfirmCount))
            r+=1
            table.cell(diag,0,r,"Missed audit B/S")
            table.cell(diag,1,r,str.tostring(bullMissedEntryCount)+" / "+str.tostring(bearMissedEntryCount))
            r+=1
            table.cell(diag,0,r,"Audit captured")
            table.cell(diag,1,r,str.tostring(arthaCapturedAuditCount))
            r+=1
            table.cell(diag,0,r,"Early opp B/S")
            table.cell(diag,1,r,str.tostring(bullEarlyOpportunityCount)+" / "+str.tostring(bearEarlyOpportunityCount))
            r+=1
            table.cell(diag,0,r,"Raw reactions")
            table.cell(diag,1,r,str.tostring(rawReactionCount))
            r+=1
            table.cell(diag,0,r,"Last audit kind")
            table.cell(diag,1,r,lastAuditKind)
            r+=1
            table.cell(diag,0,r,"Last audit family")
            table.cell(diag,1,r,lastAuditFamily)
            r+=1
            table.cell(diag,0,r,"Last reaction")
            table.cell(diag,1,r,lastAuditClass)
            r+=1
            table.cell(diag,0,r,"Last miss reason")
            table.cell(diag,1,r,lastAuditReason)
        r+=1
        table.cell(diag,0,r,"Risk plans")
        table.cell(diag,1,r,str.tostring(riskPlanCount))
        r+=1
        table.cell(diag,0,r,"Last plan")
        table.cell(diag,1,r,lastPlanText)
        r+=1
        table.cell(diag,0,r,"Entry / Stop")
        table.cell(diag,1,r,f_priceText(lastPlanEntry)+" / "+f_priceText(lastPlanStop))
        r+=1
        table.cell(diag,0,r,"Target 1 / RR")
        table.cell(diag,1,r,f_priceText(lastPlanT1)+" / "+(na(lastPlanRR1)?"—":str.tostring(lastPlanRR1,"#.00")+"R"))
        r+=1
        table.cell(diag,0,r,"Target 2 / RR")
        table.cell(diag,1,r,f_priceText(lastPlanT2)+" / "+(na(lastPlanRR2)?"—":str.tostring(lastPlanRR2,"#.00")+"R"))
        if showOutcomeDiagnostics
            r+=1
            table.cell(diag,0,r,"T1 / T2 reached")
            table.cell(diag,1,r,str.tostring(t1ReachedCount)+" / "+str.tostring(t2ReachedCount))
            r+=1
            table.cell(diag,0,r,"Stopped / Expired")
            table.cell(diag,1,r,str.tostring(stoppedTradeCount)+" / "+str.tostring(expiredTradeCount))
            r+=1
            table.cell(diag,0,r,"Realized R")
            table.cell(diag,1,r,str.tostring(totalRealizedR,"#.00"))
            r+=1
            table.cell(diag,0,r,"Average R")
            table.cell(diag,1,r,na(avgRealizedR)?"—":str.tostring(avgRealizedR,"#.00"))
            r+=1
            table.cell(diag,0,r,"REV avgR / win%")
            table.cell(diag,1,r,(na(revAvgR)?"—":str.tostring(revAvgR,"#.00"))+" / "+(na(revWinRate)?"—":str.tostring(revWinRate,"#.0")+"%"))
            r+=1
            table.cell(diag,0,r,"CONT avgR / win%")
            table.cell(diag,1,r,(na(contAvgR)?"—":str.tostring(contAvgR,"#.00"))+" / "+(na(contWinRate)?"—":str.tostring(contWinRate,"#.0")+"%"))
            r+=1
            table.cell(diag,0,r,"Last outcome")
            table.cell(diag,1,r,lastOutcomeText)

//=============================================================================
// ALERTS — ENGINE EVENTS ONLY, NOT TRADE SIGNALS
//=============================================================================
alertcondition(bullMissedEntryEvent,"ARTHA v2 Bullish Missed Entry Audit","PLUTUS-style bullish POI reaction confirmed without an ARTHA capture")
alertcondition(bearMissedEntryEvent,"ARTHA v2 Bearish Missed Entry Audit","PLUTUS-style bearish POI reaction confirmed without an ARTHA capture")
alertcondition(newRiskPlanEvent,"ARTHA v2 Risk Plan Created","Risk and target plan created for execution signal")
alertcondition(tradeOutcomeEvent,"ARTHA v2 Trade Outcome Update","A tracked ARTHA trade plan reached a terminal outcome")
alertcondition(bullREVSignal,"ARTHA v2 BUY REV","Bullish REV execution signal")
alertcondition(bearREVSignal,"ARTHA v2 SELL REV","Bearish REV execution signal")
alertcondition(bullCONTSignal,"ARTHA v2 BUY CONT","Bullish CONT execution signal")
alertcondition(bearCONTSignal,"ARTHA v2 SELL CONT","Bearish CONT execution signal")
alertcondition(bullCONTEligibleEvent,"ARTHA v2 Bullish CONT Eligible","Bullish continuation setup became eligible")
alertcondition(bearCONTEligibleEvent,"ARTHA v2 Bearish CONT Eligible","Bearish continuation setup became eligible")
alertcondition(bullREVEligibleEvent,"ARTHA v2 Bullish REV Eligible","Bullish reversal setup became eligible")
alertcondition(bearREVEligibleEvent,"ARTHA v2 Bearish REV Eligible","Bearish reversal setup became eligible")
alertcondition(bullOBEvent,"ARTHA v2 Bullish OB","Qualified bullish causal Order Block created")
alertcondition(bearOBEvent,"ARTHA v2 Bearish OB","Qualified bearish causal Order Block created")
alertcondition(bullBBEvent,"ARTHA v2 Bullish Breaker","Qualified bullish Breaker Block transition")
alertcondition(bearBBEvent,"ARTHA v2 Bearish Breaker","Qualified bearish Breaker Block transition")
alertcondition(bullFVGEvent,"ARTHA v2 Bullish FVG","Confirmed bullish FVG created")
alertcondition(bearFVGEvent,"ARTHA v2 Bearish FVG","Confirmed bearish FVG created")
alertcondition(bullIFVGEvent,"ARTHA v2 Bullish IFVG","Confirmed bullish IFVG transition")
alertcondition(bearIFVGEvent,"ARTHA v2 Bearish IFVG","Confirmed bearish IFVG transition")
alertcondition(bullDisplacementEvent,"ARTHA v2 Bullish Displacement","Confirmed bullish displacement event")
alertcondition(bearDisplacementEvent,"ARTHA v2 Bearish Displacement","Confirmed bearish displacement event")
alertcondition(bullEpisodeCompleted,"ARTHA v2 Bullish Displacement Episode Complete","Confirmed bullish displacement episode completed")
alertcondition(bearEpisodeCompleted,"ARTHA v2 Bearish Displacement Episode Complete","Confirmed bearish displacement episode completed")
alertcondition(iBullBOS or xBullBOS,"ARTHA v2 Bullish BOS","Confirmed bullish BOS")
alertcondition(iBearBOS or xBearBOS,"ARTHA v2 Bearish BOS","Confirmed bearish BOS")
alertcondition(iBullCH or xBullCH,"ARTHA v2 Bullish CHoCH","Confirmed bullish CHoCH")
alertcondition(iBearCH or xBearCH,"ARTHA v2 Bearish CHoCH","Confirmed bearish CHoCH")
alertcondition(iBullMSS or xBullMSS,"ARTHA v2 Bullish MSS","Confirmed bullish MSS")
alertcondition(iBearMSS or xBearMSS,"ARTHA v2 Bearish MSS","Confirmed bearish MSS")
alertcondition(bullLiquiditySweep,"ARTHA v2 Bullish Liquidity Sweep","Confirmed sell-side liquidity sweep")
alertcondition(bearLiquiditySweep,"ARTHA v2 Bearish Liquidity Sweep","Confirmed buy-side liquidity sweep")
alertcondition(bullLiquidityResolution,"ARTHA v2 Bullish Liquidity Resolution","Confirmed bullish liquidity resolution")
alertcondition(bearLiquidityResolution,"ARTHA v2 Bearish Liquidity Resolution","Confirmed bearish liquidity resolution")
