//@version=6
indicator("ARTHA v2 P10 — Risk & Target Engine", shorttitle="ARTHA v2 P10", overlay=true, max_lines_count=500, max_boxes_count=400, max_labels_count=500)

//=============================================================================
// ARTHA v2 — PHASE 10
// Adds structural risk and target plans after validated P09 signals.
// Signals remain unchanged. Risk/reward is descriptive and non-filtering.
// No position sizing, broker orders, or performance model.
//=============================================================================

