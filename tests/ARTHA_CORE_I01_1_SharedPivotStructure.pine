//@version=6
indicator("ARTHA Integrated Core I01.1 — Shared Pivot + Structure", overlay=true, max_lines_count=200, max_labels_count=300)

//=============================================================================
// ARTHA INTEGRATED CORE — I01.1
// SHARED PIVOT + STRUCTURE BACKBONE
//
// Source contract:
// - P01.6 event classification: BOS / CHoCH / MSS
// - P01.7 persistent break targets
//
// Integration rule:
// Downstream engines read this shared state. They must not recalculate pivots
// or structure independently.
//=============================================================================

//-----------------------------------------------------------------------------
// INPUTS
//-----------------------------------------------------------------------------
string G1 = "01 Shared Structure"
int iLen = input.int(2, "Internal pivot strength", minval=1, group=G1)
int xLen = input.int(5, "External pivot strength", minval=2, group=G1)
bool requireClose = input.bool(true, "Require close through structure", group=G1)
float mssATR = input.float(0.75, "MSS body / ATR", minval=0.0, step=0.05, group=G1)

string G2 = "02 Display"
bool showEvents = input.bool(true, "Show BOS / CHoCH / MSS", group=G2)
bool showSwings = input.bool(false, "Show HH / HL / LH / LL", group=G2)
bool showLevels = input.bool(false, "Show active structure levels", group=G2)
bool diagnostic = input.bool(false, "Diagnostic panel", group=G2)
int maxLabels = input.int(80, "Maximum text labels", minval=10, maxval=200, group=G2)

//-----------------------------------------------------------------------------
// SHARED DISPLACEMENT MEASURE
//-----------------------------------------------------------------------------
float atr = ta.atr(14)
float body = math.abs(close - open)
float disp = atr > 0 ? body / atr : 0.0

//-----------------------------------------------------------------------------
// CONFIRMED PIVOTS
//-----------------------------------------------------------------------------
float iPH = ta.pivothigh(high, iLen, iLen)
float iPL = ta.pivotlow(low, iLen, iLen)
float xPH = ta.pivothigh(high, xLen, xLen)
float xPL = ta.pivotlow(low, xLen, xLen)

bool newIPH = barstate.isconfirmed and not na(iPH)
bool newIPL = barstate.isconfirmed and not na(iPL)
bool newXPH = barstate.isconfirmed and not na(xPH)
bool newXPL = barstate.isconfirmed and not na(xPL)

//-----------------------------------------------------------------------------
// LATEST CONFIRMED SWINGS + CLASSIFICATION
//-----------------------------------------------------------------------------
var float iHigh = na
var float iPriorHigh = na
var float iLow = na
var float iPriorLow = na
var int iHighBar = na
var int iLowBar = na
var string iHighClass = "NONE"
var string iLowClass = "NONE"

var float xHigh = na
var float xPriorHigh = na
var float xLow = na
var float xPriorLow = na
var int xHighBar = na
var int xLowBar = na
var string xHighClass = "NONE"
var string xLowClass = "NONE"

if newIPH
    iPriorHigh := iHigh
    iHigh := iPH
    iHighBar := bar_index - iLen
    iHighClass := na(iPriorHigh) ? "HH" : iHigh > iPriorHigh ? "HH" : "LH"

if newIPL
    iPriorLow := iLow
    iLow := iPL
    iLowBar := bar_index - iLen
    iLowClass := na(iPriorLow) ? "HL" : iLow > iPriorLow ? "HL" : "LL"

if newXPH
    xPriorHigh := xHigh
    xHigh := xPH
    xHighBar := bar_index - xLen
    xHighClass := na(xPriorHigh) ? "HH" : xHigh > xPriorHigh ? "HH" : "LH"

if newXPL
    xPriorLow := xLow
    xLow := xPL
    xLowBar := bar_index - xLen
    xLowClass := na(xPriorLow) ? "HL" : xLow > xPriorLow ? "HL" : "LL"

//-----------------------------------------------------------------------------
// PERSISTENT BREAK TARGETS — P01.7 CONTRACT
//
// Once a target is waiting, a newer same-side pivot does NOT replace it.
// A fresh target is accepted only after the prior target has been consumed.
//-----------------------------------------------------------------------------
var float iTargetHigh = na
var int iTargetHighBar = na
var bool iHighWaiting = false

var float iTargetLow = na
var int iTargetLowBar = na
var bool iLowWaiting = false

var float xTargetHigh = na
var int xTargetHighBar = na
var bool xHighWaiting = false

var float xTargetLow = na
var int xTargetLowBar = na
var bool xLowWaiting = false

if newIPH and not iHighWaiting
    iTargetHigh := iPH
    iTargetHighBar := bar_index - iLen
    iHighWaiting := true

if newIPL and not iLowWaiting
    iTargetLow := iPL
    iTargetLowBar := bar_index - iLen
    iLowWaiting := true

if newXPH and not xHighWaiting
    xTargetHigh := xPH
    xTargetHighBar := bar_index - xLen
    xHighWaiting := true

if newXPL and not xLowWaiting
    xTargetLow := xPL
    xTargetLowBar := bar_index - xLen
    xLowWaiting := true

//-----------------------------------------------------------------------------
// STRUCTURE STATE
//-----------------------------------------------------------------------------
var int iTrend = 0
var int xTrend = 0

var float iProtectedLow = na
var int iProtectedLowBar = na
var float iProtectedHigh = na
var int iProtectedHighBar = na

var float xProtectedLow = na
var int xProtectedLowBar = na
var float xProtectedHigh = na
var int xProtectedHighBar = na

int oldITrend = iTrend
int oldXTrend = xTrend

//-----------------------------------------------------------------------------
// CONFIRMED STRUCTURAL BREAKS
//-----------------------------------------------------------------------------
bool iBullBreak =
     barstate.isconfirmed and
     iHighWaiting and
     not na(iTargetHigh) and
     bar_index > iTargetHighBar and
     (requireClose ? close > iTargetHigh : high > iTargetHigh)

bool iBearBreak =
     barstate.isconfirmed and
     iLowWaiting and
     not na(iTargetLow) and
     bar_index > iTargetLowBar and
     (requireClose ? close < iTargetLow : low < iTargetLow)

bool xBullBreak =
     barstate.isconfirmed and
     xHighWaiting and
     not na(xTargetHigh) and
     bar_index > xTargetHighBar and
     (requireClose ? close > xTargetHigh : high > xTargetHigh)

bool xBearBreak =
     barstate.isconfirmed and
     xLowWaiting and
     not na(xTargetLow) and
     bar_index > xTargetLowBar and
     (requireClose ? close < xTargetLow : low < xTargetLow)

//-----------------------------------------------------------------------------
// EVENT CLASSIFICATION — P01.6 CONTRACT
//
// Reversal + sufficient displacement = MSS.
// Reversal without sufficient displacement = CHoCH.
// Non-reversal structural break = BOS.
//-----------------------------------------------------------------------------
bool iBullMSS = iBullBreak and oldITrend < 0 and disp >= mssATR
bool iBearMSS = iBearBreak and oldITrend > 0 and disp >= mssATR
bool xBullMSS = xBullBreak and oldXTrend < 0 and disp >= mssATR
bool xBearMSS = xBearBreak and oldXTrend > 0 and disp >= mssATR

bool iBullCH = iBullBreak and oldITrend < 0 and not iBullMSS
bool iBearCH = iBearBreak and oldITrend > 0 and not iBearMSS
bool xBullCH = xBullBreak and oldXTrend < 0 and not xBullMSS
bool xBearCH = xBearBreak and oldXTrend > 0 and not xBearMSS

bool iBullBOS = iBullBreak and not iBullCH and not iBullMSS
bool iBearBOS = iBearBreak and not iBearCH and not iBearMSS
bool xBullBOS = xBullBreak and not xBullCH and not xBullMSS
bool xBearBOS = xBearBreak and not xBearCH and not xBearMSS

//-----------------------------------------------------------------------------
// BREAK LIFECYCLE
//-----------------------------------------------------------------------------
if iBullBreak
    iHighWaiting := false
    iProtectedLow := iLow
    iProtectedLowBar := iLowBar
    iTrend := 1

if iBearBreak
    iLowWaiting := false
    iProtectedHigh := iHigh
    iProtectedHighBar := iHighBar
    iTrend := -1

if xBullBreak
    xHighWaiting := false
    xProtectedLow := xLow
    xProtectedLowBar := xLowBar
    xTrend := 1

if xBearBreak
    xLowWaiting := false
    xProtectedHigh := xHigh
    xProtectedHighBar := xHighBar
    xTrend := -1

//=============================================================================
// SHARED STATE CONTRACT
//
// Pivots / swings:
// iPH, iPL, xPH, xPL
// newIPH, newIPL, newXPH, newXPL
// iHigh/iLow/xHigh/xLow + bar + classification
//
// Persistent structural targets:
// iTargetHigh/iTargetLow + waiting flags
// xTargetHigh/xTargetLow + waiting flags
//
// Protected structure:
// iProtectedHigh/iProtectedLow + bars
// xProtectedHigh/xProtectedLow + bars
//
// Trend:
// iTrend, xTrend
//
// One-bar events:
// iBullBreak/iBearBreak/xBullBreak/xBearBreak
// iBullBOS/iBearBOS/xBullBOS/xBearBOS
// iBullCH/iBearCH/xBullCH/xBearCH
// iBullMSS/iBearMSS/xBullMSS/xBearMSS
//
// Shared displacement:
// atr, body, disp
//=============================================================================

//-----------------------------------------------------------------------------
// PLAIN-TEXT RENDERER
//-----------------------------------------------------------------------------
var label[] labels = array.new_label()

f_addLabel(int _x, float _y, string _text, size _size) =>
    label l = label.new(_x, _y, _text, style=label.style_none, textcolor=color.white, size=_size)
    array.push(labels, l)
    while array.size(labels) > maxLabels
        label.delete(array.shift(labels))

if showSwings and newIPH
    f_addLabel(iHighBar, iHigh, iHighClass, size.tiny)
if showSwings and newIPL
    f_addLabel(iLowBar, iLow, iLowClass, size.tiny)
if showSwings and newXPH
    f_addLabel(xHighBar, xHigh, xHighClass, size.tiny)
if showSwings and newXPL
    f_addLabel(xLowBar, xLow, xLowClass, size.tiny)

if showEvents and iBullMSS
    f_addLabel(bar_index, low, "iMSS ↑", size.small)
else if showEvents and iBullCH
    f_addLabel(bar_index, low, "iCHoCH ↑", size.small)
else if showEvents and iBullBOS
    f_addLabel(bar_index, low, "iBOS ↑", size.small)

if showEvents and iBearMSS
    f_addLabel(bar_index, high, "iMSS ↓", size.small)
else if showEvents and iBearCH
    f_addLabel(bar_index, high, "iCHoCH ↓", size.small)
else if showEvents and iBearBOS
    f_addLabel(bar_index, high, "iBOS ↓", size.small)

if showEvents and xBullMSS
    f_addLabel(bar_index, low, "xMSS ↑", size.small)
else if showEvents and xBullCH
    f_addLabel(bar_index, low, "xCHoCH ↑", size.small)
else if showEvents and xBullBOS
    f_addLabel(bar_index, low, "xBOS ↑", size.small)

if showEvents and xBearMSS
    f_addLabel(bar_index, high, "xMSS ↓", size.small)
else if showEvents and xBearCH
    f_addLabel(bar_index, high, "xCHoCH ↓", size.small)
else if showEvents and xBearBOS
    f_addLabel(bar_index, high, "xBOS ↓", size.small)

//-----------------------------------------------------------------------------
// OPTIONAL CURRENT ACTIVE LEVELS
//-----------------------------------------------------------------------------
var line iBullLine = na
var line iBearLine = na
var line xBullLine = na
var line xBearLine = na

if barstate.islast
    if na(iBullLine)
        iBullLine := line.new(bar_index, close, bar_index, close, extend=extend.none)
    if na(iBearLine)
        iBearLine := line.new(bar_index, close, bar_index, close, extend=extend.none)
    if na(xBullLine)
        xBullLine := line.new(bar_index, close, bar_index, close, extend=extend.none)
    if na(xBearLine)
        xBearLine := line.new(bar_index, close, bar_index, close, extend=extend.none)

    if iHighWaiting
        line.set_xy1(iBullLine, iTargetHighBar, iTargetHigh)
        line.set_xy2(iBullLine, bar_index, iTargetHigh)
        line.set_color(iBullLine, showLevels ? color.gray : color.new(color.gray, 100))
    else
        line.set_color(iBullLine, color.new(color.gray, 100))

    if iLowWaiting
        line.set_xy1(iBearLine, iTargetLowBar, iTargetLow)
        line.set_xy2(iBearLine, bar_index, iTargetLow)
        line.set_color(iBearLine, showLevels ? color.gray : color.new(color.gray, 100))
    else
        line.set_color(iBearLine, color.new(color.gray, 100))

    if xHighWaiting
        line.set_xy1(xBullLine, xTargetHighBar, xTargetHigh)
        line.set_xy2(xBullLine, bar_index, xTargetHigh)
        line.set_width(xBullLine, 2)
        line.set_color(xBullLine, showLevels ? color.gray : color.new(color.gray, 100))
    else
        line.set_color(xBullLine, color.new(color.gray, 100))

    if xLowWaiting
        line.set_xy1(xBearLine, xTargetLowBar, xTargetLow)
        line.set_xy2(xBearLine, bar_index, xTargetLow)
        line.set_width(xBearLine, 2)
        line.set_color(xBearLine, showLevels ? color.gray : color.new(color.gray, 100))
    else
        line.set_color(xBearLine, color.new(color.gray, 100))

//-----------------------------------------------------------------------------
// DIAGNOSTICS
//-----------------------------------------------------------------------------
string iEvent =
     iBullMSS ? "BULL MSS" :
     iBearMSS ? "BEAR MSS" :
     iBullCH ? "BULL CHoCH" :
     iBearCH ? "BEAR CHoCH" :
     iBullBOS ? "BULL BOS" :
     iBearBOS ? "BEAR BOS" :
     "NONE"

string xEvent =
     xBullMSS ? "BULL MSS" :
     xBearMSS ? "BEAR MSS" :
     xBullCH ? "BULL CHoCH" :
     xBearCH ? "BEAR CHoCH" :
     xBullBOS ? "BULL BOS" :
     xBearBOS ? "BEAR BOS" :
     "NONE"

var table t = table.new(position.top_right, 2, 14)

if barstate.islast
    table.clear(t, 0, 0, 1, 13)
    if diagnostic
        table.cell(t, 0, 0, "ARTHA I01.1")
        table.cell(t, 1, 0, "SHARED STRUCTURE")
        table.cell(t, 0, 1, "Internal trend")
        table.cell(t, 1, 1, iTrend == 1 ? "BULLISH" : iTrend == -1 ? "BEARISH" : "NEUTRAL")
        table.cell(t, 0, 2, "Internal event")
        table.cell(t, 1, 2, iEvent)
        table.cell(t, 0, 3, "Internal swing")
        table.cell(t, 1, 3, iHighClass + " / " + iLowClass)
        table.cell(t, 0, 4, "Internal targets")
        table.cell(t, 1, 4, (iHighWaiting ? str.tostring(iTargetHigh) : "-") + " / " + (iLowWaiting ? str.tostring(iTargetLow) : "-"))
        table.cell(t, 0, 5, "External trend")
        table.cell(t, 1, 5, xTrend == 1 ? "BULLISH" : xTrend == -1 ? "BEARISH" : "NEUTRAL")
        table.cell(t, 0, 6, "External event")
        table.cell(t, 1, 6, xEvent)
        table.cell(t, 0, 7, "External swing")
        table.cell(t, 1, 7, xHighClass + " / " + xLowClass)
        table.cell(t, 0, 8, "External targets")
        table.cell(t, 1, 8, (xHighWaiting ? str.tostring(xTargetHigh) : "-") + " / " + (xLowWaiting ? str.tostring(xTargetLow) : "-"))
        table.cell(t, 0, 9, "Protected i H/L")
        table.cell(t, 1, 9, str.tostring(iProtectedHigh) + " / " + str.tostring(iProtectedLow))
        table.cell(t, 0, 10, "Protected x H/L")
        table.cell(t, 1, 10, str.tostring(xProtectedHigh) + " / " + str.tostring(xProtectedLow))
        table.cell(t, 0, 11, "Displacement")
        table.cell(t, 1, 11, str.tostring(disp, "#.##"))
        table.cell(t, 0, 12, "Internal strength")
        table.cell(t, 1, 12, str.tostring(iLen))
        table.cell(t, 0, 13, "External strength")
        table.cell(t, 1, 13, str.tostring(xLen))

//-----------------------------------------------------------------------------
// ALERTABLE STRUCTURE EVENTS — NOT ENTRY SIGNALS
//-----------------------------------------------------------------------------
alertcondition(iBullBOS or xBullBOS, "ARTHA Bullish BOS", "Confirmed bullish BOS")
alertcondition(iBearBOS or xBearBOS, "ARTHA Bearish BOS", "Confirmed bearish BOS")
alertcondition(iBullCH or xBullCH, "ARTHA Bullish CHoCH", "Confirmed bullish CHoCH")
alertcondition(iBearCH or xBearCH, "ARTHA Bearish CHoCH", "Confirmed bearish CHoCH")
alertcondition(iBullMSS or xBullMSS, "ARTHA Bullish MSS", "Confirmed bullish MSS")
alertcondition(iBearMSS or xBearMSS, "ARTHA Bearish MSS", "Confirmed bearish MSS")
