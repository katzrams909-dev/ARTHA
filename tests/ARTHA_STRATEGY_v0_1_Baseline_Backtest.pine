//=============================================================================
// TYPES + HELPERS
//=============================================================================
type LiquidityLevel
    int id
    float price
    bool buySide
    int state          // 0 ACTIVE, 1 SWEPT, 2 RESOLVED, 3 EXPIRED, 4 SUPERSEDED
    int createdBar
    int terminalBar
    int expiryBar
    int startTime
    int endTime
    string source
    int category       // 0 swing, 1 D/W/M, 2 session
    color baseColor
    line ln
    label lb

float liqTolerance=atr*eqTolATR
var array<LiquidityLevel> liquidity=array.new<LiquidityLevel>()
var int nextLiquidityId=1

f_near(float a,float b,float tol) =>
    not na(a) and not na(b) and math.abs(a-b)<=tol

f_sessionVisible(int region) =>
    region==0?showAsia:region==1?showLondon:showNewYork

f_sessionName(int region) =>
    region==0?"ASIA":region==1?"LONDON":"NEW YORK"

f_sessionColor(int region) =>
    region==0?asiaColor:region==1?londonColor:newYorkColor

f_liqCategoryVisible(int cat) =>
    cat==1?showReferenceLiquidity:cat==2?showSessionLiquidity:false

f_hasActiveSwingNear(float price,bool buySide) =>
    false

f_deleteLiquidity(LiquidityLevel q) =>
    if not na(q.ln)
        line.delete(q.ln)
    if not na(q.lb)
        label.delete(q.lb)

f_addLiquidity(int id,float price,bool buySide,int createdBar,int expiryBar,int startTime,string source,int category,color baseColor) =>
    bool duplicateSwing = category==0 and f_hasActiveSwingNear(price,buySide)
    if not na(price) and not duplicateSwing
        if array.size(liquidity)>=maxLiquidity
            LiquidityLevel old=array.shift(liquidity)
            f_deleteLiquidity(old)
        line ln=line.new(startTime,price,time,price,xloc=xloc.bar_time,extend=extend.none,color=f_hidden(baseColor))
        label lb=label.new(time,price,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
        array.push(liquidity,LiquidityLevel.new(id,price,buySide,0,createdBar,na,expiryBar,startTime,na,source,category,baseColor,ln,lb))

f_supersedeSource(string source) =>
    if array.size(liquidity)>0
        for n=0 to array.size(liquidity)-1
            LiquidityLevel q=array.get(liquidity,n)
            if q.state==0 and q.source==source
                q.state:=4
                q.terminalBar:=bar_index
                q.endTime:=time
                array.set(liquidity,n,q)

//=============================================================================
// P01 SHARED PIVOTS / STRUCTURE
//=============================================================================
float iPH=ta.pivothigh(high,iLen,iLen)
float iPL=ta.pivotlow(low,iLen,iLen)
float xPH=ta.pivothigh(high,xLen,xLen)
float xPL=ta.pivotlow(low,xLen,xLen)

bool newIPH=barstate.isconfirmed and not na(iPH)
bool newIPL=barstate.isconfirmed and not na(iPL)
bool newXPH=barstate.isconfirmed and not na(xPH)
bool newXPL=barstate.isconfirmed and not na(xPL)

var float iHigh=na
var float iLow=na
var int iHighBar=na
var int iLowBar=na
var int iHighTime=na
var int iLowTime=na
var float iPriorHigh=na
var float iPriorLow=na
var string iHighClass="NONE"
var string iLowClass="NONE"

var float xHigh=na
var float xLow=na
var int xHighBar=na
var int xLowBar=na
var int xHighTime=na
var int xLowTime=na
var float xPriorHigh=na
var float xPriorLow=na
var string xHighClass="NONE"
var string xLowClass="NONE"

var float iTargetHigh=na
var int iTargetHighTime=na
var bool iHighWaiting=false
var float iTargetLow=na
var int iTargetLowTime=na
var bool iLowWaiting=false
var float xTargetHigh=na
var int xTargetHighTime=na
var bool xHighWaiting=false
var float xTargetLow=na
var int xTargetLowTime=na
var bool xLowWaiting=false

// P/D pending legs exist before destination detection.
var bool pendingBullLeg=false
var bool pendingBearLeg=false
var float pendingLow=na
var int pendingLowBar=na
var int pendingLowTime=na
var int pendingBullBreakBar=na
var string pendingBullEvent="NONE"
var float pendingHigh=na
var int pendingHighBar=na
var int pendingHighTime=na
var int pendingBearBreakBar=na
var string pendingBearEvent="NONE"

bool destinationBullHigh=false
bool destinationBearLow=false
float destinationHigh=na
float destinationLow=na
int destinationHighTime=na
int destinationLowTime=na

if newIPH
    iPriorHigh:=iHigh
    iHigh:=iPH
    iHighBar:=bar_index-iLen
    iHighTime:=time[iLen]
    iHighClass:=na(iPriorHigh)?"HH":iHigh>iPriorHigh?"HH":"LH"
    if not iHighWaiting
        iTargetHigh:=iPH
        iTargetHighTime:=iHighTime
        iHighWaiting:=true

if newIPL
    iPriorLow:=iLow
    iLow:=iPL
    iLowBar:=bar_index-iLen
    iLowTime:=time[iLen]
    iLowClass:=na(iPriorLow)?"HL":iLow>iPriorLow?"HL":"LL"
    if not iLowWaiting
        iTargetLow:=iPL
        iTargetLowTime:=iLowTime
        iLowWaiting:=true

if newXPH
    xPriorHigh:=xHigh
    xHigh:=xPH
    xHighBar:=bar_index-xLen
    xHighTime:=time[xLen]
    xHighClass:=na(xPriorHigh)?"HH":xHigh>xPriorHigh?"HH":"LH"
    if not xHighWaiting
        xTargetHigh:=xPH
        xTargetHighTime:=xHighTime
        xHighWaiting:=true
    if pendingBullLeg and not na(pendingBullBreakBar) and bar_index>pendingBullBreakBar and not na(pendingLowBar) and xHighBar>pendingLowBar
        destinationBullHigh:=true
        destinationHigh:=xPH
        destinationHighTime:=xHighTime

if newXPL
    xPriorLow:=xLow
    xLow:=xPL
    xLowBar:=bar_index-xLen
    xLowTime:=time[xLen]
    xLowClass:=na(xPriorLow)?"HL":xLow>xPriorLow?"HL":"LL"
    if not xLowWaiting
        xTargetLow:=xPL
        xTargetLowTime:=xLowTime
        xLowWaiting:=true
    if pendingBearLeg and not na(pendingBearBreakBar) and bar_index>pendingBearBreakBar and not na(pendingHighBar) and xLowBar>pendingHighBar
        destinationBearLow:=true
        destinationLow:=xPL
        destinationLowTime:=xLowTime

//=============================================================================
// P05 DEALING RANGE — FINALIZE OLD PENDING LEG BEFORE NEW BREAK MUTATES IT
//=============================================================================
bool newPDZone=false
bool newBullPD=false
bool newBearPD=false
float newPDHigh=na
float newPDLow=na
int newPDHighTime=na
int newPDLowTime=na
int newPDDirection=0
string newPDSource="NONE"

if destinationBullHigh and not na(pendingLow) and destinationHigh>pendingLow
    newPDZone:=true
    newBullPD:=true
    newPDHigh:=destinationHigh
    newPDLow:=pendingLow
    newPDHighTime:=destinationHighTime
    newPDLowTime:=pendingLowTime
    newPDDirection:=1
    newPDSource:=pendingBullEvent
    pendingBullLeg:=false

if destinationBearLow and not na(pendingHigh) and pendingHigh>destinationLow
    newPDZone:=true
    newBullPD:=false
    newBearPD:=true
    newPDHigh:=pendingHigh
    newPDLow:=destinationLow
    newPDHighTime:=pendingHighTime
    newPDLowTime:=destinationLowTime
    newPDDirection:=-1
    newPDSource:=pendingBearEvent
    pendingBearLeg:=false

//=============================================================================
// STRUCTURE BREAKS + EVENTS
//=============================================================================
var int iTrend=0
var int xTrend=0
var float iProtectedLow=na
var float iProtectedHigh=na
var float xProtectedLow=na
var float xProtectedHigh=na
var int iProtectedLowTime=na
var int iProtectedHighTime=na
var int xProtectedLowTime=na
var int xProtectedHighTime=na

int oldITrend=iTrend
int oldXTrend=xTrend

bool iBullBreak=barstate.isconfirmed and iHighWaiting and not na(iTargetHigh) and (requireClose?close>iTargetHigh:high>iTargetHigh)
bool iBearBreak=barstate.isconfirmed and iLowWaiting and not na(iTargetLow) and (requireClose?close<iTargetLow:low<iTargetLow)
bool xBullBreak=barstate.isconfirmed and xHighWaiting and not na(xTargetHigh) and (requireClose?close>xTargetHigh:high>xTargetHigh)
bool xBearBreak=barstate.isconfirmed and xLowWaiting and not na(xTargetLow) and (requireClose?close<xTargetLow:low<xTargetLow)

bool iBullMSS=iBullBreak and oldITrend<0 and disp>=mssATR
bool iBearMSS=iBearBreak and oldITrend>0 and disp>=mssATR
bool xBullMSS=xBullBreak and oldXTrend<0 and disp>=mssATR
bool xBearMSS=xBearBreak and oldXTrend>0 and disp>=mssATR
bool iBullCH=iBullBreak and oldITrend<0 and not iBullMSS
bool iBearCH=iBearBreak and oldITrend>0 and not iBearMSS
bool xBullCH=xBullBreak and oldXTrend<0 and not xBullMSS
bool xBearCH=xBearBreak and oldXTrend>0 and not xBearMSS
bool iBullBOS=iBullBreak and not iBullCH and not iBullMSS
bool iBearBOS=iBearBreak and not iBearCH and not iBearMSS
bool xBullBOS=xBullBreak and not xBullCH and not xBullMSS
bool xBearBOS=xBearBreak and not xBearCH and not xBearMSS

// Persistent directional structure context.
// Used mainly by CONT and optionally by INV. REV still requires a fresh shift.
var int structureContext=0
var int structureContextBar=na
var string structureContextType="NONE"

bool anyBullStructure=iBullBreak or xBullBreak
bool anyBearStructure=iBearBreak or xBearBreak

if anyBullStructure and not anyBearStructure
    structureContext:=1
    structureContextBar:=bar_index
    structureContextType:=(iBullMSS or xBullMSS)?"MSS":(iBullCH or xBullCH)?"CHoCH":"BOS"
else if anyBearStructure and not anyBullStructure
    structureContext:=-1
    structureContextBar:=bar_index
    structureContextType:=(iBearMSS or xBearMSS)?"MSS":(iBearCH or xBearCH)?"CHoCH":"BOS"

f_structureContextAligned(int side,int maxAge) =>
    structureContext==side and not na(structureContextBar) and bar_index-structureContextBar<=maxAge

var line[] structureLines=array.new_line()
var label[] structureLabels=array.new_label()
var int internalBOSCount=0
var int internalCHCount=0
var int internalMSSCount=0
var int externalBOSCount=0
var int externalCHCount=0
var int externalMSSCount=0

f_structureText(string scope,string kind,bool bullish) =>
    structureLabelMode=="Full"?scope+" "+kind+(bullish?" ↑":" ↓"):kind=="CHOCH"?"CHoCH":kind

f_addStructureVisual(bool enabled,int swingTime,float price,string scope,string kind,bool bullish,color c) =>
    if enabled and structureLabelMode!="Off" and not na(swingTime) and not na(price)
        line ln=line.new(swingTime,price,time,price,xloc=xloc.bar_time,extend=extend.none,color=c,style=kind=="CHOCH"?line.style_dashed:line.style_solid,width=kind=="MSS"?2:1)
        array.push(structureLines,ln)
        string labelText=structureLabelMode=="Lines only"?"":f_structureText(scope,kind,bullish)
        int midTime=swingTime+(time-swingTime)/2
        label lb=label.new(midTime,price,labelText,xloc=xloc.bar_time,style=label.style_none,textcolor=c,size=f_textSize())
        array.push(structureLabels,lb)
        while array.size(structureLines)>maxStructureEvents
            line.delete(array.shift(structureLines))
            label.delete(array.shift(structureLabels))

// Visibility is controlled by explicit structure inputs.
// Execution mode no longer silently hides external structure.
bool renderInternal=showStructureEvents and showInternalStructure
bool renderExternal=showStructureEvents and showExternalStructure

if iBullBreak
    string kind=iBullMSS?"MSS":iBullCH?"CHOCH":"BOS"
    f_addStructureVisual(renderInternal,iTargetHighTime,iTargetHigh,"i",kind,true,bullStructureColor)
    if iBullMSS
        internalMSSCount+=1
    else if iBullCH
        internalCHCount+=1
    else
        internalBOSCount+=1
    iHighWaiting:=false
    iProtectedLow:=iLow
    iProtectedLowTime:=iLowTime
    iTrend:=1

if iBearBreak
    string kind=iBearMSS?"MSS":iBearCH?"CHOCH":"BOS"
    f_addStructureVisual(renderInternal,iTargetLowTime,iTargetLow,"i",kind,false,bearStructureColor)
    if iBearMSS
        internalMSSCount+=1
    else if iBearCH
        internalCHCount+=1
    else
        internalBOSCount+=1
    iLowWaiting:=false
    iProtectedHigh:=iHigh
    iProtectedHighTime:=iHighTime
    iTrend:=-1

if xBullBreak
    string kind=xBullMSS?"MSS":xBullCH?"CHOCH":"BOS"
    f_addStructureVisual(renderExternal,xTargetHighTime,xTargetHigh,"x",kind,true,bullStructureColor)
    if xBullMSS
        externalMSSCount+=1
    else if xBullCH
        externalCHCount+=1
    else
        externalBOSCount+=1
    xHighWaiting:=false
    xProtectedLow:=xLow
    xProtectedLowTime:=xLowTime
    xTrend:=1
    pendingBullLeg:=not na(xLow)
    pendingLow:=xLow
    pendingLowBar:=xLowBar
    pendingLowTime:=xLowTime
    pendingBullBreakBar:=bar_index
    pendingBullEvent:=xBullMSS?"EXTERNAL_MSS_BULLISH":xBullCH?"EXTERNAL_CHOCH_BULLISH":"EXTERNAL_BOS_BULLISH"
    pendingBearLeg:=false

if xBearBreak
    string kind=xBearMSS?"MSS":xBearCH?"CHOCH":"BOS"
    f_addStructureVisual(renderExternal,xTargetLowTime,xTargetLow,"x",kind,false,bearStructureColor)
    if xBearMSS
        externalMSSCount+=1
    else if xBearCH
        externalCHCount+=1
    else
        externalBOSCount+=1
    xLowWaiting:=false
    xProtectedHigh:=xHigh
    xProtectedHighTime:=xHighTime
    xTrend:=-1
    pendingBearLeg:=not na(xHigh)
    pendingHigh:=xHigh
    pendingHighBar:=xHighBar
    pendingHighTime:=xHighTime
    pendingBearBreakBar:=bar_index
    pendingBearEvent:=xBearMSS?"EXTERNAL_MSS_BEARISH":xBearCH?"EXTERNAL_CHOCH_BEARISH":"EXTERNAL_BOS_BEARISH"
    pendingBullLeg:=false

//=============================================================================
// PREVIOUS D/W/M LIQUIDITY
//=============================================================================
float pdH=request.security(syminfo.tickerid,"D",high[1],lookahead=barmerge.lookahead_on)
float pdL=request.security(syminfo.tickerid,"D",low[1],lookahead=barmerge.lookahead_on)
float pwH=request.security(syminfo.tickerid,"W",high[1],lookahead=barmerge.lookahead_on)
float pwL=request.security(syminfo.tickerid,"W",low[1],lookahead=barmerge.lookahead_on)
float pmH=request.security(syminfo.tickerid,"M",high[1],lookahead=barmerge.lookahead_on)
float pmL=request.security(syminfo.tickerid,"M",low[1],lookahead=barmerge.lookahead_on)

bool newD=ta.change(time("D"))!=0
bool newW=ta.change(time("W"))!=0
bool newM=ta.change(time("M"))!=0

if (barstate.isfirst or newD) and usePD
    f_supersedeSource("PDH")
    f_supersedeSource("PDL")
    f_addLiquidity(nextLiquidityId,pdH,true,bar_index,na,time,"PDH",1,referenceLiquidityColor)
    nextLiquidityId+=1
    f_addLiquidity(nextLiquidityId,pdL,false,bar_index,na,time,"PDL",1,referenceLiquidityColor)
    nextLiquidityId+=1

if (barstate.isfirst or newW) and usePW
    f_supersedeSource("PWH")
    f_supersedeSource("PWL")
    f_addLiquidity(nextLiquidityId,pwH,true,bar_index,na,time,"PWH",1,referenceLiquidityColor)
    nextLiquidityId+=1
    f_addLiquidity(nextLiquidityId,pwL,false,bar_index,na,time,"PWL",1,referenceLiquidityColor)
    nextLiquidityId+=1

if (barstate.isfirst or newM) and usePM
    f_supersedeSource("PMH")
    f_supersedeSource("PML")
    f_addLiquidity(nextLiquidityId,pmH,true,bar_index,na,time,"PMH",1,referenceLiquidityColor)
    nextLiquidityId+=1
    f_addLiquidity(nextLiquidityId,pmL,false,bar_index,na,time,"PML",1,referenceLiquidityColor)
    nextLiquidityId+=1

//=============================================================================
// P04 SESSION ENGINE — VISIBLE RANGE BOX + LIVE H/L
//=============================================================================
f_inSession(string sessionString) =>
    not na(time(timeframe.period,sessionString,sessionTz))

bool asiaIn=f_inSession(asiaSession)
bool londonIn=f_inSession(londonSession)
bool nyIn=f_inSession(newYorkSession)

var bool[] sessionActive=array.from(false,false,false)
var float[] sessionHi=array.new_float(3,na)
var float[] sessionLo=array.new_float(3,na)
var int[] sessionStartTime=array.new_int(3,na)
var line[] currentSessionHiLines=array.new_line(3)
var line[] currentSessionLoLines=array.new_line(3)
var box[] currentSessionBoxes=array.new_box(3)
var label[] currentSessionLabels=array.new_label(3)
var box[] completedSessionBoxes=array.new_box()
var int[] completedSessionRegions=array.new_int()

f_processSession(int idx,bool inside,int firstLiquidityId) =>
    int createdLiquidityCount=0
    bool was=array.get(sessionActive,idx)
    bool regionVisible=f_sessionVisible(idx)
    bool visualVisible=regionVisible and (modeAnalysis or modeFull)
    color c=f_sessionColor(idx)
    string nm=f_sessionName(idx)

    if inside
        if not was
            array.set(sessionActive,idx,true)
            array.set(sessionHi,idx,high)
            array.set(sessionLo,idx,low)
            array.set(sessionStartTime,idx,time)

            line hLine=line.new(time,high,time,high,xloc=xloc.bar_time,extend=extend.none,color=visualVisible and showActiveSessionHL?c:f_hidden(c))
            line lLine=line.new(time,low,time,low,xloc=xloc.bar_time,extend=extend.none,color=visualVisible and showActiveSessionHL?c:f_hidden(c))
            box b=box.new(time,high,time,low,xloc=xloc.bar_time,border_color=visualVisible and showSessionRanges?c:f_hidden(c),bgcolor=visualVisible and showSessionRanges?color.new(c,sessionBoxTransparency):f_hidden(c))
            label lb=label.new(time,(high+low)/2,visualVisible and showSessionNames?nm:"",xloc=xloc.bar_time,style=label.style_none,textcolor=c,size=f_textSize())
            array.set(currentSessionHiLines,idx,hLine)
            array.set(currentSessionLoLines,idx,lLine)
            array.set(currentSessionBoxes,idx,b)
            array.set(currentSessionLabels,idx,lb)
        else
            float oldHi=array.get(sessionHi,idx)
            float oldLo=array.get(sessionLo,idx)
            if high>oldHi
                array.set(sessionHi,idx,high)
            if low<oldLo
                array.set(sessionLo,idx,low)

        float hi=array.get(sessionHi,idx)
        float lo=array.get(sessionLo,idx)
        int st=array.get(sessionStartTime,idx)
        line hLine=array.get(currentSessionHiLines,idx)
        line lLine=array.get(currentSessionLoLines,idx)
        box b=array.get(currentSessionBoxes,idx)
        label lb=array.get(currentSessionLabels,idx)

        line.set_xy1(hLine,st,hi)
        line.set_xy2(hLine,time,hi)
        line.set_color(hLine,visualVisible and showActiveSessionHL?c:f_hidden(c))
        line.set_xy1(lLine,st,lo)
        line.set_xy2(lLine,time,lo)
        line.set_color(lLine,visualVisible and showActiveSessionHL?c:f_hidden(c))

        box.set_lefttop(b,st,hi)
        box.set_rightbottom(b,time,lo)
        box.set_border_color(b,visualVisible and showSessionRanges?c:f_hidden(c))
        box.set_bgcolor(b,visualVisible and showSessionRanges?color.new(c,sessionBoxTransparency):f_hidden(c))

        label.set_xy(lb,st+(time-st)/2,(hi+lo)/2)
        label.set_text(lb,visualVisible and showSessionNames?nm:"")
        label.set_textcolor(lb,c)

    else if was and barstate.isconfirmed
        float finalHi=array.get(sessionHi,idx)
        float finalLo=array.get(sessionLo,idx)
        int st=array.get(sessionStartTime,idx)
        line hLine=array.get(currentSessionHiLines,idx)
        line lLine=array.get(currentSessionLoLines,idx)
        box b=array.get(currentSessionBoxes,idx)
        label lb=array.get(currentSessionLabels,idx)

        line.delete(hLine)
        line.delete(lLine)
        label.delete(lb)

        if keepCompletedSessionRanges and maxCompletedSessionRanges>0
            array.push(completedSessionBoxes,b)
            array.push(completedSessionRegions,idx)
            while array.size(completedSessionBoxes)>maxCompletedSessionRanges
                box.delete(array.shift(completedSessionBoxes))
                array.shift(completedSessionRegions)
        else
            box.delete(b)

        if useSessionLiquidity
            f_addLiquidity(firstLiquidityId,finalHi,true,bar_index,bar_index+sessionLiquidityMaxAge,st,nm+" H",2,c)
            f_addLiquidity(firstLiquidityId+1,finalLo,false,bar_index,bar_index+sessionLiquidityMaxAge,st,nm+" L",2,c)
            createdLiquidityCount:=2

        array.set(currentSessionHiLines,idx,na)
        array.set(currentSessionLoLines,idx,na)
        array.set(currentSessionBoxes,idx,na)
        array.set(currentSessionLabels,idx,na)
        array.set(sessionActive,idx,false)
        array.set(sessionHi,idx,na)
        array.set(sessionLo,idx,na)
        array.set(sessionStartTime,idx,na)

    createdLiquidityCount

int asiaCreated=f_processSession(0,asiaIn,nextLiquidityId)
nextLiquidityId+=asiaCreated

int londonCreated=f_processSession(1,londonIn,nextLiquidityId)
nextLiquidityId+=londonCreated

int nyCreated=f_processSession(2,nyIn,nextLiquidityId)
nextLiquidityId+=nyCreated

if array.size(completedSessionBoxes)>0
    for n=0 to array.size(completedSessionBoxes)-1
        box b=array.get(completedSessionBoxes,n)
        int region=array.get(completedSessionRegions,n)
        color c=f_sessionColor(region)
        bool vis=f_sessionVisible(region) and (modeAnalysis or modeFull) and showSessionRanges and keepCompletedSessionRanges
        box.set_border_color(b,vis?c:f_hidden(c))
        box.set_bgcolor(b,vis?color.new(c,sessionBoxTransparency):f_hidden(c))

//=============================================================================
// COMMON LIQUIDITY LIFECYCLE
// Sweep = wick through + close back.
// Resolve = confirmed close through.
// All terminal states stop line extension immediately.
//=============================================================================
bool bullSweep=false
bool bearSweep=false
bool bullResolvedEvent=false
bool bearResolvedEvent=false
string latestSweepSource="NONE"
float latestSweepPrice=na
string latestResolvedSource="NONE"
float latestResolvedPrice=na

if array.size(liquidity)>0
    for n=0 to array.size(liquidity)-1
        LiquidityLevel q=array.get(liquidity,n)

        if q.state==0
            bool expired=not na(q.expiryBar) and bar_index>q.expiryBar
            bool sweep=barstate.isconfirmed and (q.buySide?(high>q.price and close<q.price):(low<q.price and close>q.price))
            bool resolved=barstate.isconfirmed and (q.buySide?close>q.price:close<q.price)

            if sweep
                q.state:=1
                q.terminalBar:=bar_index
                q.endTime:=time
                latestSweepSource:=q.source
                latestSweepPrice:=q.price
                if q.buySide
                    bearSweep:=true
                else
                    bullSweep:=true
            else if resolved
                q.state:=2
                q.terminalBar:=bar_index
                q.endTime:=time
                latestResolvedSource:=q.source
                latestResolvedPrice:=q.price
                if q.buySide
                    bullResolvedEvent:=true
                else
                    bearResolvedEvent:=true
            else if expired
                q.state:=3
                q.terminalBar:=bar_index
                q.endTime:=time

            array.set(liquidity,n,q)

        bool terminal=q.state!=0
        bool stateVisible=q.state==0 or (q.state==1 and keepSweptLiquidity) or (q.state==2 and keepResolvedLiquidity)
        bool categoryVisible=f_liqCategoryVisible(q.category)
        bool modeVisible=modeFull or modeAnalysis or (modeExecution and q.state==0 and q.category!=0)
        bool visible=stateVisible and categoryVisible and modeVisible
        color c=q.state==1?sweptLiquidityColor:q.state==2?resolvedLiquidityColor:q.baseColor

        if not na(q.ln)
            int x2=terminal and not na(q.endTime)?q.endTime:time
            line.set_xy2(q.ln,x2,q.price)
            line.set_color(q.ln,visible?c:f_hidden(c))
            line.set_style(q.ln,terminal?line.style_dashed:line.style_solid)
        if not na(q.lb)
            int lx=terminal and not na(q.endTime)?q.endTime:time
            label.set_xy(q.lb,lx,q.price)
            label.set_text(q.lb,visible and showLiquidityLabels?q.source:"")
            label.set_textcolor(q.lb,c)

//=============================================================================
// P02 FVG / IFVG LIFECYCLE
//=============================================================================
float bullGap=low-high[2]
float bearGap=low[2]-high
bool bullFVG=barstate.isconfirmed and not na(high[2]) and bullGap>0 and bullGap>=atr*minGapATR and (not requireFVGDisplacement or disp>=fvgDispATR)
bool bearFVG=barstate.isconfirmed and not na(low[2]) and bearGap>0 and bearGap>=atr*minGapATR and (not requireFVGDisplacement or disp>=fvgDispATR)

var float[] fvgTops=array.new_float()
var float[] fvgBots=array.new_float()
var int[] fvgDirs=array.new_int()
var int[] fvgStates=array.new_int()
var bool[] fvgMitigated=array.new_bool()
var bool[] ifvgMitigated=array.new_bool()
var float[] fvgMaxMitigationPct=array.new_float()
var float[] ifvgMaxMitigationPct=array.new_float()
var int[] ifvgBornBars=array.new_int()
var int[] fvgBornBars=array.new_int()
var int[] fvgLeftTimes=array.new_int()
var box[] fvgBoxes=array.new_box()
var label[] fvgLabels=array.new_label()

f_addFVG(float top,float bot,int dir,int leftTime) =>
    if array.size(fvgTops)>=maxFVGZones
        box.delete(array.shift(fvgBoxes))
        label oldFVGLabel=array.shift(fvgLabels)
        if not na(oldFVGLabel)
            label.delete(oldFVGLabel)
        array.shift(fvgTops)
        array.shift(fvgBots)
        array.shift(fvgDirs)
        array.shift(fvgStates)
        array.shift(fvgMitigated)
        array.shift(ifvgMitigated)
        array.shift(fvgMaxMitigationPct)
        array.shift(ifvgMaxMitigationPct)
        array.shift(ifvgBornBars)
        array.shift(fvgBornBars)
        array.shift(fvgLeftTimes)
    array.push(fvgTops,top)
    array.push(fvgBots,bot)
    array.push(fvgDirs,dir)
    array.push(fvgStates,0)
    array.push(fvgMitigated,false)
    array.push(ifvgMitigated,false)
    array.push(fvgMaxMitigationPct,0.0)
    array.push(ifvgMaxMitigationPct,0.0)
    array.push(ifvgBornBars,na)
    array.push(fvgBornBars,bar_index)
    array.push(fvgLeftTimes,leftTime)
    box b=box.new(leftTime,top,time,bot,xloc=xloc.bar_time)
    label lb=na
    array.push(fvgBoxes,b)
    array.push(fvgLabels,lb)

if bullFVG
    f_addFVG(low,high[2],1,time[2])
if bearFVG
    f_addFVG(low[2],high,-1,time[2])

bool ifvgBullEvent=false
bool ifvgBearEvent=false

if array.size(fvgTops)>0
    for n=array.size(fvgTops)-1 to 0
        float top=array.get(fvgTops,n)
        float bot=array.get(fvgBots,n)
        int dir=array.get(fvgDirs,n)
        int state=array.get(fvgStates,n)
        int born=array.get(fvgBornBars,n)
        int ifvgBorn=array.get(ifvgBornBars,n)
        int leftTime=array.get(fvgLeftTimes,n)

        // State 0 = active FVG (fresh or mitigated)
        if barstate.isconfirmed and bar_index>born and state==0
            float height=math.max(top-bot,syminfo.mintick)

            // Partial mitigation begins when any later candle overlaps the gap.
            // Partial wick penetration survives. Only a far-boundary traversal
            // consumes the zone unless a qualified close creates an IFVG.
            bool touchesGap=high>=bot and low<=top
            float fvgPenetration=dir==1?top-low:high-bot
            float fvgFillPct=touchesGap?math.max(0.0,math.min(100.0,fvgPenetration/height*100.0)):0.0

            if touchesGap
                array.set(fvgMitigated,n,true)
                float prevPct=array.get(fvgMaxMitigationPct,n)
                array.set(fvgMaxMitigationPct,n,math.max(prevPct,fvgFillPct))

            // FVG -> IFVG:
            // Wick-through alone never flips the gap.
            // A later candle must close beyond the far boundary.
            bool closeBeyond=dir==1?close<bot:close>top
            bool failureDirection=dir==1?close<open:close>open
            float bodyHigh=math.max(open,close)
            float bodyLow=math.min(open,close)
            bool fullBodyBeyond=dir==1?bodyHigh<bot:bodyLow>top

            // A wick beyond the far boundary never creates an IFVG.
            // Default mode requires the candle CLOSE beyond the boundary
            // and the candle body to close in the failure direction.
            bool qualifiedFlip=ifvgFlipMode=="Full body beyond boundary"?fullBodyBeyond:(closeBeyond and failureDirection)

            bool fullWickTraversal=dir==1?low<=bot:high>=top

            if qualifiedFlip
                array.set(fvgStates,n,2)
                array.set(ifvgBornBars,n,bar_index)
                array.set(ifvgMitigated,n,false)
                array.set(ifvgMaxMitigationPct,n,0.0)
                if dir==1
                    ifvgBearEvent:=true
                else
                    ifvgBullEvent:=true
            else if retireFVGOnFullWickFill and fullWickTraversal
                // Fully consumed as an FVG, but NOT inverted because the
                // required close/body-close confirmation did not occur.
                array.set(fvgStates,n,3)

        // State 2 = active IFVG.
        else if barstate.isconfirmed and state==2
            int invBorn=array.get(ifvgBornBars,n)

            // The inversion candle itself is not an IFVG mitigation/retest.
            if not na(invBorn) and bar_index>invBorn
                float height=math.max(top-bot,syminfo.mintick)
                bool touchesIFVG=high>=bot and low<=top

                // Original bullish FVG -> bearish IFVG: retest from below.
                // Original bearish FVG -> bullish IFVG: retest from above.
                float ifvgPenetration=dir==1?high-bot:top-low
                float ifvgFillPct=touchesIFVG?math.max(0.0,math.min(100.0,ifvgPenetration/height*100.0)):0.0

                if touchesIFVG
                    array.set(ifvgMitigated,n,true)
                    float prevPct=array.get(ifvgMaxMitigationPct,n)
                    array.set(ifvgMaxMitigationPct,n,math.max(prevPct,ifvgFillPct))

                // IFVG may be consumed by a complete wick traversal.
                // Close-based failure remains valid too.
                bool closeInvalidated=dir==1?close>top:close<bot
                bool wickConsumed=dir==1?high>=top:low<=bot
                if closeInvalidated or (retireIFVGOnFullWickFill and wickConsumed)
                    array.set(fvgStates,n,3)

        state:=array.get(fvgStates,n)
        bool fvgMit=array.get(fvgMitigated,n)
        bool ifvgMit=array.get(ifvgMitigated,n)
        float fvgPct=array.get(fvgMaxMitigationPct,n)
        float ifvgPct=array.get(ifvgMaxMitigationPct,n)

        bool isIFVG=state==2
        bool directionalBull=isIFVG?dir==-1:dir==1
        color c=isIFVG?(directionalBull?bullIFVGColor:bearIFVGColor):(dir==1?bullFVGColor:bearFVGColor)

        bool explicitShow=state==0?showFVGZones:state==2?showIFVGZones:false
        bool modeShow=modeAnalysis or modeFull
        bool visible=state!=3 and explicitShow and modeShow

        box b=array.get(fvgBoxes,n)
        label lb=array.get(fvgLabels,n)

        if state!=3
            box.set_right(b,time)

        box.set_bgcolor(b,visible?color.new(c,fvgTransparency):f_hidden(c))
        box.set_border_color(b,visible?c:f_hidden(c))

        string zoneText=""
        if state==0
            zoneText=fvgMit and showMitigationState?"FVG · MIT "+str.tostring(fvgPct,"#.0")+"%":"FVG"
        else if state==2
            zoneText=ifvgMit and showMitigationState?"IFVG · MIT "+str.tostring(ifvgPct,"#.0")+"%":"IFVG"

        // Zone labels are refreshed only on the current chart bar.
        // This keeps them among the newest label objects and prevents
        // TradingView's global label GC from silently removing them.
        if barstate.islast
            if not na(lb)
                label.delete(lb)
                lb:=na
            if visible and showFVGText
                int rightTime=state==3?box.get_right(b):time
                int zoneLabelTime=leftTime+(rightTime-leftTime)*3/4
                lb:=label.new(zoneLabelTime,(top+bot)/2,zoneText,xloc=xloc.bar_time,style=label.style_none,textcolor=c,size=f_textSize())
            array.set(fvgLabels,n,lb)

//=============================================================================
// P03 OB / BREAKER — SHARED STRUCTURE TRIGGER
//=============================================================================
bool obBullStruct=obStructureSource=="Internal"?iBullBreak:obStructureSource=="External"?xBullBreak:(iBullBreak or xBullBreak)
bool obBearStruct=obStructureSource=="Internal"?iBearBreak:obStructureSource=="External"?xBearBreak:(iBearBreak or xBearBreak)

bool obBullDisp=barstate.isconfirmed and close>open and disp>=obDispATR
bool obBearDisp=barstate.isconfirmed and close<open and disp>=obDispATR

bool obBullCore=obTriggerMode=="Structure + displacement"?(obBullStruct and obBullDisp):
     obTriggerMode=="Structure only"?obBullStruct:
     obTriggerMode=="Displacement only"?obBullDisp:
     (obBullStruct or obBullDisp)

bool obBearCore=obTriggerMode=="Structure + displacement"?(obBearStruct and obBearDisp):
     obTriggerMode=="Structure only"?obBearStruct:
     obTriggerMode=="Displacement only"?obBearDisp:
     (obBearStruct or obBearDisp)

bool obBullTrigger=barstate.isconfirmed and obBullCore and (not requireFVGForOB or bullFVG)
bool obBearTrigger=barstate.isconfirmed and obBearCore and (not requireFVGForOB or bearFVG)

f_findBullCandidate() =>
    int found=-1
    for n=1 to obSearchBack
        if close[n]<open[n]
            found:=n
            break
    found

f_findBearCandidate() =>
    int found=-1
    for n=1 to obSearchBack
        if close[n]>open[n]
            found:=n
            break
    found

int bullCand=obBullTrigger?f_findBullCandidate():-1
int bearCand=obBearTrigger?f_findBearCandidate():-1

var float[] obTops=array.new_float()
var float[] obBots=array.new_float()
var int[] obDirs=array.new_int()
var int[] obStates=array.new_int() // 0 active OB,1 mitigated/weakened OB,2 breaker,3 invalidated/expired
var bool[] obBreakerSweepSeen=array.new_bool()
var bool[] obMitigated=array.new_bool()
var bool[] obWeakened=array.new_bool()
var bool[] bbMitigated=array.new_bool()
var float[] obMitigationDepth=array.new_float()
var float[] bbMitigationDepth=array.new_float()
var int[] obTerminalBars=array.new_int()
var int[] obBornBars=array.new_int()
var int[] obSourceBars=array.new_int()
var int[] obLeftTimes=array.new_int()
var box[] obBoxes=array.new_box()
var label[] obLabels=array.new_label()

f_addOB(float top,float bot,int dir,int cand) =>
    if array.size(obTops)>=maxOBZones
        box.delete(array.shift(obBoxes))
        label oldOBLabel=array.shift(obLabels)
        if not na(oldOBLabel)
            label.delete(oldOBLabel)
        array.shift(obTops)
        array.shift(obBots)
        array.shift(obDirs)
        array.shift(obStates)
        array.shift(obBreakerSweepSeen)
        array.shift(obMitigated)
        array.shift(obWeakened)
        array.shift(bbMitigated)
        array.shift(obMitigationDepth)
        array.shift(bbMitigationDepth)
        array.shift(obTerminalBars)
        array.shift(obBornBars)
        array.shift(obSourceBars)
        array.shift(obLeftTimes)
    int leftTime=time[cand]
    array.push(obTops,top)
    array.push(obBots,bot)
    array.push(obDirs,dir)
    array.push(obStates,0)
    array.push(obBreakerSweepSeen,false)
    array.push(obMitigated,false)
    array.push(obWeakened,false)
    array.push(bbMitigated,false)
    array.push(obMitigationDepth,0.0)
    array.push(bbMitigationDepth,0.0)
    array.push(obTerminalBars,na)
    array.push(obBornBars,bar_index)
    array.push(obSourceBars,bar_index-cand)
    array.push(obLeftTimes,leftTime)
    box b=box.new(leftTime,top,time,bot,xloc=xloc.bar_time)
    label lb=na
    array.push(obBoxes,b)
    array.push(obLabels,lb)

if obBullTrigger and bullCand>0
    int candidateBar=bar_index-bullCand
    bool duplicateCandidate=false
    if array.size(obSourceBars)>0
        for n=array.size(obSourceBars)-1 to 0
            if array.get(obSourceBars,n)==candidateBar and array.get(obDirs,n)==1 and array.get(obStates,n)!=3
                duplicateCandidate:=true
                break
    if not duplicateCandidate
        float top=obBodyOnly?math.max(open[bullCand],close[bullCand]):high[bullCand]
        float bot=obBodyOnly?math.min(open[bullCand],close[bullCand]):low[bullCand]
        f_addOB(top,bot,1,bullCand)

if obBearTrigger and bearCand>0
    int candidateBar=bar_index-bearCand
    bool duplicateCandidate=false
    if array.size(obSourceBars)>0
        for n=array.size(obSourceBars)-1 to 0
            if array.get(obSourceBars,n)==candidateBar and array.get(obDirs,n)==-1 and array.get(obStates,n)!=3
                duplicateCandidate:=true
                break
    if not duplicateCandidate
        float top=obBodyOnly?math.max(open[bearCand],close[bearCand]):high[bearCand]
        float bot=obBodyOnly?math.min(open[bearCand],close[bearCand]):low[bearCand]
        f_addOB(top,bot,-1,bearCand)

bool bullBreakerEvent=false
bool bearBreakerEvent=false

if array.size(obTops)>0
    for n=array.size(obTops)-1 to 0
        float top=array.get(obTops,n)
        float bot=array.get(obBots,n)
        int dir=array.get(obDirs,n)
        int state=array.get(obStates,n)
        int born=array.get(obBornBars,n)
        int leftTime=array.get(obLeftTimes,n)

        float zoneHeight=math.max(top-bot,syminfo.mintick)
        float bodyTop=math.max(open,close)
        float bodyBot=math.min(open,close)
        float mid=bot+zoneHeight*(obMitigationPct/100.0)

        if barstate.isconfirmed and bar_index>born and state<=1
            // Partial wick/body entry marks mitigation but does not retire the block.
            // A far-boundary traversal consumes it unless a qualified BB forms.
            bool touchesZone=high>=bot and low<=top
            float penetration=dir==1?top-low:high-bot
            float depthPct=touchesZone?math.max(0.0,math.min(100.0,penetration/zoneHeight*100.0)):0.0

            if touchesZone
                array.set(obMitigated,n,true)
                float prevDepth=array.get(obMitigationDepth,n)
                array.set(obMitigationDepth,n,math.max(prevDepth,depthPct))

            // Institutional "mean threshold": a candle BODY close past the configured
            // midpoint weakens the block, but does not yet make it a breaker.
            bool closePastMean=dir==1?close<mid:close>mid
            if touchesZone and closePastMean
                array.set(obWeakened,n,true)
                array.set(obStates,n,1)

            // Track relevant liquidity sweep after OB creation.
            bool relevantSweep=dir==1?bearSweep:bullSweep
            if relevantSweep and bar_index<=born+breakerMaxAge
                array.set(obBreakerSweepSeen,n,true)

            bool sweepSeen=array.get(obBreakerSweepSeen,n)

            // Breaker failure requires the whole candle body beyond the OB zone,
            // plus aggressive displacement, and optionally the prior sweep.
            bool fullBodyBeyond=dir==1?bodyTop<bot:bodyBot>top
            bool aggressiveFailure=disp>=breakerDispATR
            bool breakerQualified=fullBodyBeyond and aggressiveFailure and (not breakerRequireLiquiditySweep or sweepSeen) and bar_index<=born+breakerMaxAge

            bool obFullWickTraversal=dir==1?low<=bot:high>=top

            if breakerQualified
                array.set(obStates,n,2)
                array.set(bbMitigated,n,false)
                array.set(bbMitigationDepth,n,0.0)
                if dir==1
                    bearBreakerEvent:=true
                else
                    bullBreakerEvent:=true
            else if retireOBOnFullWickFill and obFullWickTraversal
                // Zone is fully consumed, but it does not become a Breaker
                // unless the stricter breaker sequence is satisfied.
                array.set(obStates,n,3)
                array.set(obTerminalBars,n,bar_index)

            // Active OB that never resolves is eventually archived visually.
            if bar_index>born+obVisualMaxAge and array.get(obStates,n)<=1
                array.set(obStates,n,3)
                array.set(obTerminalBars,n,bar_index)

        else if barstate.isconfirmed and state==2
            // Breaker mitigation: any later re-entry into BB marks mitigation.
            bool touchesBB=high>=bot and low<=top
            float bbPen=dir==1?high-bot:top-low
            float bbDepth=touchesBB?math.max(0.0,math.min(100.0,bbPen/zoneHeight*100.0)):0.0
            if touchesBB
                array.set(bbMitigated,n,true)
                float prevBB=array.get(bbMitigationDepth,n)
                array.set(bbMitigationDepth,n,math.max(prevBB,bbDepth))

            // Breaker can be consumed by a full wick traversal through
            // the opposite side, even if price later closes back.
            bool breakerCloseInvalidated=dir==1?close>top:close<bot
            bool breakerWickConsumed=dir==1?high>=top:low<=bot
            if breakerCloseInvalidated or (retireBBOnFullWickFill and breakerWickConsumed) or bar_index>born+obVisualMaxAge
                array.set(obStates,n,3)
                array.set(obTerminalBars,n,bar_index)

        state:=array.get(obStates,n)
        bool breaker=state==2
        bool directionalBull=breaker?dir==-1:dir==1
        color c=breaker?(directionalBull?bullBreakerColor:bearBreakerColor):(dir==1?bullOBColor:bearOBColor)

        bool explicitShow=breaker?showBreakerZones:showOBZones
        bool modeShow=modeAnalysis or modeFull
        bool visible=state!=3 and explicitShow and modeShow

        box b=array.get(obBoxes,n)
        label lb=array.get(obLabels,n)

        // Stop extending when terminal.
        if state!=3
            box.set_right(b,time)

        box.set_bgcolor(b,visible?color.new(c,obTransparency):f_hidden(c))
        box.set_border_color(b,visible?c:f_hidden(c))

        bool obMit=array.get(obMitigated,n)
        bool weak=array.get(obWeakened,n)
        bool bbMit=array.get(bbMitigated,n)
        float obDepth=array.get(obMitigationDepth,n)
        float bbDepth=array.get(bbMitigationDepth,n)

        string blockText=""
        if breaker
            blockText=showOBMitigationState and bbMit?"BB · MIT "+str.tostring(bbDepth,"#.0")+"%":"BB"
        else
            blockText=showOBMitigationState and weak?"OB · WEAK "+str.tostring(obDepth,"#.0")+"%":
                 showOBMitigationState and obMit?"OB · MIT "+str.tostring(obDepth,"#.0")+"%":"OB"

        if barstate.islast
            if not na(lb)
                label.delete(lb)
                lb:=na
            if visible and showOBText
                int rightTime=state==3?box.get_right(b):time
                int blockLabelTime=leftTime+(rightTime-leftTime)*3/4
                lb:=label.new(blockLabelTime,(top+bot)/2,blockText,xloc=xloc.bar_time,style=label.style_none,textcolor=c,size=f_textSize())
            array.set(obLabels,n,lb)

//=============================================================================
// DIVERGENCE ENGINE
// RSI + MACD histogram. Regular = reversal; hidden = continuation.
// Confirmed pivots only; no repaint.
//=============================================================================
float rsiVal=ta.rsi(close,14)
[macdLine,macdSignal,macdHist]=ta.macd(close,12,26,9)
float pricePH=ta.pivothigh(high,divergencePivotLen,divergencePivotLen)
float pricePL=ta.pivotlow(low,divergencePivotLen,divergencePivotLen)
float rsiPH=ta.pivothigh(rsiVal,divergencePivotLen,divergencePivotLen)
float rsiPL=ta.pivotlow(rsiVal,divergencePivotLen,divergencePivotLen)
float macdPH=ta.pivothigh(macdHist,divergencePivotLen,divergencePivotLen)
float macdPL=ta.pivotlow(macdHist,divergencePivotLen,divergencePivotLen)
var float prevPricePH=na
var float prevPricePL=na
var float prevRSIPH=na
var float prevRSIPL=na
var float prevMACDPH=na
var float prevMACDPL=na
var int prevHighPivotBar=na
var int prevLowPivotBar=na
bool bullRSIDiv=false
bool bearRSIDiv=false
bool bullMACDDiv=false
bool bearMACDDiv=false
bool bullRSIHidden=false
bool bearRSIHidden=false
bool bullMACDHidden=false
bool bearMACDHidden=false
int pivotBar=bar_index-divergencePivotLen
if not na(pricePH)
    bool within=not na(prevHighPivotBar) and pivotBar-prevHighPivotBar<=divergenceMaxBars
    if enableDivergenceContext and enableRSIDivergence and within and not na(prevPricePH) and not na(prevRSIPH) and not na(rsiPH)
        bearRSIDiv:=pricePH>prevPricePH and rsiPH<prevRSIPH
        bearRSIHidden:=enableHiddenDivergence and pricePH<prevPricePH and rsiPH>prevRSIPH
    if enableDivergenceContext and enableMACDDivergence and within and not na(prevPricePH) and not na(prevMACDPH) and not na(macdPH)
        bearMACDDiv:=pricePH>prevPricePH and macdPH<prevMACDPH
        bearMACDHidden:=enableHiddenDivergence and pricePH<prevPricePH and macdPH>prevMACDPH
    prevPricePH:=pricePH
    prevRSIPH:=rsiPH
    prevMACDPH:=macdPH
    prevHighPivotBar:=pivotBar
if not na(pricePL)
    bool within=not na(prevLowPivotBar) and pivotBar-prevLowPivotBar<=divergenceMaxBars
    if enableDivergenceContext and enableRSIDivergence and within and not na(prevPricePL) and not na(prevRSIPL) and not na(rsiPL)
        bullRSIDiv:=pricePL<prevPricePL and rsiPL>prevRSIPL
        bullRSIHidden:=enableHiddenDivergence and pricePL>prevPricePL and rsiPL<prevRSIPL
    if enableDivergenceContext and enableMACDDivergence and within and not na(prevPricePL) and not na(prevMACDPL) and not na(macdPL)
        bullMACDDiv:=pricePL<prevPricePL and macdPL>prevMACDPL
        bullMACDHidden:=enableHiddenDivergence and pricePL>prevPricePL and macdPL<prevMACDPL
    prevPricePL:=pricePL
    prevRSIPL:=rsiPL
    prevMACDPL:=macdPL
    prevLowPivotBar:=pivotBar
bool bullRegularDiv=bullRSIDiv or bullMACDDiv
bool bearRegularDiv=bearRSIDiv or bearMACDDiv
bool bullHiddenDiv=bullRSIHidden or bullMACDHidden
bool bearHiddenDiv=bearRSIHidden or bearMACDHidden
bool bullMomentumDiv=bullRegularDiv or bullHiddenDiv
bool bearMomentumDiv=bearRegularDiv or bearHiddenDiv
string bullDivKind=bullRegularDiv?"REG":bullHiddenDiv?"HID":"NONE"
string bearDivKind=bearRegularDiv?"REG":bearHiddenDiv?"HID":"NONE"
string bullDivSource=(bullRSIDiv or bullRSIHidden) and (bullMACDDiv or bullMACDHidden)?"RSI+MACD":(bullRSIDiv or bullRSIHidden)?"RSI":(bullMACDDiv or bullMACDHidden)?"MACD":"NONE"
string bearDivSource=(bearRSIDiv or bearRSIHidden) and (bearMACDDiv or bearMACDHidden)?"RSI+MACD":(bearRSIDiv or bearRSIHidden)?"RSI":(bearMACDDiv or bearMACDHidden)?"MACD":"NONE"
var int lastBullDivBar=na
var int lastBearDivBar=na
if bullMomentumDiv
    lastBullDivBar:=pivotBar
if bearMomentumDiv
    lastBearDivBar:=pivotBar
int divergenceContextWindow=20
bool recentBullDiv=enableDivergenceContext and not na(lastBullDivBar) and bar_index-lastBullDivBar<=divergenceContextWindow
bool recentBearDiv=enableDivergenceContext and not na(lastBearDivBar) and bar_index-lastBearDivBar<=divergenceContextWindow
f_divAllows(int side) =>
    if not enableDivergenceContext or divergenceFilterMode=="Off"
        true
    else
        side==1?recentBullDiv:recentBearDiv
f_divText(int side) =>
    side==1?(recentBullDiv?"Bull supportive":"None"):(recentBearDiv?"Bear supportive":"None")
var label[] divergenceLabels=array.new_label()
if showDivergenceMarkers
    if bullMomentumDiv
        string t=bullDivSource+" Bull "+bullDivKind+" Div"
        label lb=label.new(pivotBar,low[divergencePivotLen],t,style=label.style_none,textcolor=bullDivColor,size=size.tiny)
        array.push(divergenceLabels,lb)
    if bearMomentumDiv
        string t=bearDivSource+" Bear "+bearDivKind+" Div"
        label lb=label.new(pivotBar,high[divergencePivotLen],t,style=label.style_none,textcolor=bearDivColor,size=size.tiny)
        array.push(divergenceLabels,lb)
    while array.size(divergenceLabels)>40
        label.delete(array.shift(divergenceLabels))

//=============================================================================
// VWAP CONTEXT ENGINE — v1.2.3 boundary-safe
//=============================================================================

// Each tracked session has its own independent VWAP accumulator.
// This prevents Asia/London/New York from being merged into one continuous VWAP.
bool asiaVWAPStart=asiaIn and not asiaIn[1]
bool londonVWAPStart=londonIn and not londonIn[1]
bool nyVWAPStart=nyIn and not nyIn[1]

var float asiaPV=na
var float asiaVol=na
var float londonPV=na
var float londonVol=na
var float nyPV=na
var float nyVol=na

if asiaVWAPStart
    asiaPV:=hlc3*volume
    asiaVol:=volume
else if asiaIn
    asiaPV:=nz(asiaPV)+hlc3*volume
    asiaVol:=nz(asiaVol)+volume
else
    asiaPV:=na
    asiaVol:=na

if londonVWAPStart
    londonPV:=hlc3*volume
    londonVol:=volume
else if londonIn
    londonPV:=nz(londonPV)+hlc3*volume
    londonVol:=nz(londonVol)+volume
else
    londonPV:=na
    londonVol:=na

if nyVWAPStart
    nyPV:=hlc3*volume
    nyVol:=volume
else if nyIn
    nyPV:=nz(nyPV)+hlc3*volume
    nyVol:=nz(nyVol)+volume
else
    nyPV:=na
    nyVol:=na

float asiaVWAP=asiaIn and nz(asiaVol)>0?asiaPV/asiaVol:na
float londonVWAP=londonIn and nz(londonVol)>0?londonPV/londonVol:na
float nyVWAP=nyIn and nz(nyVol)>0?nyPV/nyVol:na

// Track the most recently opened active session as the "current session".
// If it ends while another tracked session is still active, fall back to that active session.
var int selectedSessionId=-1
if asiaVWAPStart
    selectedSessionId:=0
if londonVWAPStart
    selectedSessionId:=1
if nyVWAPStart
    selectedSessionId:=2

bool selectedStillActive=selectedSessionId==0?asiaIn:selectedSessionId==1?londonIn:selectedSessionId==2?nyIn:false
if not selectedStillActive
    selectedSessionId:=nyIn?2:londonIn?1:asiaIn?0:-1

float sessionVWAP=selectedSessionId==0?asiaVWAP:selectedSessionId==1?londonVWAP:selectedSessionId==2?nyVWAP:na
bool anySessionActive=selectedSessionId>=0
bool newTrackedSession=selectedSessionId!=selectedSessionId[1]

// Render only the currently selected session VWAP.
// Delete prior session segments whenever selected session changes.
var line[] currentSessionVWAPSegments=array.new_line()
if newTrackedSession
    while array.size(currentSessionVWAPSegments)>0
        line.delete(array.pop(currentSessionVWAPSegments))

if enableVWAPContext and showSessionVWAP and anySessionActive and not na(sessionVWAP)
    bool sameSessionAsPrior=selectedSessionId==selectedSessionId[1]
    if sameSessionAsPrior and not na(sessionVWAP[1])
        line seg=line.new(bar_index-1,sessionVWAP[1],bar_index,sessionVWAP,xloc=xloc.bar_index,extend=extend.none,color=sessionVWAPColor,width=2)
        array.push(currentSessionVWAPSegments,seg)

// Period VWAP boundaries use the SAME timezone setting as the session engine.
// This keeps session windows and D/W/M VWAP calendars synchronized.
int vwapDayId=year(time,sessionTz)*10000+month(time,sessionTz)*100+dayofmonth(time,sessionTz)
int vwapWeekId=year(time,sessionTz)*100+weekofyear(time,sessionTz)
int vwapMonthId=year(time,sessionTz)*100+month(time,sessionTz)

bool newDay=not barstate.isfirst and vwapDayId!=vwapDayId[1]
bool newWeek=not barstate.isfirst and vwapWeekId!=vwapWeekId[1]
bool newMonth=not barstate.isfirst and vwapMonthId!=vwapMonthId[1]

var float dayPV=na
var float dayVol=na
var float weekPV=na
var float weekVol=na
var float monthPV=na
var float monthVol=na

if newDay or na(dayPV)
    dayPV:=hlc3*volume
    dayVol:=volume
else
    dayPV+=hlc3*volume
    dayVol+=volume

if newWeek or na(weekPV)
    weekPV:=hlc3*volume
    weekVol:=volume
else
    weekPV+=hlc3*volume
    weekVol+=volume

if newMonth or na(monthPV)
    monthPV:=hlc3*volume
    monthVol:=volume
else
    monthPV+=hlc3*volume
    monthVol+=volume

float dailyVWAP=nz(dayVol)>0?dayPV/dayVol:na
float weeklyVWAP=nz(weekVol)>0?weekPV/weekVol:na
float monthlyVWAP=nz(monthVol)>0?monthPV/monthVol:na

// Restrict D/W/M rendering to the chart's latest calendar period only.
int barDayId=vwapDayId
int lastDayId=year(last_bar_time,sessionTz)*10000+month(last_bar_time,sessionTz)*100+dayofmonth(last_bar_time,sessionTz)

int barWeekId=vwapWeekId
int lastWeekId=year(last_bar_time,sessionTz)*100+weekofyear(last_bar_time,sessionTz)

int barMonthId=vwapMonthId
int lastMonthId=year(last_bar_time,sessionTz)*100+month(last_bar_time,sessionTz)

bool showCurrentDayOnly=barDayId==lastDayId
bool showCurrentWeekOnly=barWeekId==lastWeekId
bool showCurrentMonthOnly=barMonthId==lastMonthId

plot(na,"Session VWAP",color=sessionVWAPColor,linewidth=2,style=plot.style_linebr)
plot(enableVWAPContext and showDailyVWAP and showCurrentDayOnly?dailyVWAP:na,"Daily VWAP",color=dailyVWAPColor,linewidth=2,style=plot.style_linebr)
plot(enableVWAPContext and showWeeklyVWAP and showCurrentWeekOnly?weeklyVWAP:na,"Weekly VWAP",color=weeklyVWAPColor,linewidth=1,style=plot.style_linebr)
plot(enableVWAPContext and showMonthlyVWAP and showCurrentMonthOnly?monthlyVWAP:na,"Monthly VWAP",color=monthlyVWAPColor,linewidth=1,style=plot.style_linebr)

f_vwapAllows(int side) =>
    if not enableVWAPContext or vwapFilterMode=="Off"
        true
    else
        bool dailyOK=side==1?close>=dailyVWAP:close<=dailyVWAP
        bool sessionOK=na(sessionVWAP)?true:(side==1?close>=sessionVWAP:close<=sessionVWAP)
        vwapFilterMode=="Daily align"?dailyOK:(dailyOK and sessionOK)

f_vwapPos(float v) =>
    na(v)?"N/A":close>v?"Above":close<v?"Below":"At"

//=============================================================================
// P05 ACTIVE P/D OBJECT — REPLACE OR INVALIDATE
//=============================================================================
var float pdZoneHigh=na
var float pdZoneLow=na
var int pdZoneLeftTime=na
var int pdZoneDirection=0
var string pdZoneSource="NONE"
var int pdZoneVersion=0
var bool pdZoneActive=false

var box pdBox=na
var line pdFib1=na
var line pdFib2=na
var line pdFib3=na
var line pdFib4=na
var line pdFib5=na
var label pdPremium=na
var label pdEq=na
var label pdDiscount=na
var label pdFibLabel1=na
var label pdFibLabel2=na
var label pdFibLabel3=na
var label pdFibLabel4=na
var label pdFibLabel5=na

f_pdPrice(float level) =>
    float span=pdZoneHigh-pdZoneLow
    fibMapping=="Directional"?(pdZoneDirection==1?pdZoneLow+span*level:pdZoneHigh-span*level):pdZoneLow+span*level

bool pdInvalidated=pdZoneActive and barstate.isconfirmed and (
     (pdZoneDirection==1 and (close<pdZoneLow or (invalidatePDOnOppositeBreak and xBearBreak))) or
     (pdZoneDirection==-1 and (close>pdZoneHigh or (invalidatePDOnOppositeBreak and xBullBreak)))
 )

if pdInvalidated or newPDZone
    if not na(pdBox)
        box.delete(pdBox)
        pdBox:=na
    if not na(pdFib1)
        line.delete(pdFib1)
        line.delete(pdFib2)
        line.delete(pdFib3)
        line.delete(pdFib4)
        line.delete(pdFib5)
        pdFib1:=na
        pdFib2:=na
        pdFib3:=na
        pdFib4:=na
        pdFib5:=na
    if not na(pdPremium)
        label.delete(pdPremium)
        label.delete(pdEq)
        label.delete(pdDiscount)
        label.delete(pdFibLabel1)
        label.delete(pdFibLabel2)
        label.delete(pdFibLabel3)
        label.delete(pdFibLabel4)
        label.delete(pdFibLabel5)
        pdPremium:=na
        pdEq:=na
        pdDiscount:=na
        pdFibLabel1:=na
        pdFibLabel2:=na
        pdFibLabel3:=na
        pdFibLabel4:=na
        pdFibLabel5:=na
    pdZoneActive:=false

if newPDZone
    pdZoneHigh:=newPDHigh
    pdZoneLow:=newPDLow
    pdZoneLeftTime:=math.min(newPDHighTime,newPDLowTime)
    pdZoneDirection:=newPDDirection
    pdZoneSource:=newPDSource
    pdZoneVersion+=1
    pdZoneActive:=true

    float p1=f_pdPrice(fib1)
    float p2=f_pdPrice(fib2)
    float p3=f_pdPrice(fib3)
    float p4=f_pdPrice(fib4)
    float p5=f_pdPrice(fib5)

    pdBox:=box.new(pdZoneLeftTime,pdZoneHigh,time,pdZoneLow,xloc=xloc.bar_time)
    pdFib1:=line.new(pdZoneLeftTime,p1,time,p1,xloc=xloc.bar_time,extend=extend.none)
    pdFib2:=line.new(pdZoneLeftTime,p2,time,p2,xloc=xloc.bar_time,extend=extend.none)
    pdFib3:=line.new(pdZoneLeftTime,p3,time,p3,xloc=xloc.bar_time,extend=extend.none,style=line.style_dashed)
    pdFib4:=line.new(pdZoneLeftTime,p4,time,p4,xloc=xloc.bar_time,extend=extend.none)
    pdFib5:=line.new(pdZoneLeftTime,p5,time,p5,xloc=xloc.bar_time,extend=extend.none)
    pdPremium:=label.new(time,pdZoneLow+(pdZoneHigh-pdZoneLow)*0.78,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
    pdEq:=label.new(time,pdZoneLow+(pdZoneHigh-pdZoneLow)*0.50,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
    pdDiscount:=label.new(time,pdZoneLow+(pdZoneHigh-pdZoneLow)*0.22,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
    pdFibLabel1:=label.new(time,p1,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
    pdFibLabel2:=label.new(time,p2,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
    pdFibLabel3:=label.new(time,p3,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
    pdFibLabel4:=label.new(time,p4,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())
    pdFibLabel5:=label.new(time,p5,"",xloc=xloc.bar_time,style=label.style_none,size=f_textSize())

if pdZoneActive
    bool vis=showPDZone and (modeAnalysis or modeFull)
    float p1=f_pdPrice(fib1)
    float p2=f_pdPrice(fib2)
    float p3=f_pdPrice(fib3)
    float p4=f_pdPrice(fib4)
    float p5=f_pdPrice(fib5)

    box.set_right(pdBox,time)
    box.set_bgcolor(pdBox,vis?color.new(pdZoneColor,pdTransparency):f_hidden(pdZoneColor))
    box.set_border_color(pdBox,vis?pdZoneColor:f_hidden(pdZoneColor))

    color fc=vis and showFibLevels?fibColor:f_hidden(fibColor)
    line.set_xy2(pdFib1,time,p1)
    line.set_xy2(pdFib2,time,p2)
    line.set_xy2(pdFib3,time,p3)
    line.set_xy2(pdFib4,time,p4)
    line.set_xy2(pdFib5,time,p5)
    line.set_color(pdFib1,fc)
    line.set_color(pdFib2,fc)
    line.set_color(pdFib3,fc)
    line.set_color(pdFib4,fc)
    line.set_color(pdFib5,fc)

    label.set_xy(pdPremium,time,pdZoneLow+(pdZoneHigh-pdZoneLow)*0.78)
    label.set_xy(pdEq,time,pdZoneLow+(pdZoneHigh-pdZoneLow)*0.50)
    label.set_xy(pdDiscount,time,pdZoneLow+(pdZoneHigh-pdZoneLow)*0.22)
    label.set_text(pdPremium,vis and showPDText?"PREMIUM":"")
    label.set_text(pdEq,vis and showPDText?"EQ":"")
    label.set_text(pdDiscount,vis and showPDText?"DISCOUNT":"")

    label.set_xy(pdFibLabel1,time,p1)
    label.set_xy(pdFibLabel2,time,p2)
    label.set_xy(pdFibLabel3,time,p3)
    label.set_xy(pdFibLabel4,time,p4)
    label.set_xy(pdFibLabel5,time,p5)
    label.set_text(pdFibLabel1,vis and showFibLabels?str.tostring(fib1,"#.###"):"")
    label.set_text(pdFibLabel2,vis and showFibLabels?str.tostring(fib2,"#.###"):"")
    label.set_text(pdFibLabel3,vis and showFibLabels?str.tostring(fib3,"#.###"):"")
    label.set_text(pdFibLabel4,vis and showFibLabels?str.tostring(fib4,"#.###"):"")
    label.set_text(pdFibLabel5,vis and showFibLabels?str.tostring(fib5,"#.###"):"")

float pdMid=pdZoneActive?(pdZoneHigh+pdZoneLow)/2:na
bool inDiscount=pdZoneActive and close<=pdMid
bool inPremium=pdZoneActive and close>=pdMid

//=============================================================================
// HTF / MTF BIAS ENGINE
//=============================================================================
f_tfBias(int pLen) =>
    float ph=ta.pivothigh(high,pLen,pLen)
    float pl=ta.pivotlow(low,pLen,pLen)
    var float lastPH=na
    var float lastPL=na
    var int bias=0
    if not na(ph)
        lastPH:=ph
    if not na(pl)
        lastPL:=pl
    if barstate.isconfirmed
        if not na(lastPH) and close>lastPH
            bias:=1
        else if not na(lastPL) and close<lastPL
            bias:=-1
    bias

int htfBiasRaw=request.security(syminfo.tickerid,htfBiasTF,f_tfBias(biasPivotLen)[1],lookahead=barmerge.lookahead_on)
int mtfBiasRaw=request.security(syminfo.tickerid,mtfBiasTF,f_tfBias(biasPivotLen)[1],lookahead=barmerge.lookahead_on)

int htfBias=enableBiasEngine?htfBiasRaw:0
int mtfBias=enableBiasEngine?mtfBiasRaw:0

bool htfBull=htfBias==1
bool htfBear=htfBias==-1
bool mtfBull=mtfBias==1
bool mtfBear=mtfBias==-1
bool mtfAligned=(htfBull and mtfBull) or (htfBear and mtfBear)

f_biasAllows(int side) =>
    if not enableBiasEngine or biasFilterMode=="Off" or biasFilterMode=="Countertrend allowed"
        true
    else
        bool htfOK=side==1?htfBull:htfBear
        bool mtfOK=side==1?mtfBull:mtfBear
        htfOK and (not requireMTFAlignment or mtfOK)

f_biasText(int b) =>
    b==1?"Bullish":b==-1?"Bearish":"Neutral"

f_biasColor(int b) =>
    b==1?color.lime:b==-1?color.red:color.gray

bgcolor(showBiasBackground and enableBiasEngine?(htfBias==1?color.new(color.lime,92):htfBias==-1?color.new(color.red,92):na):na)

//=============================================================================
// SIGNAL SCORING v1.7
// Quality-component model. Eligibility remains separate from scoring.
// Components: setup, POI, reaction, structure, context, confluence.
//=============================================================================
f_setupScore(string family,string liquiditySource,string divType,string divSource) =>
    int score=family=="REV"?18:family=="INV"?18:family=="DIV"?15:15
    if family=="REV"
        score += (liquiditySource=="PMH" or liquiditySource=="PML" or liquiditySource=="PWH" or liquiditySource=="PWL")?5:
             (liquiditySource=="PDH" or liquiditySource=="PDL")?4:
             str.contains(liquiditySource,"ASIA") or str.contains(liquiditySource,"LONDON") or str.contains(liquiditySource,"NEW YORK")?2:0
    if family=="DIV"
        score += divSource=="RSI+MACD"?5:divSource=="RSI" or divSource=="MACD"?3:0
        score += divType=="HID"?2:divType=="REG"?1:0
    math.min(score,25)

f_poiScore(string poiType) =>
    poiType=="IFVG"?20:poiType=="BB"?20:poiType=="OB"?17:poiType=="FVG"?15:0

f_reactionScore(string reactionType) =>
    reactionType=="BOUNDARY"?25:
     reactionType=="MITIGATION"?20:
     reactionType=="MIDPOINT"?17:
     reactionType=="DIRECTIONAL"?12:
     reactionType=="DIV_DIRECTIONAL"?12:
     reactionType=="DIV_CONFIRMED"?8:
     reactionType=="TOUCH"?5:0

f_structureScore(string structureType) =>
    structureType=="MSS"?15:structureType=="CHoCH"?12:structureType=="BOS"?7:0

f_contextScore(int side,string family,string divType) =>
    int score=0
    bool htfOK=side==1?htfBull:htfBear
    bool mtfOK=side==1?mtfBull:mtfBear
    bool htfOpp=side==1?htfBear:htfBull
    bool mtfOpp=side==1?mtfBear:mtfBull

    // Hidden divergence is continuation-oriented and receives stronger
    // trend-alignment weighting than regular divergence.
    if family=="DIV" and divType=="HID"
        score += htfOK?8:0
        score += mtfOK?4:0
        score += htfOpp and mtfOpp?-4:0
    else
        score += htfOK?6:0
        score += mtfOK?3:0
        if family=="DIV" and divType=="REG" and htfOpp and mtfOpp
            score -= 2

    bool dailyOK=not na(dailyVWAP) and (side==1?close>=dailyVWAP:close<=dailyVWAP)
    bool sessionOK=not na(sessionVWAP) and (side==1?close>=sessionVWAP:close<=sessionVWAP)
    score += dailyOK?3:0
    score += sessionOK?2:0

    bool pdOK=pdZoneActive and (side==1?inDiscount:inPremium)
    score += pdOK?1:0
    math.max(0,math.min(score,15))

f_confluenceScore(int side,string family,string divSource) =>
    int score=0
    if family=="DIV"
        // Divergence cannot score itself again as generic confluence.
        score:=0
    else
        bool supportive=side==1?recentBullDiv:recentBearDiv
        if supportive
            score:=5
    score

f_scoreSignal(int side,string family,string structureType,string poiType,string reactionType,string liquiditySource,string divType,string divSource) =>
    int setup=f_setupScore(family,liquiditySource,divType,divSource)
    int poi=f_poiScore(poiType)
    int reaction=f_reactionScore(reactionType)
    int structure=f_structureScore(structureType)
    int context=f_contextScore(side,family,divType)
    int confluence=f_confluenceScore(side,family,divSource)
    math.min(setup+poi+reaction+structure+context+confluence,100)

f_scoreAllows(score) =>
    not enableSignalScoring or scoreFilterMode=="Off" or score>=minimumSignalScore

f_scoreGrade(score) =>
    score>=90?"A+":score>=80?"A":score>=70?"B":score>=60?"C":"D"

var int lastSignalScore=na
var string lastSignalFamily="NONE"
var string lastSignalGrade="—"

//=============================================================================
// INVERSION SIGNAL ENGINE
// States: 0 IDLE, 1 WAIT_STRUCTURE, 2 WAIT_RETEST, 3 TRIGGERED, 4 INVALIDATED, 5 EXPIRED
//=============================================================================
var int invState=0
var int invSide=0
var string invPOIType="NONE"
var int invPOIBornBar=na
var float invTop=na
var float invBot=na
var int invStartBar=na
var int invStructBar=na
var string invStructType="NONE"
var int invTriggerCount=0
var int invInvalidCount=0
var int invExpireCount=0

//=============================================================================
// POI-FIRST CONTINUATION SIGNAL ENGINE
// States: 0 IDLE, 1 WAIT_BOS, 2 WAIT_RETEST, 3 TRIGGERED, 4 INVALIDATED, 5 EXPIRED
//=============================================================================
var int contState=0
var int contSide=0
var string contPOIType="NONE"
var int contPOIBornBar=na
var float contTop=na
var float contBot=na
var int contStartBar=na
var int contBOSBar=na
var string contStructType="NONE"
var int contLastAttemptBorn=na
var string contLastAttemptType="NONE"
var int contTriggerCount=0
var int contInvalidCount=0
var int contExpireCount=0

//=============================================================================
// CONTINUATION ENGINE v1.5.3
// Active directional FVG/IFVG/OB/BB -> valid retest/reclaim -> CONT signal.
// Same-direction BOS/CHoCH/MSS is supporting context, NOT a prerequisite.
// Clear opposite structure may invalidate when enabled.
//=============================================================================
bool contLongSignal=false
bool contShortSignal=false
int contSignalScore=na

if enableContinuationSignals and contState==0
    bool foundCont=false
    int foundSide=0
    string foundType="NONE"
    int foundBorn=na
    float foundTop=na
    float foundBot=na
    string foundStruct="NONE"

    if array.size(fvgStates)>0
        for n=array.size(fvgStates)-1 to 0
            int st=array.get(fvgStates,n)
            int dir=array.get(fvgDirs,n)
            int originalBorn=array.get(fvgBornBars,n)
            int invBorn=array.get(ifvgBornBars,n)
            bool isFVG=st==0
            bool isIFVG=st==2
            bool allowed=(isFVG and continuationUseFVG) or (isIFVG and continuationUseIFVG)
            bool directionalBull=isIFVG?dir==-1:dir==1
            int side=directionalBull?1:-1
            int poiBorn=isIFVG?invBorn:originalBorn
            string typ=isIFVG?"IFVG":"FVG"
            bool duplicate=poiBorn==contLastAttemptBorn and typ==contLastAttemptType
            bool sameStruct=f_structureContextAligned(side,continuationStructureMaxAge)
            bool oppositeStruct=f_structureContextAligned(-side,continuationStructureMaxAge)
            bool structureOK=not continuationRejectOppositeStructure or not oppositeStruct or sameStruct
            if allowed and not na(poiBorn) and not duplicate and structureOK
                foundCont:=true
                foundSide:=side
                foundType:=typ
                foundBorn:=poiBorn
                foundTop:=array.get(fvgTops,n)
                foundBot:=array.get(fvgBots,n)
                foundStruct:=sameStruct?structureContextType:"NONE"
                break

    if not foundCont and array.size(obStates)>0
        for n=array.size(obStates)-1 to 0
            int st=array.get(obStates,n)
            int dir=array.get(obDirs,n)
            int born=array.get(obBornBars,n)
            bool isOB=st<=1
            bool isBB=st==2
            bool allowed=(isOB and continuationUseOB) or (isBB and continuationUseBB)
            bool directionalBull=isBB?dir==-1:dir==1
            int side=directionalBull?1:-1
            string typ=isBB?"BB":"OB"
            bool duplicate=born==contLastAttemptBorn and typ==contLastAttemptType
            bool sameStruct=f_structureContextAligned(side,continuationStructureMaxAge)
            bool oppositeStruct=f_structureContextAligned(-side,continuationStructureMaxAge)
            bool structureOK=not continuationRejectOppositeStructure or not oppositeStruct or sameStruct
            if allowed and not duplicate and structureOK
                foundCont:=true
                foundSide:=side
                foundType:=typ
                foundBorn:=born
                foundTop:=array.get(obTops,n)
                foundBot:=array.get(obBots,n)
                foundStruct:=sameStruct?structureContextType:"NONE"
                break

    if foundCont
        contState:=2
        contSide:=foundSide
        contPOIType:=foundType
        contPOIBornBar:=foundBorn
        contTop:=foundTop
        contBot:=foundBot
        contStartBar:=bar_index
        contBOSBar:=na
        contStructType:=foundStruct
        contLastAttemptBorn:=foundBorn
        contLastAttemptType:=foundType

if contState==2
    bool contPOIStillActive=false

    if contPOIType=="FVG" or contPOIType=="IFVG"
        if array.size(fvgStates)>0
            for n=array.size(fvgStates)-1 to 0
                int st=array.get(fvgStates,n)
                int originalBorn=array.get(fvgBornBars,n)
                int invBorn=array.get(ifvgBornBars,n)
                bool typeMatch=contPOIType=="FVG"?st==0:st==2
                int identityBorn=contPOIType=="FVG"?originalBorn:invBorn
                if typeMatch and identityBorn==contPOIBornBar
                    contPOIStillActive:=true
                    break
    else if contPOIType=="OB" or contPOIType=="BB"
        if array.size(obStates)>0
            for n=array.size(obStates)-1 to 0
                int st=array.get(obStates,n)
                int born=array.get(obBornBars,n)
                bool typeMatch=contPOIType=="OB"?st<=1:st==2
                if typeMatch and born==contPOIBornBar
                    contPOIStillActive:=true
                    break

    // Formation/selection bar can only REGISTER the POI.
    // Signal eligibility starts on a later bar so entries come from a true
    // retest / touch / mitigation, never from initial zone creation.
    bool afterSelection=bar_index>contStartBar
    bool afterPOIBirth=not na(contPOIBornBar) and bar_index>contPOIBornBar
    bool retestEligible=afterSelection and afterPOIBirth
    bool touches=retestEligible and low<=contTop and high>=contBot
    float mid=(contTop+contBot)/2

    bool bullBoundarySweep=retestEligible and low<=contBot and close>contBot
    bool bearBoundarySweep=retestEligible and high>=contTop and close<contTop
    bool bullMitigationReclaim=touches and close>mid
    bool bearMitigationReclaim=touches and close<mid
    bool bullDirectional=touches and close>open
    bool bearDirectional=touches and close<open

    bool bullReaction=continuationReaction=="Boundary sweep reclaim"?bullBoundarySweep:
         continuationReaction=="Mitigation reclaim"?bullMitigationReclaim:
         continuationReaction=="Touch only"?touches:
         bullDirectional

    bool bearReaction=continuationReaction=="Boundary sweep reclaim"?bearBoundarySweep:
         continuationReaction=="Mitigation reclaim"?bearMitigationReclaim:
         continuationReaction=="Touch only"?touches:
         bearDirectional

    bool sameBarReclaim=contSide==1?bullBoundarySweep:bearBoundarySweep
    bool usableNow=contPOIStillActive or sameBarReclaim
    bool sameStruct=f_structureContextAligned(contSide,continuationStructureMaxAge)
    bool oppositeStruct=f_structureContextAligned(-contSide,continuationStructureMaxAge)
    bool structureStillOK=not continuationRejectOppositeStructure or not oppositeStruct or sameStruct

    if sameStruct
        contStructType:=structureContextType

    if not usableNow
        contState:=4
        contInvalidCount+=1
    else if not structureStillOK
        contState:=4
        contInvalidCount+=1
    else if bar_index>contStartBar+continuationRetestWindow
        contState:=5
        contExpireCount+=1
    else if retestEligible and barstate.isconfirmed
        string contBullReactionType=bullBoundarySweep?"BOUNDARY":bullMitigationReclaim?"MITIGATION":bullDirectional?"DIRECTIONAL":touches?"TOUCH":"NONE"
        string contBearReactionType=bearBoundarySweep?"BOUNDARY":bearMitigationReclaim?"MITIGATION":bearDirectional?"DIRECTIONAL":touches?"TOUCH":"NONE"
        if contSide==1
            contSignalScore:=f_scoreSignal(1,"CONT",contStructType,contPOIType,contBullReactionType,"NONE","NONE","NONE")
            if bullReaction and f_biasAllows(1) and f_scoreAllows(contSignalScore)
                contLongSignal:=true
                lastSignalScore:=contSignalScore
                lastSignalFamily:="CONT"
                lastSignalGrade:=f_scoreGrade(contSignalScore)
                contState:=3
                contTriggerCount+=1
        else if contSide==-1
            contSignalScore:=f_scoreSignal(-1,"CONT",contStructType,contPOIType,contBearReactionType,"NONE","NONE","NONE")
            if bearReaction and f_biasAllows(-1) and f_scoreAllows(contSignalScore)
                contShortSignal:=true
                lastSignalScore:=contSignalScore
                lastSignalFamily:="CONT"
                lastSignalGrade:=f_scoreGrade(contSignalScore)
                contState:=3
                contTriggerCount+=1

//=============================================================================
// INVERSION ENGINE
// Confirmed IFVG or BB -> reversal structure confirmation -> same POI retest/reclaim
//=============================================================================
bool invLongSignal=false
bool invShortSignal=false
int invSignalScore=na

bool newBullInvIFVG=enableInversionSignals and inversionUseIFVG and ifvgBullEvent
bool newBearInvIFVG=enableInversionSignals and inversionUseIFVG and ifvgBearEvent
bool newBullInvBB=enableInversionSignals and inversionUseBB and bullBreakerEvent
bool newBearInvBB=enableInversionSignals and inversionUseBB and bearBreakerEvent

if invState==0
    if newBullInvIFVG or newBullInvBB
        invState:=1
        invSide:=1
        invPOIType:=newBullInvIFVG?"IFVG":"BB"
        invStartBar:=bar_index
        invStructBar:=na
        invStructType:="NONE"

        if newBullInvIFVG and array.size(fvgTops)>0
            int n=array.size(fvgTops)-1
            invTop:=array.get(fvgTops,n)
            invBot:=array.get(fvgBots,n)
            invPOIBornBar:=array.get(fvgBornBars,n)
        else if newBullInvBB and array.size(obTops)>0
            int n=array.size(obTops)-1
            invTop:=array.get(obTops,n)
            invBot:=array.get(obBots,n)
            invPOIBornBar:=array.get(obBornBars,n)

    else if newBearInvIFVG or newBearInvBB
        invState:=1
        invSide:=-1
        invPOIType:=newBearInvIFVG?"IFVG":"BB"
        invStartBar:=bar_index
        invStructBar:=na
        invStructType:="NONE"

        if newBearInvIFVG and array.size(fvgTops)>0
            int n=array.size(fvgTops)-1
            invTop:=array.get(fvgTops,n)
            invBot:=array.get(fvgBots,n)
            invPOIBornBar:=array.get(fvgBornBars,n)
        else if newBearInvBB and array.size(obTops)>0
            int n=array.size(obTops)-1
            invTop:=array.get(obTops,n)
            invBot:=array.get(obBots,n)
            invPOIBornBar:=array.get(obBornBars,n)

if invState==1
    bool bullCore=(iBullCH or iBullMSS or xBullCH or xBullMSS)
    bool bearCore=(iBearCH or iBearMSS or xBearCH or xBearMSS)
    bool bullAny=(iBullBreak or xBullBreak)
    bool bearAny=(iBearBreak or xBearBreak)
    bool recentBull=f_structureContextAligned(1,inversionStructureMaxAge)
    bool recentBear=f_structureContextAligned(-1,inversionStructureMaxAge)

    bool bullConfirm=inversionStructure=="Any structure break"?bullAny:
         inversionStructure=="Recent aligned structure"?(bullCore or recentBull):
         bullCore
    bool bearConfirm=inversionStructure=="Any structure break"?bearAny:
         inversionStructure=="Recent aligned structure"?(bearCore or recentBear):
         bearCore

    if bar_index>invStartBar+inversionConfirmWindow
        invState:=5
        invExpireCount+=1
    else if invSide==1 and bullConfirm
        invState:=2
        invStructBar:=bullCore?bar_index:structureContextBar
        invStructType:=bullCore?((iBullMSS or xBullMSS)?"MSS":"CHoCH"):structureContextType
    else if invSide==-1 and bearConfirm
        invState:=2
        invStructBar:=bearCore?bar_index:structureContextBar
        invStructType:=bearCore?((iBearMSS or xBearMSS)?"MSS":"CHoCH"):structureContextType

if invState==2 and not na(invStructBar)
    bool invPOIStillActive=false

    if invPOIType=="IFVG"
        if array.size(fvgStates)>0
            for n=array.size(fvgStates)-1 to 0
                int st=array.get(fvgStates,n)
                int born=array.get(fvgBornBars,n)
                if born==invPOIBornBar and st==2
                    invPOIStillActive:=true
                    break

    else if invPOIType=="BB"
        if array.size(obStates)>0
            for n=array.size(obStates)-1 to 0
                int st=array.get(obStates,n)
                int born=array.get(obBornBars,n)
                if born==invPOIBornBar and st==2
                    invPOIStillActive:=true
                    break

    bool afterStruct=bar_index>invStartBar
    bool touches=afterStruct and low<=invTop and high>=invBot
    float mid=(invTop+invBot)/2

    bool bullBoundarySweep=afterStruct and low<=invBot and close>invBot
    bool bearBoundarySweep=afterStruct and high>=invTop and close<invTop
    bool bullMitigationReclaim=touches and close>mid
    bool bearMitigationReclaim=touches and close<mid
    bool bullDirectional=touches and close>open
    bool bearDirectional=touches and close<open

    bool bullReaction=inversionReaction=="Boundary sweep reclaim"?bullBoundarySweep:
         inversionReaction=="Mitigation reclaim"?bullMitigationReclaim:
         inversionReaction=="Touch only"?touches:
         bullDirectional

    bool bearReaction=inversionReaction=="Boundary sweep reclaim"?bearBoundarySweep:
         inversionReaction=="Mitigation reclaim"?bearMitigationReclaim:
         inversionReaction=="Touch only"?touches:
         bearDirectional

    bool sameBarReclaim=invSide==1?bullBoundarySweep:bearBoundarySweep
    bool usableNow=invPOIStillActive or sameBarReclaim

    if not usableNow
        invState:=4
        invInvalidCount+=1
    else if bar_index>invStartBar+inversionRetestWindow
        invState:=5
        invExpireCount+=1
    else if afterStruct and barstate.isconfirmed
        string invBullReactionType=bullBoundarySweep?"BOUNDARY":bullMitigationReclaim?"MITIGATION":bullDirectional?"DIRECTIONAL":touches?"TOUCH":"NONE"
        string invBearReactionType=bearBoundarySweep?"BOUNDARY":bearMitigationReclaim?"MITIGATION":bearDirectional?"DIRECTIONAL":touches?"TOUCH":"NONE"
        if invSide==1
            invSignalScore:=f_scoreSignal(1,"INV",invStructType,invPOIType,invBullReactionType,"NONE","NONE","NONE")
            if bullReaction and f_biasAllows(1) and f_scoreAllows(invSignalScore)
                invLongSignal:=true
                lastSignalScore:=invSignalScore
                lastSignalFamily:="INV"
                lastSignalGrade:=f_scoreGrade(invSignalScore)
                invState:=3
                invTriggerCount+=1
        else if invSide==-1
            invSignalScore:=f_scoreSignal(-1,"INV",invStructType,invPOIType,invBearReactionType,"NONE","NONE","NONE")
            if bearReaction and f_biasAllows(-1) and f_scoreAllows(invSignalScore)
                invShortSignal:=true
                lastSignalScore:=invSignalScore
                lastSignalFamily:="INV"
                lastSignalGrade:=f_scoreGrade(invSignalScore)
                invState:=3
                invTriggerCount+=1

//=============================================================================
// DIVERGENCE SIGNAL ENGINE
// Confirmed regular / hidden divergence can generate standalone signals.
// No fresh BOS / CHoCH / MSS requirement.
//=============================================================================
bool divLongSignal=false
bool divShortSignal=false
int divSignalScore=na
var int lastDivSignalBar=na
var int lastDivSignalPivotBar=na
string divSignalType="NONE"
string divSignalSource="NONE"
string divPOIType="NONE"
float divPOITop=na
float divPOIBot=na

f_divBiasAllows(int side,bool regular) =>
    if divergenceSignalBias=="Off"
        true
    else if divergenceSignalBias=="Regular countertrend allowed" and regular
        true
    else
        f_biasAllows(side)

if enableDivergenceSignals and barstate.isconfirmed
    bool allowRegular=divergenceTypeMode=="Both" or divergenceTypeMode=="Regular only"
    bool allowHidden=divergenceTypeMode=="Both" or divergenceTypeMode=="Hidden only"
    bool bullSelected=(bullRegularDiv and allowRegular) or (bullHiddenDiv and allowHidden)
    bool bearSelected=(bearRegularDiv and allowRegular) or (bearHiddenDiv and allowHidden)
    bool cooldownOK=na(lastDivSignalBar) or bar_index-lastDivSignalBar>=divergenceSignalCooldown
    bool pivotUniqueOK=not divergenceOnePerPivot or na(lastDivSignalPivotBar) or pivotBar!=lastDivSignalPivotBar

    bool bullConfirm=divergenceSignalMode=="Confirmed divergence" or close>open
    bool bearConfirm=divergenceSignalMode=="Confirmed divergence" or close<open

    if bullSelected and bullConfirm and cooldownOK and pivotUniqueOK and f_divBiasAllows(1,bullRegularDiv)
        divSignalType:=bullDivKind
        divSignalSource:=bullDivSource
        if array.size(fvgStates)>0
            for n=array.size(fvgStates)-1 to 0
                int st=array.get(fvgStates,n)
                int dir=array.get(fvgDirs,n)
                bool active=st==0 or st==2
                bool directionalBull=st==2?dir==-1:dir==1
                float top=array.get(fvgTops,n)
                float bot=array.get(fvgBots,n)
                int born=array.get(fvgBornBars,n)
                int invBorn=array.get(ifvgBornBars,n)
                int poiBorn=st==2?invBorn:born
                if active and directionalBull and not na(poiBorn) and bar_index>poiBorn and low<=top and high>=bot
                    divPOIType:=st==2?"IFVG":"FVG"
                    divPOITop:=top
                    divPOIBot:=bot
                    break
        if divPOIType=="NONE" and array.size(obStates)>0
            for n=array.size(obStates)-1 to 0
                int st=array.get(obStates,n)
                int dir=array.get(obDirs,n)
                bool active=st<=2
                bool directionalBull=st==2?dir==-1:dir==1
                float top=array.get(obTops,n)
                float bot=array.get(obBots,n)
                int poiBorn=array.get(obBornBars,n)
                if active and directionalBull and bar_index>poiBorn and low<=top and high>=bot
                    divPOIType:=st==2?"BB":"OB"
                    divPOITop:=top
                    divPOIBot:=bot
                    break
        string divBullReactionType=divergenceSignalMode=="Directional confirmation candle"?"DIV_DIRECTIONAL":"DIV_CONFIRMED"
        divSignalScore:=f_scoreSignal(1,"DIV","NONE",divPOIType,divBullReactionType,"NONE",divSignalType,divSignalSource)
        if f_scoreAllows(divSignalScore)
            divLongSignal:=true
            lastSignalScore:=divSignalScore
            lastSignalFamily:="DIV"
            lastSignalGrade:=f_scoreGrade(divSignalScore)
            lastDivSignalBar:=bar_index
            lastDivSignalPivotBar:=pivotBar

    if bearSelected and bearConfirm and cooldownOK and pivotUniqueOK and f_divBiasAllows(-1,bearRegularDiv)
        divSignalType:=bearDivKind
        divSignalSource:=bearDivSource
        if array.size(fvgStates)>0
            for n=array.size(fvgStates)-1 to 0
                int st=array.get(fvgStates,n)
                int dir=array.get(fvgDirs,n)
                bool active=st==0 or st==2
                bool directionalBull=st==2?dir==-1:dir==1
                float top=array.get(fvgTops,n)
                float bot=array.get(fvgBots,n)
                int born=array.get(fvgBornBars,n)
                int invBorn=array.get(ifvgBornBars,n)
                int poiBorn=st==2?invBorn:born
                if active and not directionalBull and not na(poiBorn) and bar_index>poiBorn and low<=top and high>=bot
                    divPOIType:=st==2?"IFVG":"FVG"
                    divPOITop:=top
                    divPOIBot:=bot
                    break
        if divPOIType=="NONE" and array.size(obStates)>0
            for n=array.size(obStates)-1 to 0
                int st=array.get(obStates,n)
                int dir=array.get(obDirs,n)
                bool active=st<=2
                bool directionalBull=st==2?dir==-1:dir==1
                float top=array.get(obTops,n)
                float bot=array.get(obBots,n)
                int poiBorn=array.get(obBornBars,n)
                if active and not directionalBull and bar_index>poiBorn and low<=top and high>=bot
                    divPOIType:=st==2?"BB":"OB"
                    divPOITop:=top
                    divPOIBot:=bot
                    break
        string divBearReactionType=divergenceSignalMode=="Directional confirmation candle"?"DIV_DIRECTIONAL":"DIV_CONFIRMED"
        divSignalScore:=f_scoreSignal(-1,"DIV","NONE",divPOIType,divBearReactionType,"NONE",divSignalType,divSignalSource)
        if f_scoreAllows(divSignalScore)
            divShortSignal:=true
            lastSignalScore:=divSignalScore
            lastSignalFamily:="DIV"
            lastSignalGrade:=f_scoreGrade(divSignalScore)
            lastDivSignalBar:=bar_index
            lastDivSignalPivotBar:=pivotBar

//=============================================================================
// PROVISIONAL SIGNAL ENGINE
//
// 0 IDLE
// 1 WAIT_DISPLACEMENT
// 2 WAIT_SHIFT
// 3 WAIT_POI
// 4 WAIT_RETEST
// 5 TRIGGERED
// 6 INVALIDATED
// 7 EXPIRED
//
// Causal order:
// liquidity sweep -> directional displacement -> CHoCH/MSS -> POI -> retest
//=============================================================================
var int sigState=0
var int sigSide=0
var int sigSweepBar=na
var int sigDispBar=na
var int sigShiftBar=na
var int sigPOISelectBar=na
var int sigPOIBornBar=na
var float sigPOITop=na
var float sigPOIBot=na
var string sigPOIType="NONE"
var string sigLiquiditySource="NONE"
var string sigShiftType="NONE"
var int lastTriggeredSweepBar=na
var int lastTriggeredPOIBornBar=na
var string lastTriggeredPOIType="NONE"
var int sigStartCount=0
var int sigDispCount=0
var int sigShiftCount=0
var int sigPOICount=0
var int sigTriggerCount=0
var int sigInvalidCount=0
var int sigExpireCount=0
var int sigPOIInvalidBeforeRetestCount=0
var int sigPOITimeoutCount=0
var int sigSweepReclaimCount=0

bool longSignal=false
bool shortSignal=false
int revSignalScore=na
bool sigSweepEventLong=false
bool sigSweepEventShort=false
bool sigDispEvent=false
bool sigShiftEvent=false
bool sigPOIEvent=false

float effectiveSignalDispATR=signalSensitivity=="Diagnostic"?math.min(signalDispATR,0.30):signalSensitivity=="Balanced"?math.min(signalDispATR,0.50):signalDispATR
bool bullDisplacement=barstate.isconfirmed and close>open and disp>=effectiveSignalDispATR
bool bearDisplacement=barstate.isconfirmed and close<open and disp>=effectiveSignalDispATR

bool bullInternalShift=iBullMSS or iBullCH
bool bearInternalShift=iBearMSS or iBearCH
bool bullExternalShift=xBullMSS or xBullCH
bool bearExternalShift=xBearMSS or xBearCH

bool bullShiftCore=requireInternalShift?bullInternalShift:(bullInternalShift or (allowExternalShift and bullExternalShift))
bool bearShiftCore=requireInternalShift?bearInternalShift:(bearInternalShift or (allowExternalShift and bearExternalShift))
bool bullAnyBreak=iBullBreak or xBullBreak
bool bearAnyBreak=iBearBreak or xBearBreak
bool bullShiftAllowed=bullShiftCore
bool bearShiftAllowed=bearShiftCore

bool oppositeBullBOS=iBullBOS or xBullBOS
bool oppositeBearBOS=iBearBOS or xBearBOS

// Reversal sweeps are the default setup origin.
// Close-through liquidity resolutions are optional because they represent
// continuation-style behavior and can otherwise create illogical reversals.
f_isREVLongSource(string source) =>
    source=="PDL" or source=="PWL" or source=="PML" or
     source=="ASIA L" or source=="LONDON L" or source=="NEW YORK L"

f_isREVShortSource(string source) =>
    source=="PDH" or source=="PWH" or source=="PMH" or
     source=="ASIA H" or source=="LONDON H" or source=="NEW YORK H"

// Reversal direction is explicit:
// sell-side liquidity lows -> potential LONG
// buy-side liquidity highs -> potential SHORT
bool revLongSweep=bullSweep and f_isREVLongSource(latestSweepSource)
bool revShortSweep=bearSweep and f_isREVShortSource(latestSweepSource)
bool revLongResolved=bullResolvedEvent and f_isREVLongSource(latestResolvedSource)
bool revShortResolved=bearResolvedEvent and f_isREVShortSource(latestResolvedSource)

bool longLiquidityEvent=revLongSweep or (allowResolvedLiquidityOrigins and revLongResolved)
bool shortLiquidityEvent=revShortSweep or (allowResolvedLiquidityOrigins and revShortResolved)
string longLiquiditySource=revLongSweep?latestSweepSource:revLongResolved?latestResolvedSource:"NONE"
string shortLiquiditySource=revShortSweep?latestSweepSource:revShortResolved?latestResolvedSource:"NONE"

if enableTestSignals
    // Ambiguous same-bar two-sided sweep is not a clean directional setup.
    if longLiquidityEvent and shortLiquidityEvent
        sigState:=6
        sigInvalidCount+=1
        sigSide:=0
        sigSweepBar:=na
        sigDispBar:=na
        sigShiftBar:=na
        sigPOISelectBar:=na
        sigPOIBornBar:=na
        sigPOITop:=na
        sigPOIBot:=na
        sigPOIType:="NONE"
        sigLiquiditySource:="NONE"
        sigShiftType:="NONE"

    else
        // Start or refresh a directional candidate from liquidity.
        if longLiquidityEvent
            bool canStart=sigState==0 or sigState>=5 or sigSide==-1 or resetOnNewSameSideSweep
            if canStart
                sigState:=1
                sigSide:=1
                sigSweepBar:=bar_index
                sigDispBar:=na
                sigShiftBar:=na
                sigPOISelectBar:=na
                sigPOIBornBar:=na
                sigPOITop:=na
                sigPOIBot:=na
                sigPOIType:="NONE"
                sigLiquiditySource:=longLiquiditySource
                sigShiftType:="NONE"
                sigSweepEventLong:=true
                sigStartCount+=1

        if shortLiquidityEvent
            bool canStart=sigState==0 or sigState>=5 or sigSide==1 or resetOnNewSameSideSweep
            if canStart
                sigState:=1
                sigSide:=-1
                sigSweepBar:=bar_index
                sigDispBar:=na
                sigShiftBar:=na
                sigPOISelectBar:=na
                sigPOIBornBar:=na
                sigPOITop:=na
                sigPOIBot:=na
                sigPOIType:="NONE"
                sigLiquiditySource:=shortLiquiditySource
                sigShiftType:="NONE"
                sigSweepEventShort:=true
                sigStartCount+=1

    // Opposite continuation structure invalidates a live candidate.
    bool liveCandidate=sigState>=1 and sigState<=4
    if liveCandidate and invalidateOnOppositeBOS
        if sigSide==1 and oppositeBearBOS
            sigState:=6
            sigInvalidCount+=1
        if sigSide==-1 and oppositeBullBOS
            sigState:=6
            sigInvalidCount+=1

    // Stage 1: require directional displacement after sweep.
    if sigState==1 and not na(sigSweepBar)
        if bar_index>sigSweepBar+signalDispWindow
            sigState:=7
            sigExpireCount+=1
        else if sigSide==1 and bullDisplacement
            sigDispBar:=bar_index
            sigDispEvent:=true
            sigDispCount+=1
            if bullShiftAllowed
                sigState:=3
                sigShiftBar:=bar_index
                sigShiftType:=(iBullMSS or xBullMSS)?"MSS":"CHoCH"
                sigShiftEvent:=true
                sigShiftCount+=1
            else
                sigState:=2
        else if sigSide==-1 and bearDisplacement
            sigDispBar:=bar_index
            sigDispEvent:=true
            sigDispCount+=1
            if bearShiftAllowed
                sigState:=3
                sigShiftBar:=bar_index
                sigShiftType:=(iBearMSS or xBearMSS)?"MSS":"CHoCH"
                sigShiftEvent:=true
                sigShiftCount+=1
            else
                sigState:=2

    // Stage 2: require genuine MSS/CHoCH structure.
    // No diagnostic bypass exists in production qualification.
    if sigState==2 and not na(sigDispBar)
        if bar_index>sigDispBar+signalShiftWindow
            sigState:=7
            sigExpireCount+=1
        else if sigSide==1 and bullShiftAllowed
            sigState:=3
            sigShiftBar:=bar_index
            sigShiftType:=(iBullMSS or xBullMSS)?"MSS":"CHoCH"
            sigShiftEvent:=true
            sigShiftCount+=1
        else if sigSide==-1 and bearShiftAllowed
            sigState:=3
            sigShiftBar:=bar_index
            sigShiftType:=(iBearMSS or xBearMSS)?"MSS":"CHoCH"
            sigShiftEvent:=true
            sigShiftCount+=1

    // Stage 3: select a directional POI that was created on/after the shift.
    if sigState==3 and not na(sigShiftBar)
        if bar_index>sigShiftBar+signalPOIWindow
            sigState:=7
            sigExpireCount+=1
        else
            bool foundPOI=false
            float foundTop=na
            float foundBot=na
            int foundBorn=na
            string foundType="NONE"

            if signalUseFVG and array.size(fvgStates)>0
                for n=array.size(fvgStates)-1 to 0
                    int st=array.get(fvgStates,n)
                    int dir=array.get(fvgDirs,n)
                    int born=array.get(fvgBornBars,n)
                    bool activePOI=st==0 or st==2
                    bool directionalBull=st==2?dir==-1:dir==1
                    bool sideMatch=sigSide==1?directionalBull:not directionalBull
                    if activePOI and sideMatch and not na(sigDispBar) and born>=sigDispBar
                        foundPOI:=true
                        foundTop:=array.get(fvgTops,n)
                        foundBot:=array.get(fvgBots,n)
                        foundBorn:=born
                        foundType:=st==2?"IFVG":"FVG"
                        break

            if not foundPOI and signalUseOB and array.size(obStates)>0
                for n=array.size(obStates)-1 to 0
                    int st=array.get(obStates,n)
                    int dir=array.get(obDirs,n)
                    int born=array.get(obBornBars,n)
                    bool active=st<=2
                    bool directionalBull=st==2?dir==-1:dir==1
                    bool sideMatch=sigSide==1?directionalBull:not directionalBull
                    if active and sideMatch and not na(sigDispBar) and born>=sigDispBar
                        foundPOI:=true
                        foundTop:=array.get(obTops,n)
                        foundBot:=array.get(obBots,n)
                        foundBorn:=born
                        foundType:=st==2?"BB":"OB"
                        break

            bool pdOK=not requireSignalPDLocation or (sigSide==1?inDiscount:inPremium)
            if foundPOI and pdOK
                sigState:=4
                sigPOITop:=foundTop
                sigPOIBot:=foundBot
                sigPOIBornBar:=foundBorn
                sigPOISelectBar:=bar_index
                sigPOIType:=foundType
                sigPOIEvent:=true
                sigPOICount+=1

    // Stage 4: POI interaction / reclaim after POI selection.
    // A selected POI may confirm through normal mitigation/reclaim or through
    // a boundary sweep-and-reclaim. A same-bar sweep/reclaim may trigger even
    // when the wick-consumption lifecycle retires the zone on that candle.
    if sigState==4 and not na(sigPOISelectBar)
        bool poiStillActive=false

        if sigPOIType=="FVG" or sigPOIType=="IFVG"
            if array.size(fvgStates)>0
                for n=array.size(fvgStates)-1 to 0
                    int st=array.get(fvgStates,n)
                    int born=array.get(fvgBornBars,n)
                    bool typeMatch=sigPOIType=="FVG"?st==0:st==2
                    if born==sigPOIBornBar and typeMatch
                        poiStillActive:=true
                        break

        else if sigPOIType=="OB" or sigPOIType=="BB"
            if array.size(obStates)>0
                for n=array.size(obStates)-1 to 0
                    int st=array.get(obStates,n)
                    int born=array.get(obBornBars,n)
                    bool typeMatch=sigPOIType=="OB"?st<=1:st==2
                    if born==sigPOIBornBar and typeMatch
                        poiStillActive:=true
                        break

        bool selectedPOIInverted=false

        if sigPOIType=="FVG" and array.size(fvgStates)>0
            for n=array.size(fvgStates)-1 to 0
                int st=array.get(fvgStates,n)
                int born=array.get(fvgBornBars,n)
                if born==sigPOIBornBar and st==2
                    selectedPOIInverted:=true
                    break

        if sigPOIType=="OB" and array.size(obStates)>0
            for n=array.size(obStates)-1 to 0
                int st=array.get(obStates,n)
                int born=array.get(obBornBars,n)
                if born==sigPOIBornBar and st==2
                    selectedPOIInverted:=true
                    break

        bool afterSelection=bar_index>sigPOISelectBar
        bool touches=afterSelection and low<=sigPOITop and high>=sigPOIBot
        float poiMid=(sigPOITop+sigPOIBot)/2

        bool bullBoundarySweep=afterSelection and low<=sigPOIBot and close>sigPOIBot
        bool bearBoundarySweep=afterSelection and high>=sigPOITop and close<sigPOITop
        bool bullMitigationReclaim=touches and close>poiMid
        bool bearMitigationReclaim=touches and close<poiMid
        bool bullDirectional=touches and close>open
        bool bearDirectional=touches and close<open
        bool bullMidpoint=touches and close>poiMid and close>open
        bool bearMidpoint=touches and close<poiMid and close<open

        bool bullReaction=signalRetestMode=="Boundary sweep reclaim"?bullBoundarySweep:
             signalRetestMode=="Mitigation reclaim"?bullMitigationReclaim:
             signalRetestMode=="Touch only"?touches:
             signalRetestMode=="Midpoint reaction"?bullMidpoint:
             bullDirectional

        bool bearReaction=signalRetestMode=="Boundary sweep reclaim"?bearBoundarySweep:
             signalRetestMode=="Mitigation reclaim"?bearMitigationReclaim:
             signalRetestMode=="Touch only"?touches:
             signalRetestMode=="Midpoint reaction"?bearMidpoint:
             bearDirectional

        bool sameBarSweepReclaim=sigSide==1?bullBoundarySweep:bearBoundarySweep
        bool poiUsableNow=poiStillActive or sameBarSweepReclaim

        if selectedPOIInverted
            // Original REV thesis failed. The new IFVG/BB belongs to INV,
            // not to the old reversal direction.
            sigState:=6
            sigInvalidCount+=1
            sigPOIInvalidBeforeRetestCount+=1

        else if not poiUsableNow
            sigState:=6
            sigInvalidCount+=1
            sigPOIInvalidBeforeRetestCount+=1

        else if bar_index>sigPOISelectBar+signalRetestWindow
            sigState:=7
            sigExpireCount+=1
            sigPOITimeoutCount+=1

        else if afterSelection
            bool duplicateSetup=not na(lastTriggeredSweepBar) and sigSweepBar==lastTriggeredSweepBar and sigPOIBornBar==lastTriggeredPOIBornBar and sigPOIType==lastTriggeredPOIType

            string revBullReactionType=bullBoundarySweep?"BOUNDARY":bullMitigationReclaim?"MITIGATION":bullMidpoint?"MIDPOINT":bullDirectional?"DIRECTIONAL":touches?"TOUCH":"NONE"
            string revBearReactionType=bearBoundarySweep?"BOUNDARY":bearMitigationReclaim?"MITIGATION":bearMidpoint?"MIDPOINT":bearDirectional?"DIRECTIONAL":touches?"TOUCH":"NONE"
            revSignalScore:=f_scoreSignal(1,"REV",sigShiftType,sigPOIType,revBullReactionType,sigLiquiditySource,"NONE","NONE")
            if not duplicateSetup and sigSide==1 and barstate.isconfirmed and bullReaction and f_biasAllows(1) and f_scoreAllows(revSignalScore)
                longSignal:=true
                lastSignalScore:=revSignalScore
                lastSignalFamily:="REV"
                lastSignalGrade:=f_scoreGrade(revSignalScore)
                sigState:=5
                lastTriggeredSweepBar:=sigSweepBar
                lastTriggeredPOIBornBar:=sigPOIBornBar
                lastTriggeredPOIType:=sigPOIType
                sigTriggerCount+=1
                if bullBoundarySweep
                    sigSweepReclaimCount+=1

            revSignalScore:=f_scoreSignal(-1,"REV",sigShiftType,sigPOIType,revBearReactionType,sigLiquiditySource,"NONE","NONE")
            if not duplicateSetup and sigSide==-1 and barstate.isconfirmed and bearReaction and f_biasAllows(-1) and f_scoreAllows(revSignalScore)
                shortSignal:=true
                lastSignalScore:=revSignalScore
                lastSignalFamily:="REV"
                lastSignalGrade:=f_scoreGrade(revSignalScore)
                sigState:=5
                lastTriggeredSweepBar:=sigSweepBar
                lastTriggeredPOIBornBar:=sigPOIBornBar
                lastTriggeredPOIType:=sigPOIType
                sigTriggerCount+=1
                if bearBoundarySweep
                    sigSweepReclaimCount+=1

//=============================================================================
// RISK / TRADE PROJECTION
//=============================================================================
var bool riskActive=false
var int riskSide=0
var string riskFamily="NONE"
var float riskEntry=na
var float riskSL=na
var float riskTP1=na
var float riskTP2=na
var float riskTP3=na
var string riskTP1Source="R"
var string riskTP2Source="R"
var string riskTP3Source="R"
var float riskInitialSL=na
var float riskInitialDistance=na
var bool riskBEActive=false
var float riskBEPrice=na
var int riskStartBar=na
var bool riskTP1Hit=false
var bool riskTP2Hit=false
var bool riskTP3Hit=false
var string riskStatus="IDLE"

var line riskEntryLine=na
var line riskSLLine=na
var line riskTP1Line=na
var line riskTP2Line=na
var line riskTP3Line=na

f_deleteRiskLines() =>
    if not na(riskEntryLine)
        line.delete(riskEntryLine)
    if not na(riskSLLine)
        line.delete(riskSLLine)
    if not na(riskTP1Line)
        line.delete(riskTP1Line)
    if not na(riskTP2Line)
        line.delete(riskTP2Line)
    if not na(riskTP3Line)
        line.delete(riskTP3Line)

f_priceText(v) =>
    na(v)?"—":str.tostring(v,format.mintick)

f_rText(float price,float entry,float dist) =>
    na(price) or na(entry) or na(dist) or dist<=0?"—":str.tostring(math.abs(price-entry)/dist,"#.##")+"R"

f_targetText(float price,string source,float entry,float dist) =>
    na(price)?"—":source+" · "+f_rText(price,entry,dist)

f_betterTarget(int side,float candidate,float current) =>
    na(current) or (side==1?candidate<current:candidate>current)

f_findLiquidityTarget(int side,float entry,float minDistance,float priorTarget) =>
    float best=na
    string bestSource="NONE"
    float threshold=side==1?entry+minDistance:entry-minDistance

    // Active/current sessions: use their live extrema as valid near-term objectives.
    if array.size(sessionActive)>0
        for idx=0 to 2
            bool active=array.get(sessionActive,idx)
            if active
                float candidate=side==1?array.get(sessionHi,idx):array.get(sessionLo,idx)
                string src=f_sessionName(idx)+(side==1?" H":" L")
                bool directionOK=not na(candidate) and (side==1?candidate>=threshold:candidate<=threshold)
                bool beyondPrior=na(priorTarget) or (side==1?candidate>priorTarget+syminfo.mintick:candidate<priorTarget-syminfo.mintick)
                if directionOK and beyondPrior and f_betterTarget(side,candidate,best)
                    best:=candidate
                    bestSource:=src

    // Common active liquidity registry:
    // category 0 = swing, 1 = previous D/W/M, 2 = completed session H/L.
    if array.size(liquidity)>0
        for n=0 to array.size(liquidity)-1
            LiquidityLevel q=array.get(liquidity,n)
            bool sideOK=side==1?q.buySide:not q.buySide
            bool directionOK=side==1?q.price>=threshold:q.price<=threshold
            bool beyondPrior=na(priorTarget) or (side==1?q.price>priorTarget+syminfo.mintick:q.price<priorTarget-syminfo.mintick)
            if q.state==0 and sideOK and directionOK and beyondPrior and f_betterTarget(side,q.price,best)
                best:=q.price
                bestSource:=q.source

    [best,bestSource]

//=============================================================================
// CORE SIGNAL DE-CLUSTER
// Applies to REV / CONT / INV only. DIV has its own controls.
//=============================================================================
var int lastCoreSignalBar=na
var int lastCorePOIBorn=na
var string lastCorePOIType="NONE"

bool revRawLong=longSignal
bool revRawShort=shortSignal
bool contRawLong=contLongSignal
bool contRawShort=contShortSignal
bool invRawLong=invLongSignal
bool invRawShort=invShortSignal

bool coreCooldownOK=na(lastCoreSignalBar) or bar_index-lastCoreSignalBar>=coreSignalCooldown

bool revPOIDuplicate=oneCoreSignalPerPOI and not na(sigPOIBornBar) and sigPOIBornBar==lastCorePOIBorn and sigPOIType==lastCorePOIType
bool contPOIDuplicate=oneCoreSignalPerPOI and not na(contPOIBornBar) and contPOIBornBar==lastCorePOIBorn and contPOIType==lastCorePOIType
bool invPOIDuplicate=oneCoreSignalPerPOI and not na(invPOIBornBar) and invPOIBornBar==lastCorePOIBorn and invPOIType==lastCorePOIType

bool revCandidate=(revRawLong or revRawShort) and coreCooldownOK and not revPOIDuplicate
bool contCandidate=(contRawLong or contRawShort) and coreCooldownOK and not contPOIDuplicate
bool invCandidate=(invRawLong or invRawShort) and coreCooldownOK and not invPOIDuplicate

bool allowREV=revCandidate
bool allowCONT=contCandidate
bool allowINV=invCandidate

if sameBarSignalPriority!="Allow all"
    if sameBarSignalPriority=="INV > REV > CONT"
        allowINV:=invCandidate
        allowREV:=revCandidate and not invCandidate
        allowCONT:=contCandidate and not invCandidate and not revCandidate
    else if sameBarSignalPriority=="REV > INV > CONT"
        allowREV:=revCandidate
        allowINV:=invCandidate and not revCandidate
        allowCONT:=contCandidate and not revCandidate and not invCandidate
    else
        allowCONT:=contCandidate
        allowINV:=invCandidate and not contCandidate
        allowREV:=revCandidate and not contCandidate and not invCandidate

longSignal:=revRawLong and allowREV
shortSignal:=revRawShort and allowREV
contLongSignal:=contRawLong and allowCONT
contShortSignal:=contRawShort and allowCONT
invLongSignal:=invRawLong and allowINV
invShortSignal:=invRawShort and allowINV

bool coreSignalFired=longSignal or shortSignal or contLongSignal or contShortSignal or invLongSignal or invShortSignal

if coreSignalFired
    lastCoreSignalBar:=bar_index
    if longSignal or shortSignal
        lastCorePOIBorn:=sigPOIBornBar
        lastCorePOIType:=sigPOIType
    else if invLongSignal or invShortSignal
        lastCorePOIBorn:=invPOIBornBar
        lastCorePOIType:=invPOIType
    else if contLongSignal or contShortSignal
        lastCorePOIBorn:=contPOIBornBar
        lastCorePOIType:=contPOIType

bool anyLongSignal=longSignal or contLongSignal or invLongSignal or divLongSignal
bool anyShortSignal=shortSignal or contShortSignal or invShortSignal or divShortSignal
bool anyNewSignal=anyLongSignal or anyShortSignal

if enableRiskProjection and anyNewSignal
    f_deleteRiskLines()

    riskSide:=anyLongSignal?1:-1
    riskFamily:=longSignal or shortSignal?"REV":contLongSignal or contShortSignal?"CONT":invLongSignal or invShortSignal?"INV":"DIV"
    riskEntry:=close
    riskStartBar:=bar_index
    riskTP1Hit:=false
    riskTP2Hit:=false
    riskTP3Hit:=false
    riskBEActive:=false
    riskBEPrice:=na
    riskStatus:="ACTIVE"

    float poiTop=riskFamily=="REV"?sigPOITop:riskFamily=="CONT"?contTop:riskFamily=="INV"?invTop:divPOITop
    float poiBot=riskFamily=="REV"?sigPOIBot:riskFamily=="CONT"?contBot:riskFamily=="INV"?invBot:divPOIBot

    if stopLossMode=="POI boundary" and not na(poiTop) and not na(poiBot)
        riskSL:=riskSide==1?poiBot-atr*stopATRBuffer:poiTop+atr*stopATRBuffer
    else if stopLossMode=="Signal candle"
        riskSL:=riskSide==1?low-atr*stopATRBuffer:high+atr*stopATRBuffer
    else
        riskSL:=riskSide==1?riskEntry-atr*atrStopMultiple:riskEntry+atr*atrStopMultiple

    riskInitialSL:=riskSL
    riskInitialDistance:=math.abs(riskEntry-riskSL)

    float rTP1=riskSide==1?riskEntry+riskInitialDistance*tp1R:riskEntry-riskInitialDistance*tp1R
    float rTP2=riskSide==1?riskEntry+riskInitialDistance*tp2R:riskEntry-riskInitialDistance*tp2R
    float rTP3=riskSide==1?riskEntry+riskInitialDistance*tp3R:riskEntry-riskInitialDistance*tp3R

    float liqTP1=na
    float liqTP2=na
    float liqTP3=na
    string liqTP1Source="NONE"
    string liqTP2Source="NONE"
    string liqTP3Source="NONE"

    if targetMode!="R-Multiple only" and riskInitialDistance>syminfo.mintick
        [t1,s1]=f_findLiquidityTarget(riskSide,riskEntry,riskInitialDistance*tp1R,na)
        liqTP1:=t1
        liqTP1Source:=s1
        [t2,s2]=f_findLiquidityTarget(riskSide,riskEntry,riskInitialDistance*tp2R,liqTP1)
        liqTP2:=t2
        liqTP2Source:=s2
        [t3,s3]=f_findLiquidityTarget(riskSide,riskEntry,riskInitialDistance*tp3R,liqTP2)
        liqTP3:=t3
        liqTP3Source:=s3

    if targetMode=="R-Multiple only"
        riskTP1:=rTP1
        riskTP2:=rTP2
        riskTP3:=rTP3
        riskTP1Source:="R"
        riskTP2Source:="R"
        riskTP3Source:="R"
    else if targetMode=="Liquidity only"
        riskTP1:=liqTP1
        riskTP2:=liqTP2
        riskTP3:=liqTP3
        riskTP1Source:=liqTP1Source
        riskTP2Source:=liqTP2Source
        riskTP3Source:=liqTP3Source
    else
        riskTP1:=na(liqTP1)?rTP1:liqTP1
        riskTP2:=na(liqTP2)?rTP2:liqTP2
        riskTP3:=na(liqTP3)?rTP3:liqTP3
        riskTP1Source:=na(liqTP1)?"R":liqTP1Source
        riskTP2Source:=na(liqTP2)?"R":liqTP2Source
        riskTP3Source:=na(liqTP3)?"R":liqTP3Source

    riskActive:=riskInitialDistance>syminfo.mintick and not na(riskTP1)

    if showRiskLines and riskActive
        int x2=bar_index+riskProjectionBars
        riskEntryLine:=line.new(bar_index,riskEntry,x2,riskEntry,xloc=xloc.bar_index,extend=extend.none,color=color.white,style=line.style_dotted,width=1)
        riskSLLine:=line.new(bar_index,riskSL,x2,riskSL,xloc=xloc.bar_index,extend=extend.none,color=color.red,width=1)
        if not na(riskTP1)
            riskTP1Line:=line.new(bar_index,riskTP1,x2,riskTP1,xloc=xloc.bar_index,extend=extend.none,color=color.lime,width=1)
        if not na(riskTP2)
            riskTP2Line:=line.new(bar_index,riskTP2,x2,riskTP2,xloc=xloc.bar_index,extend=extend.none,color=color.lime,width=1)
        if not na(riskTP3)
            riskTP3Line:=line.new(bar_index,riskTP3,x2,riskTP3,xloc=xloc.bar_index,extend=extend.none,color=color.lime,width=1)

if riskActive and bar_index>riskStartBar
    bool stopped=riskSide==1?low<=riskSL:high>=riskSL
    bool hit1=not na(riskTP1) and (riskSide==1?high>=riskTP1:low<=riskTP1)
    bool hit2=not na(riskTP2) and (riskSide==1?high>=riskTP2:low<=riskTP2)
    bool hit3=not na(riskTP3) and (riskSide==1?high>=riskTP3:low<=riskTP3)

    riskTP1Hit:=riskTP1Hit or hit1
    riskTP2Hit:=riskTP2Hit or hit2
    riskTP3Hit:=riskTP3Hit or hit3

    float oneRPrice=riskSide==1?riskEntry+riskInitialDistance:riskEntry-riskInitialDistance
    float customRPrice=riskSide==1?riskEntry+riskInitialDistance*breakEvenCustomR:riskEntry-riskInitialDistance*breakEvenCustomR
    bool oneRReached=riskSide==1?high>=oneRPrice:low<=oneRPrice
    bool customRReached=riskSide==1?high>=customRPrice:low<=customRPrice
    bool beTrigger=breakEvenMode=="After TP1"?riskTP1Hit:
         breakEvenMode=="After 1R"?oneRReached:
         breakEvenMode=="After TP2"?riskTP2Hit:
         breakEvenMode=="Custom R"?customRReached:false

    // Conservative same-bar handling: the stop in force at the start of the bar
    // takes precedence. A newly triggered BE stop becomes effective after this bar.
    if stopped
        riskStatus:=riskBEActive?"BE EXIT":"STOPPED"
        riskActive:=false
    else
        if not riskBEActive and breakEvenMode!="Off" and beTrigger
            riskBEActive:=true
            riskBEPrice:=riskSide==1?riskEntry+riskInitialDistance*breakEvenOffsetR:riskEntry-riskInitialDistance*breakEvenOffsetR
            riskSL:=riskBEPrice
            if not na(riskSLLine)
                line.set_y1(riskSLLine,riskSL)
                line.set_y2(riskSLLine,riskSL)

        if riskTP3Hit
            riskStatus:="TP3"
            riskActive:=false
        else if riskBEActive
            riskStatus:=riskTP2Hit?"TP2 + BE":riskTP1Hit?"TP1 + BE":"BE ACTIVE"
        else if riskTP2Hit
            riskStatus:="TP2"
        else if riskTP1Hit
            riskStatus:="TP1"

    if not riskActive and deleteRiskOnCompletion
        f_deleteRiskLines()

// Historical audit markers must be emitted before terminal reset.
var label[] signalLabels=array.new_label()
var label[] stageLabels=array.new_label()

if showHistoricalSignalAudit and (sigState==6 or sigState==7)
    string auditText=sigState==6?"POI×":"EXP"
    float auditY=sigSide==1?low:high
    label auditLb=label.new(bar_index,auditY,auditText,style=label.style_none,textcolor=sigState==6?color.orange:color.gray,size=size.tiny)
    array.push(stageLabels,auditLb)
    while array.size(stageLabels)>maxStageLabels
        label.delete(array.shift(stageLabels))

if showSignalStages
    if sigSweepEventLong
        label sl=label.new(bar_index,low,"SWP",style=label.style_none,textcolor=longSignalColor,size=size.tiny)
        array.push(stageLabels,sl)
        while array.size(stageLabels)>maxStageLabels
            label.delete(array.shift(stageLabels))
    if sigSweepEventShort
        label sl=label.new(bar_index,high,"SWP",style=label.style_none,textcolor=shortSignalColor,size=size.tiny)
        array.push(stageLabels,sl)
        while array.size(stageLabels)>maxStageLabels
            label.delete(array.shift(stageLabels))
    if sigDispEvent
        label sl=label.new(bar_index,sigSide==1?low:high,"DSP",style=label.style_none,textcolor=sigSide==1?longSignalColor:shortSignalColor,size=size.tiny)
        array.push(stageLabels,sl)
        while array.size(stageLabels)>maxStageLabels
            label.delete(array.shift(stageLabels))
    if sigShiftEvent
        label sl=label.new(bar_index,sigSide==1?low:high,sigShiftType,style=label.style_none,textcolor=sigSide==1?longSignalColor:shortSignalColor,size=size.tiny)
        array.push(stageLabels,sl)
        while array.size(stageLabels)>maxStageLabels
            label.delete(array.shift(stageLabels))
    if sigPOIEvent
        label sl=label.new(bar_index,(sigPOITop+sigPOIBot)/2,"POI",style=label.style_none,textcolor=sigSide==1?longSignalColor:shortSignalColor,size=size.tiny)
        array.push(stageLabels,sl)
        while array.size(stageLabels)>maxStageLabels
            label.delete(array.shift(stageLabels))

if longSignal and showSignalLabels
    label sigLb=label.new(bar_index,low,"REV LONG\n"+sigLiquiditySource+" → "+sigShiftType+" → "+sigPOIType+(showScoreOnLabels?"\nScore "+str.tostring(revSignalScore)+" ["+f_scoreGrade(revSignalScore)+"]":""),style=label.style_label_up,textcolor=color.white,color=longSignalColor,size=f_textSize())
    array.push(signalLabels,sigLb)
    while array.size(signalLabels)>maxSignalLabels
        label.delete(array.shift(signalLabels))

if shortSignal and showSignalLabels
    label sigLb=label.new(bar_index,high,"REV SHORT\n"+sigLiquiditySource+" → "+sigShiftType+" → "+sigPOIType+(showScoreOnLabels?"\nScore "+str.tostring(revSignalScore)+" ["+f_scoreGrade(revSignalScore)+"]":""),style=label.style_label_down,textcolor=color.white,color=shortSignalColor,size=f_textSize())
    array.push(signalLabels,sigLb)
    while array.size(signalLabels)>maxSignalLabels
        label.delete(array.shift(signalLabels))

if contLongSignal and showSignalLabels
    label sigLb=label.new(bar_index,low,"CONT LONG\n"+contPOIType+(contStructType!="NONE"?" · "+contStructType:"")+(showScoreOnLabels?"\nScore "+str.tostring(contSignalScore)+" ["+f_scoreGrade(contSignalScore)+"]":""),style=label.style_label_up,textcolor=color.white,color=longSignalColor,size=f_textSize())
    array.push(signalLabels,sigLb)
    while array.size(signalLabels)>maxSignalLabels
        label.delete(array.shift(signalLabels))

if contShortSignal and showSignalLabels
    label sigLb=label.new(bar_index,high,"CONT SHORT\n"+contPOIType+(contStructType!="NONE"?" · "+contStructType:"")+(showScoreOnLabels?"\nScore "+str.tostring(contSignalScore)+" ["+f_scoreGrade(contSignalScore)+"]":""),style=label.style_label_down,textcolor=color.white,color=shortSignalColor,size=f_textSize())
    array.push(signalLabels,sigLb)
    while array.size(signalLabels)>maxSignalLabels
        label.delete(array.shift(signalLabels))

if invLongSignal and showSignalLabels
    label sigLb=label.new(bar_index,low,"INV LONG\n"+invPOIType+" → "+invStructType+" → "+invPOIType+(showScoreOnLabels?"\nScore "+str.tostring(invSignalScore)+" ["+f_scoreGrade(invSignalScore)+"]":""),style=label.style_label_up,textcolor=color.white,color=longSignalColor,size=f_textSize())
    array.push(signalLabels,sigLb)
    while array.size(signalLabels)>maxSignalLabels
        label.delete(array.shift(signalLabels))

if invShortSignal and showSignalLabels
    label sigLb=label.new(bar_index,high,"INV SHORT\n"+invPOIType+" → "+invStructType+" → "+invPOIType+(showScoreOnLabels?"\nScore "+str.tostring(invSignalScore)+" ["+f_scoreGrade(invSignalScore)+"]":""),style=label.style_label_down,textcolor=color.white,color=shortSignalColor,size=f_textSize())
    array.push(signalLabels,sigLb)
    while array.size(signalLabels)>maxSignalLabels
        label.delete(array.shift(signalLabels))

if divLongSignal and showSignalLabels
    label sigLb=label.new(bar_index,low,"DIV LONG\n"+divSignalSource+" "+divSignalType+(divPOIType!="NONE"?" · "+divPOIType:"")+(showScoreOnLabels?"\nScore "+str.tostring(divSignalScore)+" ["+f_scoreGrade(divSignalScore)+"]":""),style=label.style_label_up,textcolor=color.white,color=longSignalColor,size=f_textSize())
    array.push(signalLabels,sigLb)
    while array.size(signalLabels)>maxSignalLabels
        label.delete(array.shift(signalLabels))

if divShortSignal and showSignalLabels
    label sigLb=label.new(bar_index,high,"DIV SHORT\n"+divSignalSource+" "+divSignalType+(divPOIType!="NONE"?" · "+divPOIType:"")+(showScoreOnLabels?"\nScore "+str.tostring(divSignalScore)+" ["+f_scoreGrade(divSignalScore)+"]":""),style=label.style_label_down,textcolor=color.white,color=shortSignalColor,size=f_textSize())
    array.push(signalLabels,sigLb)
    while array.size(signalLabels)>maxSignalLabels
        label.delete(array.shift(signalLabels))

// Inversion reset after its labels are rendered.
if invState==3 or invState==4 or invState==5
    invState:=0
    invSide:=0
    invPOIType:="NONE"
    invPOIBornBar:=na
    invTop:=na
    invBot:=na
    invStartBar:=na
    invStructBar:=na
    invStructType:="NONE"

// Continuation reset after its labels are rendered.
if contState==3 or contState==4 or contState==5
    contState:=0
    contSide:=0
    contPOIType:="NONE"
    contPOIBornBar:=na
    contTop:=na
    contBot:=na
    contStartBar:=na
    contBOSBar:=na
    contStructType:="NONE"

// Terminal-state reset AFTER rendering signal/stage labels.
// This preserves the completed setup's source, side, shift and POI metadata
// long enough for historical TEST labels and audit visuals to be created.
if sigState==5 or sigState==6 or sigState==7
    sigState:=0
    sigSide:=0
    sigLiquiditySource:="NONE"
    sigSweepBar:=na
    sigDispBar:=na
    sigShiftBar:=na
    sigShiftType:="NONE"
    sigPOISelectBar:=na
    sigPOIBornBar:=na
    sigPOITop:=na
    sigPOIBot:=na
    sigPOIType:="NONE"

//=============================================================================
// UNIFIED DASHBOARD
//=============================================================================
f_dashPos() =>
    dashboardPosition=="Top Right"?position.top_right:
     dashboardPosition=="Bottom Right"?position.bottom_right:
     dashboardPosition=="Top Left"?position.top_left:
     position.bottom_left

f_dashSize() =>
    dashboardTextSize=="Tiny"?size.tiny:dashboardTextSize=="Normal"?size.normal:size.small

f_trendText(v) =>
    v==1?"BULL":v==-1?"BEAR":"NEUTRAL"

f_trendColor(v) =>
    v==1?color.lime:v==-1?color.red:color.gray

f_boolStateText(bullState,bearState) =>
    bullState?"BULL":bearState?"BEAR":"NEUTRAL"

f_boolStateColor(bullState,bearState) =>
    bullState?color.lime:bearState?color.red:color.gray

f_sessionText() =>
    asiaIn?"ASIA":londonIn?"LONDON":nyIn?"NEW YORK":"OFF"

f_pdText() =>
    if not pdZoneActive or na(pdZoneHigh) or na(pdZoneLow)
        "N/A"
    else
        float eq=(pdZoneHigh+pdZoneLow)/2
        close>eq?"PREMIUM":close<eq?"DISCOUNT":"EQ"

f_latestStructureText() =>
    string t="NONE"
    if iBullMSS or xBullMSS
        t:="BULL MSS"
    else if iBearMSS or xBearMSS
        t:="BEAR MSS"
    else if iBullCH or xBullCH
        t:="BULL CHoCH"
    else if iBearCH or xBearCH
        t:="BEAR CHoCH"
    else if iBullBreak or xBullBreak
        t:="BULL BOS"
    else if iBearBreak or xBearBreak
        t:="BEAR BOS"
    t

f_latestLiquidityText() =>
    string t="NONE"
    if lastSignalFamily!="NONE"
        t:=lastSignalFamily
    if sigLiquiditySource!="NONE"
        t:=sigLiquiditySource
    t

f_activeSetupText() =>
    string t="NONE"
    if sigState>0 and sigState<5
        t:="REV "+(sigSide==1?"LONG":"SHORT")
    else if contState>0 and contState<3
        t:="CONT "+(contSide==1?"LONG":"SHORT")
    else if invState>0 and invState<3
        t:="INV "+(invSide==1?"LONG":"SHORT")
    else if lastSignalFamily!="NONE"
        t:=lastSignalFamily
    t

f_activeSetupStateText() =>
    string t="IDLE"
    if sigState==1
        t:="WAIT DISPLACEMENT"
    else if sigState==2
        t:="WAIT SHIFT"
    else if sigState==3
        t:="WAIT POI"
    else if sigState==4
        t:="WAIT RETEST"
    else if contState==1
        t:="WAIT STRUCTURE"
    else if contState==2
        t:="WAIT RETEST"
    else if invState==1
        t:="WAIT STRUCTURE"
    else if invState==2
        t:="WAIT RETEST"
    t

f_activePOIText() =>
    string t="NONE"
    if sigState>0 and sigState<5 and sigPOIType!="NONE"
        t:=sigPOIType
    else if contState>0 and contState<3 and contPOIType!="NONE"
        t:=contPOIType
    else if invState>0 and invState<3 and invPOIType!="NONE"
        t:=invPOIType
    t

f_activeScoreText() =>
    na(lastSignalScore)?"—":str.tostring(lastSignalScore)+" ["+lastSignalGrade+"]"

f_divContextText() =>
    recentBullDiv and recentBearDiv?"BULL + BEAR":recentBullDiv?"BULL SUPPORT":recentBearDiv?"BEAR SUPPORT":"NONE"

// Use fixed largest table, render subset by mode.
var table arthaDash=table.new(f_dashPos(),2,34)

if barstate.islast
    table.clear(arthaDash,0,0,1,33)
    if showUnifiedDashboard
        int r=0

        table.cell(arthaDash,0,r,"ARTHA",text_color=color.white,bgcolor=color.new(color.gray,70),text_size=f_dashSize())
        table.cell(arthaDash,1,r,dashboardMode,text_color=color.white,bgcolor=color.new(color.gray,70),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"HTF Bias",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_biasText(htfBias),text_color=f_biasColor(htfBias),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"MTF Bias",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_biasText(mtfBias),text_color=f_biasColor(mtfBias),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"Alignment",text_size=f_dashSize())
        table.cell(arthaDash,1,r,mtfAligned?"ALIGNED":"MIXED",text_color=mtfAligned?color.lime:color.orange,text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"Session",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_sessionText(),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"P/D",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_pdText(),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"Structure",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_latestStructureText(),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"POI",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_activePOIText(),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"Setup",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_activeSetupText(),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"State",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_activeSetupStateText(),text_size=f_dashSize())
        r+=1

        table.cell(arthaDash,0,r,"Score",text_size=f_dashSize())
        table.cell(arthaDash,1,r,f_activeScoreText(),text_size=f_dashSize())
        r+=1
        table.cell(arthaDash,0,r,"Risk",text_size=f_dashSize())
        table.cell(arthaDash,1,r,riskStatus,text_size=f_dashSize())
        r+=1

        if dashboardMode!="Compact"
            table.cell(arthaDash,0,r,"Time Zone",text_size=f_dashSize())
            table.cell(arthaDash,1,r,sessionTz,text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Session VWAP",text_size=f_dashSize())
            table.cell(arthaDash,1,r,(selectedSessionId==0?"ASIA ":selectedSessionId==1?"LONDON ":selectedSessionId==2?"NEW YORK ":"")+f_vwapPos(sessionVWAP),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Daily VWAP",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_vwapPos(dailyVWAP),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Weekly VWAP",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_vwapPos(weeklyVWAP),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Monthly VWAP",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_vwapPos(monthlyVWAP),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Divergence",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_divContextText(),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Bias Filter",text_size=f_dashSize())
            table.cell(arthaDash,1,r,biasFilterMode,text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"VWAP Filter",text_size=f_dashSize())
            table.cell(arthaDash,1,r,vwapFilterMode,text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Div Filter",text_size=f_dashSize())
            table.cell(arthaDash,1,r,divergenceFilterMode,text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Score Filter",text_size=f_dashSize())
            table.cell(arthaDash,1,r,scoreFilterMode=="Off"?"Off":">="+str.tostring(minimumSignalScore),text_size=f_dashSize())
            r+=1
            table.cell(arthaDash,0,r,"Entry",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_priceText(riskEntry),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"SL",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_priceText(riskSL)+(riskBEActive?" · BE":""),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"TP1",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_targetText(riskTP1,riskTP1Source,riskEntry,riskInitialDistance),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"TP2",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_targetText(riskTP2,riskTP2Source,riskEntry,riskInitialDistance),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"TP3",text_size=f_dashSize())
            table.cell(arthaDash,1,r,f_targetText(riskTP3,riskTP3Source,riskEntry,riskInitialDistance),text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"BE Trigger",text_size=f_dashSize())
            table.cell(arthaDash,1,r,breakEvenMode,text_size=f_dashSize())
            r+=1

        if dashboardMode=="Diagnostic"
            table.cell(arthaDash,0,r,"REV State",text_size=f_dashSize())
            table.cell(arthaDash,1,r,str.tostring(sigState)+" / "+sigPOIType,text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"CONT State",text_size=f_dashSize())
            table.cell(arthaDash,1,r,str.tostring(contState)+" / "+contPOIType,text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"INV State",text_size=f_dashSize())
            table.cell(arthaDash,1,r,str.tostring(invState)+" / "+invPOIType,text_size=f_dashSize())
            r+=1

            table.cell(arthaDash,0,r,"Risk Family",text_size=f_dashSize())
            table.cell(arthaDash,1,r,riskFamily+" / "+riskStatus,text_size=f_dashSize())
            r+=1
//=============================================================================
// ALERTS
//=============================================================================
alertcondition(bullSweep,"ARTHA Bullish Liquidity Sweep","Confirmed sell-side liquidity sweep")
alertcondition(bearSweep,"ARTHA Bearish Liquidity Sweep","Confirmed buy-side liquidity sweep")
alertcondition(iBullBOS or xBullBOS,"ARTHA Bullish BOS","Confirmed bullish BOS")
alertcondition(iBearBOS or xBearBOS,"ARTHA Bearish BOS","Confirmed bearish BOS")
alertcondition(iBullCH or xBullCH,"ARTHA Bullish CHoCH","Confirmed bullish CHoCH")
alertcondition(iBearCH or xBearCH,"ARTHA Bearish CHoCH","Confirmed bearish CHoCH")
alertcondition(iBullMSS or xBullMSS,"ARTHA Bullish MSS","Confirmed bullish MSS")
alertcondition(iBearMSS or xBearMSS,"ARTHA Bearish MSS","Confirmed bearish MSS")
alertcondition(bullFVG,"ARTHA Bullish FVG","Confirmed bullish FVG created")
alertcondition(bearFVG,"ARTHA Bearish FVG","Confirmed bearish FVG created")
alertcondition(ifvgBullEvent,"ARTHA Bullish IFVG","Confirmed bullish IFVG")
alertcondition(ifvgBearEvent,"ARTHA Bearish IFVG","Confirmed bearish IFVG")
alertcondition(bullBreakerEvent,"ARTHA Bullish Breaker","Confirmed bullish breaker")
alertcondition(bearBreakerEvent,"ARTHA Bearish Breaker","Confirmed bearish breaker")
alertcondition(newPDZone and newBullPD,"ARTHA Bullish P/D Range","New bullish structural P/D range")
alertcondition(newPDZone and newBearPD,"ARTHA Bearish P/D Range","New bearish structural P/D range")
alertcondition(longSignal,"ARTHA TEST LONG","Provisional ARTHA test LONG")
alertcondition(shortSignal,"ARTHA TEST SHORT","Provisional ARTHA test SHORT")
alertcondition(contLongSignal,"ARTHA CONT LONG","ARTHA continuation LONG")
alertcondition(contShortSignal,"ARTHA CONT SHORT","ARTHA continuation SHORT")
alertcondition(invLongSignal,"ARTHA INV LONG","ARTHA inversion LONG")
alertcondition(invShortSignal,"ARTHA INV SHORT","ARTHA inversion SHORT")
alertcondition(divLongSignal,"ARTHA DIV LONG","ARTHA divergence LONG")
alertcondition(divShortSignal,"ARTHA DIV SHORT","ARTHA divergence SHORT")


//=============================================================================
// STRATEGY HARNESS v0.1
// Uses existing ARTHA signals; does not modify signal-generation logic.
//=============================================================================
f_familyAllowed(string family) =>
    strategyFamilies=="All" or strategyFamilies==family

f_dirAllowed(int side) =>
    strategyDirection=="Both" or (strategyDirection=="Long only" and side==1) or (strategyDirection=="Short only" and side==-1)

bool strategyLongCandidate=longSignal or contLongSignal or invLongSignal or divLongSignal
bool strategyShortCandidate=shortSignal or contShortSignal or invShortSignal or divShortSignal

string strategyLongFamily=longSignal?"REV":contLongSignal?"CONT":invLongSignal?"INV":divLongSignal?"DIV":"NONE"
string strategyShortFamily=shortSignal?"REV":contShortSignal?"CONT":invShortSignal?"INV":divShortSignal?"DIV":"NONE"

int strategyLongScore=strategyLongCandidate?lastSignalScore:na
int strategyShortScore=strategyShortCandidate?lastSignalScore:na

bool strategyLongOK=strategyEnabled and barstate.isconfirmed and strategyLongCandidate and f_familyAllowed(strategyLongFamily) and f_dirAllowed(1) and (na(strategyLongScore) or strategyLongScore>=strategyMinScore)
bool strategyShortOK=strategyEnabled and barstate.isconfirmed and strategyShortCandidate and f_familyAllowed(strategyShortFamily) and f_dirAllowed(-1) and (na(strategyShortScore) or strategyShortScore>=strategyMinScore)

float strategyQtyPct=strategyRiskPct

// Entry price uses signal-bar close because all production signals are confirmed-bar events.
if strategyLongOK and strategy.position_size<=0
    if strategy.position_size<0
        strategy.close("SHORT")
    strategy.entry("LONG",strategy.long,qty=strategyQtyPct)

if strategyShortOK and strategy.position_size>=0
    if strategy.position_size>0
        strategy.close("LONG")
    strategy.entry("SHORT",strategy.short,qty=strategyQtyPct)

// Prefer ARTHA's existing projected SL/TP where available.
// If unavailable, derive a deterministic 1R stop from ATR and use Fixed-R target.
float stratLongSL=na
float stratLongTP=na
float stratShortSL=na
float stratShortTP=na

if strategy.position_size>0
    float entry=strategy.position_avg_price
    stratLongSL:=not na(riskSL)?riskSL:entry-atr
    float riskDist=math.max(entry-stratLongSL,syminfo.mintick)
    stratLongTP:=strategyExitMode=="Existing ARTHA risk" and not na(riskTP2)?riskTP2:entry+riskDist*strategyFixedR
    strategy.exit("LONG-X","LONG",stop=stratLongSL,limit=stratLongTP)

if strategy.position_size<0
    float entry=strategy.position_avg_price
    stratShortSL:=not na(riskSL)?riskSL:entry+atr
    float riskDist=math.max(stratShortSL-entry,syminfo.mintick)
    stratShortTP:=strategyExitMode=="Existing ARTHA risk" and not na(riskTP2)?riskTP2:entry-riskDist*strategyFixedR
    strategy.exit("SHORT-X","SHORT",stop=stratShortSL,limit=stratShortTP)

if strategyCloseOnOpposite
    if strategy.position_size>0 and strategyShortCandidate
        strategy.close("LONG")
    if strategy.position_size<0 and strategyLongCandidate
        strategy.close("SHORT")
