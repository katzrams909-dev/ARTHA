//@version=6
strategy("ARTHA STRATEGY v0.1 — Baseline Backtest", shorttitle="ARTHA S0.1", overlay=true,
     max_lines_count=500, max_boxes_count=300, max_labels_count=500,
     pyramiding=0, process_orders_on_close=true, calc_on_order_fills=true,
     commission_type=strategy.commission.percent, commission_value=0.0)

//=============================================================================
// ARTHA MASTER v0.2
// P01–P05 integrated market/context core + provisional causal signal engine.
// Calculations are independent from display settings.
//=============================================================================

//=============================================================================
// 01 GLOBAL DISPLAY
//=============================================================================
string G01="01 Global Display"
string displayMode=input.string("Analysis","Display mode",options=["Execution","Analysis","Full"],group=G01)
string textSizeChoice=input.string("Small","Global text size",options=["Tiny","Small","Normal"],group=G01)

string GS="00 Strategy Backtest"
bool strategyEnabled=input.bool(true,"Enable strategy orders",group=GS)
string strategyFamilies=input.string("All","Signal families",options=["All","REV","CONT","INV","DIV"],group=GS)
string strategyDirection=input.string("Both","Trade direction",options=["Both","Long only","Short only"],group=GS)
int strategyMinScore=input.int(0,"Minimum score for entries",minval=0,maxval=100,group=GS)
float strategyRiskPct=input.float(1.0,"Position size % of equity",minval=0.1,maxval=100,step=0.1,group=GS)
string strategyExitMode=input.string("Existing ARTHA risk","Exit model",options=["Existing ARTHA risk","Fixed R"],group=GS)
float strategyFixedR=input.float(2.0,"Fixed R target",minval=0.25,maxval=10,step=0.25,group=GS)
bool strategyUseBE=input.bool(true,"Use ARTHA break-even logic where available",group=GS)
bool strategyCloseOnOpposite=input.bool(false,"Close on opposite signal",group=GS)

bool modeExecution=displayMode=="Execution"
bool modeAnalysis=displayMode=="Analysis"
bool modeFull=displayMode=="Full"

f_textSize() =>
    textSizeChoice=="Tiny"?size.tiny:textSizeChoice=="Normal"?size.normal:size.small

f_hidden(color c) =>
    color.new(c,100)

