bool diagnostic=input.bool(false,"Diagnostic panel",group=G01)
string textSizeChoice=input.string("Small","Global text size",options=["Tiny","Small","Normal"],group=G01)

bool modeExecution=displayMode=="Execution"
bool modeAnalysis=displayMode=="Analysis"
bool modeFull=displayMode=="Full"

f_textSize() =>
    textSizeChoice=="Tiny"?size.tiny:textSizeChoice=="Normal"?size.normal:size.small

f_hidden(color c) =>
    color.new(c,100)

